// Standard I/O utilities for Nore

import "std/string.nore"

func print(ref s: str): void = {
    fd_write(STDOUT, ref s)
}

func println(ref s: str): void = {
    fd_write(STDOUT, ref s)
    fd_write(STDOUT, ref "\n")
}

func print_i64(n: i64): void = {
    mut mem: Arena = arena(64)
    val s: str = i64_to_str(mut ref mem, n)
    fd_write(STDOUT, ref s)
}
