// Standard file operations for Nore

// Open flags (POSIX)
val O_RDONLY: i32 = 0
val O_WRONLY: i32 = 1
val O_RDWR: i32 = 2
val O_CREAT: i32 = if (TARGET_OS == OS.MacOS) { 512 } else { 64 }
val O_TRUNC: i32 = if (TARGET_OS == OS.MacOS) { 1024 } else { 512 }
val O_APPEND: i32 = if (TARGET_OS == OS.MacOS) { 8 } else { 1024 }

// Seek whence constants
val SEEK_SET: i32 = 0
val SEEK_CUR: i32 = 1
val SEEK_END: i32 = 2

// Result types for file operations
enum ReadResult { Ok([u8]), Err(i32) }
enum WriteResult { Ok(i64), Err(i32) }

// Read an entire file into a byte slice (arena-allocated).
// Returns ReadResult.Ok(data) on success, ReadResult.Err(fd) on error.
func read_file(mut ref mem: Arena, ref path: str): ReadResult = {
    val fd: i32 = fd_open(ref path, O_RDONLY)
    if (fd < 0) {
        return ReadResult.Err(fd)
    }
    val size: i64 = fd_seek(fd, 0, SEEK_END)
    if (size <= 0) {
        fd_close(fd)
        if (size < 0) {
            return ReadResult.Err(i32(0 - 1))
        }
        // Empty file
        mut empty: [u8] = arena_alloc(mut ref mem, 1)
        return ReadResult.Ok(empty[0..0])
    }
    fd_seek(fd, 0, SEEK_SET)
    mut buf: [u8] = arena_alloc(mut ref mem, size)
    mut total: i64 = 0
    mut done: bool = false
    while (!done && total < size) {
        mut remaining: [u8] = buf[total..size]
        val n: i64 = fd_read(fd, mut ref remaining)
        if (n <= 0) {
            done = true
        } else {
            total = total + n
        }
    }
    fd_close(fd)
    ReadResult.Ok(buf[0..total])
}

// Write a byte slice to a file (creates or overwrites).
// Returns WriteResult.Ok(bytes_written) on success, WriteResult.Err(fd) on error.
func write_file(ref path: str, ref data: [u8]): WriteResult = {
    val fd: i32 = fd_open(ref path, O_WRONLY | O_CREAT | O_TRUNC)
    if (fd < 0) {
        return WriteResult.Err(fd)
    }
    mut written: i64 = 0
    while (written < data.len) {
        val remaining: [u8] = data[written..data.len]
        val n: i64 = fd_write(fd, ref remaining)
        if (n <= 0) {
            fd_close(fd)
            return WriteResult.Err(i32(0 - 1))
        }
        written = written + n
    }
    fd_close(fd)
    WriteResult.Ok(written)
}
