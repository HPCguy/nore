// Standard JSON parser for Nore
// Parses JSON strings into a flat node table with index-based relationships.

import string "std/string.nore"

// Node kinds
pub enum JsonKind { Null, Bool, Number, Str, Array, Object }

// Flat node table: tree relationships via parent/child/sibling indices
pub table JsonNodes {
    kind: JsonKind,
    num_val: f64,
    bool_val: i64,
    str_start: i64,
    str_len: i64,
    key_start: i64,
    key_len: i64,
    parent: i64,
    first_child: i64,
    last_child: i64,
    next_sibling: i64,
    child_count: i64
}

// Parse error info
pub value JsonError {
    line: i64,
    col: i64
}

// Parse result
pub enum JsonResult { Ok(i64), Err(JsonError) }

// Parser state (value type, passed by mut ref)
value ParseState {
    pos: i64,
    line: i64,
    col: i64,
    error: bool
}

// --- Internal helpers ---

// Return current byte without advancing
func peek(ref src: str, ref st: ParseState): u8 = {
    if (st.pos >= src.len) { return 0 }
    src[st.pos]
}

// Consume one byte, tracking line/column
func advance(ref src: str, mut ref st: ParseState): u8 = {
    if (st.pos >= src.len) { return 0 }
    val c: u8 = src[st.pos]
    st.pos = st.pos + 1
    if (c == '\n') {
        st.line = st.line + 1
        st.col = 1
    } else {
        st.col = st.col + 1
    }
    c
}

// Skip spaces, tabs, newlines
func skip_whitespace(ref src: str, mut ref st: ParseState): void = {
    while (st.pos < src.len && string.is_space(src[st.pos])) {
        advance(ref src, mut ref st)
    }
}

// Mark parse as failed
func set_error(mut ref st: ParseState): void = {
    st.error = true
}

// Insert a new node with default fields, return its index
func add_node(mut ref nodes: JsonNodes, kind: JsonKind, parent: i64): i64 = {
    val idx: i64 = table_len(ref nodes)
    table_insert(mut ref nodes, JsonNodes.Row {
        kind: kind,
        num_val: 0.0,
        bool_val: 0,
        str_start: 0,
        str_len: 0,
        key_start: 0,
        key_len: 0,
        parent: parent,
        first_child: -1,
        last_child: -1,
        next_sibling: -1,
        child_count: 0
    })
    idx
}

// Link child to parent's sibling chain (O(1) via last_child)
func add_child(mut ref nodes: JsonNodes, parent: i64, child: i64): void = {
    if (nodes.first_child[parent] < 0) {
        nodes.first_child[parent] = child
    } else {
        nodes.next_sibling[nodes.last_child[parent]] = child
    }
    nodes.last_child[parent] = child
    nodes.child_count[parent] = nodes.child_count[parent] + 1
}

// Check and consume an exact string (e.g. "null", "true", "false")
func match_literal(ref src: str, mut ref st: ParseState, ref expected: str): bool = {
    val remaining: str = src[st.pos..]
    if (!string.str_starts_with(ref remaining, ref expected)) {
        return false
    }
    mut i: i64 = 0
    while (i < expected.len) {
        advance(ref src, mut ref st)
        i = i + 1
    }
    true
}

// Advance past string content until closing quote, handling escapes
func scan_string_body(ref src: str, mut ref st: ParseState): void = {
    mut done: bool = false
    while (!done) {
        if (st.pos >= src.len) {
            set_error(mut ref st)
            return
        }
        val c: u8 = src[st.pos]
        if (c == '"') {
            done = true
        } else {
            if (c == '\\') {
                advance(ref src, mut ref st)
                if (st.pos >= src.len) {
                    set_error(mut ref st)
                    return
                }
            }
            advance(ref src, mut ref st)
        }
    }
}

// --- Main parser (self-recursive, no mutual recursion) ---

// Dispatch on first char, parse one JSON value, return node index or -1
func parse_value(ref src: str, mut ref nodes: JsonNodes, mut ref st: ParseState, parent: i64): i64 = {
    skip_whitespace(ref src, mut ref st)
    if (st.pos >= src.len) {
        set_error(mut ref st)
        return -1
    }
    val c: u8 = src[st.pos]

    // null
    if (c == 'n') {
        if (!match_literal(ref src, mut ref st, ref "null")) {
            set_error(mut ref st)
            return -1
        }
        val idx: i64 = add_node(mut ref nodes, JsonKind.Null, parent)
        if (parent >= 0) {
            add_child(mut ref nodes, parent, idx)
        }
        return idx
    }

    // true / false
    if (c == 't' || c == 'f') {
        mut bval: i64 = 0
        if (c == 't') {
            if (!match_literal(ref src, mut ref st, ref "true")) {
                set_error(mut ref st)
                return -1
            }
            bval = 1
        } else {
            if (!match_literal(ref src, mut ref st, ref "false")) {
                set_error(mut ref st)
                return -1
            }
        }
        val idx: i64 = add_node(mut ref nodes, JsonKind.Bool, parent)
        nodes.bool_val[idx] = bval
        if (parent >= 0) {
            add_child(mut ref nodes, parent, idx)
        }
        return idx
    }

    // string
    if (c == '"') {
        advance(ref src, mut ref st)
        val start: i64 = st.pos
        scan_string_body(ref src, mut ref st)
        if (st.error) {
            return -1
        }
        val slen: i64 = st.pos - start
        advance(ref src, mut ref st)
        val idx: i64 = add_node(mut ref nodes, JsonKind.Str, parent)
        nodes.str_start[idx] = start
        nodes.str_len[idx] = slen
        if (parent >= 0) {
            add_child(mut ref nodes, parent, idx)
        }
        return idx
    }

    // number
    if (c == '-' || string.is_digit(c)) {
        // Scan forward to find the number boundary
        val start: i64 = st.pos
        mut end: i64 = st.pos
        mut scanning: bool = true
        while (end < src.len && scanning) {
            val ch: u8 = src[end]
            if (string.is_digit(ch) || ch == '-' || ch == '+' || ch == '.' || ch == 'e' || ch == 'E') {
                end = end + 1
            } else {
                scanning = false
            }
        }
        val num_str: str = src[start..end]
        val result: string.ParseFloatResult = string.str_to_f64(ref num_str)
        match (result) {
            Ok(num) = {
                // Advance parser past the number
                mut ai: i64 = 0
                while (ai < num_str.len) {
                    advance(ref src, mut ref st)
                    ai = ai + 1
                }
                val idx: i64 = add_node(mut ref nodes, JsonKind.Number, parent)
                nodes.num_val[idx] = num
                if (parent >= 0) {
                    add_child(mut ref nodes, parent, idx)
                }
                return idx
            }
            None = {
                set_error(mut ref st)
                return -1
            }
        }
        set_error(mut ref st)
        return -1
    }

    // array
    if (c == '[') {
        advance(ref src, mut ref st)
        val idx: i64 = add_node(mut ref nodes, JsonKind.Array, parent)
        if (parent >= 0) {
            add_child(mut ref nodes, parent, idx)
        }
        skip_whitespace(ref src, mut ref st)
        if (st.pos < src.len && src[st.pos] == ']') {
            advance(ref src, mut ref st)
            return idx
        }
        mut arr_done: bool = false
        while (!arr_done) {
            val child: i64 = parse_value(ref src, mut ref nodes, mut ref st, idx)
            if (st.error) {
                return -1
            }
            skip_whitespace(ref src, mut ref st)
            if (st.pos >= src.len) {
                set_error(mut ref st)
                return -1
            }
            if (src[st.pos] == ',') {
                advance(ref src, mut ref st)
            } else {
                if (src[st.pos] == ']') {
                    advance(ref src, mut ref st)
                    arr_done = true
                } else {
                    set_error(mut ref st)
                    return -1
                }
            }
        }
        return idx
    }

    // object
    if (c == '{') {
        advance(ref src, mut ref st)
        val idx: i64 = add_node(mut ref nodes, JsonKind.Object, parent)
        if (parent >= 0) {
            add_child(mut ref nodes, parent, idx)
        }
        skip_whitespace(ref src, mut ref st)
        if (st.pos < src.len && src[st.pos] == '}') {
            advance(ref src, mut ref st)
            return idx
        }
        mut obj_done: bool = false
        while (!obj_done) {
            skip_whitespace(ref src, mut ref st)
            // Parse key
            if (st.pos >= src.len || src[st.pos] != '"') {
                set_error(mut ref st)
                return -1
            }
            advance(ref src, mut ref st)
            val key_start: i64 = st.pos
            scan_string_body(ref src, mut ref st)
            if (st.error) {
                return -1
            }
            val key_len: i64 = st.pos - key_start
            advance(ref src, mut ref st)
            // Expect colon
            skip_whitespace(ref src, mut ref st)
            if (st.pos >= src.len || src[st.pos] != ':') {
                set_error(mut ref st)
                return -1
            }
            advance(ref src, mut ref st)
            // Parse value
            val child: i64 = parse_value(ref src, mut ref nodes, mut ref st, idx)
            if (st.error) {
                return -1
            }
            nodes.key_start[child] = key_start
            nodes.key_len[child] = key_len
            // Comma or close
            skip_whitespace(ref src, mut ref st)
            if (st.pos >= src.len) {
                set_error(mut ref st)
                return -1
            }
            if (src[st.pos] == ',') {
                advance(ref src, mut ref st)
            } else {
                if (src[st.pos] == '}') {
                    advance(ref src, mut ref st)
                    obj_done = true
                } else {
                    set_error(mut ref st)
                    return -1
                }
            }
        }
        return idx
    }

    set_error(mut ref st)
    return -1
}

// --- Public API ---

// Parse a JSON string into the node table, return root index or error
pub func json_parse(mut ref nodes: JsonNodes, ref src: str): JsonResult = {
    mut st: ParseState = ParseState { pos: 0, line: 1, col: 1, error: false }
    val root: i64 = parse_value(ref src, mut ref nodes, mut ref st, -1)
    if (st.error) {
        return JsonResult.Err(JsonError { line: st.line, col: st.col })
    }
    skip_whitespace(ref src, mut ref st)
    if (st.pos < src.len) {
        return JsonResult.Err(JsonError { line: st.line, col: st.col })
    }
    JsonResult.Ok(root)
}

// Node kind (Null, Bool, Number, Str, Array, Object)
pub func json_kind(ref nodes: JsonNodes, node: i64): JsonKind = {
    nodes.kind[node]
}

// First child index, -1 if leaf
pub func json_child(ref nodes: JsonNodes, parent: i64): i64 = {
    nodes.first_child[parent]
}

// Next sibling index, -1 if last
pub func json_next(ref nodes: JsonNodes, node: i64): i64 = {
    nodes.next_sibling[node]
}

// String value as sub-slice of source (zero-copy)
pub func json_str(ref src: str, ref nodes: JsonNodes, node: i64): str = {
    src[nodes.str_start[node] .. nodes.str_start[node] + nodes.str_len[node]]
}

// Object key as sub-slice of source (zero-copy)
pub func json_key(ref src: str, ref nodes: JsonNodes, node: i64): str = {
    src[nodes.key_start[node] .. nodes.key_start[node] + nodes.key_len[node]]
}

// Number value as f64
pub func json_num(ref nodes: JsonNodes, node: i64): f64 = {
    nodes.num_val[node]
}

// Boolean value
pub func json_bool(ref nodes: JsonNodes, node: i64): bool = {
    nodes.bool_val[node] != 0
}

// Number of children (array elements or object keys)
pub func json_len(ref nodes: JsonNodes, node: i64): i64 = {
    nodes.child_count[node]
}

// Total number of nodes in the tree
pub func json_count(ref nodes: JsonNodes): i64 = {
    table_len(ref nodes)
}

// Find child of parent by key name, -1 if not found
pub func json_find(ref src: str, ref nodes: JsonNodes, parent: i64, ref key: str): i64 = {
    mut child: i64 = nodes.first_child[parent]
    while (child >= 0) {
        val k: str = src[nodes.key_start[child] .. nodes.key_start[child] + nodes.key_len[child]]
        if (string.str_eq(ref k, ref key)) {
            return child
        }
        child = nodes.next_sibling[child]
    }
    -1
}
