// Test if/else as block value expression

// Simple: if/else as function body value_expr
func min_i64(a: i64, b: i64): i64 = {
    if (a < b) { a } else { b }
}

func max_i64(a: i64, b: i64): i64 = {
    if (a > b) { a } else { b }
}

// return if/else
func abs_i64(a: i64): i64 = {
    return if (a < 0) { 0 - a } else { a }
}

// else if as value_expr
func clamp(x: i64, lo: i64, hi: i64): i64 = {
    if (x < lo) { lo } else if (x > hi) { hi } else { x }
}

// else if as value_expr in val initializer
func sign(x: i64): i64 = {
    val s: i64 = if (x > 0) { 1 } else if (x < 0) { 0 - 1 } else { 0 }
    s
}

// else if as a complex function body value_expr (requires hoisting in codegen)
func bucket(x: i64): i64 = {
    if (x > 0) {
        val y: i64 = 10
        y
    } else if (x < 0) {
        val y: i64 = 0 - 10
        y
    } else {
        0
    }
}

// Statement if (no else) still works as statement in block
func count_positive(a: i64, b: i64, c: i64): i64 = {
    mut n: i64 = 0
    if (a > 0) { n = n + 1 }
    if (b > 0) { n = n + 1 }
    if (c > 0) { n = n + 1 }
    n
}

// Statement else if (branches have side effects, no value) still works
func categorize(mut ref out: i64, x: i64): void = {
    if (x > 0) {
        out = 1
    } else if (x < 0) {
        out = 0 - 1
    } else {
        out = 0
    }
}

// Count target-index evaluation so assignment ordering stays observable.
func capture_index(mut ref hits: i64, idx: i64): i64 = {
    hits = hits + 1
    idx
}

func main(): void = {
    // Simple value_expr
    assert min_i64(3, 5) == 3
    assert min_i64(7, 2) == 2
    assert max_i64(3, 5) == 5
    assert max_i64(7, 2) == 7

    // return if/else
    assert abs_i64(5) == 5
    assert abs_i64(0 - 3) == 3
    assert abs_i64(0) == 0

    // else if expression
    assert clamp(5, 1, 10) == 5
    assert clamp(0 - 3, 1, 10) == 1
    assert clamp(15, 1, 10) == 10

    // val initializer with else if
    assert sign(42) == 1
    assert sign(0 - 7) == 0 - 1
    assert sign(0) == 0

    // Assignment RHS with value-form if/else
    mut reassigned: i64 = 0
    reassigned = if (true) { 11 } else { 22 }
    assert reassigned == 11
    reassigned = if (false) { 33 } else if (true) { 44 } else { 55 }
    assert reassigned == 44
    reassigned = if (true) {
        val branch_value: i64 = 66
        branch_value
    } else {
        val branch_value: i64 = 77
        branch_value
    }
    assert reassigned == 66

    mut index_hits: i64 = 0
    mut index_source: i64 = 0
    mut indexed: [i64; 2] = [10, 20]
    indexed[capture_index(mut ref index_hits, index_source)] = if (true) {
        index_source = 1
        99
    } else {
        88
    }
    assert index_hits == 1
    assert indexed[0] == 99
    assert indexed[1] == 20
    assert index_source == 1

    val left_bytes: [u8; 2] = [65, 66]
    val right_bytes: [u8; 2] = [67, 68]
    mut selected_bytes: [u8] = left_bytes[..]
    mut selected_branch: i64 = 0
    selected_bytes = if (true) {
        selected_branch = 1
        left_bytes
    } else {
        selected_branch = 2
        right_bytes
    }
    assert selected_branch == 1
    assert selected_bytes.len == 2
    assert selected_bytes[0] == 65
    assert selected_bytes[1] == 66
    selected_bytes = if (false) { left_bytes } else { right_bytes }
    assert selected_bytes.len == 2
    assert selected_bytes[0] == 67
    assert selected_bytes[1] == 68

    // complex else if expression
    assert bucket(5) == 10
    assert bucket(0 - 5) == 0 - 10
    assert bucket(0) == 0

    // Statement if still works
    assert count_positive(1, 0 - 2, 3) == 2
    assert count_positive(0 - 1, 0 - 2, 0 - 3) == 0

    // Statement else if with side effects
    mut r: i64 = 0
    categorize(mut ref r, 5)
    assert r == 1
    categorize(mut ref r, 0 - 3)
    assert r == 0 - 1
    categorize(mut ref r, 0)
    assert r == 0
}
