// Test print, println, and print_i64 from std/io.nore
import io "std/io.nore"

func main(): void = {
    // print a string literal
    io.print(ref "Hello, ")

    // println adds a newline
    io.println(ref "World!")

    // print_i64 prints integers
    io.print_i64(42)
    io.print(ref "\n")

    // negative numbers
    io.print_i64(-123)
    io.print(ref "\n")

    // zero
    io.print_i64(0)
    io.print(ref "\n")

    // print from a str variable
    val msg: str = "test slice"
    io.println(ref msg)

    // print from an array variable
    val arr: [u8; 3] = ['a', 'b', 'c']
    io.print(ref arr)
    io.print(ref "\n")

    // print_i64 with different integer types
    val x: i32 = 99
    io.print_i64(i64(x))
    io.print(ref "\n")
}
