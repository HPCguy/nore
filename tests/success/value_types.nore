// Test value type declarations, constructors, and field access

value Vec2 { x: f64, y: f64 }
value Color { r: u8, g: u8, b: u8 }

func make_vec(x: f64, y: f64): Vec2 = {
    return Vec2 { x: x, y: y }
}

func dot(a: Vec2, b: Vec2): f64 = {
    return a.x * b.x + a.y * b.y
}

func main(): void = {
    // Constructor and field access
    val p: Vec2 = Vec2 { x: 3.0, y: 4.0 }
    assert p.x == 3.0
    assert p.y == 4.0

    // Field order doesn't matter
    val q: Vec2 = Vec2 { y: 2.0, x: 1.0 }
    assert q.x == 1.0
    assert q.y == 2.0

    // Value semantics (copy)
    mut a: Vec2 = Vec2 { x: 1.0, y: 2.0 }
    mut b: Vec2 = a
    b.x = 99.0
    assert a.x == 1.0

    // Mutable field assignment
    mut v: Vec2 = Vec2 { x: 0.0, y: 0.0 }
    v.x = 5.0
    v.y = 10.0
    assert v.x == 5.0
    assert v.y == 10.0

    // Function returning value type
    val r: Vec2 = make_vec(7.0, 8.0)
    assert r.x == 7.0
    assert r.y == 8.0

    // Passing value types to functions
    val d: f64 = dot(Vec2 { x: 1.0, y: 0.0 }, Vec2 { x: 0.0, y: 1.0 })
    assert d == 0.0

    val d2: f64 = dot(Vec2 { x: 2.0, y: 3.0 }, Vec2 { x: 4.0, y: 5.0 })
    assert d2 == 23.0

    // u8 fields
    val c: Color = Color { r: 255, g: 128, b: 0 }
    assert c.r == 255
    assert c.g == 128
    assert c.b == 0
}
