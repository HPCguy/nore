// Test bitwise operators

func main(): void = {
    // Bitwise AND
    assert (255 & 15) == 15
    assert (12 & 10) == 8
    assert (0 & 255) == 0

    // Bitwise OR
    assert (240 | 15) == 255
    assert (12 | 10) == 14
    assert (0 | 0) == 0

    // Bitwise XOR
    assert (255 ^ 15) == 240
    assert (12 ^ 10) == 6
    assert (5 ^ 5) == 0

    // Left shift
    assert (1 << 0) == 1
    assert (1 << 3) == 8
    assert (5 << 2) == 20

    // Right shift
    assert (8 >> 3) == 1
    assert (20 >> 2) == 5
    assert (255 >> 4) == 15

    // Bitwise NOT
    val a: i64 = 0
    assert ~a == -1
    val b: i64 = -1
    assert ~b == 0

    // With variables
    val x: i64 = 255
    val mask: i64 = 15
    assert (x & mask) == 15
    assert (x | mask) == 255
    assert (x ^ mask) == 240

    // Comptime constant folding
    val folded: i64 = 3 & 5
    assert folded == 1
    val folded2: i64 = 3 | 5
    assert folded2 == 7
    val folded3: i64 = 3 ^ 5
    assert folded3 == 6
    val folded4: i64 = 1 << 4
    assert folded4 == 16
    val folded5: i64 = 32 >> 3
    assert folded5 == 4
    val folded6: i64 = ~0
    assert folded6 == -1

    // Precedence: bitwise binds tighter than comparisons
    // c & m == 0 should mean (c & m) == 0, not c & (m == 0)
    val c: i64 = 16
    val m: i64 = 15
    assert c & m == 0
    assert c | m == 31
    assert 6 ^ 3 == 5

    // Shift binds tighter than bitwise AND
    // 1 << 4 & 255 means (1 << 4) & 255
    assert 1 << 4 & 255 == 16

    // All integer types
    val i32_val: i32 = 255
    val i32_mask: i32 = 15
    assert (i32_val & i32_mask) == 15

    val u8_val: u8 = 255
    val u8_mask: u8 = 15
    assert (u8_val & u8_mask) == 15

    val u32_val: u32 = 255
    val u32_mask: u32 = 15
    assert (u32_val & u32_mask) == 15

    // Combination with arithmetic
    assert (3 + 1) << 2 == 16
    assert (16 >> 2) - 1 == 3
    assert 255 & 15 + 1 == 16
}
