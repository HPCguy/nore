// Test sub-slicing: expr[start..end]

func sum(ref data: [i64]): i64 = {
    mut total: i64 = 0
    mut i: i64 = 0
    while (i < data.len) {
        total = total + data[i]
        i = i + 1
    }
    return total
}

func main(): void = {
    mut mem: Arena = arena(4096)

    // Sub-slice of a slice
    mut nums: [i64] = arena_alloc(mut ref mem, 5)
    nums[0] = 10
    nums[1] = 20
    nums[2] = 30
    nums[3] = 40
    nums[4] = 50

    val sub: [i64] = nums[1..4]
    assert sub.len == 3
    assert sub[0] == 20
    assert sub[1] == 30
    assert sub[2] == 40

    // Sub-slice of a fixed array
    val arr: [i64; 5] = [100, 200, 300, 400, 500]
    val asub: [i64] = arr[2..5]
    assert asub.len == 3
    assert asub[0] == 300
    assert asub[1] == 400
    assert asub[2] == 500

    // Empty sub-slice
    val empty: [i64] = nums[3..3]
    assert empty.len == 0

    // Full sub-slice
    val full: [i64] = nums[0..nums.len]
    assert full.len == 5
    assert full[0] == 10
    assert full[4] == 50

    // Shorthand: omit start
    val head: [i64] = nums[..3]
    assert head.len == 3
    assert head[0] == 10
    assert head[1] == 20
    assert head[2] == 30

    // Shorthand: omit end
    val tail: [i64] = nums[2..]
    assert tail.len == 3
    assert tail[0] == 30
    assert tail[1] == 40
    assert tail[2] == 50

    // Shorthand: omit both (full copy)
    val all: [i64] = nums[..]
    assert all.len == 5
    assert all[0] == 10

    // Shorthand on arrays
    val arr_head: [i64] = arr[..2]
    assert arr_head.len == 2
    assert arr_head[0] == 100
    assert arr_head[1] == 200

    val arr_tail: [i64] = arr[3..]
    assert arr_tail.len == 2
    assert arr_tail[0] == 400
    assert arr_tail[1] == 500

    val arr_all: [i64] = arr[..]
    assert arr_all.len == 5

    // Chained access: index into sub-slice
    assert nums[1..4][0] == 20
    assert nums[1..4][2] == 40

    // Sub-slice passed to function (ref parameter)
    assert sum(ref nums[1..4]) == 90

    // Sub-slice with for loop iteration
    val tail2: [i64] = nums[2..]
    mut count: i64 = 0
    for i in 0..tail2.len {
        count = count + 1
    }
    assert count == 3

    // Mutation through sub-slice of mut slice
    mut msub: [i64] = nums[1..3]
    msub[0] = 99
    assert nums[1] == 99

    // Sub-slice of byte array
    val barr: [u8; 4] = [72, 105, 33, 0]
    val greeting: [u8] = barr[..2]
    assert greeting.len == 2
    assert greeting[0] == 72
    assert greeting[1] == 105
}
