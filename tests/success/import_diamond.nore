// Diamond: this imports both types_helper (directly) and combined_helper
// (which also imports types_helper). types_helper should be imported only once.
import types "import_helpers/types_helper.nore"
import combined "import_helpers/combined_helper.nore"

func main(): void = {
    val v: types.Vec2 = combined.make_vec2(5.0, 6.0)
    assert v.x == 5.0

    val d: types.Direction = types.Direction.West
    assert d == types.Direction.West
}
