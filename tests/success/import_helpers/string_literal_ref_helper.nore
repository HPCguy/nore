pub func take16(
    ref s0: str,
    ref s1: str,
    ref s2: str,
    ref s3: str,
    ref s4: str,
    ref s5: str,
    ref s6: str,
    ref s7: str,
    ref s8: str,
    ref s9: str,
    ref s10: str,
    ref s11: str,
    ref s12: str,
    ref s13: str,
    ref s14: str,
    ref s15: str
): i64 = {
    s0.len + s1.len + s2.len + s3.len + s4.len + s5.len + s6.len + s7.len +
    s8.len + s9.len + s10.len + s11.len + s12.len + s13.len + s14.len + s15.len
}
