// Test function declarations, calls, and return values

func add(a: i64, b: i64): i64 = {
    return a + b
}

func factorial(n: i64): i64 = {
    mut result: i64 = 1
    mut i: i64 = 1
    while (i <= n) {
        result = result * i
        i = i + 1
    }
    return result
}

func is_positive(n: i64): bool = {
    return n > 0
}

func noop(): void = {
    // does nothing
}

func max(a: i64, b: i64): i64 = {
    if (a > b) {
        return a
    }
    return b
}

func fib(n: i64): i64 = {
    if (n <= 1) {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

func main(): void = {
    // Basic function calls
    assert add(2, 3) == 5
    assert add(0, 0) == 0
    assert add(-1, 1) == 0

    // Factorial
    assert factorial(0) == 1
    assert factorial(1) == 1
    assert factorial(5) == 120

    // Boolean return
    assert is_positive(1)
    assert !is_positive(-1)
    assert !is_positive(0)

    // Void function
    noop()

    // Nested calls
    assert add(add(1, 2), add(3, 4)) == 10
    assert max(10, 20) == 20
    assert max(20, 10) == 20

    // Recursive function
    assert fib(0) == 0
    assert fib(1) == 1
    assert fib(10) == 55
}
