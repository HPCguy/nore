// Test constant folding and comptime expressions

val A = 10
val B = A + 5
val C = A * B
val D = C / 3

val E = 3.0 + 5
val F = A * 2.5

func main(): void = {
    // Comptime integer folding
    assert A == 10
    assert B == 15
    assert C == 150
    assert D == 50

    // Comptime float folding
    assert E == 8.0
    assert F == 25.0

    // Comptime bool in local scope
    val g: bool = 10 > 5
    assert g
    val h: bool = A == 10
    assert h

    // Comptime arithmetic in local scope
    val x = 3 + 5 * 2
    assert x == 13

    val y = 100 / 4 - 5
    assert y == 20
}
