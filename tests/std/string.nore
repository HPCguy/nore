import "std/string.nore"

func main(): void = {
    mut mem: Arena = arena(4096)

    // is_digit
    assert is_digit('0')
    assert is_digit('5')
    assert is_digit('9')
    assert !is_digit('a')
    assert !is_digit(' ')
    assert !is_digit('/')
    assert !is_digit(':')

    // is_alpha
    assert is_alpha('A')
    assert is_alpha('Z')
    assert is_alpha('a')
    assert is_alpha('z')
    assert is_alpha('M')
    assert !is_alpha('0')
    assert !is_alpha(' ')
    assert !is_alpha('@')
    assert !is_alpha('[')

    // is_space
    assert is_space(' ')
    assert is_space('\t')
    assert is_space('\n')
    assert is_space('\r')
    assert !is_space('a')
    assert !is_space('0')

    // str_eq
    assert str_eq(ref "hello", ref "hello")
    assert !str_eq(ref "hello", ref "world")
    assert !str_eq(ref "hi", ref "hello")
    assert str_eq(ref "", ref "")
    assert !str_eq(ref "", ref "a")
    assert !str_eq(ref "a", ref "")

    // str_starts_with
    assert str_starts_with(ref "hello", ref "hel")
    assert str_starts_with(ref "hello", ref "")
    assert str_starts_with(ref "hello", ref "hello")
    assert !str_starts_with(ref "hello", ref "world")
    assert !str_starts_with(ref "hi", ref "hello")

    // str_ends_with
    assert str_ends_with(ref "hello", ref "llo")
    assert str_ends_with(ref "hello", ref "")
    assert str_ends_with(ref "hello", ref "hello")
    assert !str_ends_with(ref "hello", ref "hel")
    assert !str_ends_with(ref "hi", ref "hello")

    // str_find
    assert str_find(ref "hello world", ref "world") == 6
    assert str_find(ref "hello world", ref "hello") == 0
    assert str_find(ref "hello", ref "xyz") == 0 - 1
    assert str_find(ref "hello", ref "") == 0
    assert str_find(ref "aababc", ref "abc") == 3
    assert str_find(ref "", ref "a") == 0 - 1
    assert str_find(ref "aaa", ref "aa") == 0
    assert str_find(ref "abcabc", ref "cab") == 2

    // str_contains
    assert str_contains(ref "hello world", ref "world")
    assert !str_contains(ref "hello", ref "xyz")
    assert str_contains(ref "hello", ref "")

    // str_concat
    val hw: str = str_concat(mut ref mem, ref "hello", ref " world")
    assert str_eq(ref hw, ref "hello world")

    val empty_concat: str = str_concat(mut ref mem, ref "", ref "")
    assert empty_concat.len == 0

    val left_empty: str = str_concat(mut ref mem, ref "", ref "abc")
    assert str_eq(ref left_empty, ref "abc")

    val right_empty: str = str_concat(mut ref mem, ref "abc", ref "")
    assert str_eq(ref right_empty, ref "abc")

    // chained concat
    val abc: str = str_concat(mut ref mem, ref "a", ref "b")
    val abcd: str = str_concat(mut ref mem, ref abc, ref "cd")
    assert str_eq(ref abcd, ref "abcd")

    // i64_to_str
    val s0: str = i64_to_str(mut ref mem, 0)
    assert str_eq(ref s0, ref "0")

    val s42: str = i64_to_str(mut ref mem, 42)
    assert str_eq(ref s42, ref "42")

    val sneg: str = i64_to_str(mut ref mem, 0 - 123)
    assert str_eq(ref sneg, ref "-123")

    val s1: str = i64_to_str(mut ref mem, 1)
    assert str_eq(ref s1, ref "1")

    val sbig: str = i64_to_str(mut ref mem, 9223372036854775807)
    assert str_eq(ref sbig, ref "9223372036854775807")

    val smin: str = i64_to_str(mut ref mem, -9223372036854775807 - 1)
    assert str_eq(ref smin, ref "-9223372036854775808")

    // str_to_i64
    assert str_to_i64(ref "0") == 0
    assert str_to_i64(ref "42") == 42
    assert str_to_i64(ref "-123") == 0 - 123
    assert str_to_i64(ref "") == 0
    assert str_to_i64(ref "abc") == 0
    assert str_to_i64(ref "9223372036854775807") == 9223372036854775807
    assert str_to_i64(ref "1") == 1
    assert str_to_i64(ref "100") == 100

    // roundtrip: i64_to_str -> str_to_i64
    val rt: str = i64_to_str(mut ref mem, 12345)
    assert str_to_i64(ref rt) == 12345

    val rt_neg: str = i64_to_str(mut ref mem, 0 - 6789)
    assert str_to_i64(ref rt_neg) == 0 - 6789
}
