import string "std/string.nore"

func main(): void = {
    mut mem: Arena = arena(4096)

    // is_digit
    assert string.is_digit('0')
    assert string.is_digit('5')
    assert string.is_digit('9')
    assert !string.is_digit('a')
    assert !string.is_digit(' ')
    assert !string.is_digit('/')
    assert !string.is_digit(':')

    // is_alpha
    assert string.is_alpha('A')
    assert string.is_alpha('Z')
    assert string.is_alpha('a')
    assert string.is_alpha('z')
    assert string.is_alpha('M')
    assert !string.is_alpha('0')
    assert !string.is_alpha(' ')
    assert !string.is_alpha('@')
    assert !string.is_alpha('[')

    // is_space
    assert string.is_space(' ')
    assert string.is_space('\t')
    assert string.is_space('\n')
    assert string.is_space('\r')
    assert !string.is_space('a')
    assert !string.is_space('0')

    // str_eq
    assert string.str_eq(ref "hello", ref "hello")
    assert !string.str_eq(ref "hello", ref "world")
    assert !string.str_eq(ref "hi", ref "hello")
    assert string.str_eq(ref "", ref "")
    assert !string.str_eq(ref "", ref "a")
    assert !string.str_eq(ref "a", ref "")

    // str_starts_with
    assert string.str_starts_with(ref "hello", ref "hel")
    assert string.str_starts_with(ref "hello", ref "")
    assert string.str_starts_with(ref "hello", ref "hello")
    assert !string.str_starts_with(ref "hello", ref "world")
    assert !string.str_starts_with(ref "hi", ref "hello")

    // str_ends_with
    assert string.str_ends_with(ref "hello", ref "llo")
    assert string.str_ends_with(ref "hello", ref "")
    assert string.str_ends_with(ref "hello", ref "hello")
    assert !string.str_ends_with(ref "hello", ref "hel")
    assert !string.str_ends_with(ref "hi", ref "hello")

    // str_find
    assert string.str_find(ref "hello world", ref "world") == 6
    assert string.str_find(ref "hello world", ref "hello") == 0
    assert string.str_find(ref "hello", ref "xyz") == -1
    assert string.str_find(ref "hello", ref "") == 0
    assert string.str_find(ref "aababc", ref "abc") == 3
    assert string.str_find(ref "", ref "a") == -1
    assert string.str_find(ref "aaa", ref "aa") == 0
    assert string.str_find(ref "abcabc", ref "cab") == 2

    // str_find_byte
    assert string.str_find_byte(ref "hello/world", '/') == 5
    assert string.str_find_byte(ref "abc", 'x') == -1
    assert string.str_find_byte(ref "", 'x') == -1

    // str_rfind_byte
    assert string.str_rfind_byte(ref "a/b/c", '/') == 3
    assert string.str_rfind_byte(ref ".hidden", '.') == 0
    assert string.str_rfind_byte(ref "abc", 'x') == -1
    assert string.str_rfind_byte(ref "", 'x') == -1

    // str_contains
    assert string.str_contains(ref "hello world", ref "world")
    assert !string.str_contains(ref "hello", ref "xyz")
    assert string.str_contains(ref "hello", ref "")

    // str_concat
    val hw: str = string.str_concat(mut ref mem, ref "hello", ref " world")
    assert string.str_eq(ref hw, ref "hello world")

    val empty_concat: str = string.str_concat(mut ref mem, ref "", ref "")
    assert empty_concat.len == 0

    val left_empty: str = string.str_concat(mut ref mem, ref "", ref "abc")
    assert string.str_eq(ref left_empty, ref "abc")

    val right_empty: str = string.str_concat(mut ref mem, ref "abc", ref "")
    assert string.str_eq(ref right_empty, ref "abc")

    // str_copy
    val copied: str = string.str_copy(mut ref mem, ref "copied")
    assert string.str_eq(ref copied, ref "copied")

    val copied_empty: str = string.str_copy(mut ref mem, ref "")
    assert copied_empty.len == 0

    // chained concat
    val abc: str = string.str_concat(mut ref mem, ref "a", ref "b")
    val abcd: str = string.str_concat(mut ref mem, ref abc, ref "cd")
    assert string.str_eq(ref abcd, ref "abcd")

    // str_concat3
    val joined: str = string.str_concat3(mut ref mem, ref "a", ref "/", ref "b")
    assert string.str_eq(ref joined, ref "a/b")

    val joined_empty: str = string.str_concat3(mut ref mem, ref "", ref "", ref "")
    assert joined_empty.len == 0

    // i64_to_str
    val s0: str = string.i64_to_str(mut ref mem, 0)
    assert string.str_eq(ref s0, ref "0")

    val s42: str = string.i64_to_str(mut ref mem, 42)
    assert string.str_eq(ref s42, ref "42")

    val sneg: str = string.i64_to_str(mut ref mem, -123)
    assert string.str_eq(ref sneg, ref "-123")

    val s1: str = string.i64_to_str(mut ref mem, 1)
    assert string.str_eq(ref s1, ref "1")

    val sbig: str = string.i64_to_str(mut ref mem, 9223372036854775807)
    assert string.str_eq(ref sbig, ref "9223372036854775807")

    val smin: str = string.i64_to_str(mut ref mem, -9223372036854775807 - 1)
    assert string.str_eq(ref smin, ref "-9223372036854775808")

    // str_to_i64 returns ParseResult
    val r0: string.ParseResult = string.str_to_i64(ref "0")
    val v0: i64 = match (r0) { Ok(n) = { n } None = { -9999 } }
    assert v0 == 0

    val r42: string.ParseResult = string.str_to_i64(ref "42")
    val v42: i64 = match (r42) { Ok(n) = { n } None = { -9999 } }
    assert v42 == 42

    val rneg: string.ParseResult = string.str_to_i64(ref "-123")
    val vneg: i64 = match (rneg) { Ok(n) = { n } None = { -9999 } }
    assert vneg == -123

    // Empty string returns None
    val rempty: string.ParseResult = string.str_to_i64(ref "")
    val is_none: bool = match (rempty) { Ok(n) = { false } None = { true } }
    assert is_none

    // Invalid string returns None
    val rabc: string.ParseResult = string.str_to_i64(ref "abc")
    val is_none2: bool = match (rabc) { Ok(n) = { false } None = { true } }
    assert is_none2

    // Bare minus returns None
    val rminus: string.ParseResult = string.str_to_i64(ref "-")
    val is_none3: bool = match (rminus) { Ok(n) = { false } None = { true } }
    assert is_none3

    val rbig: string.ParseResult = string.str_to_i64(ref "9223372036854775807")
    val vbig: i64 = match (rbig) { Ok(n) = { n } None = { -9999 } }
    assert vbig == 9223372036854775807

    val r1: string.ParseResult = string.str_to_i64(ref "1")
    val v1: i64 = match (r1) { Ok(n) = { n } None = { -9999 } }
    assert v1 == 1

    val r100: string.ParseResult = string.str_to_i64(ref "100")
    val v100: i64 = match (r100) { Ok(n) = { n } None = { -9999 } }
    assert v100 == 100

    // roundtrip: i64_to_str -> str_to_i64
    val rt: str = string.i64_to_str(mut ref mem, 12345)
    val rrt: string.ParseResult = string.str_to_i64(ref rt)
    val vrt: i64 = match (rrt) { Ok(n) = { n } None = { -9999 } }
    assert vrt == 12345

    val rt_neg: str = string.i64_to_str(mut ref mem, -6789)
    val rrt_neg: string.ParseResult = string.str_to_i64(ref rt_neg)
    val vrt_neg: i64 = match (rrt_neg) { Ok(n) = { n } None = { -9999 } }
    assert vrt_neg == -6789

    // str_to_f64
    val f1: string.ParseFloatResult = string.str_to_f64(ref "42")
    val fv1: f64 = match (f1) { Ok(n) = { n } None = { -9999.0 } }
    assert fv1 == 42.0

    val f2: string.ParseFloatResult = string.str_to_f64(ref "3.14")
    val fv2: f64 = match (f2) { Ok(n) = { n } None = { -9999.0 } }
    assert fv2 > 3.13 && fv2 < 3.15

    val f3: string.ParseFloatResult = string.str_to_f64(ref "-17")
    val fv3: f64 = match (f3) { Ok(n) = { n } None = { -9999.0 } }
    assert fv3 == -17.0

    val f4: string.ParseFloatResult = string.str_to_f64(ref "1e3")
    val fv4: f64 = match (f4) { Ok(n) = { n } None = { -9999.0 } }
    assert fv4 == 1000.0

    val f5: string.ParseFloatResult = string.str_to_f64(ref "1.5e-2")
    val fv5: f64 = match (f5) { Ok(n) = { n } None = { -9999.0 } }
    assert fv5 > 0.014 && fv5 < 0.016

    val f6: string.ParseFloatResult = string.str_to_f64(ref "0")
    val fv6: f64 = match (f6) { Ok(n) = { n } None = { -9999.0 } }
    assert fv6 == 0.0

    // Invalid floats return None
    val fbad1: bool = match (string.str_to_f64(ref "")) { Ok(n) = { false } None = { true } }
    assert fbad1
    val fbad2: bool = match (string.str_to_f64(ref "abc")) { Ok(n) = { false } None = { true } }
    assert fbad2
    val fbad3: bool = match (string.str_to_f64(ref "-")) { Ok(n) = { false } None = { true } }
    assert fbad3
    val fbad4: bool = match (string.str_to_f64(ref "1.")) { Ok(n) = { false } None = { true } }
    assert fbad4
    val fbad5: bool = match (string.str_to_f64(ref "1e")) { Ok(n) = { false } None = { true } }
    assert fbad5
}
