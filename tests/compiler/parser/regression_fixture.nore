func compound_and_if(flag: bool, n: i64): i64 = {
    mut counter: i64 = 0
    counter += n + 1
    if (flag) { { counter } } else { { n } }
}

func tail_match(n: i64): i64 = {
    match (n) {
        0 = { { 10 } }
        else = { { 20 } }
    }
}

func grouped_else_match(n: i64): i64 = {
    match (n) {
        0 | else = { { 30 } }
    }
}

func lower_constructor(): i64 = {
    val built = foo { x: 1 }
    built.x
}
