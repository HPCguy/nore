import bbuf "../../../compiler/support/byte_buf.nore"
import diag "../../../compiler/support/diag.nore"
import ibuf "../../../compiler/support/i64_buf.nore"
import lexer "../../../compiler/frontend/lexer.nore"
import node "../../../compiler/frontend/node.nore"
import parser "../../../compiler/frontend/parser.nore"
import source "../../../compiler/support/source.nore"
import token "../../../compiler/frontend/token.nore"
import string "std/string.nore"

val BLOCK_VALUE_FLAG: i64 = 32

// Keep span flag checks readable in the regression assertions below.
func flag_has(flags: i64, bit: i64): bool = {
    (flags & bit) != 0
}

// Walk one parent's child list by source order.
func child_at(ref nodes: node.Nodes, parent_id: i64, wanted_index: i64): i64 = {
    mut child_id: i64 = nodes.first_child[parent_id]
    mut index: i64 = 0
    while (child_id >= 0) {
        if (index == wanted_index) {
            return child_id
        }
        child_id = nodes.next_sibling[child_id]
        index += 1
    }
    -1
}

// Function bodies are the only block children under top-level function declarations.
func first_child_kind(ref nodes: node.Nodes, parent_id: i64, kind: node.NodeKind): i64 = {
    mut child_id: i64 = nodes.first_child[parent_id]
    while (child_id >= 0) {
        if (nodes.kind[child_id] == kind) {
            return child_id
        }
        child_id = nodes.next_sibling[child_id]
    }
    -1
}

// Slice the original source text using the stored node span metadata.
func node_span_text(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref nodes: node.Nodes,
    node_id: i64
): [u8] = {
    val text: [u8] = source.source_text(ref text_pool, ref sources, nodes.source_id[node_id])
    val start: i64 = nodes.start[node_id]
    val len: i64 = nodes.span_len[node_id]
    text[start..start + len]
}

// Resolve one top-level function by its recorded name token.
func find_func(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref wanted_name: [u8]
): i64 = {
    mut node_id: i64 = 0
    while (node_id < table_len(ref nodes)) {
        if (nodes.kind[node_id] == node.NodeKind.FuncDecl) {
            val name_token_id: i64 = nodes.data0[node_id]
            val name_text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, name_token_id)
            if (string.str_eq(ref name_text, ref wanted_name)) {
                return node_id
            }
        }
        node_id += 1
    }
    -1
}

// Cover regressions for compound assignment parsing, block values, and node spans.
func main(): void = {
    mut mem: Arena = arena(262144)
    mut sources: source.Sources = table_alloc(mut ref mem, 4)
    mut path_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 256)
    mut text_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 2048)
    mut line_starts: ibuf.I64Buf = ibuf.i64_buf_new(mut ref mem, 256)
    mut diags: diag.Diagnostics = table_alloc(mut ref mem, 16)
    mut diag_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 512)

    val loaded: source.SourceLoadResult = source.sources_load_file(
        mut ref mem,
        mut ref sources,
        mut ref path_pool,
        mut ref text_pool,
        mut ref line_starts,
        ref "tests/compiler/parser/regression_fixture.nore",
        ref "tests/compiler/parser/regression_fixture.nore",
        -1
    )

    val source_id: i64 = match (loaded) {
        Ok(id) = { id }
        Err(code) = { -1 }
    }
    assert source_id == 0

    val text: [u8] = source.source_text(ref text_pool, ref sources, source_id)
    mut tokens: token.Tokens = table_alloc(mut ref mem, token.token_capacity_for_source_len(text.len))

    val lexed: lexer.LexResult = lexer.lex_source(
        mut ref mem,
        ref sources,
        ref text_pool,
        source_id,
        mut ref tokens,
        mut ref diags,
        mut ref diag_pool
    )
    assert lexed.diags.count == 0

    mut nodes: node.Nodes = table_alloc(mut ref mem, node.node_capacity_for_token_count(lexed.tokens.count))
    val parsed: parser.ParseResult = parser.parse_tokens(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref lexed.tokens,
        ref tokens,
        mut ref nodes,
        mut ref diags,
        mut ref diag_pool
    )
    assert parsed.root >= 0
    assert parsed.diags.count == 0

    val compound_func_id: i64 = find_func(ref sources, ref text_pool, ref tokens, ref nodes, ref "compound_and_if")
    assert compound_func_id >= 0
    val compound_body_id: i64 = first_child_kind(ref nodes, compound_func_id, node.NodeKind.Block)
    assert compound_body_id >= 0
    assert flag_has(nodes.data1[compound_body_id], BLOCK_VALUE_FLAG)

    val assign_id: i64 = child_at(ref nodes, compound_body_id, 1)
    assert nodes.kind[assign_id] == node.NodeKind.CompoundAssignStmt
    assert string.str_eq(ref node_span_text(ref sources, ref text_pool, ref nodes, assign_id), ref "counter += n + 1")
    assert string.str_eq(ref token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[assign_id]), ref "+=")

    val rhs_id: i64 = child_at(ref nodes, assign_id, 1)
    assert nodes.kind[rhs_id] == node.NodeKind.BinaryExpr
    assert string.str_eq(ref node_span_text(ref sources, ref text_pool, ref nodes, rhs_id), ref "n + 1")
    assert string.str_eq(ref token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[rhs_id]), ref "+")

    val if_id: i64 = child_at(ref nodes, compound_body_id, 2)
    assert nodes.kind[if_id] == node.NodeKind.IfStmt
    val then_block_id: i64 = child_at(ref nodes, if_id, 1)
    val else_block_id: i64 = child_at(ref nodes, if_id, 2)
    assert flag_has(nodes.data1[then_block_id], BLOCK_VALUE_FLAG)
    assert flag_has(nodes.data1[else_block_id], BLOCK_VALUE_FLAG)

    val match_func_id: i64 = find_func(ref sources, ref text_pool, ref tokens, ref nodes, ref "tail_match")
    assert match_func_id >= 0
    val match_body_id: i64 = first_child_kind(ref nodes, match_func_id, node.NodeKind.Block)
    assert match_body_id >= 0
    assert flag_has(nodes.data1[match_body_id], BLOCK_VALUE_FLAG)

    val match_id: i64 = child_at(ref nodes, match_body_id, 0)
    assert nodes.kind[match_id] == node.NodeKind.MatchExpr
    val arm0_id: i64 = child_at(ref nodes, match_id, 1)
    val arm1_id: i64 = child_at(ref nodes, match_id, 2)
    assert string.str_eq(ref node_span_text(ref sources, ref text_pool, ref nodes, arm0_id), ref "0 = { { 10 } }")
    assert string.str_eq(ref node_span_text(ref sources, ref text_pool, ref nodes, arm1_id), ref "else = { { 20 } }")

    val arm0_body_id: i64 = child_at(ref nodes, arm0_id, 1)
    val arm1_body_id: i64 = child_at(ref nodes, arm1_id, 1)
    val arm1_pattern_id: i64 = child_at(ref nodes, arm1_id, 0)
    assert flag_has(nodes.data1[arm0_body_id], BLOCK_VALUE_FLAG)
    assert flag_has(nodes.data1[arm1_body_id], BLOCK_VALUE_FLAG)
    assert nodes.kind[arm1_pattern_id] == node.NodeKind.Identifier
    assert string.str_eq(ref token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[arm1_pattern_id]), ref "else")

    val grouped_func_id: i64 = find_func(ref sources, ref text_pool, ref tokens, ref nodes, ref "grouped_else_match")
    assert grouped_func_id >= 0
    val grouped_body_id: i64 = first_child_kind(ref nodes, grouped_func_id, node.NodeKind.Block)
    val grouped_match_id: i64 = child_at(ref nodes, grouped_body_id, 0)
    val grouped_arm_id: i64 = child_at(ref nodes, grouped_match_id, 1)
    val grouped_pattern_id: i64 = child_at(ref nodes, grouped_arm_id, 0)
    val grouped_left_id: i64 = child_at(ref nodes, grouped_pattern_id, 0)
    val grouped_right_id: i64 = child_at(ref nodes, grouped_pattern_id, 1)
    assert nodes.kind[grouped_pattern_id] == node.NodeKind.BinaryExpr
    assert string.str_eq(ref token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[grouped_pattern_id]), ref "|")
    assert nodes.kind[grouped_left_id] == node.NodeKind.NumberLit
    assert nodes.kind[grouped_right_id] == node.NodeKind.Identifier
    assert string.str_eq(ref token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[grouped_right_id]), ref "else")

    val lower_func_id: i64 = find_func(ref sources, ref text_pool, ref tokens, ref nodes, ref "lower_constructor")
    assert lower_func_id >= 0
    val lower_body_id: i64 = first_child_kind(ref nodes, lower_func_id, node.NodeKind.Block)
    val lower_decl_id: i64 = child_at(ref nodes, lower_body_id, 0)
    val lower_init_id: i64 = child_at(ref nodes, lower_decl_id, 0)
    val lower_callee_id: i64 = child_at(ref nodes, lower_init_id, 0)
    assert nodes.kind[lower_decl_id] == node.NodeKind.VarDecl
    assert nodes.kind[lower_init_id] == node.NodeKind.ConstructorExpr
    assert string.str_eq(ref node_span_text(ref sources, ref text_pool, ref nodes, lower_init_id), ref "foo { x: 1 }")
    assert nodes.kind[lower_callee_id] == node.NodeKind.Identifier
    assert string.str_eq(ref token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[lower_callee_id]), ref "foo")
}
