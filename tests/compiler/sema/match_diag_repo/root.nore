enum Option { Some(i64), None }
enum Color { Red, Green, Blue }

func duplicate_enum(x: Option): i64 = {
    match (x) {
        Some(n) = { n }
        Some(m) = { m }
        None = { 0 }
    }
}

func missing_enum(c: Color): i64 = {
    match (c) {
        Red = { 1 }
        Green = { 2 }
    }
}

func duplicate_bool(flag: bool): i64 = {
    match (flag) {
        true = { 1 }
        true = { 2 }
        false = { 0 }
    }
}

func missing_bool(flag: bool): i64 = {
    match (flag) {
        true = { 1 }
    }
}

func duplicate_scalar(x: u8): i64 = {
    match (x) {
        65 = { 1 }
        'A' = { 2 }
        _ = { 0 }
    }
}

func missing_scalar(x: u8): i64 = {
    match (x) {
        0 = { 0 }
    }
}

func duplicate_else(c: Color): i64 = {
    match (c) {
        Red = { 1 }
        else = { 0 }
        else = { 2 }
    }
}

func else_binding(x: Option): i64 = {
    match (x) {
        else(n) = { n }
    }
}

func else_not_last(flag: bool): i64 = {
    match (flag) {
        else = { 0 }
        true = { 1 }
    }
}

func duplicate_or_enum(c: Color): i64 = {
    match (c) {
        Red | Green = { 1 }
        Green | Blue = { 2 }
    }
}

func duplicate_or_scalar(x: u8): i64 = {
    match (x) {
        65 | 'A' = { 1 }
        else = { 0 }
    }
}

func or_binding(x: Option): i64 = {
    match (x) {
        Some(n) | None = { 0 }
    }
}

func grouped_else(flag: bool): i64 = {
    match (flag) {
        true | else = { 1 }
        false = { 0 }
    }
}
