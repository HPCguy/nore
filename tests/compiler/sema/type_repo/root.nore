import helper "helper.nore"

func main(): void = {
    mut pair: helper.Pair = helper.Pair { left: 1, right: 2 }
    pair.left = 3

    val total: i64 = helper.sum_pair(pair)
    val picked: i64 = if (total == 5) {
        pair.left
    } else {
        pair.right
    }
    val same_total: bool = (total == 5) == true

    assert picked == 3
    assert same_total
}
