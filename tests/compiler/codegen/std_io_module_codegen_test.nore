import bbuf "../../../compiler/support/byte_buf.nore"
import cmain "../../../compiler/codegen/c_main.nore"
import check "../../../compiler/sema/check.nore"
import diag "../../../compiler/support/diag.nore"
import ibuf "../../../compiler/support/i64_buf.nore"
import loader "../../../compiler/frontend/loader.nore"
import node "../../../compiler/frontend/node.nore"
import scopes "../../../compiler/sema/scopes.nore"
import source "../../../compiler/support/source.nore"
import string "std/string.nore"
import token "../../../compiler/frontend/token.nore"
import types "../../../compiler/sema/types.nore"
import symbols "../../../compiler/sema/symbols.nore"

// One real std module should lower through the current whole-file slice, including native hook prototypes.
func main(): void = {
    mut mem: Arena = arena(16777216)
    mut sources: source.Sources = table_alloc(mut ref mem, 16)
    mut path_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 1024)
    mut text_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 65536)
    mut line_starts: ibuf.I64Buf = ibuf.i64_buf_new(mut ref mem, 4096)
    mut tokens: token.Tokens = table_alloc(mut ref mem, 4096)
    mut nodes: node.Nodes = table_alloc(mut ref mem, 16384)
    mut modules: loader.Modules = table_alloc(mut ref mem, 16)
    mut imports: loader.ModuleImports = table_alloc(mut ref mem, 16)
    mut diags: diag.Diagnostics = table_alloc(mut ref mem, 32)
    mut diag_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 4096)
    mut scopes_table: scopes.Scopes = table_alloc(mut ref mem, 256)
    mut symbols_table: symbols.Symbols = table_alloc(mut ref mem, 512)
    mut types_table: types.Types = table_alloc(mut ref mem, 512)

    val loaded: loader.LoadResult = loader.load_graph(
        mut ref mem,
        ref ".",
        ref "std/io.nore",
        mut ref sources,
        mut ref path_pool,
        mut ref text_pool,
        mut ref line_starts,
        mut ref tokens,
        mut ref nodes,
        mut ref modules,
        mut ref imports,
        mut ref diags,
        mut ref diag_pool
    )
    assert loaded.diags.count == 0

    val checked: check.CheckResult = check.check_modules(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref modules,
        ref imports,
        mut ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        mut ref diags,
        mut ref diag_pool
    )
    assert checked.diags.count == 0

    val dumped: [u8] = cmain.c_file_dump(
        mut ref mem,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref modules,
        ref symbols_table,
        mut ref types_table,
        ref checked.types,
        ref loaded.modules
    )

    assert string.str_contains(ref dumped, ref "typedef struct { uint8_t data[21]; } ni_arr_21_uint8_t;\n")
    assert string.str_contains(ref dumped, ref "#include <stddef.h>\n#include <string.h>\n#include <unistd.h>\n#include <fcntl.h>\n")
    assert string.str_contains(ref dumped, ref "int64_t ni_fd_write(int32_t ni_fd, const ni_slice_uint8_t *ni_data);\n")
    assert string.str_contains(ref dumped, ref "int64_t ni_fd_read(int32_t ni_fd, ni_slice_uint8_t *ni_buf);\n")
    assert string.str_contains(ref dumped, ref "int64_t ni_mem_copy(ni_slice_uint8_t *ni_dst, const ni_slice_uint8_t *ni_src);\n")
    assert string.str_contains(ref dumped, ref "static ni_Arena ni_arena_new(int64_t ni_capacity) {\n")
    assert string.str_contains(ref dumped, ref "int64_t ni_fd_write(int32_t ni_fd, const ni_slice_uint8_t *ni_data) {\n    return (int64_t)write(ni_fd, ni_data->data, (size_t)ni_data->len);\n}\n")
    assert string.str_contains(ref dumped, ref "int64_t ni_mem_copy(ni_slice_uint8_t *ni_dst, const ni_slice_uint8_t *ni_src) {\n    int64_t ni_n = (ni_dst->len < ni_src->len) ? ni_dst->len : ni_src->len;\n")
    assert string.str_contains(ref dumped, ref "void ni_m0_print_i64(int64_t ni_n) {\n    ni_arr_21_uint8_t ni_buf = (ni_arr_21_uint8_t){{0L, 0L, 0L, 0L")
    assert string.str_contains(ref dumped, ref "int64_t ni_pos = ni_m1_fmt_i64(&(((ni_slice_uint8_t[]){(ni_slice_uint8_t){.data = (ni_buf).data, .len = 21L}})[0]), ni_n);\n    (void)(ni_fd_write(ni_m0_STDOUT, &(((ni_slice_uint8_t[]){(ni_slice_uint8_t){.data = (ni_buf).data + ni_pos, .len = (20L - ni_pos)}})[0])));\n}\n")
    assert string.str_contains(ref dumped, ref "void ni_m0_write_i64(ni_m0_Writer *ni_w, int64_t ni_n) {\n    ni_arr_21_uint8_t ni_buf = (ni_arr_21_uint8_t){{0L, 0L, 0L, 0L")
    assert string.str_contains(ref dumped, ref "ni_mem_copy(&ni_dst, &(((ni_slice_uint8_t[]){(ni_slice_uint8_t){.data = (ni_buf).data + ni_pos, .len = (20L - ni_pos)}})[0]));\n")
    assert string.str_contains(ref dumped, ref "(void)(ni_fd_write(ni_m0_STDOUT, ((const ni_slice_uint8_t *)ni_s)));\n")
    assert string.str_contains(ref dumped, ref "return ni_coerce__ni_str__from__ni_slice_uint8_t((ni_slice_uint8_t){.data = (ni_raw).data + 0L, .len = (0L - 0L)});\n")
    assert !string.str_contains(ref dumped, ref "static int64_t ni_fd_write(")
    assert !string.str_contains(ref dumped, ref "static int64_t ni_mem_copy(")
}
