import bbuf "../../../compiler/support/byte_buf.nore"
import cmain "../../../compiler/codegen/c_main.nore"
import check "../../../compiler/sema/check.nore"
import diag "../../../compiler/support/diag.nore"
import ibuf "../../../compiler/support/i64_buf.nore"
import loader "../../../compiler/frontend/loader.nore"
import node "../../../compiler/frontend/node.nore"
import scopes "../../../compiler/sema/scopes.nore"
import source "../../../compiler/support/source.nore"
import string "std/string.nore"
import token "../../../compiler/frontend/token.nore"
import types "../../../compiler/sema/types.nore"
import symbols "../../../compiler/sema/symbols.nore"

// Arena/table builtins should lower to runtime helpers instead of raw source names.
func main(): void = {
    mut mem: Arena = arena(16777216)
    mut sources: source.Sources = table_alloc(mut ref mem, 16)
    mut path_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 1024)
    mut text_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 65536)
    mut line_starts: ibuf.I64Buf = ibuf.i64_buf_new(mut ref mem, 4096)
    mut tokens: token.Tokens = table_alloc(mut ref mem, 4096)
    mut nodes: node.Nodes = table_alloc(mut ref mem, 16384)
    mut modules: loader.Modules = table_alloc(mut ref mem, 16)
    mut imports: loader.ModuleImports = table_alloc(mut ref mem, 16)
    mut diags: diag.Diagnostics = table_alloc(mut ref mem, 32)
    mut diag_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 4096)
    mut scopes_table: scopes.Scopes = table_alloc(mut ref mem, 256)
    mut symbols_table: symbols.Symbols = table_alloc(mut ref mem, 512)
    mut types_table: types.Types = table_alloc(mut ref mem, 512)

    val loaded: loader.LoadResult = loader.load_graph(
        mut ref mem,
        ref "tests/compiler/codegen/builtins_repo",
        ref "tests/compiler/codegen/builtins_repo/root.nore",
        mut ref sources,
        mut ref path_pool,
        mut ref text_pool,
        mut ref line_starts,
        mut ref tokens,
        mut ref nodes,
        mut ref modules,
        mut ref imports,
        mut ref diags,
        mut ref diag_pool
    )
    assert loaded.diags.count == 0

    val checked: check.CheckResult = check.check_modules(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref modules,
        ref imports,
        mut ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        mut ref diags,
        mut ref diag_pool
    )
    assert checked.diags.count == 0

    val dumped: [u8] = cmain.c_file_dump(
        mut ref mem,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref modules,
        ref symbols_table,
        mut ref types_table,
        ref checked.types,
        ref loaded.modules,
        false
    )

    assert string.str_contains(ref dumped, ref "#include <stddef.h>\n#include <string.h>\n")
    assert string.str_contains(ref dumped, ref "#define NI_ALIGNOF(T) __alignof__(T)\n\n")
    assert string.str_contains(ref dumped, ref "static ni_Arena ni_arena_new(int64_t ni_capacity) {\n")
    assert string.str_contains(ref dumped, ref "static void *ni_arena_alloc(ni_Arena *ni_arena, int64_t ni_count, size_t ni_elem_size, size_t ni_elem_align) {\n")
    assert string.str_contains(ref dumped, ref "static inline int64_t ni_checked_index(int64_t ni_idx, int64_t ni_size,\n")
    assert string.str_contains(ref dumped, ref "static ni_m0_Bag ni_m0_Bag__alloc(ni_Arena *ni_arena, int64_t ni_cap) {\n")
    assert string.str_contains(ref dumped, ref "static ni_m0_Bag_Row ni_m0_Bag__get(const ni_m0_Bag *ni_table, int64_t ni_idx, const char *ni_file, unsigned long ni_line, unsigned long ni_col) {\n")
    assert string.str_contains(ref dumped, ref "static void ni_m0_Bag__insert(ni_m0_Bag *ni_table, ni_m0_Bag_Row ni_row) {\n")
    assert string.str_contains(ref dumped, ref "return ni_arena_new(64L);\n")
    assert string.str_contains(ref dumped, ref "return (ni_slice_uint8_t){.data = (uint8_t *)ni_arena_alloc(ni_mem, ni_count, sizeof(uint8_t), NI_ALIGNOF(uint8_t)), .len = ni_count};\n")
    assert string.str_contains(ref dumped, ref "return (ni_str){.data = (uint8_t *)ni_arena_alloc(ni_mem, ni_count, sizeof(uint8_t), NI_ALIGNOF(uint8_t)), .len = ni_count};\n")
    assert string.str_contains(ref dumped, ref "ni_m0_Bag ni_bag = ni_m0_Bag__alloc(ni_mem, 4L);\n")
    assert string.str_contains(ref dumped, ref "ni_m0_Bag__insert(&ni_bag, (ni_m0_Bag_Row){.ni_count = 7L});\n")
    assert string.str_contains(ref dumped, ref "ni_m0_Bag_Row ni_got = ni_m0_Bag__get(&ni_bag, 0L, \"tests/compiler/codegen/builtins_repo/root.nore\", 25UL, 24UL);\n")
    assert string.str_contains(ref dumped, ref "return (ni_got.ni_count + ((&ni_bag)->ni__len));\n")
    assert string.str_contains(ref dumped, ref "ni_got.ni_count")
    assert string.str_contains(ref dumped, ref "ni__len")
    assert !string.str_contains(ref dumped, ref "sizeof(void)")
    assert !string.str_contains(ref dumped, ref "NI_ALIGNOF(void)")
    assert !string.str_contains(ref dumped, ref "(&ni_bag->ni__len)")
    assert !string.str_contains(ref dumped, ref "offsetof(struct { char c;")
    assert !string.str_contains(ref dumped, ref "table_alloc(")
    assert !string.str_contains(ref dumped, ref "table_get(")
    assert !string.str_contains(ref dumped, ref "table_insert(")
    assert !string.str_contains(ref dumped, ref " arena_reset(")
}
