native func fd_write(fd: i32, ref data: [u8]): i64

func get_bytes(): [u8] = {
    "abc"[0..3]
}

func tail_bytes(): [u8] = {
    get_bytes()[1..]
}

func full_bytes(): [u8] = {
    get_bytes()[..]
}

func tail_name(): [u8] = {
    "abc"[1..]
}

func send_tail(ref src: [u8]): i64 = {
    fd_write(1, ref src[1..])
}

func send_all(ref src: [u8]): i64 = {
    fd_write(1, ref src[..])
}

func send_name_tail(ref name: str): i64 = {
    fd_write(1, ref name[1..])
}
