import bbuf "../../../compiler/support/byte_buf.nore"
import cmain "../../../compiler/codegen/c_main.nore"
import check "../../../compiler/sema/check.nore"
import diag "../../../compiler/support/diag.nore"
import ibuf "../../../compiler/support/i64_buf.nore"
import loader "../../../compiler/frontend/loader.nore"
import node "../../../compiler/frontend/node.nore"
import scopes "../../../compiler/sema/scopes.nore"
import source "../../../compiler/support/source.nore"
import string "std/string.nore"
import token "../../../compiler/frontend/token.nore"
import types "../../../compiler/sema/types.nore"
import symbols "../../../compiler/sema/symbols.nore"

// Array-literal expression lowering should cover direct returns, local inits, and control-flow-produced arrays.
func main(): void = {
    mut mem: Arena = arena(16777216)
    mut sources: source.Sources = table_alloc(mut ref mem, 8)
    mut path_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 1024)
    mut text_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 65536)
    mut line_starts: ibuf.I64Buf = ibuf.i64_buf_new(mut ref mem, 4096)
    mut tokens: token.Tokens = table_alloc(mut ref mem, 4096)
    mut nodes: node.Nodes = table_alloc(mut ref mem, 16384)
    mut modules: loader.Modules = table_alloc(mut ref mem, 8)
    mut imports: loader.ModuleImports = table_alloc(mut ref mem, 8)
    mut diags: diag.Diagnostics = table_alloc(mut ref mem, 32)
    mut diag_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 4096)
    mut scopes_table: scopes.Scopes = table_alloc(mut ref mem, 256)
    mut symbols_table: symbols.Symbols = table_alloc(mut ref mem, 512)
    mut types_table: types.Types = table_alloc(mut ref mem, 512)

    val loaded: loader.LoadResult = loader.load_graph(
        mut ref mem,
        ref "tests/compiler/codegen/array_expr_repo",
        ref "tests/compiler/codegen/array_expr_repo/root.nore",
        mut ref sources,
        mut ref path_pool,
        mut ref text_pool,
        mut ref line_starts,
        mut ref tokens,
        mut ref nodes,
        mut ref modules,
        mut ref imports,
        mut ref diags,
        mut ref diag_pool
    )
    assert loaded.diags.count == 0

    val checked: check.CheckResult = check.check_modules(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref modules,
        ref imports,
        mut ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        mut ref diags,
        mut ref diag_pool
    )
    assert checked.diags.count == 0

    val dumped: [u8] = cmain.c_file_dump(
        mut ref mem,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref modules,
        ref symbols_table,
        mut ref types_table,
        ref checked.types,
        ref loaded.modules
    )

    assert string.str_contains(ref dumped, ref "typedef struct { uint8_t data[4]; } ni_arr_4_uint8_t;\n")
    assert string.str_contains(ref dumped, ref "typedef struct { int64_t data[2]; } ni_arr_2_int64_t;\n")
    assert string.str_contains(ref dumped, ref "ni_arr_4_uint8_t ni_m0_digits(void) {\n    return (ni_arr_4_uint8_t){{1L, 2L, 3L, 4L}};\n}\n")
    assert string.str_contains(ref dumped, ref "ni_arr_2_int64_t ni_m0_choose_pair(int ni_flag) {\n    ni_arr_2_int64_t ni_value_")
    assert string.str_contains(ref dumped, ref " = (ni_arr_2_int64_t){{10L, 20L}};\n    } else {\n        ni_value_")
    assert string.str_contains(ref dumped, ref " = (ni_arr_2_int64_t){{30L, 40L}};\n    }\n    ni_arr_2_int64_t ni_pair = ni_value_")
    assert string.str_contains(ref dumped, ref "uint8_t ni_m0_second_digit(void) {\n    ni_arr_4_uint8_t ni_digits = (ni_arr_4_uint8_t){{9L, 8L, 7L, 6L}};\n    return ((ni_digits).data[1L]);\n}\n")
    assert string.str_contains(ref dumped, ref "ni_slice_uint8_t ni_m0_middle_digits(void) {\n    ni_arr_4_uint8_t ni_digits = (ni_arr_4_uint8_t){{9L, 8L, 7L, 6L}};\n    return (ni_slice_uint8_t){.data = (ni_digits).data + 1L, .len = (3L - 1L)};\n}\n")
}
