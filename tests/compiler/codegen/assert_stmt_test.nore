import bbuf "../../../compiler/support/byte_buf.nore"
import cmain "../../../compiler/codegen/c_main.nore"
import check "../../../compiler/sema/check.nore"
import diag "../../../compiler/support/diag.nore"
import ibuf "../../../compiler/support/i64_buf.nore"
import loader "../../../compiler/frontend/loader.nore"
import node "../../../compiler/frontend/node.nore"
import scopes "../../../compiler/sema/scopes.nore"
import source "../../../compiler/support/source.nore"
import string "std/string.nore"
import token "../../../compiler/frontend/token.nore"
import types "../../../compiler/sema/types.nore"
import symbols "../../../compiler/sema/symbols.nore"

// Assert statements need a direct regression because the bootstrap compiler uses assert false for internal invariants.
func main(): void = {
    mut mem: Arena = arena(16777216)
    mut sources: source.Sources = table_alloc(mut ref mem, 8)
    mut path_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 1024)
    mut text_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 32768)
    mut line_starts: ibuf.I64Buf = ibuf.i64_buf_new(mut ref mem, 2048)
    mut tokens: token.Tokens = table_alloc(mut ref mem, 2048)
    mut nodes: node.Nodes = table_alloc(mut ref mem, 8192)
    mut modules: loader.Modules = table_alloc(mut ref mem, 8)
    mut imports: loader.ModuleImports = table_alloc(mut ref mem, 8)
    mut diags: diag.Diagnostics = table_alloc(mut ref mem, 32)
    mut diag_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 2048)
    mut scopes_table: scopes.Scopes = table_alloc(mut ref mem, 64)
    mut symbols_table: symbols.Symbols = table_alloc(mut ref mem, 128)
    mut types_table: types.Types = table_alloc(mut ref mem, 128)

    val loaded: loader.LoadResult = loader.load_graph(
        mut ref mem,
        ref "tests/compiler/codegen/assert_repo",
        ref "tests/compiler/codegen/assert_repo/root.nore",
        mut ref sources,
        mut ref path_pool,
        mut ref text_pool,
        mut ref line_starts,
        mut ref tokens,
        mut ref nodes,
        mut ref modules,
        mut ref imports,
        mut ref diags,
        mut ref diag_pool
    )
    assert loaded.diags.count == 0

    val checked: check.CheckResult = check.check_modules(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref modules,
        ref imports,
        mut ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        mut ref diags,
        mut ref diag_pool
    )
    assert checked.diags.count == 0

    val dumped: [u8] = cmain.c_file_dump(
        mut ref mem,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref modules,
        ref symbols_table,
        mut ref types_table,
        ref checked.types,
        ref loaded.modules,
        false
    )

    assert string.str_contains(ref dumped, ref "#include <stdio.h>\n")
    assert string.str_contains(ref dumped, ref "#include <stdlib.h>\n")
    assert string.str_contains(ref dumped, ref "void ni_m0_check(int ni_flag, int64_t ni_a, int64_t ni_b) {\n")
    assert string.str_contains(ref dumped, ref "if (!(ni_flag)) {\n        fprintf(stderr, \"tests/compiler/codegen/assert_repo/root.nore:2:5: error[R001]: Assertion failed\\n\");\n        exit(2);\n    }\n")
    assert string.str_contains(ref dumped, ref "if (!(ni_a == ni_b)) {\n        fprintf(stderr, \"tests/compiler/codegen/assert_repo/root.nore:3:5: error[R001]: Assertion failed\\n\");\n        exit(2);\n    }\n")
    assert string.str_contains(ref dumped, ref "if (!(0)) {\n        fprintf(stderr, \"tests/compiler/codegen/assert_repo/root.nore:4:5: error[R001]: Assertion failed\\n\");\n        exit(2);\n    }\n")

    val stripped: [u8] = cmain.c_file_dump(
        mut ref mem,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref modules,
        ref symbols_table,
        mut ref types_table,
        ref checked.types,
        ref loaded.modules,
        true
    )
    assert string.str_contains(ref stripped, ref "void ni_m0_check(int ni_flag, int64_t ni_a, int64_t ni_b) {\n")
    assert !string.str_contains(ref stripped, ref "Assertion failed")
}
