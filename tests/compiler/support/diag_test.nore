import bbuf "../../../compiler/support/byte_buf.nore"
import diag "../../../compiler/support/diag.nore"
import ibuf "../../../compiler/support/i64_buf.nore"
import source "../../../compiler/support/source.nore"
import string "std/string.nore"

// Prove structured diagnostics can load a file and format one source-backed error.
func main(): void = {
    mut mem: Arena = arena(32768)
    mut sources: source.Sources = table_alloc(mut ref mem, 4)
    mut path_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 128)
    mut text_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 256)
    mut line_starts: ibuf.I64Buf = ibuf.i64_buf_new(mut ref mem, 32)

    val loaded: source.SourceLoadResult = source.sources_load_file(
        mut ref mem,
        mut ref sources,
        mut ref path_pool,
        mut ref text_pool,
        mut ref line_starts,
        ref "tests/compiler/support/source_sample.nore",
        ref "tests/compiler/support/source_sample.nore",
        -1
    )

    val source_id: i64 = match (loaded) {
        Ok(id) = { id }
        Err(code) = { -1 }
    }
    assert source_id == 0

    val text: [u8] = source.source_text(ref text_pool, ref sources, source_id)
    val assert_at: i64 = string.str_find(ref text, ref "assert")
    assert assert_at >= 0

    mut diags: diag.Diagnostics = table_alloc(mut ref mem, 4)
    mut diag_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 128)
    val diag_id: i64 = diag.diag_error(
        mut ref mem,
        mut ref diags,
        mut ref diag_pool,
        ref "T001",
        source_id,
        assert_at,
        6,
        ref "synthetic failure"
    )
    assert diag_id == 0

    val rendered: [u8] = diag.diag_format(
        mut ref mem,
        ref diags,
        ref diag_pool,
        ref sources,
        ref path_pool,
        ref line_starts,
        diag_id
    )
    assert string.str_eq(
        ref rendered,
        ref "tests/compiler/support/source_sample.nore:3:5: error[T001]: synthetic failure"
    )
}
