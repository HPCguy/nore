import path "../../../compiler/support/path.nore"
import string "std/string.nore"

// Verify the bootstrap path helpers before import loading depends on them.
func main(): void = {
    mut mem: Arena = arena(4096)

    assert path.path_is_std_import(ref "std/io.nore")
    assert !path.path_is_std_import(ref "compiler/main.nore")

    val dirname1: str = path.path_dirname(mut ref mem, ref "compiler/main.nore")
    assert string.str_eq(ref dirname1, ref "compiler")

    val dirname2: str = path.path_dirname(mut ref mem, ref "main.nore")
    assert string.str_eq(ref dirname2, ref ".")

    val dirname3: str = path.path_dirname(mut ref mem, ref "/tmp/file.nore")
    assert string.str_eq(ref dirname3, ref "/tmp")

    val joined1: str = path.path_join(mut ref mem, ref "compiler/support", ref "diag.nore")
    assert string.str_eq(ref joined1, ref "compiler/support/diag.nore")

    val joined2: str = path.path_join(mut ref mem, ref "compiler/support/", ref "diag.nore")
    assert string.str_eq(ref joined2, ref "compiler/support/diag.nore")

    val normalized1: str = path.path_normalize(mut ref mem, ref "compiler/frontend/../support/source.nore")
    assert string.str_eq(ref normalized1, ref "compiler/support/source.nore")

    val normalized2: str = path.path_normalize(mut ref mem, ref "./tests/./compiler/imports/repo/app/../app/shared.nore")
    assert string.str_eq(ref normalized2, ref "tests/compiler/imports/repo/app/shared.nore")

    val normalized3: str = path.path_normalize(mut ref mem, ref "../compiler/../std/string.nore")
    assert string.str_eq(ref normalized3, ref "../std/string.nore")

    assert string.str_eq(ref path.path_extension(ref "compiler/main.nore"), ref ".nore")
    assert path.path_has_extension(ref "compiler/main.nore", ref ".nore")
    assert !path.path_has_extension(ref "compiler/main", ref ".nore")

    val std_import: str = path.path_resolve_import(
        mut ref mem,
        ref "/repo",
        ref "compiler/main.nore",
        ref "std/io.nore"
    )
    assert string.str_eq(ref std_import, ref "/repo/std/io.nore")

    val local_import: str = path.path_resolve_import(
        mut ref mem,
        ref "/repo",
        ref "tests/compiler/support/diag_test.nore",
        ref "source_sample.nore"
    )
    assert string.str_eq(ref local_import, ref "tests/compiler/support/source_sample.nore")
}
