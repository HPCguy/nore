import bbuf "../../../compiler/support/byte_buf.nore"
import ibuf "../../../compiler/support/i64_buf.nore"
import lmap "../../../compiler/support/line_map.nore"
import source "../../../compiler/support/source.nore"
import string "std/string.nore"

// Smoke-test source loading and pooled text access through the shared tables.
func main(): void = {
    mut mem: Arena = arena(16384)
    mut sources: source.Sources = table_alloc(mut ref mem, 4)
    mut path_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 128)
    mut text_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 256)
    mut line_starts: ibuf.I64Buf = ibuf.i64_buf_new(mut ref mem, 32)

    val loaded: source.SourceLoadResult = source.sources_load_file(
        mut ref mem,
        mut ref sources,
        mut ref path_pool,
        mut ref text_pool,
        mut ref line_starts,
        ref "tests/compiler/support/source_sample.nore",
        ref "tests/compiler/support/source_sample.nore",
        -1
    )

    val source_id: i64 = match (loaded) {
        Ok(id) = { id }
        Err(code) = { -1 }
    }
    assert source_id == 0
    assert table_len(ref sources) == 1

    val path_text: [u8] = source.source_path(ref path_pool, ref sources, source_id)
    assert string.str_eq(ref path_text, ref "tests/compiler/support/source_sample.nore")

    val display_path: [u8] = source.source_display_path(ref path_pool, ref sources, source_id)
    assert string.str_eq(ref display_path, ref "tests/compiler/support/source_sample.nore")

    val text: [u8] = source.source_text(ref text_pool, ref sources, source_id)
    assert string.str_contains(ref text, ref "func sample")
    assert string.str_contains(ref text, ref "assert x == 1")

    val assert_at: i64 = string.str_find(ref text, ref "assert")
    assert assert_at >= 0

    val loc: lmap.LineCol = source.source_line_col(ref sources, ref line_starts, source_id, assert_at)
    assert loc.line == 3
    assert loc.col == 5
}
