import bbuf "../../../compiler/support/byte_buf.nore"
import diag "../../../compiler/support/diag.nore"
import ibuf "../../../compiler/support/i64_buf.nore"
import loader "../../../compiler/frontend/loader.nore"
import node "../../../compiler/frontend/node.nore"
import source "../../../compiler/support/source.nore"
import token "../../../compiler/frontend/token.nore"
import string "std/string.nore"

// Verify a second graph walk can recover from a partial first load without duplicate edges.
func main(): void = {
    mut mem: Arena = arena(4194304)
    mut sources: source.Sources = table_alloc(mut ref mem, 16)
    mut path_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 2048)
    mut text_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 32768)
    mut line_starts: ibuf.I64Buf = ibuf.i64_buf_new(mut ref mem, 2048)
    mut tokens: token.Tokens = table_alloc(mut ref mem, 2048)
    mut nodes: node.Nodes = table_alloc(mut ref mem, 8192)
    mut modules: loader.Modules = table_alloc(mut ref mem, 16)
    mut imports: loader.ModuleImports = table_alloc(mut ref mem, 16)
    mut diags: diag.Diagnostics = table_alloc(mut ref mem, 16)
    mut diag_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 1024)

    val first: loader.LoadResult = loader.load_graph(
        mut ref mem,
        ref "tests/compiler/imports/repo_missing",
        ref "tests/compiler/imports/repo/app/root.nore",
        mut ref sources,
        mut ref path_pool,
        mut ref text_pool,
        mut ref line_starts,
        mut ref tokens,
        mut ref nodes,
        mut ref modules,
        mut ref imports,
        mut ref diags,
        mut ref diag_pool
    )

    assert first.root_module == 0
    assert first.modules.count == 3
    assert first.imports.count == 2
    assert first.diags.count == 1
    assert modules.import_count[first.root_module] == 2

    val second: loader.LoadResult = loader.load_graph(
        mut ref mem,
        ref "tests/compiler/imports/repo",
        ref "tests/compiler/imports/repo/app/root.nore",
        mut ref sources,
        mut ref path_pool,
        mut ref text_pool,
        mut ref line_starts,
        mut ref tokens,
        mut ref nodes,
        mut ref modules,
        mut ref imports,
        mut ref diags,
        mut ref diag_pool
    )

    assert second.root_module == 0
    assert second.modules.count == 2
    assert second.imports.count == 3
    assert second.diags.count == 0

    assert table_len(ref modules) == 5
    assert table_len(ref imports) == 5
    assert modules.import_count[0] == 3
    assert modules.import_count[1] == 1
    assert modules.import_count[2] == 1

    val dump: [u8] = loader.module_graph_dump(
        mut ref mem,
        ref modules,
        ref imports,
        ref nodes,
        ref tokens,
        ref sources,
        ref path_pool,
        ref text_pool
    )
    assert string.str_contains(ref dump, ref "MODULE path=tests/compiler/imports/repo/app/root.nore imports=3")
    assert string.str_contains(ref dump, ref "MODULE path=tests/compiler/imports/repo/app/left.nore imports=1")
    assert string.str_contains(ref dump, ref "MODULE path=tests/compiler/imports/repo/app/right.nore imports=1")
}
