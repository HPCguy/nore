import bbuf "../../../compiler/support/byte_buf.nore"
import diag "../../../compiler/support/diag.nore"
import ibuf "../../../compiler/support/i64_buf.nore"
import loader "../../../compiler/frontend/loader.nore"
import node "../../../compiler/frontend/node.nore"
import source "../../../compiler/support/source.nore"
import token "../../../compiler/frontend/token.nore"
import string "std/string.nore"

// Verify a missing entrypoint keeps the requested path and uses the file-not-found code.
func main(): void = {
    mut mem: Arena = arena(524288)
    mut sources: source.Sources = table_alloc(mut ref mem, 4)
    mut path_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 512)
    mut text_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 1024)
    mut line_starts: ibuf.I64Buf = ibuf.i64_buf_new(mut ref mem, 128)
    mut tokens: token.Tokens = table_alloc(mut ref mem, 64)
    mut nodes: node.Nodes = table_alloc(mut ref mem, 128)
    mut modules: loader.Modules = table_alloc(mut ref mem, 4)
    mut imports: loader.ModuleImports = table_alloc(mut ref mem, 4)
    mut diags: diag.Diagnostics = table_alloc(mut ref mem, 4)
    mut diag_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 256)

    val loaded: loader.LoadResult = loader.load_graph(
        mut ref mem,
        ref "tests/compiler/imports/repo",
        ref "tests/compiler/imports/repo/app/nope.nore",
        mut ref sources,
        mut ref path_pool,
        mut ref text_pool,
        mut ref line_starts,
        mut ref tokens,
        mut ref nodes,
        mut ref modules,
        mut ref imports,
        mut ref diags,
        mut ref diag_pool
    )

    assert loaded.root_module < 0
    assert loaded.modules.count == 0
    assert loaded.imports.count == 0
    assert loaded.diags.count == 1
    assert string.str_eq(ref diag.diag_code(ref diag_pool, ref diags, 0), ref "D005")
    assert string.str_eq(
        ref diag.diag_display_path(ref diag_pool, ref diags, 0),
        ref "tests/compiler/imports/repo/app/nope.nore"
    )

    val rendered: [u8] = diag.diag_format(
        mut ref mem,
        ref diags,
        ref diag_pool,
        ref sources,
        ref path_pool,
        ref line_starts,
        0
    )
    assert string.str_eq(
        ref rendered,
        ref "tests/compiler/imports/repo/app/nope.nore:0:0: error[D005]: Could not open file"
    )
}
