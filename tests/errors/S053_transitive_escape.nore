func level2(mut ref mem: Arena): [i64] = {
    mut data: [i64] = arena_alloc(mut ref mem, 10)
    return data
}

func level1(mut ref mem: Arena): [i64] = {
    return level2(mut ref mem)
}

func bad(): [i64] = {
    mut mem: Arena = arena(1024)
    return level1(mut ref mem)
}

func main(): void = {}
