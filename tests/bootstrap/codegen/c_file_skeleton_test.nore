import bbuf "../../../compiler/support/byte_buf.nore"
import cmain "../../../compiler/codegen/c_main.nore"
import check "../../../compiler/sema/check.nore"
import diag "../../../compiler/support/diag.nore"
import ibuf "../../../compiler/support/i64_buf.nore"
import loader "../../../compiler/frontend/loader.nore"
import node "../../../compiler/frontend/node.nore"
import scopes "../../../compiler/sema/scopes.nore"
import source "../../../compiler/support/source.nore"
import token "../../../compiler/frontend/token.nore"
import types "../../../compiler/sema/types.nore"
import string "std/string.nore"
import symbols "../../../compiler/sema/symbols.nore"

// Whole-file expected output is easier to keep stable when built with the same byte-buffer helpers.
func append_bytes(mut ref mem: Arena, mut ref out: bbuf.ByteBuf, ref data: [u8]): void = {
    bbuf.byte_buf_append(mut ref mem, mut ref out, ref data)
}

// Lock in the first assembled C-file skeleton: prelude, typedefs, then user-function prototypes.
func main(): void = {
    mut mem: Arena = arena(8388608)
    mut sources: source.Sources = table_alloc(mut ref mem, 8)
    mut path_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 1024)
    mut text_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 32768)
    mut line_starts: ibuf.I64Buf = ibuf.i64_buf_new(mut ref mem, 2048)
    mut tokens: token.Tokens = table_alloc(mut ref mem, 2048)
    mut nodes: node.Nodes = table_alloc(mut ref mem, 8192)
    mut modules: loader.Modules = table_alloc(mut ref mem, 8)
    mut imports: loader.ModuleImports = table_alloc(mut ref mem, 8)
    mut diags: diag.Diagnostics = table_alloc(mut ref mem, 32)
    mut diag_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 2048)
    mut scopes_table: scopes.Scopes = table_alloc(mut ref mem, 64)
    mut symbols_table: symbols.Symbols = table_alloc(mut ref mem, 128)
    mut types_table: types.Types = table_alloc(mut ref mem, 128)

    val loaded: loader.LoadResult = loader.load_graph(
        mut ref mem,
        ref "tests/bootstrap/codegen/repo",
        ref "tests/bootstrap/codegen/repo/root.nore",
        mut ref sources,
        mut ref path_pool,
        mut ref text_pool,
        mut ref line_starts,
        mut ref tokens,
        mut ref nodes,
        mut ref modules,
        mut ref imports,
        mut ref diags,
        mut ref diag_pool
    )
    assert loaded.diags.count == 0

    val checked: check.CheckResult = check.check_modules(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref modules,
        ref imports,
        mut ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        mut ref diags,
        mut ref diag_pool
    )
    assert checked.diags.count == 0

    val dumped: [u8] = cmain.c_file_dump(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref modules,
        ref symbols_table,
        mut ref types_table,
        ref checked.types,
        ref loaded.modules
    )

    mut expected_buf: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 2048)
    append_bytes(mut ref mem, mut ref expected_buf, ref "#include <stdint.h>\n\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "typedef struct { uint8_t *data; int64_t len; } ni_str;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "typedef struct { uint8_t *data; int64_t capacity; int64_t offset; } ni_Arena;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "typedef int64_t ni_OS;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "typedef struct { uint8_t data[4]; } ni_arr_4_uint8_t;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "typedef struct { int64_t ni_left; ni_arr_4_uint8_t ni_bytes; } ni_m0_Pair;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "typedef struct { uint8_t *data; int64_t len; } ni_slice_uint8_t;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "typedef struct { ni_slice_uint8_t ni_bytes; ni_str ni_name; } ni_m0_View;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "typedef struct { int64_t *data; int64_t len; } ni_slice_int64_t;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "typedef struct { int *data; int64_t len; } ni_slice_int;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "typedef struct { int64_t ni_id; int ni_ok; } ni_m0_Scores_Row;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "typedef struct { ni_slice_int64_t ni_id; ni_slice_int ni_ok; int64_t ni__len; } ni_m0_Scores;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "typedef int64_t ni_m0_Color;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "typedef struct {\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "    int64_t tag;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "    union {\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "        int64_t ni_Some;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "        ni_m0_Pair ni_Pair;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "    } data;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "} ni_m0_MaybeNum;\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "ni_m0_Scores_Row ni_m0_make_row(void);\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "void ni_m0_inspect_os(ni_OS ni_os);\n")
    append_bytes(mut ref mem, mut ref expected_buf, ref "void ni_m0_take_mem(ni_Arena *ni_mem);\n")

    val expected: [u8] = expected_buf.data[0..expected_buf.count]
    assert string.str_eq(ref dumped, ref expected)
}
