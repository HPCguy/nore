import bbuf "../../../compiler/support/byte_buf.nore"
import cmain "../../../compiler/codegen/c_main.nore"
import check "../../../compiler/sema/check.nore"
import diag "../../../compiler/support/diag.nore"
import ibuf "../../../compiler/support/i64_buf.nore"
import loader "../../../compiler/frontend/loader.nore"
import node "../../../compiler/frontend/node.nore"
import scopes "../../../compiler/sema/scopes.nore"
import source "../../../compiler/support/source.nore"
import span "../../../compiler/support/span.nore"
import string "std/string.nore"
import token "../../../compiler/frontend/token.nore"
import types "../../../compiler/sema/types.nore"
import symbols "../../../compiler/sema/symbols.nore"

// Parser-module globals should lower cleanly even before expression-form `if` or imported match-heavy bodies do.
func main(): void = {
    mut mem: Arena = arena(67108864)
    mut sources: source.Sources = table_alloc(mut ref mem, 64)
    mut path_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 4096)
    mut text_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 262144)
    mut line_starts: ibuf.I64Buf = ibuf.i64_buf_new(mut ref mem, 16384)
    mut tokens: token.Tokens = table_alloc(mut ref mem, 65536)
    mut nodes: node.Nodes = table_alloc(mut ref mem, 262144)
    mut modules: loader.Modules = table_alloc(mut ref mem, 64)
    mut imports: loader.ModuleImports = table_alloc(mut ref mem, 128)
    mut diags: diag.Diagnostics = table_alloc(mut ref mem, 128)
    mut diag_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 16384)
    mut scopes_table: scopes.Scopes = table_alloc(mut ref mem, 8192)
    mut symbols_table: symbols.Symbols = table_alloc(mut ref mem, 32768)
    mut types_table: types.Types = table_alloc(mut ref mem, 16384)

    val loaded: loader.LoadResult = loader.load_graph(
        mut ref mem,
        ref ".",
        ref "compiler/frontend/parser.nore",
        mut ref sources,
        mut ref path_pool,
        mut ref text_pool,
        mut ref line_starts,
        mut ref tokens,
        mut ref nodes,
        mut ref modules,
        mut ref imports,
        mut ref diags,
        mut ref diag_pool
    )
    assert loaded.diags.count == 0

    val checked: check.CheckResult = check.check_modules(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref modules,
        ref imports,
        mut ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        mut ref diags,
        mut ref diag_pool
    )
    assert checked.diags.count == 0

    val parser_only: span.Range = span.range(loaded.root_module, 1)
    val dumped: [u8] = cmain.global_definitions_dump(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref modules,
        ref symbols_table,
        ref types_table,
        ref parser_only
    )

    assert string.str_contains(ref dumped, ref "static const int64_t ni_m0_FLAG_MUT = 1L;\n")
    assert string.str_contains(ref dumped, ref "static const int64_t ni_m0_FLAG_HAS_END = 128L;\n")
    assert string.str_contains(ref dumped, ref "static const int64_t ni_m0_FLAG_NATIVE = 8L;\n")
}
