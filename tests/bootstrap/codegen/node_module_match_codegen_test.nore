import bbuf "../../../compiler/support/byte_buf.nore"
import cmain "../../../compiler/codegen/c_main.nore"
import check "../../../compiler/sema/check.nore"
import diag "../../../compiler/support/diag.nore"
import ibuf "../../../compiler/support/i64_buf.nore"
import loader "../../../compiler/frontend/loader.nore"
import node "../../../compiler/frontend/node.nore"
import scopes "../../../compiler/sema/scopes.nore"
import source "../../../compiler/support/source.nore"
import string "std/string.nore"
import token "../../../compiler/frontend/token.nore"
import types "../../../compiler/sema/types.nore"
import symbols "../../../compiler/sema/symbols.nore"

// One real compiler module should lower through the current match slice before Milestone 8 moves on.
func main(): void = {
    mut mem: Arena = arena(33554432)
    mut sources: source.Sources = table_alloc(mut ref mem, 16)
    mut path_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 2048)
    mut text_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 131072)
    mut line_starts: ibuf.I64Buf = ibuf.i64_buf_new(mut ref mem, 8192)
    mut tokens: token.Tokens = table_alloc(mut ref mem, 16384)
    mut nodes: node.Nodes = table_alloc(mut ref mem, 65536)
    mut modules: loader.Modules = table_alloc(mut ref mem, 16)
    mut imports: loader.ModuleImports = table_alloc(mut ref mem, 16)
    mut diags: diag.Diagnostics = table_alloc(mut ref mem, 64)
    mut diag_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 8192)
    mut scopes_table: scopes.Scopes = table_alloc(mut ref mem, 2048)
    mut symbols_table: symbols.Symbols = table_alloc(mut ref mem, 4096)
    mut types_table: types.Types = table_alloc(mut ref mem, 2048)

    val loaded: loader.LoadResult = loader.load_graph(
        mut ref mem,
        ref "compiler/frontend",
        ref "compiler/frontend/node.nore",
        mut ref sources,
        mut ref path_pool,
        mut ref text_pool,
        mut ref line_starts,
        mut ref tokens,
        mut ref nodes,
        mut ref modules,
        mut ref imports,
        mut ref diags,
        mut ref diag_pool
    )
    assert loaded.diags.count == 0

    val checked: check.CheckResult = check.check_modules(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref modules,
        ref imports,
        mut ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        mut ref diags,
        mut ref diag_pool
    )
    assert checked.diags.count == 0

    val dumped: [u8] = cmain.c_file_dump(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref modules,
        ref symbols_table,
        mut ref types_table,
        ref checked.types,
        ref loaded.modules
    )

    assert string.str_contains(ref dumped, ref "ni_str ni_m0_node_kind_name(ni_m0_NodeKind ni_kind) {\n    ni_m0_NodeKind ni_match_")
    assert string.str_contains(ref dumped, ref "return (ni_str){.data = (uint8_t *)\"MODULE\", .len = 6L};\n")
    assert string.str_contains(ref dumped, ref "} else if (ni_match_")
}
