value Pair {
    left: i64,
    bytes: [u8; 4]
}

struct View {
    bytes: [u8],
    name: str
}

table Scores {
    id: i64,
    ok: bool
}

enum Color {
    Red,
    Blue
}

enum MaybeNum {
    None,
    Some(i64),
    Pair(Pair)
}

func make_row(): Scores.Row = {
    Scores.Row {
        id: 1,
        ok: true
    }
}

func inspect_os(os: OS): void = {
}

func take_mem(mut ref mem: Arena): void = {
}

func call_id(n: i64): i64 = {
    id(n)
}

func id(n: i64): i64 = {
    return n
}

func pair_left(pair: Pair): i64 = {
    return pair.left
}

func pair_left_ref(ref pair: Pair): i64 = {
    pair.left
}

func passthrough_ref(ref n: i64): i64 = {
    n
}

func always_true(): bool = {
    true
}

func color_red(): Color = {
    Color.Red
}

func maybe_none(): MaybeNum = {
    MaybeNum.None
}

func maybe_some(n: i64): MaybeNum = {
    MaybeNum.Some(n)
}

func take_name(ref name: str): i64 = {
    name.len
}

func call_take_name(): i64 = {
    take_name(ref "hi")
}

func count_up(limit: i64): i64 = {
    mut x: i64 = 0
    while (x < limit) {
        x += 1
    }
    x
}

func choose_count(n: i64): i64 = {
    mut x: i64 = n
    if (x < 2) {
        x = x + 10
    } else {
        x -= 1
    }
    x
}

func second_byte(bytes: [u8; 4]): u8 = {
    bytes[1]
}

func mid_bytes(bytes: [u8; 4]): [u8] = {
    bytes[1..3]
}

func invert(ok: bool): bool = {
    !ok
}

func narrow(n: i64): i32 = {
    i32(n)
}

func is_newline(c: u8): bool = {
    c == '\n'
}

func pi(): f64 = {
    3.5
}

func break_at(limit: i64): i64 = {
    mut x: i64 = 0
    while (x < limit) {
        x += 1
        if (x == 2) {
            break
        }
    }
    x
}

func skip_first(limit: i64): i64 = {
    mut x: i64 = 0
    mut seen: i64 = 0
    while (x < limit) {
        x += 1
        if (x == 1) {
            continue
        }
        seen += 1
    }
    seen
}
