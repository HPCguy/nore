// Bootstrap compiler whole-file C orchestration.
// Responsibility: assemble the current generated-C skeleton for a checked module graph.
// Owns: section ordering for prelude, typedefs, module globals, native/user prototypes, and helper/function bodies.
// Does not own: expression lowering, statement lowering, runtime helper bodies, or CLI behavior.

import bbuf "../support/byte_buf.nore"
import cdecl "c_emit_decl.nore"
import cexpr "c_emit_expr.nore"
import cstmt "c_emit_stmt.nore"
import cruntime "c_runtime.nore"
import ctypes "c_types.nore"
import loader "../frontend/loader.nore"
import node "../frontend/node.nore"
import source "../support/source.nore"
import span "../support/span.nore"
import symbols "../sema/symbols.nore"
import token "../frontend/token.nore"
import types "../sema/types.nore"
import string "std/string.nore"

val GLOBAL_MUT_FLAG: i64 = 1
val GLOBAL_TYPED_FLAG: i64 = 16
val EMIT_STATE_UNSEEN: i64 = 0
val EMIT_STATE_VISITING: i64 = 1
val EMIT_STATE_EMITTED: i64 = 2
val TABLE_HELPER_ALLOC: i64 = 1
val TABLE_HELPER_GET: i64 = 2
val TABLE_HELPER_INSERT: i64 = 4

func append_bytes(mut ref mem: Arena, mut ref out: bbuf.ByteBuf, ref data: [u8]): void = {
    bbuf.byte_buf_append(mut ref mem, mut ref out, ref data)
}

func append_i64(mut ref mem: Arena, mut ref out: bbuf.ByteBuf, n: i64): void = {
    val text: str = string.i64_to_str(mut ref mem, n)
    append_bytes(mut ref mem, mut ref out, ref text)
}

// Keep section spacing centralized so later codegen slices can extend the file layout without churn.
func append_section(mut ref mem: Arena, mut ref out: bbuf.ByteBuf, ref data: [u8]): void = {
    if (data.len == 0) {
        return
    }
    if (out.count > 0) {
        append_bytes(mut ref mem, mut ref out, ref "\n")
    }
    append_bytes(mut ref mem, mut ref out, ref data)
}

// Parser and later passes share the same declaration flag bits for mutability and type annotations.
func flag_has(flags: i64, bit: i64): bool = {
    (flags & bit) != 0
}

// Global definitions only need mutability and initializer-child recovery from the checked declaration row.
func decl_init_node(ref nodes: node.Nodes, decl_id: i64): i64 = {
    if (flag_has(nodes.data1[decl_id], GLOBAL_TYPED_FLAG)) {
        return node.node_child_at(ref nodes, decl_id, 1)
    }
    node.node_child_at(ref nodes, decl_id, 0)
}

// Builtin scans only match unresolved identifiers so module-local shadowing stays aligned with sema.
func identifier_token_is(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    node_id: i64,
    ref wanted: [u8]
): bool = {
    if (node_id < 0 ||
        nodes.kind[node_id] != node.NodeKind.Identifier ||
        nodes.symbol_id[node_id] >= 0) {
        return false
    }
    val name_text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[node_id])
    string.str_eq(ref name_text, ref wanted)
}

// One recursive scan keeps the generated-C runtime surface aligned with actual module usage.
func collect_runtime_usage(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    node_id: i64,
    mut ref table_helpers: [i64],
    mut ref needs_arena: bool,
    mut ref needs_mem: bool,
    mut ref needs_io: bool,
    mut ref needs_exit: bool,
    mut ref needs_args: bool,
    mut ref needs_driver: bool
): void = {
    if (node_id < 0) {
        return
    }

    if (nodes.kind[node_id] == node.NodeKind.CallExpr) {
        val callee_id: i64 = node.node_child_at(ref nodes, node_id, 0)
        if (identifier_token_is(ref sources, ref text_pool, ref tokens, ref nodes, callee_id, ref "arena") ||
            identifier_token_is(ref sources, ref text_pool, ref tokens, ref nodes, callee_id, ref "arena_alloc") ||
            identifier_token_is(ref sources, ref text_pool, ref tokens, ref nodes, callee_id, ref "arena_reset")) {
            needs_arena = true
        }

        if (identifier_token_is(ref sources, ref text_pool, ref tokens, ref nodes, callee_id, ref "table_alloc")) {
            needs_arena = true
            if (nodes.type_id[node_id] >= 0 && nodes.type_id[node_id] < table_helpers.len) {
                table_helpers[nodes.type_id[node_id]] = table_helpers[nodes.type_id[node_id]] | TABLE_HELPER_ALLOC
            }
        }

        if (identifier_token_is(ref sources, ref text_pool, ref tokens, ref nodes, callee_id, ref "table_get")) {
            val table_value_id: i64 = cexpr.ref_arg_value_id(ref nodes, node.node_child_at(ref nodes, node_id, 1))
            if (table_value_id >= 0 &&
                nodes.type_id[table_value_id] >= 0 &&
                nodes.type_id[table_value_id] < table_helpers.len) {
                table_helpers[nodes.type_id[table_value_id]] = table_helpers[nodes.type_id[table_value_id]] | TABLE_HELPER_GET
            }
        } else if (identifier_token_is(ref sources, ref text_pool, ref tokens, ref nodes, callee_id, ref "table_insert")) {
            val table_value_id: i64 = cexpr.ref_arg_value_id(ref nodes, node.node_child_at(ref nodes, node_id, 1))
            if (table_value_id >= 0 &&
                nodes.type_id[table_value_id] >= 0 &&
                nodes.type_id[table_value_id] < table_helpers.len) {
                table_helpers[nodes.type_id[table_value_id]] = table_helpers[nodes.type_id[table_value_id]] | TABLE_HELPER_INSERT
            }
        }
    }

    if (nodes.kind[node_id] == node.NodeKind.NativeFuncDecl) {
        val name_token: i64 = nodes.data0[node_id]
        if (cexpr.token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "mem_copy")) {
            needs_mem = true
        }
        if (cexpr.token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "exit")) {
            needs_exit = true
        }
        if (cexpr.token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "args")) {
            needs_arena = true
            needs_args = true
        }
        if (cexpr.token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "shell_run")) {
            needs_driver = true
        }
        if (cexpr.token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "exe_dir")) {
            needs_arena = true
            needs_args = true
            needs_driver = true
        }
        if (cexpr.token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "pid")) {
            needs_driver = true
        }
        if (cexpr.token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_write") ||
            cexpr.token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_read") ||
            cexpr.token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_open") ||
            cexpr.token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_close") ||
            cexpr.token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_seek")) {
            needs_io = true
        }
    }

    mut child_id: i64 = nodes.first_child[node_id]
    while (child_id >= 0) {
        collect_runtime_usage(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            child_id,
            mut ref table_helpers,
            mut ref needs_arena,
            mut ref needs_mem,
            mut ref needs_io,
            mut ref needs_exit,
            mut ref needs_args,
            mut ref needs_driver
        )
        child_id = nodes.next_sibling[child_id]
    }
}

// Arena globals still need a special lowering path until runtime init/free hooks are wired through main.
func decl_is_arena_global_init(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref types_table: types.Types,
    decl_id: i64
): bool = {
    if (decl_id < 0 || nodes.type_id[decl_id] < 0) {
        return false
    }
    if (types_table.kind[nodes.type_id[decl_id]] != types.TypeKind.ArenaType) {
        return false
    }
    val init_id: i64 = decl_init_node(ref nodes, decl_id)
    if (init_id < 0 || nodes.kind[init_id] != node.NodeKind.CallExpr) {
        return false
    }
    identifier_token_is(
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        node.node_child_at(ref nodes, init_id, 0),
        ref "arena"
    )
}

// Global initializers cover a slightly broader subset than the current general expression emitter.
func append_global_initializer_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    node_id: i64
): void = {
    if (node_id < 0) {
        return
    }

    if (nodes.kind[node_id] == node.NodeKind.ArrayLit) {
        val type_text: str = ctypes.type_name(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref types_table,
            nodes.type_id[node_id]
        )
        append_bytes(mut ref mem, mut ref out, ref "(")
        append_bytes(mut ref mem, mut ref out, ref type_text)
        append_bytes(mut ref mem, mut ref out, ref "){{")
        mut elem_id: i64 = nodes.first_child[node_id]
        mut first: bool = true
        while (elem_id >= 0) {
            if (!first) {
                append_bytes(mut ref mem, mut ref out, ref ", ")
            }
            append_global_initializer_expr(
                mut ref mem,
                mut ref out,
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref symbols_table,
                ref types_table,
                elem_id
            )
            first = false
            elem_id = nodes.next_sibling[elem_id]
        }
        append_bytes(mut ref mem, mut ref out, ref "}}")
        return
    }

    if (nodes.kind[node_id] == node.NodeKind.IfStmt) {
        val then_value: i64 = cstmt.block_value_expr(ref nodes, node.node_child_at(ref nodes, node_id, 1))
        val else_id: i64 = node.node_child_at(ref nodes, node_id, 2)
        append_bytes(mut ref mem, mut ref out, ref "(")
        append_global_initializer_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node.node_child_at(ref nodes, node_id, 0)
        )
        append_bytes(mut ref mem, mut ref out, ref " ? ")
        append_global_initializer_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            then_value
        )
        append_bytes(mut ref mem, mut ref out, ref " : ")
        if (else_id >= 0 && nodes.kind[else_id] == node.NodeKind.Block) {
            append_global_initializer_expr(
                mut ref mem,
                mut ref out,
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref symbols_table,
                ref types_table,
                cstmt.block_value_expr(ref nodes, else_id)
            )
        } else {
            append_global_initializer_expr(
                mut ref mem,
                mut ref out,
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref symbols_table,
                ref types_table,
                else_id
            )
        }
        append_bytes(mut ref mem, mut ref out, ref ")")
        return
    }

    cexpr.append_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        node_id
    )
}

// Arena globals keep a static declaration plus a separately lowered capacity constant.
func append_arena_global_definition(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    module_id: i64,
    decl_id: i64
): void = {
    val type_text: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        nodes.type_id[decl_id]
    )
    val name_text: str = cdecl.decl_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        module_id,
        nodes.data0[decl_id]
    )
    val init_id: i64 = decl_init_node(ref nodes, decl_id)

    append_bytes(mut ref mem, mut ref out, ref "static ")
    append_bytes(mut ref mem, mut ref out, ref type_text)
    append_bytes(mut ref mem, mut ref out, ref " ")
    append_bytes(mut ref mem, mut ref out, ref name_text)
    append_bytes(mut ref mem, mut ref out, ref ";\n")
    append_bytes(mut ref mem, mut ref out, ref "static const int64_t ")
    append_bytes(mut ref mem, mut ref out, ref name_text)
    append_bytes(mut ref mem, mut ref out, ref "_cap = ")
    append_global_initializer_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        node.node_child_at(ref nodes, init_id, 1)
    )
    append_bytes(mut ref mem, mut ref out, ref ";\n")
}

// Bootstrap whole-file C still emits one translation unit, so globals can keep internal linkage.
func append_global_definition(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    module_id: i64,
    decl_id: i64
): void = {
    if (decl_is_arena_global_init(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref types_table,
            decl_id
        )) {
        append_arena_global_definition(
            mut ref mem,
            mut ref out,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            module_id,
            decl_id
        )
        return
    }

    val type_text: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        nodes.type_id[decl_id]
    )
    val name_text: str = cdecl.decl_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        module_id,
        nodes.data0[decl_id]
    )

    append_bytes(mut ref mem, mut ref out, ref "static ")
    if (!flag_has(nodes.data1[decl_id], GLOBAL_MUT_FLAG)) {
        append_bytes(mut ref mem, mut ref out, ref "const ")
    }
    append_bytes(mut ref mem, mut ref out, ref type_text)
    append_bytes(mut ref mem, mut ref out, ref " ")
    append_bytes(mut ref mem, mut ref out, ref name_text)
    append_bytes(mut ref mem, mut ref out, ref " = ")
    append_global_initializer_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        decl_init_node(ref nodes, decl_id)
    )
    append_bytes(mut ref mem, mut ref out, ref ";\n")
}

// Global initializer references must emit dependency-first so later constant aliases compile as C.
func global_dep_decl_id(ref nodes: node.Nodes, ref symbols_table: symbols.Symbols, node_id: i64): i64 = {
    if (node_id < 0 ||
        nodes.kind[node_id] != node.NodeKind.Identifier ||
        nodes.symbol_id[node_id] < 0) {
        return node.invalid_node_id()
    }
    val symbol_id: i64 = nodes.symbol_id[node_id]
    if (symbols_table.kind[symbol_id] != symbols.SymbolKind.GlobalSymbol) {
        return node.invalid_node_id()
    }
    val decl_id: i64 = symbols_table.decl_node[symbol_id]
    if (decl_id < 0 || nodes.kind[decl_id] != node.NodeKind.VarDecl) {
        return node.invalid_node_id()
    }
    decl_id
}

// Dependency discovery walks the initializer tree directly so ordering stays correct without a separate graph table.
func emit_global_decl_recursive(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref modules: loader.Modules,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    decl_id: i64,
    mut ref states: [i64],
    mut ref dep_walk: [i64]
): void = {
    if (decl_id < 0 || decl_id >= states.len) {
        return
    }
    if (states[decl_id] == EMIT_STATE_EMITTED || states[decl_id] == EMIT_STATE_VISITING) {
        return
    }

    states[decl_id] = EMIT_STATE_VISITING
    val init_id: i64 = decl_init_node(ref nodes, decl_id)
    dep_walk[0] = init_id
    mut dep_count: i64 = 1
    mut dep_index: i64 = 0
    while (dep_index < dep_count) {
        val node_id: i64 = dep_walk[dep_index]
        dep_index += 1
        if (node_id < 0) {
            continue
        }
        val dep_decl: i64 = global_dep_decl_id(ref nodes, ref symbols_table, node_id)
        if (dep_decl >= 0 && dep_decl != decl_id) {
            emit_global_decl_recursive(
                mut ref mem,
                mut ref out,
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref modules,
                ref symbols_table,
                ref types_table,
                dep_decl,
                mut ref states,
                mut ref dep_walk
            )
        }

        mut child_id: i64 = nodes.first_child[node_id]
        while (child_id >= 0) {
            dep_walk[dep_count] = child_id
            dep_count += 1
            child_id = nodes.next_sibling[child_id]
        }
    }

    val symbol_id: i64 = nodes.symbol_id[decl_id]
    val module_id: i64 = if (symbol_id >= 0) {
        symbols_table.module_id[symbol_id]
    } else {
        0
    }
    append_global_definition(
        mut ref mem,
        mut ref out,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        module_id,
        decl_id
    )
    states[decl_id] = EMIT_STATE_EMITTED
}

// Tests and whole-file assembly both need one stable entry point for module-global definitions.
pub func global_definitions_dump(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref modules: loader.Modules,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    ref module_range: span.Range
): [u8] = {
    mut out: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 256)
    mut states: [i64] = arena_alloc(mut ref mem, table_len(ref nodes))
    mut dep_walk: [i64] = arena_alloc(mut ref mem, table_len(ref nodes))
    mut state_id: i64 = 0
    while (state_id < states.len) {
        states[state_id] = EMIT_STATE_UNSEEN
        state_id += 1
    }
    mut module_id: i64 = module_range.start
    val end: i64 = span.range_end(ref module_range)
    while (module_id < end && module_id < table_len(ref modules)) {
        val root_id: i64 = modules.root_node[module_id]
        mut decl_id: i64 = nodes.first_child[root_id]
        while (decl_id >= 0) {
            if (nodes.kind[decl_id] == node.NodeKind.VarDecl) {
                emit_global_decl_recursive(
                    mut ref mem,
                    mut ref out,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    ref nodes,
                    ref modules,
                    ref symbols_table,
                    ref types_table,
                    decl_id,
                    mut ref states,
                    mut ref dep_walk
                )
            }
            decl_id = nodes.next_sibling[decl_id]
        }
        module_id += 1
    }

    out.data[0..out.count]
}

// Table helper emission reuses the same field iteration shape as the table typedefs.
func append_table_alloc_helper(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    mut ref types_table: types.Types,
    table_type: i64
): void = {
    val decl_id: i64 = types_table.decl_node[table_type]
    val table_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        table_type
    )
    val helper_name: str = cexpr.table_helper_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        table_type,
        ref "__alloc"
    )

    append_bytes(mut ref mem, mut ref out, ref "static ")
    append_bytes(mut ref mem, mut ref out, ref table_name)
    append_bytes(mut ref mem, mut ref out, ref " ")
    append_bytes(mut ref mem, mut ref out, ref helper_name)
    append_bytes(mut ref mem, mut ref out, ref "(ni_Arena *ni_arena, int64_t ni_cap) {\n")
    append_bytes(mut ref mem, mut ref out, ref "    return (")
    append_bytes(mut ref mem, mut ref out, ref table_name)
    append_bytes(mut ref mem, mut ref out, ref "){\n")

    mut field_id: i64 = nodes.first_child[decl_id]
    while (field_id >= 0) {
        if (nodes.kind[field_id] == node.NodeKind.FieldDecl) {
            val slice_type_id: i64 = types.type_slice(mut ref types_table, nodes.type_id[field_id])
            val slice_name: str = ctypes.type_name(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref types_table,
                slice_type_id
            )
            val elem_name: str = ctypes.type_name(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref types_table,
                nodes.type_id[field_id]
            )
            val field_name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[field_id])
            append_bytes(mut ref mem, mut ref out, ref "        .ni_")
            append_bytes(mut ref mem, mut ref out, ref field_name)
            append_bytes(mut ref mem, mut ref out, ref " = (")
            append_bytes(mut ref mem, mut ref out, ref slice_name)
            append_bytes(mut ref mem, mut ref out, ref "){.data = (")
            append_bytes(mut ref mem, mut ref out, ref elem_name)
            append_bytes(mut ref mem, mut ref out, ref " *)ni_arena_alloc(ni_arena, ni_cap, sizeof(")
            append_bytes(mut ref mem, mut ref out, ref elem_name)
            append_bytes(mut ref mem, mut ref out, ref "), NI_ALIGNOF(")
            append_bytes(mut ref mem, mut ref out, ref elem_name)
            append_bytes(mut ref mem, mut ref out, ref ")), .len = ni_cap},\n")
        }
        field_id = nodes.next_sibling[field_id]
    }

    append_bytes(mut ref mem, mut ref out, ref "        .ni__len = 0L\n")
    append_bytes(mut ref mem, mut ref out, ref "    };\n")
    append_bytes(mut ref mem, mut ref out, ref "}\n")
}

// Table row helpers centralize the bounds/error contract for the first lowered table builtin slice.
func append_table_get_helper(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    mut ref types_table: types.Types,
    table_type: i64
): void = {
    val decl_id: i64 = types_table.decl_node[table_type]
    val row_type: i64 = types.type_table_row(
        mut ref types_table,
        types_table.module_id[table_type],
        decl_id,
        table_type
    )
    val table_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        table_type
    )
    val row_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        row_type
    )
    val helper_name: str = cexpr.table_helper_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        table_type,
        ref "__get"
    )

    append_bytes(mut ref mem, mut ref out, ref "static ")
    append_bytes(mut ref mem, mut ref out, ref row_name)
    append_bytes(mut ref mem, mut ref out, ref " ")
    append_bytes(mut ref mem, mut ref out, ref helper_name)
    append_bytes(mut ref mem, mut ref out, ref "(const ")
    append_bytes(mut ref mem, mut ref out, ref table_name)
    append_bytes(mut ref mem, mut ref out, ref " *ni_table, int64_t ni_idx) {\n")
    append_bytes(mut ref mem, mut ref out, ref "    if ((uint64_t)ni_idx >= (uint64_t)ni_table->ni__len) {\n")
    append_bytes(mut ref mem, mut ref out, ref "        fprintf(stderr, \"error[R002]: Table index out of bounds: %ld not in [0, %ld)\\n\", (long)ni_idx, (long)ni_table->ni__len);\n")
    append_bytes(mut ref mem, mut ref out, ref "        exit(2);\n")
    append_bytes(mut ref mem, mut ref out, ref "    }\n")
    append_bytes(mut ref mem, mut ref out, ref "    return (")
    append_bytes(mut ref mem, mut ref out, ref row_name)
    append_bytes(mut ref mem, mut ref out, ref "){")

    mut field_id: i64 = nodes.first_child[decl_id]
    mut wrote_any: bool = false
    while (field_id >= 0) {
        if (nodes.kind[field_id] == node.NodeKind.FieldDecl) {
            val field_name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[field_id])
            if (wrote_any) {
                append_bytes(mut ref mem, mut ref out, ref ", ")
            }
            append_bytes(mut ref mem, mut ref out, ref ".ni_")
            append_bytes(mut ref mem, mut ref out, ref field_name)
            append_bytes(mut ref mem, mut ref out, ref " = ni_table->ni_")
            append_bytes(mut ref mem, mut ref out, ref field_name)
            append_bytes(mut ref mem, mut ref out, ref ".data[ni_idx]")
            wrote_any = true
        }
        field_id = nodes.next_sibling[field_id]
    }

    append_bytes(mut ref mem, mut ref out, ref "};\n")
    append_bytes(mut ref mem, mut ref out, ref "}\n")
}

// Table inserts stay table-specific so the generated C never needs a generic metadata layer during bootstrap.
func append_table_insert_helper(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    mut ref types_table: types.Types,
    table_type: i64
): void = {
    val decl_id: i64 = types_table.decl_node[table_type]
    val row_type: i64 = types.type_table_row(
        mut ref types_table,
        types_table.module_id[table_type],
        decl_id,
        table_type
    )
    val table_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        table_type
    )
    val row_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        row_type
    )
    val helper_name: str = cexpr.table_helper_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        table_type,
        ref "__insert"
    )

    append_bytes(mut ref mem, mut ref out, ref "static void ")
    append_bytes(mut ref mem, mut ref out, ref helper_name)
    append_bytes(mut ref mem, mut ref out, ref "(")
    append_bytes(mut ref mem, mut ref out, ref table_name)
    append_bytes(mut ref mem, mut ref out, ref " *ni_table, ")
    append_bytes(mut ref mem, mut ref out, ref row_name)
    append_bytes(mut ref mem, mut ref out, ref " ni_row) {\n")

    mut field_id: i64 = nodes.first_child[decl_id]
    mut first_field_token: i64 = -1
    mut has_field: bool = false
    while (field_id >= 0 && !has_field) {
        if (nodes.kind[field_id] == node.NodeKind.FieldDecl) {
            first_field_token = nodes.data0[field_id]
            has_field = true
        }
        field_id = nodes.next_sibling[field_id]
    }

    if (has_field) {
        val first_field_name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, first_field_token)
        append_bytes(mut ref mem, mut ref out, ref "    if (ni_table->ni__len >= ni_table->ni_")
        append_bytes(mut ref mem, mut ref out, ref first_field_name)
        append_bytes(mut ref mem, mut ref out, ref ".len) {\n")
        append_bytes(mut ref mem, mut ref out, ref "        fprintf(stderr, \"Table capacity exceeded\\n\");\n")
        append_bytes(mut ref mem, mut ref out, ref "        exit(2);\n")
        append_bytes(mut ref mem, mut ref out, ref "    }\n")
    }

    field_id = nodes.first_child[decl_id]
    while (field_id >= 0) {
        if (nodes.kind[field_id] == node.NodeKind.FieldDecl) {
            val field_name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[field_id])
            append_bytes(mut ref mem, mut ref out, ref "    ni_table->ni_")
            append_bytes(mut ref mem, mut ref out, ref field_name)
            append_bytes(mut ref mem, mut ref out, ref ".data[ni_table->ni__len] = ni_row.ni_")
            append_bytes(mut ref mem, mut ref out, ref field_name)
            append_bytes(mut ref mem, mut ref out, ref ";\n")
        }
        field_id = nodes.next_sibling[field_id]
    }

    append_bytes(mut ref mem, mut ref out, ref "    ni_table->ni__len += 1L;\n")
    append_bytes(mut ref mem, mut ref out, ref "}\n")
}

// Per-table helpers only emit for builtin table operations actually used by the current module graph.
func table_helpers_dump(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    mut ref types_table: types.Types,
    ref table_helpers: [i64]
): [u8] = {
    mut out: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 512)
    mut wrote_any: bool = false
    mut type_id: i64 = 0
    while (type_id < table_helpers.len && type_id < table_len(ref types_table)) {
        val helper_flags: i64 = table_helpers[type_id]
        if (helper_flags != 0 &&
            types_table.kind[type_id] == types.TypeKind.TableType) {
            if (wrote_any) {
                append_bytes(mut ref mem, mut ref out, ref "\n")
            }
            mut wrote_table_helper: bool = false
            if (flag_has(helper_flags, TABLE_HELPER_ALLOC)) {
                append_table_alloc_helper(
                    mut ref mem,
                    mut ref out,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    ref nodes,
                    mut ref types_table,
                    type_id
                )
                wrote_table_helper = true
            }
            if (flag_has(helper_flags, TABLE_HELPER_GET)) {
                if (wrote_table_helper) {
                    append_bytes(mut ref mem, mut ref out, ref "\n")
                }
                append_table_get_helper(
                    mut ref mem,
                    mut ref out,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    ref nodes,
                    mut ref types_table,
                    type_id
                )
                wrote_table_helper = true
            }
            if (flag_has(helper_flags, TABLE_HELPER_INSERT)) {
                if (wrote_table_helper) {
                    append_bytes(mut ref mem, mut ref out, ref "\n")
                }
                append_table_insert_helper(
                    mut ref mem,
                    mut ref out,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    ref nodes,
                    mut ref types_table,
                    type_id
                )
            }
            wrote_any = true
        }
        type_id += 1
    }

    out.data[0..out.count]
}

// The helper body is tiny but centralizes the single-evaluation contract for open-ended sub-slices.
func append_slice_tail_helper(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref types_table: types.Types,
    source_type: i64,
    result_type: i64
): void = {
    val source_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        source_type
    )
    val result_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        result_type
    )
    val helper_name: str = cexpr.slice_tail_helper_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        source_type
    )

    append_bytes(mut ref mem, mut ref out, ref "static inline ")
    append_bytes(mut ref mem, mut ref out, ref result_name)
    append_bytes(mut ref mem, mut ref out, ref " ")
    append_bytes(mut ref mem, mut ref out, ref helper_name)
    append_bytes(mut ref mem, mut ref out, ref "(")
    append_bytes(mut ref mem, mut ref out, ref source_name)
    append_bytes(mut ref mem, mut ref out, ref " ni_value, int64_t ni_start) {\n")
    append_bytes(mut ref mem, mut ref out, ref "    return (")
    append_bytes(mut ref mem, mut ref out, ref result_name)
    append_bytes(mut ref mem, mut ref out, ref "){.data = ni_value.data + ni_start, .len = (ni_value.len - ni_start)};\n")
    append_bytes(mut ref mem, mut ref out, ref "}\n")
}

// Helper emission only scans the modules that will actually be lowered into the current C file.
func collect_slice_tail_helpers(
    ref nodes: node.Nodes,
    ref types_table: types.Types,
    node_id: i64,
    mut ref slice_helper_results: [i64],
    mut ref str_helper_source_type: i64,
    mut ref str_helper_result_type: i64
): void = {
    if (node_id < 0) {
        return
    }

    if (nodes.kind[node_id] == node.NodeKind.SliceExpr &&
        (nodes.data0[node_id] & cexpr.SLICE_FLAG_HAS_END) == 0) {
        val object_id: i64 = node.node_child_at(ref nodes, node_id, 0)
        val object_type: i64 = if (object_id >= 0) { nodes.type_id[object_id] } else { -1 }
        if (object_type >= 0 && types_table.kind[object_type] == types.TypeKind.SliceType) {
            if (object_type < slice_helper_results.len && slice_helper_results[object_type] < 0) {
                slice_helper_results[object_type] = nodes.type_id[node_id]
            }
        } else if (object_type >= 0 &&
                   types_table.kind[object_type] == types.TypeKind.StrType &&
                   str_helper_result_type < 0) {
            str_helper_source_type = object_type
            str_helper_result_type = nodes.type_id[node_id]
        }
    }

    mut child_id: i64 = nodes.first_child[node_id]
    while (child_id >= 0) {
        collect_slice_tail_helpers(
            ref nodes,
            ref types_table,
            child_id,
            mut ref slice_helper_results,
            mut ref str_helper_source_type,
            mut ref str_helper_result_type
        )
        child_id = nodes.next_sibling[child_id]
    }
}

// Open-ended slice helpers live beside typedefs/prototypes because they are generated support code.
func slice_helpers_dump(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref modules: loader.Modules,
    ref types_table: types.Types,
    ref module_range: span.Range
): [u8] = {
    mut slice_helper_results: [i64] = arena_alloc(mut ref mem, table_len(ref types_table))
    mut index: i64 = 0
    while (index < slice_helper_results.len) {
        slice_helper_results[index] = -1
        index += 1
    }

    mut str_helper_source_type: i64 = -1
    mut str_helper_result_type: i64 = -1
    mut module_id: i64 = module_range.start
    val end: i64 = span.range_end(ref module_range)
    while (module_id < end && module_id < table_len(ref modules)) {
        collect_slice_tail_helpers(
            ref nodes,
            ref types_table,
            modules.root_node[module_id],
            mut ref slice_helper_results,
            mut ref str_helper_source_type,
            mut ref str_helper_result_type
        )
        module_id += 1
    }

    mut out: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 256)
    mut wrote_any: bool = false
    index = 0
    while (index < slice_helper_results.len) {
        if (slice_helper_results[index] >= 0) {
            if (wrote_any) {
                append_bytes(mut ref mem, mut ref out, ref "\n")
            }
            append_slice_tail_helper(
                mut ref mem,
                mut ref out,
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref types_table,
                index,
                slice_helper_results[index]
            )
            wrote_any = true
        }
        index += 1
    }

    if (str_helper_result_type >= 0) {
        if (wrote_any) {
            append_bytes(mut ref mem, mut ref out, ref "\n")
        }
        append_slice_tail_helper(
            mut ref mem,
            mut ref out,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref types_table,
            str_helper_source_type,
            str_helper_result_type
        )
    }

    out.data[0..out.count]
}

// Value coercion helpers keep destination-type-aware reshapes single-evaluation in the generated C.
func append_value_coercion_helper(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref types_table: types.Types,
    source_type: i64,
    target_type: i64
): void = {
    val source_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        source_type
    )
    val target_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        target_type
    )
    val helper_name: str = cexpr.value_coercion_helper_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        source_type,
        target_type
    )

    val is_array_source: bool = types_table.kind[source_type] == types.TypeKind.ArrayType
    append_bytes(mut ref mem, mut ref out, ref "static inline ")
    append_bytes(mut ref mem, mut ref out, ref target_name)
    append_bytes(mut ref mem, mut ref out, ref " ")
    append_bytes(mut ref mem, mut ref out, ref helper_name)
    append_bytes(mut ref mem, mut ref out, ref "(")
    append_bytes(mut ref mem, mut ref out, ref source_name)
    if (is_array_source) {
        append_bytes(mut ref mem, mut ref out, ref " *ni_value) {\n")
        append_bytes(mut ref mem, mut ref out, ref "    return (")
        append_bytes(mut ref mem, mut ref out, ref target_name)
        append_bytes(mut ref mem, mut ref out, ref "){.data = ni_value->data, .len = ")
        append_i64(mut ref mem, mut ref out, types_table.data1[source_type])
        append_bytes(mut ref mem, mut ref out, ref "L};\n")
    } else {
        append_bytes(mut ref mem, mut ref out, ref " ni_value) {\n")
        append_bytes(mut ref mem, mut ref out, ref "    return (")
        append_bytes(mut ref mem, mut ref out, ref target_name)
        append_bytes(mut ref mem, mut ref out, ref "){.data = ni_value.data, .len = ni_value.len};\n")
    }
    append_bytes(mut ref mem, mut ref out, ref "}\n")
}

// Helper emission is cheap enough to derive from the checked type table instead of a second context-specific scan.
func value_coercion_helpers_dump(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref types_table: types.Types
): [u8] = {
    mut out: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 256)
    mut wrote_any: bool = false
    mut source_type: i64 = 0
    while (source_type < table_len(ref types_table)) {
        mut target_type: i64 = 0
        while (target_type < table_len(ref types_table)) {
            if (cexpr.value_coercion_supported(ref types_table, source_type, target_type)) {
                if (wrote_any) {
                    append_bytes(mut ref mem, mut ref out, ref "\n")
                }
                append_value_coercion_helper(
                    mut ref mem,
                    mut ref out,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    ref nodes,
                    ref types_table,
                    source_type,
                    target_type
                )
                wrote_any = true
            }
            target_type += 1
        }
        source_type += 1
    }

    out.data[0..out.count]
}

// Definitions still emit in module order, but now cover the broader statement/expression slice.
func function_definitions_dump(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref modules: loader.Modules,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    ref module_range: span.Range
): [u8] = {
    mut out: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 512)
    mut wrote_any: bool = false
    mut module_id: i64 = module_range.start
    val end: i64 = span.range_end(ref module_range)
    while (module_id < end && module_id < table_len(ref modules)) {
        val root_id: i64 = modules.root_node[module_id]
        mut decl_id: i64 = nodes.first_child[root_id]
        while (decl_id >= 0) {
            if (nodes.kind[decl_id] == node.NodeKind.FuncDecl) {
                if (wrote_any) {
                    append_bytes(mut ref mem, mut ref out, ref "\n")
                }
                cdecl.append_function_signature(
                    mut ref mem,
                    mut ref out,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    ref nodes,
                    ref symbols_table,
                    ref types_table,
                    module_id,
                    decl_id
                )
                append_bytes(mut ref mem, mut ref out, ref " ")
                cstmt.append_function_body(
                    mut ref mem,
                    mut ref out,
                    ref sources,
                    ref path_pool,
                    ref text_pool,
                    ref tokens,
                    ref nodes,
                    ref symbols_table,
                    ref types_table,
                    decl_id
                )
                wrote_any = true
            }
            decl_id = nodes.next_sibling[decl_id]
        }
        module_id += 1
    }

    out.data[0..out.count]
}

// Executable graphs keep the user-visible Nore main and add one C entry wrapper at the translation-unit boundary.
func root_main_decl_id(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref modules: loader.Modules,
    ref module_range: span.Range
): i64 = {
    if (module_range.count <= 0 || module_range.start >= table_len(ref modules)) {
        return -1
    }

    val root_id: i64 = modules.root_node[module_range.start]
    mut decl_id: i64 = nodes.first_child[root_id]
    while (decl_id >= 0) {
        if (nodes.kind[decl_id] == node.NodeKind.FuncDecl &&
            cexpr.token_name_is(ref sources, ref text_pool, ref tokens, nodes.data0[decl_id], ref "main")) {
            return decl_id
        }
        decl_id = nodes.next_sibling[decl_id]
    }
    -1
}

// The wrapper stays tiny: stash argc/argv when needed, call the root-module Nore main, then return zero to libc.
func entry_wrapper_dump(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref modules: loader.Modules,
    ref types_table: types.Types,
    ref module_range: span.Range,
    needs_args: bool
): [u8] = {
    mut out: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 128)
    val decl_id: i64 = root_main_decl_id(ref sources, ref text_pool, ref tokens, ref nodes, ref modules, ref module_range)
    if (decl_id < 0 ||
        nodes.data2[decl_id] != 0 ||
        nodes.type_id[decl_id] < 0 ||
        types_table.kind[nodes.type_id[decl_id]] != types.TypeKind.VoidType) {
        return out.data[0..out.count]
    }

    val main_name: str = cdecl.decl_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        module_range.start,
        nodes.data0[decl_id]
    )
    append_bytes(mut ref mem, mut ref out, ref "int main(")
    if (needs_args) {
        append_bytes(mut ref mem, mut ref out, ref "int argc, char **argv")
    } else {
        append_bytes(mut ref mem, mut ref out, ref "void")
    }
    append_bytes(mut ref mem, mut ref out, ref ") {\n")
    if (needs_args) {
        append_bytes(mut ref mem, mut ref out, ref "    ni_argc = argc;\n")
        append_bytes(mut ref mem, mut ref out, ref "    ni_argv = argv;\n")
    }
    append_bytes(mut ref mem, mut ref out, ref "    ")
    append_bytes(mut ref mem, mut ref out, ref main_name)
    append_bytes(mut ref mem, mut ref out, ref "();\n")
    append_bytes(mut ref mem, mut ref out, ref "    return 0;\n")
    append_bytes(mut ref mem, mut ref out, ref "}\n")
    out.data[0..out.count]
}

// The current whole-file dump now assembles prelude, typedefs, module globals, native/user prototypes, and the broader early body-emission slice.
pub func c_file_dump(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref modules: loader.Modules,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref type_range: span.Range,
    ref module_range: span.Range
): [u8] = {
    mut out: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 1024)
    mut table_helpers: [i64] = arena_alloc(mut ref mem, table_len(ref types_table))
    mut helper_id: i64 = 0
    while (helper_id < table_helpers.len) {
        table_helpers[helper_id] = 0
        helper_id += 1
    }
    mut needs_arena: bool = false
    mut needs_mem: bool = false
    mut needs_io: bool = false
    mut needs_exit: bool = false
    mut needs_args: bool = false
    mut needs_driver: bool = false
    mut module_id: i64 = module_range.start
    val module_end: i64 = span.range_end(ref module_range)
    while (module_id < module_end && module_id < table_len(ref modules)) {
        collect_runtime_usage(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            modules.root_node[module_id],
            mut ref table_helpers,
            mut ref needs_arena,
            mut ref needs_mem,
            mut ref needs_io,
            mut ref needs_exit,
            mut ref needs_args,
            mut ref needs_driver
        )
        module_id += 1
    }

    val prelude: [u8] = cruntime.runtime_prelude_dump(
        mut ref mem,
        needs_arena,
        needs_mem,
        needs_io,
        needs_args,
        needs_driver
    )
    append_section(mut ref mem, mut ref out, ref prelude)

    val type_defs: [u8] = ctypes.type_defs_dump(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        mut ref types_table,
        ref type_range
    )
    append_section(mut ref mem, mut ref out, ref type_defs)

    val runtime_helpers: [u8] = cruntime.runtime_helpers_dump(
        mut ref mem,
        needs_arena,
        needs_mem,
        needs_io,
        needs_exit,
        needs_args,
        needs_driver
    )

    val globals: [u8] = global_definitions_dump(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref modules,
        ref symbols_table,
        ref types_table,
        ref module_range
    )
    append_section(mut ref mem, mut ref out, ref globals)

    val native_prototypes: [u8] = cdecl.native_function_prototypes_dump(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref modules,
        ref symbols_table,
        ref types_table,
        ref module_range
    )
    append_section(mut ref mem, mut ref out, ref native_prototypes)

    append_section(mut ref mem, mut ref out, ref runtime_helpers)

    val table_helper_text: [u8] = table_helpers_dump(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        mut ref types_table,
        ref table_helpers
    )
    append_section(mut ref mem, mut ref out, ref table_helper_text)

    val helpers: [u8] = slice_helpers_dump(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref modules,
        ref types_table,
        ref module_range
    )
    append_section(mut ref mem, mut ref out, ref helpers)

    val coercion_helpers: [u8] = value_coercion_helpers_dump(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table
    )
    append_section(mut ref mem, mut ref out, ref coercion_helpers)

    val prototypes: [u8] = cdecl.function_prototypes_dump(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref modules,
        ref symbols_table,
        ref types_table,
        ref module_range
    )
    append_section(mut ref mem, mut ref out, ref prototypes)

    val definitions: [u8] = function_definitions_dump(
        mut ref mem,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref modules,
        ref symbols_table,
        ref types_table,
        ref module_range
    )
    append_section(mut ref mem, mut ref out, ref definitions)

    val entry_wrapper: [u8] = entry_wrapper_dump(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref modules,
        ref types_table,
        ref module_range,
        needs_args
    )
    append_section(mut ref mem, mut ref out, ref entry_wrapper)

    out.data[0..out.count]
}
