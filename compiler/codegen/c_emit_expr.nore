// Bootstrap compiler C expression emission.
// Responsibility: emit C for the broader checked expression subset used by early compiler modules.
// Owns: literals, array/constructor compound literals, operators, field/index/slice access, casts, and plain call emission.
// Does not own: statement/control-flow lowering, runtime helper bodies, or whole-file orchestration.

import bbuf "../support/byte_buf.nore"
import cdecl "c_emit_decl.nore"
import ctypes "c_types.nore"
import node "../frontend/node.nore"
import source "../support/source.nore"
import symbols "../sema/symbols.nore"
import token "../frontend/token.nore"
import types "../sema/types.nore"
import string "std/string.nore"

pub val SLICE_FLAG_HAS_START: i64 = 64
pub val SLICE_FLAG_HAS_END: i64 = 128
val CEXPR_BUILTIN_CALL_NONE: i64 = 0
val CEXPR_BUILTIN_CALL_ARENA: i64 = 1
val CEXPR_BUILTIN_CALL_ARENA_ALLOC: i64 = 2
val CEXPR_BUILTIN_CALL_ARENA_RESET: i64 = 3
val CEXPR_BUILTIN_CALL_TABLE_ALLOC: i64 = 4
val CEXPR_BUILTIN_CALL_TABLE_LEN: i64 = 5
val CEXPR_BUILTIN_CALL_TABLE_GET: i64 = 6
val CEXPR_BUILTIN_CALL_TABLE_INSERT: i64 = 7
val CEXPR_CHECK_NODE_FLAG_MUT: i64 = 1
val CEXPR_CHECK_NODE_FLAG_REF: i64 = 4
val CODEGEN_SYNTHETIC_TOKEN_OS: i64 = -2
val CODEGEN_SYNTHETIC_TOKEN_TARGET_OS: i64 = -3
val CODEGEN_SYNTHETIC_TOKEN_LINUX: i64 = -4
val CODEGEN_SYNTHETIC_TOKEN_MACOS: i64 = -5

func append_bytes(mut ref mem: Arena, mut ref out: bbuf.ByteBuf, ref data: [u8]): void = {
    bbuf.byte_buf_append(mut ref mem, mut ref out, ref data)
}

// Parser and codegen share a few tiny node-flag checks for slice children.
func flag_has(flags: i64, bit: i64): bool = {
    (flags & bit) != 0
}

// Integer fragments stay centralized so enum tags and string lengths render consistently.
func append_i64(mut ref mem: Arena, mut ref out: bbuf.ByteBuf, n: i64): void = {
    val text: str = string.i64_to_str(mut ref mem, n)
    append_bytes(mut ref mem, mut ref out, ref text)
}

value ExprLineCol {
    line: i64,
    col: i64
}

// Runtime-check diagnostics use source offsets directly so expression lowering stays independent of line maps.
func expr_line_col(ref sources: source.Sources, ref text_pool: bbuf.ByteBuf, source_id: i64, offset: i64): ExprLineCol = {
    val text: [u8] = source.source_text(ref text_pool, ref sources, source_id)
    mut clamped: i64 = offset
    if (clamped < 0) {
        clamped = 0
    }
    if (clamped > text.len) {
        clamped = text.len
    }

    mut line: i64 = 1
    mut col: i64 = 1
    mut i: i64 = 0
    while (i < clamped) {
        if (text[i] == '\n') {
            line += 1
            col = 1
        } else {
            col += 1
        }
        i += 1
    }

    ExprLineCol { line: line, col: col }
}

// Runtime helpers receive ordinary C string literals, so generated paths must be escaped once here.
func append_c_string_literal(mut ref mem: Arena, mut ref out: bbuf.ByteBuf, ref text: [u8]): void = {
    append_bytes(mut ref mem, mut ref out, ref "\"")
    mut i: i64 = 0
    while (i < text.len) {
        val ch: u8 = text[i]
        if (ch == '\\') {
            append_bytes(mut ref mem, mut ref out, ref "\\\\")
        } else if (ch == '"') {
            append_bytes(mut ref mem, mut ref out, ref "\\\"")
        } else if (ch == '\n') {
            append_bytes(mut ref mem, mut ref out, ref "\\n")
        } else if (ch == '\r') {
            append_bytes(mut ref mem, mut ref out, ref "\\r")
        } else if (ch == '\t') {
            append_bytes(mut ref mem, mut ref out, ref "\\t")
        } else {
            bbuf.byte_buf_push(mut ref mem, mut ref out, ch)
        }
        i += 1
    }
    append_bytes(mut ref mem, mut ref out, ref "\"")
}

// Bounds checks embed the Nore source location that should appear in runtime diagnostics.
func append_location_args(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref nodes: node.Nodes,
    node_id: i64
): void = {
    val loc: ExprLineCol = expr_line_col(ref sources, ref text_pool, nodes.source_id[node_id], nodes.start[node_id])
    val display_path: [u8] = source.source_display_path(ref path_pool, ref sources, nodes.source_id[node_id])
    append_c_string_literal(mut ref mem, mut ref out, ref display_path)
    append_bytes(mut ref mem, mut ref out, ref ", ")
    append_i64(mut ref mem, mut ref out, loc.line)
    append_bytes(mut ref mem, mut ref out, ref "UL, ")
    append_i64(mut ref mem, mut ref out, loc.col)
    append_bytes(mut ref mem, mut ref out, ref "UL")
}

// The bootstrap type table keeps builtin rows small, so a linear u8 lookup stays cheap and local.
func u8_type_id(ref types_table: types.Types): i64 = {
    mut type_id: i64 = 0
    while (type_id < table_len(ref types_table)) {
        if (types_table.kind[type_id] == types.TypeKind.U8Type) {
            return type_id
        }
        type_id += 1
    }
    -1
}

// Byte-view coercions intentionally treat str, [u8], and [u8; N] as the same underlying data+len view.
pub func type_is_byte_view(ref types_table: types.Types, type_id: i64): bool = {
    if (type_id < 0) {
        return false
    }

    if (types_table.kind[type_id] == types.TypeKind.StrType) {
        return true
    }

    val byte_type: i64 = u8_type_id(ref types_table)
    if (byte_type < 0) {
        return false
    }

    if ((types_table.kind[type_id] == types.TypeKind.SliceType ||
         types_table.kind[type_id] == types.TypeKind.ArrayType) &&
        types_table.data0[type_id] == byte_type) {
        return true
    }

    false
}

// Value coercions only cover the sema-approved view reshapes that do not need element conversion code.
pub func value_coercion_supported(
    ref types_table: types.Types,
    source_type: i64,
    target_type: i64
): bool = {
    if (source_type < 0 || target_type < 0 || source_type == target_type) {
        return false
    }

    if (types_table.kind[target_type] == types.TypeKind.SliceType &&
        types_table.kind[source_type] == types.TypeKind.ArrayType &&
        types_table.data0[target_type] == types_table.data0[source_type]) {
        return true
    }

    if ((types_table.kind[target_type] == types.TypeKind.StrType ||
         (types_table.kind[target_type] == types.TypeKind.SliceType &&
          type_is_byte_view(ref types_table, target_type))) &&
        type_is_byte_view(ref types_table, source_type)) {
        return true
    }

    false
}

// str and [u8] share the same lowered `{data,len}` header, so ref coercions can preserve aliasing with a cast.
func value_coercion_uses_pointer_cast(
    ref types_table: types.Types,
    source_type: i64,
    target_type: i64
): bool = {
    if (!value_coercion_supported(ref types_table, source_type, target_type)) {
        return false
    }

    source_type >= 0 &&
    target_type >= 0 &&
    source_type != target_type &&
    type_is_byte_view(ref types_table, source_type) &&
    type_is_byte_view(ref types_table, target_type) &&
    types_table.kind[source_type] != types.TypeKind.ArrayType &&
    types_table.kind[target_type] != types.TypeKind.ArrayType
}

// Helper names stay type-pair-specific so value coercions evaluate the source expression only once.
pub func value_coercion_helper_name(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref types_table: types.Types,
    source_type: i64,
    target_type: i64
): str = {
    val source_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        source_type
    )
    val target_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        target_type
    )
    val prefix: str = string.str_concat3(mut ref mem, ref "ni_coerce__", ref target_name, ref "__from__")
    string.str_concat(mut ref mem, ref prefix, ref source_name)
}

// Parameter declarations reuse sema's ref flag layout in nodes.data1.
func decl_is_ref(ref nodes: node.Nodes, param_id: i64): bool = {
    param_id >= 0 && (nodes.data1[param_id] & CEXPR_CHECK_NODE_FLAG_REF) != 0
}

// Builtin names still dispatch by source spelling until sema grows dedicated call rows.
pub func token_name_is(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    token_id: i64,
    ref wanted: [u8]
): bool = {
    if (token_id < 0) {
        return false
    }
    val token_text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, token_id)
    string.str_eq(ref token_text, ref wanted)
}

// Keep the builtin dispatch table aligned with sema without coupling codegen to sema internals.
func builtin_call_kind(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    token_id: i64
): i64 = {
    if (token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "arena")) {
        return CEXPR_BUILTIN_CALL_ARENA
    }
    if (token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "arena_alloc")) {
        return CEXPR_BUILTIN_CALL_ARENA_ALLOC
    }
    if (token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "arena_reset")) {
        return CEXPR_BUILTIN_CALL_ARENA_RESET
    }
    if (token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "table_alloc")) {
        return CEXPR_BUILTIN_CALL_TABLE_ALLOC
    }
    if (token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "table_len")) {
        return CEXPR_BUILTIN_CALL_TABLE_LEN
    }
    if (token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "table_get")) {
        return CEXPR_BUILTIN_CALL_TABLE_GET
    }
    if (token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "table_insert")) {
        return CEXPR_BUILTIN_CALL_TABLE_INSERT
    }
    CEXPR_BUILTIN_CALL_NONE
}

// Builtin lowering only applies when sema left the callee unresolved, so module-local shadowing stays a normal call.
func resolved_builtin_call_kind(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    callee_id: i64
): i64 = {
    if (callee_id < 0 ||
        nodes.kind[callee_id] != node.NodeKind.Identifier ||
        nodes.symbol_id[callee_id] >= 0) {
        return CEXPR_BUILTIN_CALL_NONE
    }
    builtin_call_kind(ref sources, ref text_pool, ref tokens, nodes.data0[callee_id])
}

// Compiler-injected names do not live in the token table, so codegen keeps the same synthetic spellings as sema.
func token_text_or_synthetic(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    token_id: i64
): [u8] = {
    if (token_id == CODEGEN_SYNTHETIC_TOKEN_OS) {
        return "OS"
    }
    if (token_id == CODEGEN_SYNTHETIC_TOKEN_TARGET_OS) {
        return "TARGET_OS"
    }
    if (token_id == CODEGEN_SYNTHETIC_TOKEN_LINUX) {
        return "Linux"
    }
    if (token_id == CODEGEN_SYNTHETIC_TOKEN_MACOS) {
        return "MacOS"
    }
    token.token_text(ref sources, ref text_pool, ref tokens, token_id)
}

// Generated C keeps TARGET_OS as a preprocessor constant so static initializers remain valid C.
func symbol_is_target_os_builtin(ref symbols_table: symbols.Symbols, symbol_id: i64): bool = {
    symbol_id >= 0 &&
    symbols_table.kind[symbol_id] == symbols.SymbolKind.GlobalSymbol &&
    symbols_table.decl_node[symbol_id] < 0 &&
    symbols_table.name_token[symbol_id] == CODEGEN_SYNTHETIC_TOKEN_TARGET_OS
}

// Local identifiers keep the short ni_ prefix because their scope stays inside one function.
pub func append_local_name(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    name_token: i64
): void = {
    append_bytes(mut ref mem, mut ref out, ref "ni_")
    val name_text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, name_token)
    append_bytes(mut ref mem, mut ref out, ref name_text)
}

// Expression lowering needs the undereferenced storage spelling for ref arguments and field bases.
func append_symbol_storage_name(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref symbols_table: symbols.Symbols,
    symbol_id: i64
): void = {
    if (symbol_id < 0) {
        return
    }

    val kind: symbols.SymbolKind = symbols_table.kind[symbol_id]
    if (symbol_is_target_os_builtin(ref symbols_table, symbol_id)) {
        append_bytes(mut ref mem, mut ref out, ref "NI_TARGET_OS")
        return
    }
    if (kind == symbols.SymbolKind.LocalSymbol ||
        kind == symbols.SymbolKind.ParamSymbol) {
        append_local_name(
            mut ref mem,
            mut ref out,
            ref sources,
            ref text_pool,
            ref tokens,
            symbols_table.name_token[symbol_id]
        )
        return
    }

    if (kind == symbols.SymbolKind.GlobalSymbol) {
        val name_text: str = cdecl.decl_name(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            symbols_table.module_id[symbol_id],
            symbols_table.name_token[symbol_id]
        )
        append_bytes(mut ref mem, mut ref out, ref name_text)
        return
    }

    if (kind == symbols.SymbolKind.FunctionSymbol) {
        if (symbols.symbol_is_native(ref symbols_table, symbol_id)) {
            append_local_name(
                mut ref mem,
                mut ref out,
                ref sources,
                ref text_pool,
                ref tokens,
                symbols_table.name_token[symbol_id]
            )
        } else {
            val name_text: str = cdecl.decl_name(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                symbols_table.module_id[symbol_id],
                symbols_table.name_token[symbol_id]
            )
            append_bytes(mut ref mem, mut ref out, ref name_text)
        }
    }
}

// Plain identifiers need one shared ref-aware spelling so value and call emission stay aligned.
func append_identifier_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    node_id: i64
): void = {
    val symbol_id: i64 = nodes.symbol_id[node_id]
    if (symbol_id < 0) {
        append_local_name(
            mut ref mem,
            mut ref out,
            ref sources,
            ref text_pool,
            ref tokens,
            nodes.data0[node_id]
        )
        return
    }

    if (symbols_table.kind[symbol_id] == symbols.SymbolKind.ParamSymbol &&
        symbols.symbol_is_ref(ref symbols_table, symbol_id)) {
        append_bytes(mut ref mem, mut ref out, ref "(*")
        append_symbol_storage_name(
            mut ref mem,
            mut ref out,
            ref sources,
            ref text_pool,
            ref tokens,
            ref symbols_table,
            symbol_id
        )
        append_bytes(mut ref mem, mut ref out, ref ")")
        return
    }

    append_symbol_storage_name(
        mut ref mem,
        mut ref out,
        ref sources,
        ref text_pool,
        ref tokens,
        ref symbols_table,
        symbol_id
    )
}

// Ref parameters use pointer syntax when they become field-access bases.
func expr_uses_arrow(ref nodes: node.Nodes, ref symbols_table: symbols.Symbols, node_id: i64): bool = {
    if (node_id < 0 ||
        nodes.kind[node_id] != node.NodeKind.Identifier ||
        nodes.symbol_id[node_id] < 0) {
        return false
    }

    val symbol_id: i64 = nodes.symbol_id[node_id]
    symbols_table.kind[symbol_id] == symbols.SymbolKind.ParamSymbol &&
    symbols.symbol_is_ref(ref symbols_table, symbol_id)
}

// Slice/string len keeps the raw C field name while record/table fields stay ni_-prefixed.
func field_is_len(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    field_token: i64
): bool = {
    val field_name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, field_token)
    string.str_eq(ref field_name, ref "len")
}

// Field access suffix shared by place-expr and value-expr paths so the arrow/dot logic stays in one place.
func append_field_suffix(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    use_arrow: bool,
    is_len: bool,
    ref field_text: [u8]
): void = {
    if (is_len) {
        if (use_arrow) {
            append_bytes(mut ref mem, mut ref out, ref "->len")
        } else {
            append_bytes(mut ref mem, mut ref out, ref ".len")
        }
    } else {
        if (use_arrow) {
            append_bytes(mut ref mem, mut ref out, ref "->ni_")
        } else {
            append_bytes(mut ref mem, mut ref out, ref ".ni_")
        }
        append_bytes(mut ref mem, mut ref out, ref field_text)
    }
}

// Enum-variant access only applies when the left side resolved to a type symbol, never a value expression.
func expr_is_type_path(ref nodes: node.Nodes, ref symbols_table: symbols.Symbols, node_id: i64): bool = {
    node_id >= 0 &&
    nodes.symbol_id[node_id] >= 0 &&
    symbols_table.kind[nodes.symbol_id[node_id]] == symbols.SymbolKind.TypeSymbol
}

// Type-qualified field access is the only sema-valid surface form for enum variants.
func field_access_enum_type(
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    field_access_id: i64
): i64 = {
    if (field_access_id < 0 || nodes.kind[field_access_id] != node.NodeKind.FieldAccess) {
        return types.invalid_type_id()
    }

    val left_id: i64 = node.node_child_at(ref nodes, field_access_id, 0)
    if (!expr_is_type_path(ref nodes, ref symbols_table, left_id) ||
        nodes.type_id[left_id] < 0 ||
        types_table.kind[nodes.type_id[left_id]] != types.TypeKind.EnumType) {
        return types.invalid_type_id()
    }

    nodes.type_id[left_id]
}

// Bootstrap enums are small enough that a linear variant lookup keeps the emitter simple.
func enum_find_variant(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref types_table: types.Types,
    enum_type: i64,
    variant_token: i64
): i64 = {
    if (enum_type < 0 || types_table.kind[enum_type] != types.TypeKind.EnumType) {
        return node.invalid_node_id()
    }

    val wanted_name: [u8] = token_text_or_synthetic(ref sources, ref text_pool, ref tokens, variant_token)
    val enum_decl: i64 = types_table.decl_node[enum_type]
    mut variant_id: i64 = nodes.first_child[enum_decl]
    while (variant_id >= 0) {
        if (nodes.kind[variant_id] == node.NodeKind.VariantDecl) {
            val variant_name: [u8] = token_text_or_synthetic(ref sources, ref text_pool, ref tokens, nodes.data0[variant_id])
            if (string.str_eq(ref variant_name, ref wanted_name)) {
                return variant_id
            }
        }
        variant_id = nodes.next_sibling[variant_id]
    }
    node.invalid_node_id()
}

// Tags follow source-order enum variant numbering so C and sema stay aligned.
pub func enum_variant_tag(ref nodes: node.Nodes, ref types_table: types.Types, enum_type: i64, wanted_variant: i64): i64 = {
    if (enum_type < 0 || types_table.kind[enum_type] != types.TypeKind.EnumType) {
        return -1
    }

    val enum_decl: i64 = types_table.decl_node[enum_type]
    mut tag: i64 = 0
    mut variant_id: i64 = nodes.first_child[enum_decl]
    while (variant_id >= 0) {
        if (nodes.kind[variant_id] == node.NodeKind.VariantDecl) {
            if (variant_id == wanted_variant) {
                return tag
            }
            tag = tag + 1
        }
        variant_id = nodes.next_sibling[variant_id]
    }
    -1
}

// Tagged-enum detection mirrors the typedef emitter so value lowering matches the C layout.
pub func enum_has_payload_variant(ref nodes: node.Nodes, ref types_table: types.Types, enum_type: i64): bool = {
    if (enum_type < 0 || types_table.kind[enum_type] != types.TypeKind.EnumType) {
        return false
    }

    val enum_decl: i64 = types_table.decl_node[enum_type]
    mut variant_id: i64 = nodes.first_child[enum_decl]
    while (variant_id >= 0) {
        if (nodes.kind[variant_id] == node.NodeKind.VariantDecl && nodes.type_id[variant_id] >= 0) {
            return true
        }
        variant_id = nodes.next_sibling[variant_id]
    }
    false
}

// C enum tags are always emitted as int64_t literals to match the typedefs.
func append_enum_tag(mut ref mem: Arena, mut ref out: bbuf.ByteBuf, tag: i64): void = {
    append_i64(mut ref mem, mut ref out, tag)
    append_bytes(mut ref mem, mut ref out, ref "L")
}

// String refs need the post-unescape byte length even though the raw token keeps source escapes.
func string_literal_len(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    token_id: i64
): i64 = {
    val payload: [u8] = token.token_payload_text(ref sources, ref text_pool, ref tokens, token_id)
    mut count: i64 = 0
    mut i: i64 = 0
    while (i < payload.len) {
        if (payload[i] == '\\' && i + 1 < payload.len) {
            i = i + 2
        } else {
            i = i + 1
        }
        count = count + 1
    }
    count
}

// Strings lower to the shared ni_str value shape so both value and ref calls can reuse one path.
func append_string_lit_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    node_id: i64
): void = {
    val token_id: i64 = nodes.data0[node_id]
    val literal_text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, token_id)
    append_bytes(mut ref mem, mut ref out, ref "(ni_str){.data = (uint8_t *)")
    append_bytes(mut ref mem, mut ref out, ref literal_text)
    append_bytes(mut ref mem, mut ref out, ref ", .len = ")
    append_i64(mut ref mem, mut ref out, string_literal_len(ref sources, ref text_pool, ref tokens, token_id))
    append_bytes(mut ref mem, mut ref out, ref "L}")
}

// Postfix array/slice lowering needs the stable data pointer for any array-like value.
func append_array_like_data_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    object_id: i64
): void = {
    append_bytes(mut ref mem, mut ref out, ref "(")
    append_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        object_id
    )
    append_bytes(mut ref mem, mut ref out, ref ").data")
}

// Slice lengths come either from the source type or from the stored runtime len field.
func append_array_like_len_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    object_id: i64
): void = {
    val object_type: i64 = nodes.type_id[object_id]
    if (object_type >= 0 && types_table.kind[object_type] == types.TypeKind.ArrayType) {
        append_i64(mut ref mem, mut ref out, types_table.data1[object_type])
        append_bytes(mut ref mem, mut ref out, ref "L")
        return
    }

    append_bytes(mut ref mem, mut ref out, ref "(")
    append_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        object_id
    )
    append_bytes(mut ref mem, mut ref out, ref ").len")
}

// Slice child order is object first, then optional start/end bounds in source order.
func slice_start_id(ref nodes: node.Nodes, slice_id: i64): i64 = {
    if (!flag_has(nodes.data0[slice_id], SLICE_FLAG_HAS_START)) {
        return node.invalid_node_id()
    }
    node.node_child_at(ref nodes, slice_id, 1)
}

// End bounds shift left when the start bound is absent.
func slice_end_id(ref nodes: node.Nodes, slice_id: i64): i64 = {
    if (!flag_has(nodes.data0[slice_id], SLICE_FLAG_HAS_END)) {
        return node.invalid_node_id()
    }
    if (flag_has(nodes.data0[slice_id], SLICE_FLAG_HAS_START)) {
        return node.node_child_at(ref nodes, slice_id, 2)
    }
    node.node_child_at(ref nodes, slice_id, 1)
}

// Open-ended sub-slices over slices/strings use one helper call so the base expression runs once.
pub func slice_tail_helper_name(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref types_table: types.Types,
    object_type: i64
): str = {
    if (object_type >= 0 && types_table.kind[object_type] == types.TypeKind.StrType) {
        return "ni_str_tail"
    }

    val object_type_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        object_type
    )
    string.str_concat(mut ref mem, ref object_type_name, ref "_tail")
}

// Slice and string index helpers return an element pointer from one evaluated source value.
pub func index_helper_name(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref types_table: types.Types,
    object_type: i64
): str = {
    if (object_type >= 0 && types_table.kind[object_type] == types.TypeKind.StrType) {
        return "ni_str_at"
    }

    val object_type_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        object_type
    )
    string.str_concat(mut ref mem, ref object_type_name, ref "_at")
}

// Closed-range helpers keep source/start/end single-evaluated before checking and building the view.
pub func slice_range_helper_name(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref types_table: types.Types,
    object_type: i64
): str = {
    if (object_type >= 0 && types_table.kind[object_type] == types.TypeKind.StrType) {
        return "ni_str_slice"
    }

    val object_type_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        object_type
    )
    string.str_concat(mut ref mem, ref object_type_name, ref "_slice")
}

// The helper call keeps both `.data` and `.len` derived from the same already-evaluated source value.
func append_open_ended_slice_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    object_id: i64,
    slice_id: i64,
    start_id: i64
): void = {
    val helper_name: str = slice_tail_helper_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        nodes.type_id[object_id]
    )
    append_bytes(mut ref mem, mut ref out, ref helper_name)
    append_bytes(mut ref mem, mut ref out, ref "(")
    append_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        object_id
    )
    append_bytes(mut ref mem, mut ref out, ref ", ")
    if (start_id >= 0) {
        append_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            start_id
        )
    } else {
        append_bytes(mut ref mem, mut ref out, ref "0L")
    }
    append_bytes(mut ref mem, mut ref out, ref ", ")
    append_location_args(mut ref mem, mut ref out, ref sources, ref path_pool, ref text_pool, ref nodes, slice_id)
    append_bytes(mut ref mem, mut ref out, ref ")")
}

// Indexed slice/string values route through helpers so `.data` and `.len` share one source evaluation.
func append_checked_index_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    node_id: i64
): void = {
    val object_id: i64 = node.node_child_at(ref nodes, node_id, 0)
    val index_id: i64 = node.node_child_at(ref nodes, node_id, 1)
    val object_type: i64 = nodes.type_id[object_id]
    if (object_type >= 0 &&
        (types_table.kind[object_type] == types.TypeKind.SliceType ||
         types_table.kind[object_type] == types.TypeKind.StrType)) {
        val helper_name: str = index_helper_name(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref types_table,
            object_type
        )
        append_bytes(mut ref mem, mut ref out, ref "(*")
        append_bytes(mut ref mem, mut ref out, ref helper_name)
        append_bytes(mut ref mem, mut ref out, ref "(")
        append_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            object_id
        )
        append_bytes(mut ref mem, mut ref out, ref ", ")
        append_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            index_id
        )
        append_bytes(mut ref mem, mut ref out, ref ", ")
        append_location_args(mut ref mem, mut ref out, ref sources, ref path_pool, ref text_pool, ref nodes, node_id)
        append_bytes(mut ref mem, mut ref out, ref "))")
        return
    }

    append_bytes(mut ref mem, mut ref out, ref "(")
    append_array_like_data_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        object_id
    )
    append_bytes(mut ref mem, mut ref out, ref "[ni_checked_index(")
    append_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        index_id
    )
    append_bytes(mut ref mem, mut ref out, ref ", ")
    append_array_like_len_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        object_id
    )
    append_bytes(mut ref mem, mut ref out, ref ", ")
    append_location_args(mut ref mem, mut ref out, ref sources, ref path_pool, ref text_pool, ref nodes, node_id)
    append_bytes(mut ref mem, mut ref out, ref ")])")
}

// Addressable expressions share one lvalue-like spelling path for ref arguments.
func append_place_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    node_id: i64
): void = {
    val kind: node.NodeKind = nodes.kind[node_id]
    if (kind == node.NodeKind.Identifier) {
        val symbol_id: i64 = nodes.symbol_id[node_id]
        if (symbol_id >= 0) {
            append_symbol_storage_name(
                mut ref mem,
                mut ref out,
                ref sources,
                ref text_pool,
                ref tokens,
                ref symbols_table,
                symbol_id
            )
        } else {
            append_local_name(
                mut ref mem,
                mut ref out,
                ref sources,
                ref text_pool,
                ref tokens,
                nodes.data0[node_id]
            )
        }
        return
    }

    if (kind == node.NodeKind.FieldAccess) {
        val left_id: i64 = node.node_child_at(ref nodes, node_id, 0)
        val left_type: i64 = if (left_id >= 0) { nodes.type_id[left_id] } else { -1 }
        val is_len: bool = field_is_len(ref sources, ref text_pool, ref tokens, nodes.data0[node_id]) &&
            left_type >= 0 &&
            (types_table.kind[left_type] == types.TypeKind.SliceType ||
             types_table.kind[left_type] == types.TypeKind.StrType)
        val field_text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[node_id])
        val use_arrow: bool = expr_uses_arrow(ref nodes, ref symbols_table, left_id)

        if (use_arrow) {
            append_symbol_storage_name(
                mut ref mem,
                mut ref out,
                ref sources,
                ref text_pool,
                ref tokens,
                ref symbols_table,
                nodes.symbol_id[left_id]
            )
        } else {
            append_place_expr(
                mut ref mem,
                mut ref out,
                ref sources,
                ref path_pool,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref symbols_table,
                ref types_table,
                left_id
            )
        }
        append_field_suffix(mut ref mem, mut ref out, use_arrow, is_len, ref field_text)
        return
    }

    if (kind == node.NodeKind.IndexExpr) {
        append_checked_index_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node_id
        )
        return
    }

    assert false
}

// View literals keep array-to-slice/str reshapes explicit at the call site without inventing hidden locals.
func append_view_literal_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    target_type: i64,
    value_id: i64
): void = {
    val type_text: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        target_type
    )
    append_bytes(mut ref mem, mut ref out, ref "(")
    append_bytes(mut ref mem, mut ref out, ref type_text)
    append_bytes(mut ref mem, mut ref out, ref "){.data = ")
    append_array_like_data_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        value_id
    )
    append_bytes(mut ref mem, mut ref out, ref ", .len = ")
    append_array_like_len_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        value_id
    )
    append_bytes(mut ref mem, mut ref out, ref "}")
}

// Array-source view coercions must preserve the original array storage whenever the source is addressable.
func append_array_value_pointer(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    node_id: i64
): void = {
    val actual_type: i64 = nodes.type_id[node_id]
    if (actual_type < 0) {
        return
    }

    if (nodes.kind[node_id] == node.NodeKind.Identifier &&
        nodes.symbol_id[node_id] >= 0 &&
        symbols_table.kind[nodes.symbol_id[node_id]] == symbols.SymbolKind.ParamSymbol &&
        symbols.symbol_is_ref(ref symbols_table, nodes.symbol_id[node_id])) {
        append_symbol_storage_name(
            mut ref mem,
            mut ref out,
            ref sources,
            ref text_pool,
            ref tokens,
            ref symbols_table,
            nodes.symbol_id[node_id]
        )
        return
    }

    if (nodes.kind[node_id] == node.NodeKind.Identifier ||
        nodes.kind[node_id] == node.NodeKind.FieldAccess) {
        append_bytes(mut ref mem, mut ref out, ref "&")
        append_place_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node_id
        )
        return
    }

    val type_text: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        actual_type
    )
    append_bytes(mut ref mem, mut ref out, ref "&(((")
    append_bytes(mut ref mem, mut ref out, ref type_text)
    append_bytes(mut ref mem, mut ref out, ref "[]){")
    append_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        node_id
    )
    append_bytes(mut ref mem, mut ref out, ref "})[0])")
}

// Range helpers preserve one evaluation of the source object and both range bounds.
func append_slice_range_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    node_id: i64,
    object_id: i64,
    start_id: i64,
    end_id: i64
): void = {
    val object_type: i64 = nodes.type_id[object_id]
    val helper_name: str = slice_range_helper_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        object_type
    )
    append_bytes(mut ref mem, mut ref out, ref helper_name)
    append_bytes(mut ref mem, mut ref out, ref "(")
    if (object_type >= 0 && types_table.kind[object_type] == types.TypeKind.ArrayType) {
        append_array_value_pointer(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            object_id
        )
    } else {
        append_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            object_id
        )
    }
    append_bytes(mut ref mem, mut ref out, ref ", ")
    if (start_id >= 0) {
        append_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            start_id
        )
    } else {
        append_bytes(mut ref mem, mut ref out, ref "0L")
    }
    append_bytes(mut ref mem, mut ref out, ref ", ")
    if (end_id >= 0) {
        append_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            end_id
        )
    } else {
        append_array_like_len_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            object_id
        )
    }
    append_bytes(mut ref mem, mut ref out, ref ", ")
    append_location_args(mut ref mem, mut ref out, ref sources, ref path_pool, ref text_pool, ref nodes, node_id)
    append_bytes(mut ref mem, mut ref out, ref ")")
}

// Value coercions call one generated helper so the source expression only runs once.
pub func append_expr_as_type(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    expected_type: i64,
    node_id: i64
): void = {
    if (node_id < 0) {
        return
    }

    val actual_type: i64 = nodes.type_id[node_id]
    if (value_coercion_supported(ref types_table, actual_type, expected_type)) {
        val helper_name: str = value_coercion_helper_name(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref types_table,
            actual_type,
            expected_type
        )
        append_bytes(mut ref mem, mut ref out, ref helper_name)
        append_bytes(mut ref mem, mut ref out, ref "(")
        if (actual_type >= 0 && types_table.kind[actual_type] == types.TypeKind.ArrayType) {
            append_array_value_pointer(
                mut ref mem,
                mut ref out,
                ref sources,
                ref path_pool,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref symbols_table,
                ref types_table,
                node_id
            )
        } else {
            append_expr(
                mut ref mem,
                mut ref out,
                ref sources,
                ref path_pool,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref symbols_table,
                ref types_table,
                node_id
            )
        }
        append_bytes(mut ref mem, mut ref out, ref ")")
        return
    }

    append_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        node_id
    )
}

// Ref arguments lower to pointers, reusing an existing pointer when the source is already a ref binding.
func append_ref_source_pointer(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    ref_expr_id: i64
): void = {
    val value_id: i64 = node.node_child_at(ref nodes, ref_expr_id, 0)
    if (value_id >= 0 &&
        nodes.kind[value_id] == node.NodeKind.Identifier &&
        nodes.symbol_id[value_id] >= 0 &&
        symbols_table.kind[nodes.symbol_id[value_id]] == symbols.SymbolKind.ParamSymbol &&
        symbols.symbol_is_ref(ref symbols_table, nodes.symbol_id[value_id])) {
        append_symbol_storage_name(
            mut ref mem,
            mut ref out,
            ref sources,
            ref text_pool,
            ref tokens,
            ref symbols_table,
            nodes.symbol_id[value_id]
        )
        return
    }

    // Rvalue ref args (literals, slices, injected constants) need a compound-literal temporary for addressability.
    val is_rvalue_ref: bool = value_id >= 0 &&
        (nodes.kind[value_id] == node.NodeKind.StringLit ||
         nodes.kind[value_id] == node.NodeKind.SliceExpr ||
         (nodes.kind[value_id] == node.NodeKind.Identifier &&
          nodes.symbol_id[value_id] >= 0 &&
          symbol_is_target_os_builtin(ref symbols_table, nodes.symbol_id[value_id])))
    if (is_rvalue_ref) {
        val type_text: str = ctypes.type_name(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref types_table,
            nodes.type_id[value_id]
        )
        append_bytes(mut ref mem, mut ref out, ref "&(((")
        append_bytes(mut ref mem, mut ref out, ref type_text)
        append_bytes(mut ref mem, mut ref out, ref "[]){")
        append_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            value_id
        )
        append_bytes(mut ref mem, mut ref out, ref "})[0])")
        return
    }

    append_bytes(mut ref mem, mut ref out, ref "&")
    append_place_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        value_id
    )
}

// Ref arguments may need a pointer-preserving cast or a temporary view object when sema accepted a coercion.
func append_ref_arg_expr_as_type(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    expected_type: i64,
    ref_expr_id: i64
): void = {
    val value_id: i64 = node.node_child_at(ref nodes, ref_expr_id, 0)
    val actual_type: i64 = if (value_id >= 0) { nodes.type_id[value_id] } else { -1 }
    if (value_coercion_supported(ref types_table, actual_type, expected_type)) {
        if (value_coercion_uses_pointer_cast(ref types_table, actual_type, expected_type)) {
            val type_text: str = ctypes.type_name(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref types_table,
                expected_type
            )
            append_bytes(mut ref mem, mut ref out, ref "((")
            if ((nodes.data0[ref_expr_id] & CEXPR_CHECK_NODE_FLAG_MUT) == 0) {
                append_bytes(mut ref mem, mut ref out, ref "const ")
            }
            append_bytes(mut ref mem, mut ref out, ref type_text)
            append_bytes(mut ref mem, mut ref out, ref " *)")
            append_ref_source_pointer(
                mut ref mem,
                mut ref out,
                ref sources,
                ref path_pool,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref symbols_table,
                ref types_table,
                ref_expr_id
            )
            append_bytes(mut ref mem, mut ref out, ref ")")
            return
        }

        val type_text: str = ctypes.type_name(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref types_table,
            expected_type
        )
        append_bytes(mut ref mem, mut ref out, ref "&(((")
        append_bytes(mut ref mem, mut ref out, ref type_text)
        append_bytes(mut ref mem, mut ref out, ref "[]){")
        if (actual_type >= 0 && types_table.kind[actual_type] == types.TypeKind.ArrayType) {
            append_view_literal_expr(
                mut ref mem,
                mut ref out,
                ref sources,
                ref path_pool,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref symbols_table,
                ref types_table,
                expected_type,
                value_id
            )
        } else {
            append_expr_as_type(
                mut ref mem,
                mut ref out,
                ref sources,
                ref path_pool,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref symbols_table,
                ref types_table,
                expected_type,
                value_id
            )
        }
        append_bytes(mut ref mem, mut ref out, ref "})[0])")
        return
    }

    append_ref_source_pointer(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        ref_expr_id
    )
}

// Legacy ref emission still exists for builtin lowering paths that do not need destination-type coercions.
func append_ref_arg_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    ref_expr_id: i64
): void = {
    append_ref_arg_expr_as_type(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        -1,
        ref_expr_id
    )
}

// Builtin ref arguments still wrap the pointee in a RefExpr node even though codegen lowers them specially.
pub func ref_arg_value_id(ref nodes: node.Nodes, arg_id: i64): i64 = {
    if (arg_id < 0) {
        return -1
    }
    if (nodes.kind[arg_id] == node.NodeKind.RefExpr) {
        return node.node_child_at(ref nodes, arg_id, 0)
    }
    arg_id
}

// Table helpers keep one stable naming convention shared with the helper-emission pass.
pub func table_helper_name(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref types_table: types.Types,
    table_type: i64,
    ref suffix: [u8]
): str = {
    val base_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        table_type
    )
    string.str_concat(mut ref mem, ref base_name, ref suffix)
}

// arena_alloc can produce either a slice or a str, so codegen needs the same byte-element fallback sema accepts.
func arena_alloc_elem_type(ref types_table: types.Types, result_type: i64): i64 = {
    if (result_type < 0) {
        return -1
    }
    if (types_table.kind[result_type] == types.TypeKind.SliceType) {
        return types_table.data0[result_type]
    }
    if (types_table.kind[result_type] == types.TypeKind.StrType) {
        return u8_type_id(ref types_table)
    }
    -1
}

// Arena allocation lowers to the shared ni_arena_alloc runtime with element-type metadata.
func append_arena_alloc_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    node_id: i64
): void = {
    val arena_arg_id: i64 = node.node_child_at(ref nodes, node_id, 1)
    val count_id: i64 = node.node_child_at(ref nodes, node_id, 2)
    val result_type: i64 = nodes.type_id[node_id]
    val elem_type: i64 = arena_alloc_elem_type(ref types_table, result_type)
    val result_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        result_type
    )
    val elem_name: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        elem_type
    )

    append_bytes(mut ref mem, mut ref out, ref "(")
    append_bytes(mut ref mem, mut ref out, ref result_name)
    append_bytes(mut ref mem, mut ref out, ref "){.data = (")
    append_bytes(mut ref mem, mut ref out, ref elem_name)
    append_bytes(mut ref mem, mut ref out, ref " *)ni_arena_alloc(")
    append_ref_arg_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        arena_arg_id
    )
    append_bytes(mut ref mem, mut ref out, ref ", ")
    append_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        count_id
    )
    append_bytes(mut ref mem, mut ref out, ref ", sizeof(")
    append_bytes(mut ref mem, mut ref out, ref elem_name)
    append_bytes(mut ref mem, mut ref out, ref "), NI_ALIGNOF(")
    append_bytes(mut ref mem, mut ref out, ref elem_name)
    append_bytes(mut ref mem, mut ref out, ref ")), .len = ")
    append_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        count_id
    )
    append_bytes(mut ref mem, mut ref out, ref "}")
}

// Table allocation lowers through one generated helper per table type.
func append_table_alloc_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    node_id: i64
): void = {
    val arena_arg_id: i64 = node.node_child_at(ref nodes, node_id, 1)
    val count_id: i64 = node.node_child_at(ref nodes, node_id, 2)
    val helper_name: str = table_helper_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        nodes.type_id[node_id],
        ref "__alloc"
    )

    append_bytes(mut ref mem, mut ref out, ref helper_name)
    append_bytes(mut ref mem, mut ref out, ref "(")
    append_ref_arg_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        arena_arg_id
    )
    append_bytes(mut ref mem, mut ref out, ref ", ")
    append_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        count_id
    )
    append_bytes(mut ref mem, mut ref out, ref ")")
}

// Table get/insert helpers need the pointee table type rather than the call-result row type.
func append_table_helper_call(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    call_id: i64,
    ref suffix: [u8]
): void = {
    val table_arg_id: i64 = node.node_child_at(ref nodes, call_id, 1)
    val table_value_id: i64 = ref_arg_value_id(ref nodes, table_arg_id)
    val helper_name: str = table_helper_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        nodes.type_id[table_value_id],
        ref suffix
    )
    append_bytes(mut ref mem, mut ref out, ref helper_name)
    append_bytes(mut ref mem, mut ref out, ref "(")
    append_ref_arg_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        table_arg_id
    )
}

// Builtin calls lower directly to runtime/helper spellings instead of the unresolved source identifiers.
func append_builtin_call_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    node_id: i64,
    builtin_kind: i64
): void = {
    if (builtin_kind == CEXPR_BUILTIN_CALL_ARENA) {
        append_bytes(mut ref mem, mut ref out, ref "ni_arena_new(")
        append_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node.node_child_at(ref nodes, node_id, 1)
        )
        append_bytes(mut ref mem, mut ref out, ref ")")
        return
    }

    if (builtin_kind == CEXPR_BUILTIN_CALL_ARENA_ALLOC) {
        append_arena_alloc_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node_id
        )
        return
    }

    if (builtin_kind == CEXPR_BUILTIN_CALL_ARENA_RESET) {
        append_bytes(mut ref mem, mut ref out, ref "ni_arena_reset(")
        append_ref_arg_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node.node_child_at(ref nodes, node_id, 1)
        )
        append_bytes(mut ref mem, mut ref out, ref ")")
        return
    }

    if (builtin_kind == CEXPR_BUILTIN_CALL_TABLE_ALLOC) {
        append_table_alloc_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node_id
        )
        return
    }

    if (builtin_kind == CEXPR_BUILTIN_CALL_TABLE_LEN) {
        append_bytes(mut ref mem, mut ref out, ref "((")
        append_ref_arg_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node.node_child_at(ref nodes, node_id, 1)
        )
        append_bytes(mut ref mem, mut ref out, ref ")->ni__len)")
        return
    }

    if (builtin_kind == CEXPR_BUILTIN_CALL_TABLE_GET) {
        append_table_helper_call(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node_id,
            ref "__get"
        )
        append_bytes(mut ref mem, mut ref out, ref ", ")
        append_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node.node_child_at(ref nodes, node_id, 2)
        )
        append_bytes(mut ref mem, mut ref out, ref ", ")
        append_location_args(mut ref mem, mut ref out, ref sources, ref path_pool, ref text_pool, ref nodes, node_id)
        append_bytes(mut ref mem, mut ref out, ref ")")
        return
    }

    if (builtin_kind == CEXPR_BUILTIN_CALL_TABLE_INSERT) {
        append_table_helper_call(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node_id,
            ref "__insert"
        )
        append_bytes(mut ref mem, mut ref out, ref ", ")
        append_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node.node_child_at(ref nodes, node_id, 2)
        )
        append_bytes(mut ref mem, mut ref out, ref ")")
    }
}

// Call targets use symbol resolution rather than value-expression spelling.
func append_call_target(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    callee_id: i64
): void = {
    if (callee_id < 0) {
        return
    }

    val symbol_id: i64 = nodes.symbol_id[callee_id]
    if (symbol_id >= 0 && symbols_table.kind[symbol_id] == symbols.SymbolKind.FunctionSymbol) {
        append_symbol_storage_name(
            mut ref mem,
            mut ref out,
            ref sources,
            ref text_pool,
            ref tokens,
            ref symbols_table,
            symbol_id
        )
        return
    }

    if (nodes.kind[callee_id] == node.NodeKind.Identifier) {
        val callee_text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[callee_id])
        append_bytes(mut ref mem, mut ref out, ref callee_text)
        return
    }

    assert false
}

// Call lowering only needs the already-checked parameter node so argument emission can mirror sema's expectations.
func call_param_id(
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    callee_id: i64,
    arg_index: i64
): i64 = {
    if (callee_id < 0 ||
        arg_index < 0 ||
        nodes.symbol_id[callee_id] < 0 ||
        symbols_table.kind[nodes.symbol_id[callee_id]] != symbols.SymbolKind.FunctionSymbol) {
        return -1
    }

    val decl_id: i64 = symbols_table.decl_node[nodes.symbol_id[callee_id]]
    if (decl_id < 0 || arg_index >= nodes.data2[decl_id]) {
        return -1
    }

    node.node_child_at(ref nodes, decl_id, arg_index)
}

// Type-qualified enum variant values lower directly to their tag or tagged-enum literal.
func append_enum_variant_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref types_table: types.Types,
    enum_type: i64,
    node_id: i64
): void = {
    val variant_id: i64 = enum_find_variant(
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        enum_type,
        nodes.data0[node_id]
    )
    val tag: i64 = enum_variant_tag(ref nodes, ref types_table, enum_type, variant_id)

    if (!enum_has_payload_variant(ref nodes, ref types_table, enum_type)) {
        append_enum_tag(mut ref mem, mut ref out, tag)
        return
    }

    val type_text: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        enum_type
    )
    append_bytes(mut ref mem, mut ref out, ref "(")
    append_bytes(mut ref mem, mut ref out, ref type_text)
    append_bytes(mut ref mem, mut ref out, ref "){.tag = ")
    append_enum_tag(mut ref mem, mut ref out, tag)
    append_bytes(mut ref mem, mut ref out, ref "}")
}

// Tagged-enum constructor calls reuse the same compound-literal shape as the typedef emitter.
func append_enum_variant_call_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    enum_type: i64,
    node_id: i64
): void = {
    val callee_id: i64 = node.node_child_at(ref nodes, node_id, 0)
    val variant_id: i64 = enum_find_variant(
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        enum_type,
        nodes.data0[callee_id]
    )
    val tag: i64 = enum_variant_tag(ref nodes, ref types_table, enum_type, variant_id)
    val type_text: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        enum_type
    )

    append_bytes(mut ref mem, mut ref out, ref "(")
    append_bytes(mut ref mem, mut ref out, ref type_text)
    append_bytes(mut ref mem, mut ref out, ref "){.tag = ")
    append_enum_tag(mut ref mem, mut ref out, tag)

    if (nodes.type_id[variant_id] >= 0) {
        val arg_id: i64 = nodes.next_sibling[callee_id]
        val variant_name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[variant_id])
        append_bytes(mut ref mem, mut ref out, ref ", .data = {.ni_")
        append_bytes(mut ref mem, mut ref out, ref variant_name)
        append_bytes(mut ref mem, mut ref out, ref " = ")
        append_expr_as_type(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            nodes.type_id[variant_id],
            arg_id
        )
        append_bytes(mut ref mem, mut ref out, ref "}")
    }

    append_bytes(mut ref mem, mut ref out, ref "}")
}

// Constructor expressions lower to C99 compound literals with designated field initializers.
func append_constructor_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    node_id: i64
): void = {
    val type_text: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        nodes.type_id[node_id]
    )
    append_bytes(mut ref mem, mut ref out, ref "(")
    append_bytes(mut ref mem, mut ref out, ref type_text)
    append_bytes(mut ref mem, mut ref out, ref "){")

    val callee_id: i64 = node.node_child_at(ref nodes, node_id, 0)
    mut init_id: i64 = if (callee_id >= 0) {
        nodes.next_sibling[callee_id]
    } else {
        node.invalid_node_id()
    }
    if (init_id < 0) {
        append_bytes(mut ref mem, mut ref out, ref "0")
        append_bytes(mut ref mem, mut ref out, ref "}")
        return
    }

    mut first: bool = true
    while (init_id >= 0) {
        if (!first) {
            append_bytes(mut ref mem, mut ref out, ref ", ")
        }
        append_bytes(mut ref mem, mut ref out, ref ".ni_")
        val field_text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[init_id])
        append_bytes(mut ref mem, mut ref out, ref field_text)
        append_bytes(mut ref mem, mut ref out, ref " = ")
        append_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node.node_child_at(ref nodes, init_id, 0)
        )
        first = false
        init_id = nodes.next_sibling[init_id]
    }

    append_bytes(mut ref mem, mut ref out, ref "}")
}

// Fixed-size array literals lower to the array-typedef wrapper used by the type emitter.
func append_array_lit_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    node_id: i64
): void = {
    val type_text: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        nodes.type_id[node_id]
    )
    append_bytes(mut ref mem, mut ref out, ref "(")
    append_bytes(mut ref mem, mut ref out, ref type_text)
    append_bytes(mut ref mem, mut ref out, ref "){{")

    mut elem_id: i64 = nodes.first_child[node_id]
    mut first: bool = true
    while (elem_id >= 0) {
        if (!first) {
            append_bytes(mut ref mem, mut ref out, ref ", ")
        }
        append_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            elem_id
        )
        first = false
        elem_id = nodes.next_sibling[elem_id]
    }

    append_bytes(mut ref mem, mut ref out, ref "}}")
}

// The first integer-literal slice only needs stable suffixes for i64 and enum-typed values.
func append_number_lit(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref types_table: types.Types,
    node_id: i64
): void = {
    val literal_text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[node_id])
    append_bytes(mut ref mem, mut ref out, ref literal_text)
    val type_id: i64 = nodes.type_id[node_id]
    if (type_id >= 0 &&
        (types_table.kind[type_id] == types.TypeKind.I64Type ||
         types_table.kind[type_id] == types.TypeKind.EnumType)) {
        append_bytes(mut ref mem, mut ref out, ref "L")
    }
}

// Float and char literals use C-compatible source spelling, so the token text is emitted directly.
func append_token_text_lit(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    node_id: i64
): void = {
    val token_text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[node_id])
    append_bytes(
        mut ref mem,
        mut ref out,
        ref token_text
    )
}

// C cannot spell i64 min as one signed positive token with unary minus.
func append_i64_min_literal(mut ref mem: Arena, mut ref out: bbuf.ByteBuf): void = {
    append_bytes(mut ref mem, mut ref out, ref "((-9223372036854775807L) - 1L)")
}

// Prefix operators stay parenthesized so later binary lowering never depends on C precedence trivia.
func append_unary_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    node_id: i64
): void = {
    val op_text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[node_id])
    val operand_id: i64 = node.node_child_at(ref nodes, node_id, 0)
    if (tokens.kind[nodes.data0[node_id]] == token.TokenKind.Minus &&
        operand_id >= 0 &&
        nodes.kind[operand_id] == node.NodeKind.NumberLit) {
        val operand_text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[operand_id])
        if (string.str_eq(ref operand_text, ref "9223372036854775808")) {
            append_i64_min_literal(mut ref mem, mut ref out)
            return
        }
    }

    append_bytes(mut ref mem, mut ref out, ref "(")
    append_bytes(
        mut ref mem,
        mut ref out,
        ref op_text
    )
    append_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        operand_id
    )
    append_bytes(mut ref mem, mut ref out, ref ")")
}

// Binary operators also stay parenthesized so the bootstrap emitter can stay simple and local.
func append_binary_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    node_id: i64
): void = {
    val op_text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[node_id])
    append_bytes(mut ref mem, mut ref out, ref "(")
    append_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        node.node_child_at(ref nodes, node_id, 0)
    )
    append_bytes(mut ref mem, mut ref out, ref " ")
    append_bytes(
        mut ref mem,
        mut ref out,
        ref op_text
    )
    append_bytes(mut ref mem, mut ref out, ref " ")
    append_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        node.node_child_at(ref nodes, node_id, 1)
    )
    append_bytes(mut ref mem, mut ref out, ref ")")
}

// Numeric casts lower directly to the already-lowered destination C type name.
func append_cast_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    node_id: i64
): void = {
    val type_text: str = ctypes.type_name(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref types_table,
        nodes.type_id[node_id]
    )
    append_bytes(mut ref mem, mut ref out, ref "((")
    append_bytes(mut ref mem, mut ref out, ref type_text)
    append_bytes(mut ref mem, mut ref out, ref ")(")
    append_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        node.node_child_at(ref nodes, node_id, 0)
    )
    append_bytes(mut ref mem, mut ref out, ref "))")
}

// Indexing targets the lowered `.data` storage for arrays, slices, and strings.
func append_index_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    node_id: i64
): void = {
    append_checked_index_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        node_id
    )
}

// Sub-slicing lowers to the standard `{data,len}` shape shared by slices and strings.
func append_slice_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    node_id: i64
): void = {
    val object_id: i64 = node.node_child_at(ref nodes, node_id, 0)
    val start_id: i64 = slice_start_id(ref nodes, node_id)
    val end_id: i64 = slice_end_id(ref nodes, node_id)
    val object_type: i64 = nodes.type_id[object_id]

    if (end_id < 0 &&
        object_type >= 0 &&
        (types_table.kind[object_type] == types.TypeKind.SliceType ||
         types_table.kind[object_type] == types.TypeKind.StrType)) {
        append_open_ended_slice_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            object_id,
            node_id,
            start_id
        )
        return
    }

    append_slice_range_expr(
        mut ref mem,
        mut ref out,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref symbols_table,
        ref types_table,
        node_id,
        object_id,
        start_id,
        end_id
    )
}

// Later statement/codegen layers share one expression entry point for the currently supported subset.
pub func append_expr(
    mut ref mem: Arena,
    mut ref out: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    ref types_table: types.Types,
    node_id: i64
): void = {
    if (node_id < 0) {
        return
    }

    val kind: node.NodeKind = nodes.kind[node_id]
    if (kind == node.NodeKind.NumberLit) {
        append_number_lit(mut ref mem, mut ref out, ref sources, ref text_pool, ref tokens, ref nodes, ref types_table, node_id)
        return
    }
    if (kind == node.NodeKind.FloatLit) {
        append_token_text_lit(mut ref mem, mut ref out, ref sources, ref text_pool, ref tokens, ref nodes, node_id)
        return
    }
    if (kind == node.NodeKind.BoolLit) {
        if (tokens.kind[nodes.data0[node_id]] == token.TokenKind.True) {
            append_bytes(mut ref mem, mut ref out, ref "1")
        } else {
            append_bytes(mut ref mem, mut ref out, ref "0")
        }
        return
    }
    if (kind == node.NodeKind.StringLit) {
        append_string_lit_expr(mut ref mem, mut ref out, ref sources, ref text_pool, ref tokens, ref nodes, node_id)
        return
    }
    if (kind == node.NodeKind.CharLit) {
        append_token_text_lit(mut ref mem, mut ref out, ref sources, ref text_pool, ref tokens, ref nodes, node_id)
        return
    }
    if (kind == node.NodeKind.Identifier) {
        append_identifier_expr(mut ref mem, mut ref out, ref sources, ref text_pool, ref tokens, ref nodes, ref symbols_table, node_id)
        return
    }
    if (kind == node.NodeKind.UnaryExpr) {
        append_unary_expr(mut ref mem, mut ref out, ref sources, ref path_pool, ref text_pool, ref tokens, ref nodes, ref symbols_table, ref types_table, node_id)
        return
    }
    if (kind == node.NodeKind.BinaryExpr) {
        append_binary_expr(mut ref mem, mut ref out, ref sources, ref path_pool, ref text_pool, ref tokens, ref nodes, ref symbols_table, ref types_table, node_id)
        return
    }
    if (kind == node.NodeKind.CastExpr) {
        append_cast_expr(mut ref mem, mut ref out, ref sources, ref path_pool, ref text_pool, ref tokens, ref nodes, ref symbols_table, ref types_table, node_id)
        return
    }
    if (kind == node.NodeKind.FieldAccess) {
        val enum_type: i64 = field_access_enum_type(ref nodes, ref symbols_table, ref types_table, node_id)
        if (enum_type >= 0) {
            append_enum_variant_expr(
                mut ref mem,
                mut ref out,
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref types_table,
                enum_type,
                node_id
            )
            return
        }

        val symbol_id: i64 = nodes.symbol_id[node_id]
        if (symbol_id >= 0 &&
            symbols_table.kind[symbol_id] == symbols.SymbolKind.GlobalSymbol) {
            append_symbol_storage_name(
                mut ref mem,
                mut ref out,
                ref sources,
                ref text_pool,
                ref tokens,
                ref symbols_table,
                symbol_id
            )
            return
        }

        val left_id: i64 = node.node_child_at(ref nodes, node_id, 0)
        val left_type: i64 = if (left_id >= 0) { nodes.type_id[left_id] } else { -1 }
        val field_text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[node_id])
        val is_len: bool = field_is_len(ref sources, ref text_pool, ref tokens, nodes.data0[node_id]) &&
            left_type >= 0 &&
            (types_table.kind[left_type] == types.TypeKind.SliceType ||
             types_table.kind[left_type] == types.TypeKind.StrType)
        val use_arrow: bool = expr_uses_arrow(ref nodes, ref symbols_table, left_id)

        if (use_arrow) {
            append_symbol_storage_name(
                mut ref mem,
                mut ref out,
                ref sources,
                ref text_pool,
                ref tokens,
                ref symbols_table,
                nodes.symbol_id[left_id]
            )
        } else {
            append_expr(
                mut ref mem,
                mut ref out,
                ref sources,
                ref path_pool,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref symbols_table,
                ref types_table,
                left_id
            )
        }
        append_field_suffix(mut ref mem, mut ref out, use_arrow, is_len, ref field_text)
        return
    }
    if (kind == node.NodeKind.IndexExpr) {
        append_index_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node_id
        )
        return
    }
    if (kind == node.NodeKind.SliceExpr) {
        append_slice_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node_id
        )
        return
    }
    if (kind == node.NodeKind.CallExpr) {
        val callee_id: i64 = node.node_child_at(ref nodes, node_id, 0)
        val builtin_kind: i64 = resolved_builtin_call_kind(ref sources, ref text_pool, ref tokens, ref nodes, callee_id)
        if (builtin_kind != CEXPR_BUILTIN_CALL_NONE) {
            append_builtin_call_expr(
                mut ref mem,
                mut ref out,
                ref sources,
                ref path_pool,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref symbols_table,
                ref types_table,
                node_id,
                builtin_kind
            )
            return
        }
        val callee_enum_type: i64 = field_access_enum_type(ref nodes, ref symbols_table, ref types_table, callee_id)
        if (callee_enum_type >= 0) {
            append_enum_variant_call_expr(
                mut ref mem,
                mut ref out,
                ref sources,
                ref path_pool,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref symbols_table,
                ref types_table,
                callee_enum_type,
                node_id
            )
            return
        }
        append_call_target(
            mut ref mem,
            mut ref out,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            callee_id
        )
        append_bytes(mut ref mem, mut ref out, ref "(")
        mut arg_id: i64 = if (callee_id >= 0) {
            nodes.next_sibling[callee_id]
        } else {
            node.invalid_node_id()
        }
        mut arg_index: i64 = 0
        mut first: bool = true
        while (arg_id >= 0) {
            val param_id: i64 = call_param_id(ref nodes, ref symbols_table, callee_id, arg_index)
            val param_type: i64 = if (param_id >= 0) { nodes.type_id[param_id] } else { -1 }
            if (!first) {
                append_bytes(mut ref mem, mut ref out, ref ", ")
            }
            if (nodes.kind[arg_id] == node.NodeKind.RefExpr && decl_is_ref(ref nodes, param_id)) {
                append_ref_arg_expr_as_type(
                    mut ref mem,
                    mut ref out,
                    ref sources,
                    ref path_pool,
                    ref text_pool,
                    ref tokens,
                    ref nodes,
                    ref symbols_table,
                    ref types_table,
                    param_type,
                    arg_id
                )
            } else {
                append_expr_as_type(
                    mut ref mem,
                    mut ref out,
                    ref sources,
                    ref path_pool,
                    ref text_pool,
                    ref tokens,
                    ref nodes,
                    ref symbols_table,
                    ref types_table,
                    param_type,
                    arg_id
                )
            }
            first = false
            arg_id = nodes.next_sibling[arg_id]
            arg_index += 1
        }
        append_bytes(mut ref mem, mut ref out, ref ")")
        return
    }
    if (kind == node.NodeKind.ConstructorExpr) {
        append_constructor_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node_id
        )
        return
    }
    if (kind == node.NodeKind.ArrayLit) {
        append_array_lit_expr(
            mut ref mem,
            mut ref out,
            ref sources,
            ref path_pool,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            ref types_table,
            node_id
        )
        return
    }

    assert false
}
