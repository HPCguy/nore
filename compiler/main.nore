// Bootstrap compiler entry point.
// Responsibility: wire the committed frontend, sema, and C codegen stages into one runnable pipeline.
// Owns: CLI argument decoding, long-lived compiler tables, and top-level stage sequencing.
// Does not own: frontend internals, semantic rules, codegen details, or Clang invocation.

import bbuf "support/byte_buf.nore"
import cmain "codegen/c_main.nore"
import check "sema/check.nore"
import driver "driver/cli.nore"
import diag "support/diag.nore"
import file "std/file.nore"
import lexer "frontend/lexer.nore"
import ibuf "support/i64_buf.nore"
import io "std/io.nore"
import loader "frontend/loader.nore"
import node "frontend/node.nore"
import parser "frontend/parser.nore"
import scopes "sema/scopes.nore"
import source "support/source.nore"
import span "support/span.nore"
import string "std/string.nore"
import symbols "sema/symbols.nore"
import token "frontend/token.nore"
import types "sema/types.nore"

native func exit(code: i32): void
native func args(mut ref mem: Arena): [str]

val MAIN_ARENA_CAPACITY: i64 = 134217728
val SOURCES_CAPACITY: i64 = 128
val PATH_POOL_CAPACITY: i64 = 4096
val TEXT_POOL_CAPACITY: i64 = 262144
val LINE_STARTS_CAPACITY: i64 = 32768
val TOKENS_CAPACITY: i64 = 131072
val NODES_CAPACITY: i64 = 524288
val MODULES_CAPACITY: i64 = 128
val IMPORTS_CAPACITY: i64 = 256
val DIAGS_CAPACITY: i64 = 512
val DIAG_POOL_CAPACITY: i64 = 16384
val SCOPES_CAPACITY: i64 = 16384
val SYMBOLS_CAPACITY: i64 = 65536
val TYPES_CAPACITY: i64 = 32768

// Diagnostics already know how to format themselves; the driver only needs to stream one range in order.
func emit_diag_range(
    mut ref mem: Arena,
    ref diags: diag.Diagnostics,
    ref diag_pool: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref line_starts: ibuf.I64Buf,
    ref diag_range: span.Range
): void = {
    mut diag_id: i64 = diag_range.start
    val end: i64 = span.range_end(ref diag_range)
    while (diag_id < end) {
        val text: [u8] = diag.diag_format(
            mut ref mem,
            ref diags,
            ref diag_pool,
            ref sources,
            ref path_pool,
            ref line_starts,
            diag_id
        )
        io.eprintln(ref text)
        diag_id += 1
    }
}

// One small helper keeps the write-error path out of the main pipeline flow.
func write_output_or_exit(mut ref mem: Arena, ref output_path: str, ref dumped: [u8]): void = {
    match (file.write_file(ref output_path, ref dumped)) {
        Ok(written) = { }
        Err(code) = {
            val message: str = string.str_concat(mut ref mem, ref "Could not write output file: ", ref output_path)
            io.eprintln(ref message)
            exit(1)
        }
    }
}

// Root-module dumps still use the root module row even when imports were loaded transitively.
func root_module_token_range(ref modules: loader.Modules, root_module: i64): span.Range = {
    if (root_module < 0 || root_module >= table_len(ref modules)) {
        return span.range(0, 0)
    }
    span.range(modules.token_start[root_module], modules.token_count[root_module])
}

// The entrypoint keeps one linear pipeline and branches only after the final C dump is ready.
func main(): void = {
    mut mem: Arena = arena(MAIN_ARENA_CAPACITY)
    val argv: [str] = args(mut ref mem)
    mut cli_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, 512)
    val parsed: driver.CliParseResult = driver.parse_cli(mut ref mem, mut ref cli_pool, ref argv)

    mut config: driver.CliConfig = driver.CliConfig {
        mode: driver.CliMode.EmitC,
        input_path: span.span(0, 0),
        output_path: span.span(0, 0),
        compiler_root: span.span(0, 0),
        output_given: true,
        run_after_compile: false,
        print_tokens: false,
        print_ast: false,
        print_codegen: false,
        program_arg_start: -1
    }
    match (parsed) {
        Ok(parsed_config) = {
            config = parsed_config
        }
        Exit(code) = {
            exit(code)
        }
    }

    mut sources: source.Sources = table_alloc(mut ref mem, SOURCES_CAPACITY)
    mut path_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, PATH_POOL_CAPACITY)
    mut text_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, TEXT_POOL_CAPACITY)
    mut line_starts: ibuf.I64Buf = ibuf.i64_buf_new(mut ref mem, LINE_STARTS_CAPACITY)
    mut tokens: token.Tokens = table_alloc(mut ref mem, TOKENS_CAPACITY)
    mut nodes: node.Nodes = table_alloc(mut ref mem, NODES_CAPACITY)
    mut modules: loader.Modules = table_alloc(mut ref mem, MODULES_CAPACITY)
    mut imports: loader.ModuleImports = table_alloc(mut ref mem, IMPORTS_CAPACITY)
    mut diags: diag.Diagnostics = table_alloc(mut ref mem, DIAGS_CAPACITY)
    mut diag_pool: bbuf.ByteBuf = bbuf.byte_buf_new(mut ref mem, DIAG_POOL_CAPACITY)
    mut scopes_table: scopes.Scopes = table_alloc(mut ref mem, SCOPES_CAPACITY)
    mut symbols_table: symbols.Symbols = table_alloc(mut ref mem, SYMBOLS_CAPACITY)
    mut types_table: types.Types = table_alloc(mut ref mem, TYPES_CAPACITY)
    val compiler_root: [u8] = driver.cli_text(ref cli_pool, ref config.compiler_root)
    val input_path: [u8] = driver.cli_text(ref cli_pool, ref config.input_path)

    val loaded: loader.LoadResult = loader.load_graph(
        mut ref mem,
        ref compiler_root,
        ref input_path,
        mut ref sources,
        mut ref path_pool,
        mut ref text_pool,
        mut ref line_starts,
        mut ref tokens,
        mut ref nodes,
        mut ref modules,
        mut ref imports,
        mut ref diags,
        mut ref diag_pool
    )
    if (loaded.diags.count > 0) {
        emit_diag_range(
            mut ref mem,
            ref diags,
            ref diag_pool,
            ref sources,
            ref path_pool,
            ref line_starts,
            ref loaded.diags
        )
        exit(1)
    }

    if (config.print_tokens) {
        val token_range: span.Range = root_module_token_range(ref modules, loaded.root_module)
        val dump: [u8] = lexer.lex_dump(mut ref mem, ref tokens, ref sources, ref text_pool, ref token_range)
        io.print(ref dump)
    }

    if (config.print_ast && loaded.root_module >= 0 && loaded.root_module < table_len(ref modules)) {
        val dump: [u8] = parser.parse_dump(
            mut ref mem,
            ref nodes,
            ref tokens,
            ref sources,
            ref text_pool,
            modules.root_node[loaded.root_module]
        )
        io.print(ref dump)
    }

    val checked: check.CheckResult = check.check_modules(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref modules,
        ref imports,
        mut ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        mut ref diags,
        mut ref diag_pool
    )
    if (checked.diags.count > 0) {
        emit_diag_range(
            mut ref mem,
            ref diags,
            ref diag_pool,
            ref sources,
            ref path_pool,
            ref line_starts,
            ref checked.diags
        )
        exit(1)
    }

    if (config.mode == driver.CliMode.Driver) {
        val main_diags: span.Range = driver.validate_root_main(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref modules,
            ref types_table,
            mut ref diags,
            mut ref diag_pool,
            ref loaded.modules
        )
        if (main_diags.count > 0) {
            emit_diag_range(
                mut ref mem,
                ref diags,
                ref diag_pool,
                ref sources,
                ref path_pool,
                ref line_starts,
                ref main_diags
            )
            exit(1)
        }
    }

    val dumped: [u8] = cmain.c_file_dump(
        mut ref mem,
        ref sources,
        ref path_pool,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref modules,
        ref symbols_table,
        mut ref types_table,
        ref checked.types,
        ref loaded.modules
    )

    if (config.print_codegen) {
        io.print(ref dumped)
    }

    if (driver.debug_requested(ref config)) {
        exit(0)
    }

    if (config.mode == driver.CliMode.EmitC) {
        val output_path: [u8] = driver.cli_text(ref cli_pool, ref config.output_path)
        write_output_or_exit(mut ref mem, ref output_path, ref dumped)
    } else {
        val driver_status: i32 = driver.compile_program(mut ref mem, ref cli_pool, ref config, ref dumped, ref argv)
        if (driver_status != 0) {
            exit(driver_status)
        }
    }
}
