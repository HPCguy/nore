// Structured diagnostics and late formatting for bootstrap compiler phases.
// Responsibility: store structured diagnostics and render them from stable compiler data.
// Owns: Diagnostics rows, pooled code/message text, and file:line:col formatting helpers.
// Does not own: phase control, error limits, or CLI/reporting policy above formatting.

import bbuf "byte_buf.nore"
import ibuf "i64_buf.nore"
import lmap "line_map.nore"
import source "source.nore"
import span "span.nore"
import string "std/string.nore"

pub enum DiagSeverity { Error, Warning, Note }

pub table Diagnostics {
    severity: DiagSeverity,
    code: span.Span,
    source_id: i64,
    display_path: span.Span,
    start: i64,
    len: i64,
    message: span.Span
}

// Driver-style diagnostics without a source row still need a distinct sentinel path span.
func invalid_span(): span.Span = {
    span.span(-1, 0)
}

// Re-slice pooled diagnostic strings by span so rows stay compact.
func pool_slice(ref pool: bbuf.ByteBuf, ref part: span.Span): [u8] = {
    pool.data[part.start..part.start + part.len]
}

// Keep severity spelling centralized so all phases format the same way.
func severity_text(severity: DiagSeverity): str = {
    if (severity == DiagSeverity.Error) {
        return "error"
    }
    if (severity == DiagSeverity.Warning) {
        return "warning"
    }
    "note"
}

// Funnel raw byte appends through one helper for formatter readability.
func append_bytes(mut ref mem: Arena, mut ref out: bbuf.ByteBuf, ref data: [u8]): void = {
    bbuf.byte_buf_append(mut ref mem, mut ref out, ref data)
}

// Format integers through std/string so callers do not hand-roll digit loops.
func append_i64(mut ref mem: Arena, mut ref out: bbuf.ByteBuf, n: i64): void = {
    val text: str = string.i64_to_str(mut ref mem, n)
    append_bytes(mut ref mem, mut ref out, ref text)
}

// Append one structured diagnostic into the flat diagnostics table.
pub func diag_push(
    mut ref mem: Arena,
    mut ref diags: Diagnostics,
    mut ref text_pool: bbuf.ByteBuf,
    severity: DiagSeverity,
    ref code: [u8],
    source_id: i64,
    start: i64,
    len: i64,
    ref message: [u8]
): i64 = {
    val code_span: span.Span = bbuf.byte_buf_append(mut ref mem, mut ref text_pool, ref code)
    val message_span: span.Span = bbuf.byte_buf_append(mut ref mem, mut ref text_pool, ref message)

    val diag_id: i64 = table_len(ref diags)
    table_insert(mut ref diags, Diagnostics.Row {
        severity: severity,
        code: code_span,
        source_id: source_id,
        display_path: invalid_span(),
        start: start,
        len: len,
        message: message_span
    })
    diag_id
}

// Keep the common error case terse for lexer/parser/sema call sites.
pub func diag_error(
    mut ref mem: Arena,
    mut ref diags: Diagnostics,
    mut ref text_pool: bbuf.ByteBuf,
    ref code: [u8],
    source_id: i64,
    start: i64,
    len: i64,
    ref message: [u8]
): i64 = {
    diag_push(
        mut ref mem,
        mut ref diags,
        mut ref text_pool,
        DiagSeverity.Error,
        ref code,
        source_id,
        start,
        len,
        ref message
    )
}

// Driver/file diagnostics can carry a display path even when no source row exists yet.
pub func diag_error_path(
    mut ref mem: Arena,
    mut ref diags: Diagnostics,
    mut ref text_pool: bbuf.ByteBuf,
    ref code: [u8],
    ref display_path: [u8],
    ref message: [u8]
): i64 = {
    val code_span: span.Span = bbuf.byte_buf_append(mut ref mem, mut ref text_pool, ref code)
    val path_span: span.Span = bbuf.byte_buf_append(mut ref mem, mut ref text_pool, ref display_path)
    val message_span: span.Span = bbuf.byte_buf_append(mut ref mem, mut ref text_pool, ref message)

    val diag_id: i64 = table_len(ref diags)
    table_insert(mut ref diags, Diagnostics.Row {
        severity: DiagSeverity.Error,
        code: code_span,
        source_id: -1,
        display_path: path_span,
        start: 0,
        len: 0,
        message: message_span
    })
    diag_id
}

// Recover a diagnostic code slice from the shared text pool.
pub func diag_code(ref text_pool: bbuf.ByteBuf, ref diags: Diagnostics, diag_id: i64): [u8] = {
    val part: span.Span = diags.code[diag_id]
    pool_slice(ref text_pool, ref part)
}

// Recover an explicit display path for diagnostics that do not have a source row.
pub func diag_display_path(ref text_pool: bbuf.ByteBuf, ref diags: Diagnostics, diag_id: i64): [u8] = {
    val part: span.Span = diags.display_path[diag_id]
    if (part.start < 0) {
        return text_pool.data[0..0]
    }
    pool_slice(ref text_pool, ref part)
}

// Recover a diagnostic message slice from the shared text pool.
pub func diag_message(ref text_pool: bbuf.ByteBuf, ref diags: Diagnostics, diag_id: i64): [u8] = {
    val part: span.Span = diags.message[diag_id]
    pool_slice(ref text_pool, ref part)
}

// Render one diagnostic in the same basic file:line:col shape as stage-0.
pub func diag_format(
    mut ref mem: Arena,
    ref diags: Diagnostics,
    ref diag_pool: bbuf.ByteBuf,
    ref sources: source.Sources,
    ref path_pool: bbuf.ByteBuf,
    ref line_starts: ibuf.I64Buf,
    diag_id: i64
): [u8] = {
    val code: [u8] = diag_code(ref diag_pool, ref diags, diag_id)
    val message: [u8] = diag_message(ref diag_pool, ref diags, diag_id)
    val explicit_path: [u8] = diag_display_path(ref diag_pool, ref diags, diag_id)
    val severity: str = severity_text(diags.severity[diag_id])
    val has_source: bool = diags.source_id[diag_id] >= 0
    val has_explicit_path: bool = explicit_path.len > 0

    mut line: i64 = 0
    mut col: i64 = 0

    if (has_source) {
        val loc: lmap.LineCol = source.source_line_col(
            ref sources,
            ref line_starts,
            diags.source_id[diag_id],
            diags.start[diag_id]
        )
        line = loc.line
        col = loc.col
    }

    mut path_len: i64 = 9
    if (has_source) {
        path_len = source.source_display_path(ref path_pool, ref sources, diags.source_id[diag_id]).len
    } else {
        if (has_explicit_path) {
            path_len = explicit_path.len
        }
    }

    mut out: bbuf.ByteBuf = bbuf.byte_buf_new(
        mut ref mem,
        path_len + code.len + message.len + severity.len + 32
    )
    if (has_source) {
        val display_path: [u8] = source.source_display_path(ref path_pool, ref sources, diags.source_id[diag_id])
        append_bytes(mut ref mem, mut ref out, ref display_path)
    } else {
        if (has_explicit_path) {
            append_bytes(mut ref mem, mut ref out, ref explicit_path)
        } else {
            append_bytes(mut ref mem, mut ref out, ref "<unknown>")
        }
    }
    append_bytes(mut ref mem, mut ref out, ref ":")
    append_i64(mut ref mem, mut ref out, line)
    append_bytes(mut ref mem, mut ref out, ref ":")
    append_i64(mut ref mem, mut ref out, col)
    append_bytes(mut ref mem, mut ref out, ref ": ")
    append_bytes(mut ref mem, mut ref out, ref severity)
    append_bytes(mut ref mem, mut ref out, ref "[")
    append_bytes(mut ref mem, mut ref out, ref code)
    append_bytes(mut ref mem, mut ref out, ref "]: ")
    append_bytes(mut ref mem, mut ref out, ref message)
    out.data[0..out.count]
}
