// Bootstrap compiler semantic binding for the current subset.
// Responsibility: bind scopes, names, imports, and declared types into flat sema tables.
// Owns: module-scope creation, top-level symbol collection, and first-pass name resolution.
// Does not own: full expression typing, escape analysis, or C lowering.

import bbuf "../support/byte_buf.nore"
import diag "../support/diag.nore"
import ibuf "../support/i64_buf.nore"
import loader "../frontend/loader.nore"
import node "../frontend/node.nore"
import scopes "scopes.nore"
import source "../support/source.nore"
import span "../support/span.nore"
import symbols "symbols.nore"
import token "../frontend/token.nore"
import types "types.nore"
import string "std/string.nore"

val CHECK_NODE_FLAG_MUT: i64 = 1
val CHECK_NODE_FLAG_PUB: i64 = 2
val CHECK_NODE_FLAG_REF: i64 = 4
val CHECK_NODE_FLAG_NATIVE: i64 = 8
val CHECK_NODE_FLAG_HAS_TYPE: i64 = 16
val CHECK_NODE_FLAG_HAS_VALUE: i64 = 32

val BUILTIN_CALL_NONE: i64 = 0
val BUILTIN_CALL_ARENA: i64 = 1
val BUILTIN_CALL_ARENA_ALLOC: i64 = 2
val BUILTIN_CALL_ARENA_RESET: i64 = 3
val BUILTIN_CALL_TABLE_ALLOC: i64 = 4
val BUILTIN_CALL_TABLE_LEN: i64 = 5
val BUILTIN_CALL_TABLE_GET: i64 = 6
val BUILTIN_CALL_TABLE_INSERT: i64 = 7

val SYNTHETIC_TOKEN_OS: i64 = -2
val SYNTHETIC_TOKEN_TARGET_OS: i64 = -3
val SYNTHETIC_TOKEN_LINUX: i64 = -4
val SYNTHETIC_TOKEN_MACOS: i64 = -5
val MATCH_PATTERN_CATCH_ALL_ID: i64 = -6
val INT_CONST_I64_MAX: i64 = 9223372036854775807
val INT_CONST_I64_MIN: i64 = -9223372036854775807 - 1
val INT_CONST_I32_MAX: i64 = 2147483647
val INT_CONST_I32_MIN: i64 = -2147483647 - 1

// Per-type property cache stored in types.data2, avoids redundant recursive queries.
val TYPE_CACHE_HAS_ARENA_COMPUTED: i64 = 1
val TYPE_CACHE_HAS_ARENA_VALUE: i64 = 2
val TYPE_CACHE_NON_COPYABLE_COMPUTED: i64 = 4
val TYPE_CACHE_NON_COPYABLE_VALUE: i64 = 8
val TYPE_CACHE_VALUE_COMPAT_COMPUTED: i64 = 16
val TYPE_CACHE_VALUE_COMPAT_VALUE: i64 = 32

pub value CheckResult {
    scopes: span.Range,
    symbols: span.Range,
    types: span.Range,
    diags: span.Range
}

value TypePathResolution {
    type_id: i64,
    symbol_id: i64
}

value ScalarPatternInfo {
    wildcard: bool,
    has_value: bool,
    literal_value: i64
}

value ScalarCoverageState {
    has_true: bool,
    has_false: bool
}

value IntegerLiteralEval {
    known: bool,
    overflow: bool,
    int_value: i64
}

table ArenaDependencies {
    func_symbol: i64,
    callee_symbol: i64
}

table DeferredArenaChecks {
    call_node: i64,
    callee_symbol: i64,
    arena_symbol: i64
}

// Reuse one bit-test helper so parser metadata stays readable here too.
func flag_has(flags: i64, bit: i64): bool = {
    (flags & bit) != 0
}

// Module scopes are the first N scopes created in module_id order, so direct index works.
func module_scope_id(ref scopes_table: scopes.Scopes, module_id: i64): i64 = {
    assert module_id >= 0
    assert module_id < table_len(ref scopes_table)
    assert scopes_table.parent[module_id] < 0
    module_id
}

// Function-level arena escape tracking needs the owning function symbol from any nested scope.
func scope_enclosing_function_symbol(
    ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    scope_id: i64
): i64 = {
    mut current_scope: i64 = scope_id
    while (current_scope >= 0) {
        val owner_node: i64 = scopes_table.owner_node[current_scope]
        if (owner_node >= 0 &&
            (nodes.kind[owner_node] == node.NodeKind.FuncDecl ||
             nodes.kind[owner_node] == node.NodeKind.NativeFuncDecl)) {
            return nodes.symbol_id[owner_node]
        }
        current_scope = scopes_table.parent[current_scope]
    }
    symbols.invalid_symbol_id()
}

// New symbols are appended in source order on each scope-local linked list.
func scope_append_symbol(
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    scope_id: i64,
    symbol_id: i64
): void = {
    if (scopes_table.first_symbol[scope_id] < 0) {
        scopes_table.first_symbol[scope_id] = symbol_id
    } else {
        symbols_table.next_symbol[scopes_table.last_symbol[scope_id]] = symbol_id
    }
    scopes_table.last_symbol[scope_id] = symbol_id

    val kind: symbols.SymbolKind = symbols_table.kind[symbol_id]
    if (is_value_symbol(kind)) {
        if (scopes_table.first_value_symbol[scope_id] < 0) {
            scopes_table.first_value_symbol[scope_id] = symbol_id
        } else {
            symbols_table.next_value_symbol[scopes_table.last_value_symbol[scope_id]] = symbol_id
        }
        scopes_table.last_value_symbol[scope_id] = symbol_id
    }
    if (is_runtime_value_symbol(kind)) {
        if (scopes_table.first_runtime_value_symbol[scope_id] < 0) {
            scopes_table.first_runtime_value_symbol[scope_id] = symbol_id
        } else {
            symbols_table.next_runtime_value_symbol[scopes_table.last_runtime_value_symbol[scope_id]] = symbol_id
        }
        scopes_table.last_runtime_value_symbol[scope_id] = symbol_id
    }
    if (kind == symbols.SymbolKind.ModuleAliasSymbol) {
        if (scopes_table.first_module_alias_symbol[scope_id] < 0) {
            scopes_table.first_module_alias_symbol[scope_id] = symbol_id
        } else {
            symbols_table.next_module_alias_symbol[scopes_table.last_module_alias_symbol[scope_id]] = symbol_id
        }
        scopes_table.last_module_alias_symbol[scope_id] = symbol_id
    }
    if (kind == symbols.SymbolKind.FunctionSymbol) {
        if (scopes_table.first_function_symbol[scope_id] < 0) {
            scopes_table.first_function_symbol[scope_id] = symbol_id
        } else {
            symbols_table.next_function_symbol[scopes_table.last_function_symbol[scope_id]] = symbol_id
        }
        scopes_table.last_function_symbol[scope_id] = symbol_id
    }
    if (kind == symbols.SymbolKind.TypeSymbol) {
        if (scopes_table.first_type_symbol[scope_id] < 0) {
            scopes_table.first_type_symbol[scope_id] = symbol_id
        } else {
            symbols_table.next_type_symbol[scopes_table.last_type_symbol[scope_id]] = symbol_id
        }
        scopes_table.last_type_symbol[scope_id] = symbol_id
    }
}

// Keep token-name comparisons centralized so all namespace searches behave the same way.
func token_name_eq(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    left_token: i64,
    right_token: i64
): bool = {
    val left: [u8] = token_text_or_synthetic(ref sources, ref text_pool, ref tokens, left_token)
    val right: [u8] = token_text_or_synthetic(ref sources, ref text_pool, ref tokens, right_token)
    string.str_eq(ref left, ref right)
}

// Field and synthetic-type checks sometimes compare against fixed spelling.
func token_text_or_synthetic(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    token_id: i64
): [u8] = {
    if (token_id == SYNTHETIC_TOKEN_OS) {
        return "OS"
    }
    if (token_id == SYNTHETIC_TOKEN_TARGET_OS) {
        return "TARGET_OS"
    }
    if (token_id == SYNTHETIC_TOKEN_LINUX) {
        return "Linux"
    }
    if (token_id == SYNTHETIC_TOKEN_MACOS) {
        return "MacOS"
    }
    token.token_text(ref sources, ref text_pool, ref tokens, token_id)
}

// Synthetic injected names reuse the same comparison path as parsed identifiers.
func token_name_is(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    token_id: i64,
    ref wanted: [u8]
): bool = {
    val name: [u8] = token_text_or_synthetic(ref sources, ref text_pool, ref tokens, token_id)
    string.str_eq(ref name, ref wanted)
}

// Later diagnostics occasionally need a symbol/type spelling that may be injected.
func name_text(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    name_token: i64
): [u8] = {
    token_text_or_synthetic(ref sources, ref text_pool, ref tokens, name_token)
}

// Compiler intrinsics are still identified by spelling until sema grows dedicated rows.
func builtin_call_kind(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    token_id: i64
): i64 = {
    if (token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "arena")) {
        return BUILTIN_CALL_ARENA
    }
    if (token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "arena_alloc")) {
        return BUILTIN_CALL_ARENA_ALLOC
    }
    if (token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "arena_reset")) {
        return BUILTIN_CALL_ARENA_RESET
    }
    if (token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "table_alloc")) {
        return BUILTIN_CALL_TABLE_ALLOC
    }
    if (token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "table_len")) {
        return BUILTIN_CALL_TABLE_LEN
    }
    if (token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "table_get")) {
        return BUILTIN_CALL_TABLE_GET
    }
    if (token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "table_insert")) {
        return BUILTIN_CALL_TABLE_INSERT
    }
    BUILTIN_CALL_NONE
}

// Native declarations are only valid for the compiler-provided runtime hooks.
func native_builtin_name_known(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    token_id: i64
): bool = {
    token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "fd_write") ||
    token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "fd_read") ||
    token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "fd_open") ||
    token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "fd_close") ||
    token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "fd_seek") ||
    token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "mem_copy") ||
    token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "exit") ||
    token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "args") ||
    token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "shell_run") ||
    token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "exe_dir") ||
    token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "pid") ||
    token_name_is(ref sources, ref text_pool, ref tokens, token_id, ref "time_ns")
}

// Native hook signatures are fixed by the stage-0 runtime boundary and must stay consistent across modules.
func native_param_matches(
    ref nodes: node.Nodes,
    param_id: i64,
    wanted_type: i64,
    wants_ref: bool,
    wants_mut: bool
): bool = {
    val has_ref: bool = decl_is_ref(ref nodes, param_id)
    val has_mut: bool = decl_is_mut(ref nodes, param_id)
    param_id >= 0 &&
    nodes.type_id[param_id] == wanted_type &&
    wants_ref == has_ref &&
    wants_mut == has_mut
}

// One shared message keeps native-signature diagnostics stable across all builtin hooks.
func native_signature_message(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    name_token: i64
): str = {
    val name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, name_token)
    message_named(mut ref mem, ref "Native function '", ref name, ref "' must use the compiler-provided signature")
}

// Native I/O hooks use dedicated diagnostics so callers see stable language-level errors, not generic arg mismatches.
func native_builtin_arg_is_fd_integer(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    name_token: i64,
    arg_index: i64
): bool = {
    arg_index == 0 &&
        (token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_write") ||
         token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_read") ||
         token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_close") ||
         token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_seek"))
}

// Byte-buffer native hooks share one compatibility contract across io and mem_copy.
func native_builtin_arg_is_byte_buffer(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    name_token: i64,
    arg_index: i64
): bool = {
    (arg_index == 0 &&
        token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_open")) ||
    (arg_index == 1 &&
        (token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_write") ||
         token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_read") ||
         token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "mem_copy"))) ||
    (arg_index == 0 &&
        token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "mem_copy"))
}

// Mutable-byte-buffer hooks reject immutable refs with a dedicated diagnostic.
func native_builtin_arg_requires_mutable_buffer(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    name_token: i64,
    arg_index: i64
): bool = {
    (arg_index == 1 &&
        token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_read")) ||
    (arg_index == 0 &&
        token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "mem_copy"))
}

// Known native names still need one exact signature contract so multi-module graphs lower to one C hook declaration.
func check_native_decl_signature(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    decl_id: i64
): bool = {
    val name_token: i64 = nodes.data0[decl_id]
    if (!native_builtin_name_known(ref sources, ref text_pool, ref tokens, name_token)) {
        return false
    }

    val byte_slice_type: i64 = types.type_slice(mut ref types_table, builtins.u8_type)
    val str_slice_type: i64 = types.type_slice(mut ref types_table, builtins.str_type)
    val param_count: i64 = nodes.data2[decl_id]
    val return_type: i64 = nodes.type_id[decl_id]
    mut valid: bool = false

    if (token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_write")) {
        valid = param_count == 2 &&
            return_type == builtins.i64_type &&
            native_param_matches(ref nodes, node.node_child_at(ref nodes, decl_id, 0), builtins.i32_type, false, false) &&
            native_param_matches(ref nodes, node.node_child_at(ref nodes, decl_id, 1), byte_slice_type, true, false)
    } else if (token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_read")) {
        valid = param_count == 2 &&
            return_type == builtins.i64_type &&
            native_param_matches(ref nodes, node.node_child_at(ref nodes, decl_id, 0), builtins.i32_type, false, false) &&
            native_param_matches(ref nodes, node.node_child_at(ref nodes, decl_id, 1), byte_slice_type, true, true)
    } else if (token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_open")) {
        valid = param_count == 2 &&
            return_type == builtins.i32_type &&
            native_param_matches(ref nodes, node.node_child_at(ref nodes, decl_id, 0), builtins.str_type, true, false) &&
            native_param_matches(ref nodes, node.node_child_at(ref nodes, decl_id, 1), builtins.i32_type, false, false)
    } else if (token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_close")) {
        valid = param_count == 1 &&
            return_type == builtins.void_type &&
            native_param_matches(ref nodes, node.node_child_at(ref nodes, decl_id, 0), builtins.i32_type, false, false)
    } else if (token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "fd_seek")) {
        valid = param_count == 3 &&
            return_type == builtins.i64_type &&
            native_param_matches(ref nodes, node.node_child_at(ref nodes, decl_id, 0), builtins.i32_type, false, false) &&
            native_param_matches(ref nodes, node.node_child_at(ref nodes, decl_id, 1), builtins.i64_type, false, false) &&
            native_param_matches(ref nodes, node.node_child_at(ref nodes, decl_id, 2), builtins.i32_type, false, false)
    } else if (token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "mem_copy")) {
        valid = param_count == 2 &&
            return_type == builtins.i64_type &&
            native_param_matches(ref nodes, node.node_child_at(ref nodes, decl_id, 0), byte_slice_type, true, true) &&
            native_param_matches(ref nodes, node.node_child_at(ref nodes, decl_id, 1), byte_slice_type, true, false)
    } else if (token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "exit")) {
        valid = param_count == 1 &&
            return_type == builtins.void_type &&
            native_param_matches(ref nodes, node.node_child_at(ref nodes, decl_id, 0), builtins.i32_type, false, false)
    } else if (token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "args")) {
        valid = param_count == 1 &&
            return_type == str_slice_type &&
            native_param_matches(ref nodes, node.node_child_at(ref nodes, decl_id, 0), builtins.arena_type, true, true)
    } else if (token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "shell_run")) {
        valid = param_count == 1 &&
            return_type == builtins.i32_type &&
            native_param_matches(ref nodes, node.node_child_at(ref nodes, decl_id, 0), builtins.str_type, true, false)
    } else if (token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "exe_dir")) {
        valid = param_count == 1 &&
            return_type == builtins.str_type &&
            native_param_matches(ref nodes, node.node_child_at(ref nodes, decl_id, 0), builtins.arena_type, true, true)
    } else if (token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "pid")) {
        valid = param_count == 0 &&
            return_type == builtins.i64_type
    } else if (token_name_is(ref sources, ref text_pool, ref tokens, name_token, ref "time_ns")) {
        valid = param_count == 0 &&
            return_type == builtins.i64_type
    }

    if (!valid) {
        val message: str = native_signature_message(mut ref mem, ref sources, ref text_pool, ref tokens, name_token)
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, name_token, ref "S090", ref message)
    }
    valid
}

// Keep short diagnostic string assembly out of the resolution loops.
func message_named(mut ref mem: Arena, ref prefix: [u8], ref name: [u8], ref suffix: [u8]): str = {
    string.str_concat3(mut ref mem, ref prefix, ref name, ref suffix)
}

// Module-qualified messages need one extra concatenation step for the alias text.
func message_named_in_module(
    mut ref mem: Arena,
    ref prefix: [u8],
    ref name: [u8],
    ref middle: [u8],
    ref module_name: [u8]
): str = {
    val head: str = string.str_concat3(mut ref mem, ref prefix, ref name, ref middle)
    string.str_concat3(mut ref mem, ref head, ref module_name, ref "'")
}

// Most semantic diagnostics point at one token row rather than a whole node span.
func diag_error_token(
    mut ref mem: Arena,
    ref tokens: token.Tokens,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    token_id: i64,
    ref code: [u8],
    ref message: [u8]
): void = {
    diag.diag_error(
        mut ref mem,
        mut ref diags,
        mut ref diag_pool,
        ref code,
        tokens.source_id[token_id],
        tokens.start[token_id],
        tokens.len[token_id],
        ref message
    )
}

// Expression and statement diagnostics often want the full node span instead of one token.
func diag_error_node(
    mut ref mem: Arena,
    ref nodes: node.Nodes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    node_id: i64,
    ref code: [u8],
    ref message: [u8]
): void = {
    diag.diag_error(
        mut ref mem,
        mut ref diags,
        mut ref diag_pool,
        ref code,
        nodes.source_id[node_id],
        nodes.start[node_id],
        nodes.span_len[node_id],
        ref message
    )
}

// Duplicate checks treat module aliases like value names even though expressions do not.
func is_value_symbol(kind: symbols.SymbolKind): bool = {
    kind == symbols.SymbolKind.ModuleAliasSymbol ||
    kind == symbols.SymbolKind.GlobalSymbol ||
    kind == symbols.SymbolKind.ParamSymbol ||
    kind == symbols.SymbolKind.LocalSymbol
}

// Runtime expression lookup excludes module aliases unless a qualified access follows.
func is_runtime_value_symbol(kind: symbols.SymbolKind): bool = {
    kind == symbols.SymbolKind.GlobalSymbol ||
    kind == symbols.SymbolKind.ParamSymbol ||
    kind == symbols.SymbolKind.LocalSymbol
}

// Module-alias lookup is separate from normal value lookup at qualified call/type sites.
func scope_find_module_alias_local(
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    scope_id: i64,
    name_token: i64
): i64 = {
    mut symbol_id: i64 = scopes_table.first_module_alias_symbol[scope_id]
    while (symbol_id >= 0) {
        if (token_name_eq(
                ref sources,
                ref text_pool,
                ref tokens,
                symbols_table.name_token[symbol_id],
                name_token
            )) {
            return symbol_id
        }
        symbol_id = symbols_table.next_module_alias_symbol[symbol_id]
    }
    symbols.invalid_symbol_id()
}

// Duplicate-value checks only care about the current lexical scope.
func scope_find_value_local(
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    scope_id: i64,
    name_token: i64
): i64 = {
    mut symbol_id: i64 = scopes_table.first_value_symbol[scope_id]
    while (symbol_id >= 0) {
        if (is_value_symbol(symbols_table.kind[symbol_id]) &&
            token_name_eq(
                ref sources,
                ref text_pool,
                ref tokens,
                symbols_table.name_token[symbol_id],
                name_token
            )) {
            return symbol_id
        }
        symbol_id = symbols_table.next_value_symbol[symbol_id]
    }
    symbols.invalid_symbol_id()
}

// Value lookup walks parent scopes outward until it finds the first matching binding.
func scope_find_value_visible(
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    scope_id: i64,
    name_token: i64
): i64 = {
    mut current_scope: i64 = scope_id
    while (current_scope >= 0) {
        mut symbol_id: i64 = scopes_table.first_runtime_value_symbol[current_scope]
        while (symbol_id >= 0) {
            if (token_name_eq(
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    symbols_table.name_token[symbol_id],
                    name_token
                )) {
                return symbol_id
            }
            symbol_id = symbols_table.next_runtime_value_symbol[symbol_id]
        }
        current_scope = scopes_table.parent[current_scope]
    }
    symbols.invalid_symbol_id()
}

// Function lookup prefers native hooks (prefer_public=false) or public wrappers (prefer_public=true).
func module_find_function(
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    scope_id: i64,
    name_token: i64,
    prefer_public: bool
): i64 = {
    mut first_match: i64 = symbols.invalid_symbol_id()
    mut symbol_id: i64 = scopes_table.first_function_symbol[scope_id]
    while (symbol_id >= 0) {
        if (token_name_eq(
                ref sources,
                ref text_pool,
                ref tokens,
                symbols_table.name_token[symbol_id],
                name_token
            )) {
            if (first_match < 0) {
                first_match = symbol_id
            }
            if (prefer_public) {
                if (symbols.symbol_is_public(ref symbols_table, symbol_id)) {
                    return symbol_id
                }
            } else {
                if (symbols.symbol_is_native(ref symbols_table, symbol_id)) {
                    return symbol_id
                }
            }
        }
        symbol_id = symbols_table.next_function_symbol[symbol_id]
    }
    first_match
}


// One native declaration may share a name with one regular wrapper, but same-kind duplicates stay illegal.
func module_find_same_kind_function(
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    scope_id: i64,
    name_token: i64,
    wants_native: bool
): i64 = {
    mut symbol_id: i64 = scopes_table.first_function_symbol[scope_id]
    while (symbol_id >= 0) {
        if (token_name_eq(
                ref sources,
                ref text_pool,
                ref tokens,
                symbols_table.name_token[symbol_id],
                name_token
            ) &&
            symbols.symbol_is_native(ref symbols_table, symbol_id) == wants_native) {
            return symbol_id
        }
        symbol_id = symbols_table.next_function_symbol[symbol_id]
    }
    symbols.invalid_symbol_id()
}

// Module-qualified values only target globals, never locals or parameters.
func module_find_global(
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    scope_id: i64,
    name_token: i64
): i64 = {
    mut symbol_id: i64 = scopes_table.first_runtime_value_symbol[scope_id]
    while (symbol_id >= 0) {
        if (token_name_eq(
                ref sources,
                ref text_pool,
                ref tokens,
                symbols_table.name_token[symbol_id],
                name_token
            )) {
                return symbol_id
            }
        symbol_id = symbols_table.next_runtime_value_symbol[symbol_id]
    }
    symbols.invalid_symbol_id()
}

// Type lookup is also module-local except for explicit module-qualified references.
func module_find_type(
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    scope_id: i64,
    name_token: i64
): i64 = {
    mut symbol_id: i64 = scopes_table.first_type_symbol[scope_id]
    while (symbol_id >= 0) {
        if (token_name_eq(
                ref sources,
                ref text_pool,
                ref tokens,
                symbols_table.name_token[symbol_id],
                name_token
            )) {
            return symbol_id
        }
        symbol_id = symbols_table.next_type_symbol[symbol_id]
    }
    symbols.invalid_symbol_id()
}

// Import edges are already recorded by the loader; sema only needs the target module id.
func import_target_module(
    ref modules: loader.Modules,
    ref imports: loader.ModuleImports,
    module_id: i64,
    import_node: i64
): i64 = {
    mut import_id: i64 = modules.first_import[module_id]
    while (import_id >= 0) {
        if (imports.import_node[import_id] == import_node) {
            return imports.to_module[import_id]
        }
        import_id = imports.next_import[import_id]
    }
    -1
}

// Decl helpers keep parser flag decoding local to sema.
func decl_is_pub(ref nodes: node.Nodes, node_id: i64): bool = {
    flag_has(nodes.data1[node_id], CHECK_NODE_FLAG_PUB)
}

// Type annotations are optional for immutable val declarations only.
func decl_has_type(ref nodes: node.Nodes, node_id: i64): bool = {
    flag_has(nodes.data1[node_id], CHECK_NODE_FLAG_HAS_TYPE)
}

// Mutability is shared between globals, locals, and loop variables.
func decl_is_mut(ref nodes: node.Nodes, node_id: i64): bool = {
    flag_has(nodes.data1[node_id], CHECK_NODE_FLAG_MUT)
}

// Parameters carry one explicit ref bit so later typechecking can reuse it.
func decl_is_ref(ref nodes: node.Nodes, node_id: i64): bool = {
    flag_has(nodes.data1[node_id], CHECK_NODE_FLAG_REF)
}

// Native functions skip body checking but still participate in symbol collection.
func decl_is_native(ref nodes: node.Nodes, node_id: i64): bool = {
    flag_has(nodes.data1[node_id], CHECK_NODE_FLAG_NATIVE)
}

// Map syntax decl kinds into the internal type table kinds.
func named_type_kind(kind: node.NodeKind): types.TypeKind = {
    if (kind == node.NodeKind.ValueDecl) {
        return types.TypeKind.ValueType
    }
    if (kind == node.NodeKind.StructDecl) {
        return types.TypeKind.StructType
    }
    if (kind == node.NodeKind.TableDecl) {
        return types.TypeKind.TableType
    }
    types.TypeKind.EnumType
}

// Compiler-injected `OS` stays one shared enum type so all modules compare the same type id.
func inject_builtin_os_type(mut ref nodes: node.Nodes, mut ref types_table: types.Types): i64 = {
    val enum_decl: i64 = node.node_push(mut ref nodes, node.NodeKind.EnumDecl, -1, 0, 0, SYNTHETIC_TOKEN_OS, 0, 0)
    val linux_variant: i64 = node.node_push(mut ref nodes, node.NodeKind.VariantDecl, -1, 0, 0, SYNTHETIC_TOKEN_LINUX, 0, 0)
    val macos_variant: i64 = node.node_push(mut ref nodes, node.NodeKind.VariantDecl, -1, 0, 0, SYNTHETIC_TOKEN_MACOS, 0, 0)
    node.node_append_child(mut ref nodes, enum_decl, linux_variant)
    node.node_append_child(mut ref nodes, enum_decl, macos_variant)
    types.types_push(mut ref types_table, types.TypeKind.EnumType, -1, enum_decl, -1, 0, 0, 0)
}

// Each module gets the injected type/value bindings in its root scope before user decls.
func inject_module_builtins(
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    module_id: i64,
    os_type: i64
): void = {
    val module_scope: i64 = module_scope_id(ref scopes_table, module_id)

    val os_symbol: i64 = symbols.symbols_push(
        mut ref symbols_table,
        symbols.SymbolKind.TypeSymbol,
        module_id,
        module_scope,
        -1,
        SYNTHETIC_TOKEN_OS,
        os_type,
        -1,
        0
    )
    scope_append_symbol(mut ref scopes_table, mut ref symbols_table, module_scope, os_symbol)

    val target_os_symbol: i64 = symbols.symbols_push(
        mut ref symbols_table,
        symbols.SymbolKind.GlobalSymbol,
        module_id,
        module_scope,
        -1,
        SYNTHETIC_TOKEN_TARGET_OS,
        os_type,
        -1,
        0
    )
    scope_append_symbol(mut ref scopes_table, mut ref symbols_table, module_scope, target_os_symbol)
}

// Top-level import aliases live in the value namespace of the module scope.
func bind_import_decl(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref modules: loader.Modules,
    ref imports: loader.ModuleImports,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    module_id: i64,
    module_scope: i64,
    import_node: i64
): void = {
    val alias_token: i64 = nodes.data0[import_node]
    if (scope_find_value_local(
        ref scopes_table,
        ref symbols_table,
        ref sources,
        ref text_pool,
        ref tokens,
        module_scope,
        alias_token
    ) >= 0) {
        val alias_name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, alias_token)
        val message: str = message_named(
            mut ref mem,
            ref "Variable '",
            ref alias_name,
            ref "' already declared in this scope"
        )
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, alias_token, ref "S001", ref message)
        return
    }

    val symbol_id: i64 = symbols.symbols_push(
        mut ref symbols_table,
        symbols.SymbolKind.ModuleAliasSymbol,
        module_id,
        module_scope,
        import_node,
        alias_token,
        types.invalid_type_id(),
        import_target_module(ref modules, ref imports, module_id, import_node),
        0
    )
    scope_append_symbol(mut ref scopes_table, mut ref symbols_table, module_scope, symbol_id)
    nodes.symbol_id[import_node] = symbol_id
}

// Function symbols are collected before bodies so later calls can resolve forward references.
func bind_func_decl(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    module_id: i64,
    module_scope: i64,
    decl_id: i64
): void = {
    val name_token: i64 = nodes.data0[decl_id]
    if (module_find_same_kind_function(
        ref scopes_table,
        ref symbols_table,
        ref sources,
        ref text_pool,
        ref tokens,
        module_scope,
        name_token,
        decl_is_native(ref nodes, decl_id)
    ) >= 0) {
        val name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, name_token)
        val message: str = message_named(mut ref mem, ref "Duplicate function '", ref name, ref "'")
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, name_token, ref "S008", ref message)
        return
    }

    mut flags: i64 = 0
    if (decl_is_pub(ref nodes, decl_id)) {
        flags |= 1
    }
    if (decl_is_native(ref nodes, decl_id)) {
        flags |= 8
    }

    val symbol_id: i64 = symbols.symbols_push(
        mut ref symbols_table,
        symbols.SymbolKind.FunctionSymbol,
        module_id,
        module_scope,
        decl_id,
        name_token,
        types.invalid_type_id(),
        -1,
        flags
    )
    scope_append_symbol(mut ref scopes_table, mut ref symbols_table, module_scope, symbol_id)
    nodes.symbol_id[decl_id] = symbol_id
}

// Globals share the same value namespace as import aliases inside the module scope.
func bind_global_decl(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    module_id: i64,
    module_scope: i64,
    decl_id: i64
): void = {
    val name_token: i64 = nodes.data0[decl_id]
    if (scope_find_value_local(
        ref scopes_table,
        ref symbols_table,
        ref sources,
        ref text_pool,
        ref tokens,
        module_scope,
        name_token
    ) >= 0) {
        val name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, name_token)
        val message: str = message_named(
            mut ref mem,
            ref "Variable '",
            ref name,
            ref "' already declared in this scope"
        )
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, name_token, ref "S001", ref message)
        return
    }

    mut flags: i64 = 0
    if (decl_is_pub(ref nodes, decl_id)) {
        flags |= 1
    }
    if (decl_is_mut(ref nodes, decl_id)) {
        flags |= 2
    }

    val symbol_id: i64 = symbols.symbols_push(
        mut ref symbols_table,
        symbols.SymbolKind.GlobalSymbol,
        module_id,
        module_scope,
        decl_id,
        name_token,
        types.invalid_type_id(),
        -1,
        flags
    )
    scope_append_symbol(mut ref scopes_table, mut ref symbols_table, module_scope, symbol_id)
    nodes.symbol_id[decl_id] = symbol_id
}

// Type declarations are collected up front so later fields and bodies can resolve them.
func bind_type_decl(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    module_id: i64,
    module_scope: i64,
    decl_id: i64
): void = {
    val name_token: i64 = nodes.data0[decl_id]
    if (module_find_type(
        ref scopes_table,
        ref symbols_table,
        ref sources,
        ref text_pool,
        ref tokens,
        module_scope,
        name_token
    ) >= 0) {
        val name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, name_token)
        val message: str = message_named(
            mut ref mem,
            ref "Type name '",
            ref name,
            ref "' is already defined"
        )
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, name_token, ref "S070", ref message)
        return
    }

    mut flags: i64 = 0
    if (decl_is_pub(ref nodes, decl_id)) {
        flags |= 1
    }

    val symbol_id: i64 = symbols.symbols_push(
        mut ref symbols_table,
        symbols.SymbolKind.TypeSymbol,
        module_id,
        module_scope,
        decl_id,
        name_token,
        types.invalid_type_id(),
        -1,
        flags
    )
    scope_append_symbol(mut ref scopes_table, mut ref symbols_table, module_scope, symbol_id)

    val type_id: i64 = types.type_named(
        mut ref types_table,
        named_type_kind(nodes.kind[decl_id]),
        module_id,
        decl_id,
        symbol_id
    )
    symbols_table.type_id[symbol_id] = type_id
    nodes.symbol_id[decl_id] = symbol_id
    nodes.type_id[decl_id] = type_id
}

// One module collection pass binds only root declarations and imports.
func collect_module_symbols(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref modules: loader.Modules,
    ref imports: loader.ModuleImports,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    module_id: i64
): void = {
    val module_scope: i64 = module_scope_id(ref scopes_table, module_id)
    val root_id: i64 = modules.root_node[module_id]
    mut decl_id: i64 = nodes.first_child[root_id]
    while (decl_id >= 0) {
        val kind: node.NodeKind = nodes.kind[decl_id]
        if (kind == node.NodeKind.ImportDecl) {
            bind_import_decl(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                ref modules,
                ref imports,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref diags,
                mut ref diag_pool,
                module_id,
                module_scope,
                decl_id
            )
        } else {
            if (kind == node.NodeKind.FuncDecl || kind == node.NodeKind.NativeFuncDecl) {
                bind_func_decl(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    mut ref scopes_table,
                    mut ref symbols_table,
                    mut ref diags,
                    mut ref diag_pool,
                    module_id,
                    module_scope,
                    decl_id
                )
            } else {
                if (kind == node.NodeKind.VarDecl) {
                    bind_global_decl(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        mut ref scopes_table,
                        mut ref symbols_table,
                        mut ref diags,
                        mut ref diag_pool,
                        module_id,
                        module_scope,
                        decl_id
                    )
                } else {
                    if (kind == node.NodeKind.ValueDecl ||
                        kind == node.NodeKind.StructDecl ||
                        kind == node.NodeKind.TableDecl ||
                        kind == node.NodeKind.EnumDecl) {
                        bind_type_decl(
                            mut ref mem,
                            ref sources,
                            ref text_pool,
                            ref tokens,
                            mut ref nodes,
                            mut ref scopes_table,
                            mut ref symbols_table,
                            mut ref types_table,
                            mut ref diags,
                            mut ref diag_pool,
                            module_id,
                            module_scope,
                            decl_id
                        )
                    }
                }
            }
        }
        decl_id = nodes.next_sibling[decl_id]
    }
}

// Type references can temporarily resolve to module aliases while a field access is still open.
func resolve_type_node(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    module_id: i64,
    node_id: i64,
    allow_module_alias: bool
): i64 = {
    if (node_id < 0) {
        return types.invalid_type_id()
    }

    val kind: node.NodeKind = nodes.kind[node_id]
    if (kind == node.NodeKind.BuiltinType) {
        val type_id: i64 = types.builtin_type_from_token(ref builtins, tokens.kind[nodes.data0[node_id]])
        nodes.type_id[node_id] = type_id
        return type_id
    }
    if (kind == node.NodeKind.VoidType) {
        nodes.type_id[node_id] = builtins.void_type
        return builtins.void_type
    }
    if (kind == node.NodeKind.ArrayType) {
        val elem_node: i64 = node.node_child_at(ref nodes, node_id, 0)
        val elem_type: i64 = resolve_type_node(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            module_id,
            elem_node,
            false
        )
        if (elem_type < 0) {
            return types.invalid_type_id()
        }

        val size_text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[node_id])
        val size: i64 = match (string.str_to_i64(ref size_text)) {
            Ok(n) = { n }
            None = { -1 }
        }
        if (size <= 0) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S031", ref "Array size must be positive integer")
        }
        val type_id: i64 = types.type_array(mut ref types_table, elem_type, size)
        nodes.type_id[node_id] = type_id
        return type_id
    }
    if (kind == node.NodeKind.SliceType) {
        val elem_node: i64 = node.node_child_at(ref nodes, node_id, 0)
        val elem_type: i64 = resolve_type_node(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            module_id,
            elem_node,
            false
        )
        if (elem_type < 0) {
            return types.invalid_type_id()
        }

        val type_id: i64 = types.type_slice(mut ref types_table, elem_type)
        nodes.type_id[node_id] = type_id
        return type_id
    }
    if (kind == node.NodeKind.Identifier) {
        val name_token: i64 = nodes.data0[node_id]
        val current_scope: i64 = module_scope_id(ref scopes_table, module_id)
        if (allow_module_alias) {
            val alias_symbol: i64 = scope_find_module_alias_local(
                ref scopes_table,
                ref symbols_table,
                ref sources,
                ref text_pool,
                ref tokens,
                current_scope,
                name_token
            )
            if (alias_symbol >= 0) {
                nodes.symbol_id[node_id] = alias_symbol
                return types.invalid_type_id()
            }
        }

        val type_symbol: i64 = module_find_type(
            ref scopes_table,
            ref symbols_table,
            ref sources,
            ref text_pool,
            ref tokens,
            current_scope,
            name_token
        )
        if (type_symbol >= 0) {
            nodes.symbol_id[node_id] = type_symbol
            nodes.type_id[node_id] = symbols_table.type_id[type_symbol]
            return symbols_table.type_id[type_symbol]
        }

        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, name_token, ref "P015", ref "Expected type")
        return types.invalid_type_id()
    }
    if (kind == node.NodeKind.FieldAccess) {
        val left_id: i64 = node.node_child_at(ref nodes, node_id, 0)
        val field_token: i64 = nodes.data0[node_id]
        val left_type: i64 = resolve_type_node(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            module_id,
            left_id,
            true
        )

        val left_symbol: i64 = nodes.symbol_id[left_id]
        if (left_symbol >= 0 && symbols_table.kind[left_symbol] == symbols.SymbolKind.ModuleAliasSymbol) {
            val target_module: i64 = symbols_table.target_module[left_symbol]
            val target_scope: i64 = module_scope_id(ref scopes_table, target_module)
            val type_symbol: i64 = module_find_type(
                ref scopes_table,
                ref symbols_table,
                ref sources,
                ref text_pool,
                ref tokens,
                target_scope,
                field_token
            )
            if (type_symbol < 0) {
                val type_name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, field_token)
                val module_name: [u8] = name_text(ref sources, ref text_pool, ref tokens, symbols_table.name_token[left_symbol])
                val message: str = message_named_in_module(
                    mut ref mem,
                    ref "Unknown type '",
                    ref type_name,
                    ref "' in module '",
                    ref module_name
                )
                diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, field_token, ref "P015", ref message)
                return types.invalid_type_id()
            }

            if (!symbols.symbol_is_public(ref symbols_table, type_symbol)) {
                val type_name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, field_token)
                val module_name: [u8] = name_text(ref sources, ref text_pool, ref tokens, symbols_table.name_token[left_symbol])
                val message: str = message_named_in_module(
                    mut ref mem,
                    ref "Type '",
                    ref type_name,
                    ref "' is not public in module '",
                    ref module_name
                )
                diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, field_token, ref "S084", ref message)
            }

            nodes.symbol_id[node_id] = type_symbol
            nodes.type_id[node_id] = symbols_table.type_id[type_symbol]
            return symbols_table.type_id[type_symbol]
        }

        if (left_type >= 0 &&
            types_table.kind[left_type] == types.TypeKind.TableType &&
            token_name_is(ref sources, ref text_pool, ref tokens, field_token, ref "Row")) {
            val type_id: i64 = types.type_table_row(
                mut ref types_table,
                types_table.module_id[left_type],
                types_table.decl_node[left_type],
                left_type
            )
            nodes.type_id[node_id] = type_id
            return type_id
        }

        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, field_token, ref "P015", ref "Expected type")
        return types.invalid_type_id()
    }

    diag.diag_error(
        mut ref mem,
        mut ref diags,
        mut ref diag_pool,
        ref "P015",
        nodes.source_id[node_id],
        nodes.start[node_id],
        nodes.span_len[node_id],
        ref "Expected type"
    )
    types.invalid_type_id()
}

// Bare identifiers in expression position bind against the lexical value namespace.
func resolve_value_identifier(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    scope_id: i64,
    node_id: i64
): void = {
    val name_token: i64 = nodes.data0[node_id]
    val symbol_id: i64 = scope_find_value_visible(
        ref scopes_table,
        ref symbols_table,
        ref sources,
        ref text_pool,
        ref tokens,
        scope_id,
        name_token
    )
    if (symbol_id >= 0) {
        nodes.symbol_id[node_id] = symbol_id
        nodes.type_id[node_id] = symbols_table.type_id[symbol_id]
        return
    }

    val name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, name_token)
    val message: str = message_named(mut ref mem, ref "Undeclared variable '", ref name, ref "'")
    diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, name_token, ref "S002", ref message)
}

// Unqualified function calls only see functions declared in the current module.
func resolve_call_identifier(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    module_id: i64,
    node_id: i64,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf
): void = {
    val name_token: i64 = nodes.data0[node_id]
    val module_scope: i64 = module_scope_id(ref scopes_table, module_id)
    val symbol_id: i64 = module_find_function(
        ref scopes_table,
        ref symbols_table,
        ref sources,
        ref text_pool,
        ref tokens,
        module_scope,
        name_token,
        false
    )
    if (symbol_id >= 0) {
        nodes.symbol_id[node_id] = symbol_id
        nodes.type_id[node_id] = symbols_table.type_id[symbol_id]
        return
    }

    if (native_builtin_name_known(ref sources, ref text_pool, ref tokens, name_token)) {
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, name_token, ref "S087", ref "Built-in function requires native declaration in the current module")
    } else {
        val name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, name_token)
        val message: str = message_named(mut ref mem, ref "Undefined function '", ref name, ref "'")
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, name_token, ref "S016", ref message)
    }
}

// Qualified function calls resolve through an already bound module-alias symbol.
func resolve_qualified_call(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    node_id: i64,
    alias_symbol: i64,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf
): void = {
    val field_token: i64 = nodes.data0[node_id]
    val target_scope: i64 = module_scope_id(ref scopes_table, symbols_table.target_module[alias_symbol])
    val symbol_id: i64 = module_find_function(
        ref scopes_table,
        ref symbols_table,
        ref sources,
        ref text_pool,
        ref tokens,
        target_scope,
        field_token,
        true
    )
    if (symbol_id < 0) {
        val name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, field_token)
        val module_name: [u8] = name_text(ref sources, ref text_pool, ref tokens, symbols_table.name_token[alias_symbol])
        val message: str = message_named_in_module(
            mut ref mem,
            ref "Function '",
            ref name,
            ref "' not found in module '",
            ref module_name
        )
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, field_token, ref "S016", ref message)
        return
    }

    if (!symbols.symbol_is_public(ref symbols_table, symbol_id)) {
        val name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, field_token)
        val module_name: [u8] = name_text(ref sources, ref text_pool, ref tokens, symbols_table.name_token[alias_symbol])
        val message: str = message_named_in_module(
            mut ref mem,
            ref "Function '",
            ref name,
            ref "' is not public in module '",
            ref module_name
        )
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, field_token, ref "S083", ref message)
    }

    nodes.symbol_id[node_id] = symbol_id
    nodes.type_id[node_id] = symbols_table.type_id[symbol_id]
}

// Qualified value lookup is limited to globals in the target module root scope.
func resolve_qualified_value(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    node_id: i64,
    alias_symbol: i64,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf
): void = {
    val field_token: i64 = nodes.data0[node_id]
    val target_scope: i64 = module_scope_id(ref scopes_table, symbols_table.target_module[alias_symbol])
    val symbol_id: i64 = module_find_global(
        ref scopes_table,
        ref symbols_table,
        ref sources,
        ref text_pool,
        ref tokens,
        target_scope,
        field_token
    )
    if (symbol_id < 0) {
        val name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, field_token)
        val message: str = message_named(mut ref mem, ref "Undeclared variable '", ref name, ref "'")
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, field_token, ref "S002", ref message)
        return
    }

    if (!symbols.symbol_is_public(ref symbols_table, symbol_id)) {
        val name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, field_token)
        val module_name: [u8] = name_text(ref sources, ref text_pool, ref tokens, symbols_table.name_token[alias_symbol])
        val message: str = message_named_in_module(
            mut ref mem,
            ref "Value '",
            ref name,
            ref "' is not public in module '",
            ref module_name
        )
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, field_token, ref "S085", ref message)
    }

    nodes.symbol_id[node_id] = symbol_id
    nodes.type_id[node_id] = symbols_table.type_id[symbol_id]
}

// Enum variants in expression position reuse the type-namespace path grammar silently.
func resolve_expr_type_path(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    module_id: i64,
    node_id: i64
): TypePathResolution = {
    if (node_id < 0) {
        return TypePathResolution {
            type_id: types.invalid_type_id(),
            symbol_id: symbols.invalid_symbol_id()
        }
    }

    if (nodes.kind[node_id] == node.NodeKind.Identifier) {
        val name_token: i64 = nodes.data0[node_id]
        val module_scope: i64 = module_scope_id(ref scopes_table, module_id)
        val alias_symbol: i64 = scope_find_module_alias_local(
            ref scopes_table,
            ref symbols_table,
            ref sources,
            ref text_pool,
            ref tokens,
            module_scope,
            name_token
        )
        if (alias_symbol >= 0) {
            return TypePathResolution {
                type_id: types.invalid_type_id(),
                symbol_id: alias_symbol
            }
        }

        val type_symbol: i64 = module_find_type(
            ref scopes_table,
            ref symbols_table,
            ref sources,
            ref text_pool,
            ref tokens,
            module_scope,
            name_token
        )
        if (type_symbol >= 0) {
            return TypePathResolution {
                type_id: symbols_table.type_id[type_symbol],
                symbol_id: type_symbol
            }
        }

        return TypePathResolution {
            type_id: types.invalid_type_id(),
            symbol_id: symbols.invalid_symbol_id()
        }
    }

    if (nodes.kind[node_id] == node.NodeKind.FieldAccess) {
        val left_id: i64 = node.node_child_at(ref nodes, node_id, 0)
        val field_token: i64 = nodes.data0[node_id]
        val left: TypePathResolution = resolve_expr_type_path(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            module_id,
            left_id
        )

        if (left.symbol_id >= 0 && symbols_table.kind[left.symbol_id] == symbols.SymbolKind.ModuleAliasSymbol) {
            val target_scope: i64 = module_scope_id(ref scopes_table, symbols_table.target_module[left.symbol_id])
            val type_symbol: i64 = module_find_type(
                ref scopes_table,
                ref symbols_table,
                ref sources,
                ref text_pool,
                ref tokens,
                target_scope,
                field_token
            )
            if (type_symbol >= 0) {
                return TypePathResolution {
                    type_id: symbols_table.type_id[type_symbol],
                    symbol_id: type_symbol
                }
            }
            return TypePathResolution {
                type_id: types.invalid_type_id(),
                symbol_id: symbols.invalid_symbol_id()
            }
        }

        if (left.type_id >= 0 &&
            types_table.kind[left.type_id] == types.TypeKind.TableType &&
            token_name_is(ref sources, ref text_pool, ref tokens, field_token, ref "Row")) {
            return TypePathResolution {
                type_id: types.type_table_row(
                    mut ref types_table,
                    types_table.module_id[left.type_id],
                    types_table.decl_node[left.type_id],
                    left.type_id
                ),
                symbol_id: symbols.invalid_symbol_id()
            }
        }
    }

    TypePathResolution {
        type_id: types.invalid_type_id(),
        symbol_id: symbols.invalid_symbol_id()
    }
}

// Keep scalar operator checks on one builtin-kind table.
func type_is_numeric_builtin(ref types_table: types.Types, type_id: i64): bool = {
    if (type_id < 0) {
        return false
    }

    val kind: types.TypeKind = types_table.kind[type_id]
    kind == types.TypeKind.I64Type ||
    kind == types.TypeKind.I32Type ||
    kind == types.TypeKind.U8Type ||
    kind == types.TypeKind.U32Type ||
    kind == types.TypeKind.F64Type
}

// Integer-only operations share one helper instead of open-coded kind checks.
func type_is_integer_builtin(ref types_table: types.Types, type_id: i64): bool = {
    if (type_id < 0) {
        return false
    }

    val kind: types.TypeKind = types_table.kind[type_id]
    kind == types.TypeKind.I64Type ||
    kind == types.TypeKind.I32Type ||
    kind == types.TypeKind.U8Type ||
    kind == types.TypeKind.U32Type
}

// Ref validation treats plain numeric and bool fields as scalar copy values.
func type_is_scalar_builtin(
    ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    type_id: i64
): bool = {
    type_is_numeric_builtin(ref types_table, type_id) ||
    type_id == builtins.bool_type
}

// Conditions and logical operators only accept the builtin bool row.
func type_is_bool_builtin(ref types_table: types.Types, type_id: i64): bool = {
    type_id >= 0 && types_table.kind[type_id] == types.TypeKind.BoolType
}

// Strings and byte slices need one shared compatibility rule for std helpers.
func type_is_byte_view(
    ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    type_id: i64
): bool = {
    if (type_id < 0) {
        return false
    }

    if (types_table.kind[type_id] == types.TypeKind.StrType) {
        return true
    }
    if ((types_table.kind[type_id] == types.TypeKind.SliceType ||
         types_table.kind[type_id] == types.TypeKind.ArrayType) &&
        types_table.data0[type_id] == builtins.u8_type) {
        return true
    }
    false
}

// Indexing and slicing all boil down to one element-type query.
func array_like_elem_type(
    ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    type_id: i64
): i64 = {
    if (type_id < 0) {
        return types.invalid_type_id()
    }

    if (types_table.kind[type_id] == types.TypeKind.ArrayType ||
        types_table.kind[type_id] == types.TypeKind.SliceType) {
        return types_table.data0[type_id]
    }
    if (types_table.kind[type_id] == types.TypeKind.StrType) {
        return builtins.u8_type
    }
    types.invalid_type_id()
}

// Slice expressions always produce a slice view over the same element type.
func array_like_slice_type(
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    type_id: i64
): i64 = {
    val elem_type: i64 = array_like_elem_type(ref types_table, ref builtins, type_id)
    if (elem_type < 0) {
        return types.invalid_type_id()
    }
    types.type_slice(mut ref types_table, elem_type)
}

// Signed literals are parsed as unary minus over a literal token in the current frontend.
func node_is_negative_literal(
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    node_id: i64,
    wants_float: bool
): bool = {
    if (node_id < 0 || nodes.kind[node_id] != node.NodeKind.UnaryExpr) {
        return false
    }
    if (tokens.kind[nodes.data0[node_id]] != token.TokenKind.Minus) {
        return false
    }

    val operand_id: i64 = node.node_child_at(ref nodes, node_id, 0)
    if (wants_float) {
        return operand_id >= 0 && nodes.kind[operand_id] == node.NodeKind.FloatLit
    }

    operand_id >= 0 &&
        (nodes.kind[operand_id] == node.NodeKind.NumberLit ||
         nodes.kind[operand_id] == node.NodeKind.CharLit)
}

// Integer literals stay flexible until a surrounding type check pins them down.
func node_is_integer_literal(ref tokens: token.Tokens, ref nodes: node.Nodes, node_id: i64): bool = {
    if (node_id < 0) {
        return false
    }
    nodes.kind[node_id] == node.NodeKind.NumberLit ||
    nodes.kind[node_id] == node.NodeKind.CharLit ||
    node_is_negative_literal(ref tokens, ref nodes, node_id, false)
}

// Float literals only coerce to f64 in the current bootstrap subset.
func node_is_float_literal(ref tokens: token.Tokens, ref nodes: node.Nodes, node_id: i64): bool = {
    (node_id >= 0 && nodes.kind[node_id] == node.NodeKind.FloatLit) ||
    node_is_negative_literal(ref tokens, ref nodes, node_id, true)
}

// Number tokens still parse through std/string so sema only keeps one overflow policy.
func number_token_integer_eval(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    token_id: i64
): IntegerLiteralEval = {
    val text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, token_id)
    val parsed: string.ParseResult = string.str_to_i64(ref text)
    val result: IntegerLiteralEval = match (parsed) {
        Ok(n) = {
            IntegerLiteralEval { known: true, overflow: false, int_value: n }
        }
        None = {
            IntegerLiteralEval { known: false, overflow: true, int_value: 0 }
        }
    }
    result
}

// The absolute text for i64 min is only valid after a unary minus applies the missing sign.
func integer_text_is_i64_min_abs(ref text: [u8]): bool = {
    string.str_eq(ref text, ref "9223372036854775808")
}

// Bindings need to reject overflowing integer tokens even when they sit inside a larger expression tree.
func expr_has_overflowing_integer_literal(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    node_id: i64
): bool = {
    if (node_id < 0) {
        return false
    }

    if (nodes.kind[node_id] == node.NodeKind.NumberLit) {
        return number_token_integer_eval(ref sources, ref text_pool, ref tokens, nodes.data0[node_id]).overflow
    }

    if (nodes.kind[node_id] == node.NodeKind.UnaryExpr &&
        tokens.kind[nodes.data0[node_id]] == token.TokenKind.Minus) {
        val operand_id: i64 = node.node_child_at(ref nodes, node_id, 0)
        if (operand_id >= 0 && nodes.kind[operand_id] == node.NodeKind.NumberLit) {
            val text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[operand_id])
            val operand_eval: IntegerLiteralEval = number_token_integer_eval(
                ref sources,
                ref text_pool,
                ref tokens,
                nodes.data0[operand_id]
            )
            return operand_eval.overflow && !integer_text_is_i64_min_abs(ref text)
        }
        return expr_has_overflowing_integer_literal(ref sources, ref text_pool, ref tokens, ref nodes, operand_id)
    }

    mut child_id: i64 = nodes.first_child[node_id]
    while (child_id >= 0) {
        if (expr_has_overflowing_integer_literal(ref sources, ref text_pool, ref tokens, ref nodes, child_id)) {
            return true
        }
        child_id = nodes.next_sibling[child_id]
    }
    false
}

// Subtraction overflow still needs a dedicated guard because signed wrap is not sema-visible.
func integer_sub_overflows(left_value: i64, right_value: i64): bool = {
    if (right_value > 0 && left_value < INT_CONST_I64_MIN + right_value) {
        return true
    }
    if (right_value < 0 && left_value > INT_CONST_I64_MAX + right_value) {
        return true
    }
    false
}

// Multiplication keeps the usual division-bound checks so sema never relies on wrapped results.
func integer_mul_overflows(left_value: i64, right_value: i64): bool = {
    if (left_value == 0 || right_value == 0) {
        return false
    }
    if ((left_value == INT_CONST_I64_MIN && right_value == -1) ||
        (right_value == INT_CONST_I64_MIN && left_value == -1)) {
        return true
    }

    if (left_value > 0) {
        if (right_value > 0) {
            return left_value > INT_CONST_I64_MAX / right_value
        }
        return right_value < INT_CONST_I64_MIN / left_value
    }

    if (right_value > 0) {
        return left_value < INT_CONST_I64_MIN / right_value
    }

    left_value < INT_CONST_I64_MAX / right_value
}

// Integer range checks fold the current constant subset so later diagnostics can reuse one evaluator.
func integer_literal_eval(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    node_id: i64
): IntegerLiteralEval = {
    if (node_id < 0) {
        return IntegerLiteralEval { known: false, overflow: false, int_value: 0 }
    }

    if (nodes.kind[node_id] == node.NodeKind.NumberLit) {
        return number_token_integer_eval(ref sources, ref text_pool, ref tokens, nodes.data0[node_id])
    }

    if (nodes.kind[node_id] == node.NodeKind.CharLit) {
        return IntegerLiteralEval {
            known: true,
            overflow: false,
            int_value: char_literal_value(ref sources, ref text_pool, ref tokens, nodes.data0[node_id])
        }
    }

    if (nodes.kind[node_id] == node.NodeKind.UnaryExpr &&
        tokens.kind[nodes.data0[node_id]] == token.TokenKind.Minus) {
        val operand_id: i64 = node.node_child_at(ref nodes, node_id, 0)
        if (operand_id >= 0 && nodes.kind[operand_id] == node.NodeKind.NumberLit) {
            val text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[operand_id])
            val operand_eval: IntegerLiteralEval = number_token_integer_eval(
                ref sources,
                ref text_pool,
                ref tokens,
                nodes.data0[operand_id]
            )
            if (operand_eval.overflow) {
                if (integer_text_is_i64_min_abs(ref text)) {
                    return IntegerLiteralEval { known: true, overflow: false, int_value: INT_CONST_I64_MIN }
                }
                return operand_eval
            }
            return IntegerLiteralEval {
                known: true,
                overflow: false,
                int_value: 0 - operand_eval.int_value
            }
        }

        val operand_eval: IntegerLiteralEval = integer_literal_eval(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            operand_id
        )
        if (!(operand_eval.known) || operand_eval.overflow) {
            return operand_eval
        }
        if (operand_eval.int_value == INT_CONST_I64_MIN) {
            return IntegerLiteralEval { known: false, overflow: true, int_value: 0 }
        }
        return IntegerLiteralEval {
            known: true,
            overflow: false,
            int_value: 0 - operand_eval.int_value
        }
    }

    if (nodes.kind[node_id] == node.NodeKind.BinaryExpr) {
        val op_kind: token.TokenKind = tokens.kind[nodes.data0[node_id]]
        if (op_kind != token.TokenKind.Plus &&
            op_kind != token.TokenKind.Minus &&
            op_kind != token.TokenKind.Star &&
            op_kind != token.TokenKind.Slash &&
            op_kind != token.TokenKind.Percent) {
            return IntegerLiteralEval { known: false, overflow: false, int_value: 0 }
        }

        val left_eval: IntegerLiteralEval = integer_literal_eval(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            node.node_child_at(ref nodes, node_id, 0)
        )
        val right_eval: IntegerLiteralEval = integer_literal_eval(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            node.node_child_at(ref nodes, node_id, 1)
        )
        if (left_eval.overflow || right_eval.overflow) {
            return IntegerLiteralEval { known: false, overflow: true, int_value: 0 }
        }
        if (!(left_eval.known) || !(right_eval.known)) {
            return IntegerLiteralEval { known: false, overflow: false, int_value: 0 }
        }

        if (op_kind == token.TokenKind.Plus) {
            if (right_eval.int_value > 0 && left_eval.int_value > INT_CONST_I64_MAX - right_eval.int_value) {
                return IntegerLiteralEval { known: false, overflow: true, int_value: 0 }
            }
            if (right_eval.int_value < 0 && left_eval.int_value < INT_CONST_I64_MIN - right_eval.int_value) {
                return IntegerLiteralEval { known: false, overflow: true, int_value: 0 }
            }
            return IntegerLiteralEval {
                known: true,
                overflow: false,
                int_value: left_eval.int_value + right_eval.int_value
            }
        }

        if (op_kind == token.TokenKind.Minus) {
            if (integer_sub_overflows(left_eval.int_value, right_eval.int_value)) {
                return IntegerLiteralEval { known: false, overflow: true, int_value: 0 }
            }
            return IntegerLiteralEval {
                known: true,
                overflow: false,
                int_value: left_eval.int_value - right_eval.int_value
            }
        }

        if (op_kind == token.TokenKind.Star) {
            if (integer_mul_overflows(left_eval.int_value, right_eval.int_value)) {
                return IntegerLiteralEval { known: false, overflow: true, int_value: 0 }
            }
            return IntegerLiteralEval {
                known: true,
                overflow: false,
                int_value: left_eval.int_value * right_eval.int_value
            }
        }

        if (right_eval.int_value == 0) {
            return IntegerLiteralEval { known: false, overflow: false, int_value: 0 }
        }
        if (left_eval.int_value == INT_CONST_I64_MIN && right_eval.int_value == -1) {
            return IntegerLiteralEval { known: false, overflow: true, int_value: 0 }
        }
        if (op_kind == token.TokenKind.Slash) {
            return IntegerLiteralEval {
                known: true,
                overflow: false,
                int_value: left_eval.int_value / right_eval.int_value
            }
        }
        return IntegerLiteralEval {
            known: true,
            overflow: false,
            int_value: left_eval.int_value % right_eval.int_value
        }
    }

    IntegerLiteralEval { known: false, overflow: false, int_value: 0 }
}

// Constant zero-divisor checks need to walk the whole expression tree, not just the top-level node.
func integer_expr_divides_by_zero(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    node_id: i64
): bool = {
    if (node_id < 0) {
        return false
    }

    if (nodes.kind[node_id] == node.NodeKind.BinaryExpr) {
        val op_kind: token.TokenKind = tokens.kind[nodes.data0[node_id]]
        if (op_kind == token.TokenKind.Slash || op_kind == token.TokenKind.Percent) {
            val right_eval: IntegerLiteralEval = integer_literal_eval(
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                node.node_child_at(ref nodes, node_id, 1)
            )
            if (right_eval.known && !(right_eval.overflow) && right_eval.int_value == 0) {
                return true
            }
        }
    }

    mut child_id: i64 = nodes.first_child[node_id]
    while (child_id >= 0) {
        if (integer_expr_divides_by_zero(ref sources, ref text_pool, ref tokens, ref nodes, child_id)) {
            return true
        }
        child_id = nodes.next_sibling[child_id]
    }
    false
}

// Arithmetic overflow also needs a tree walk so folded subexpressions cannot slip through bindings.
func integer_expr_arithmetic_overflows(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    node_id: i64
): bool = {
    if (node_id < 0) {
        return false
    }

    if (integer_literal_eval(ref sources, ref text_pool, ref tokens, ref nodes, node_id).overflow) {
        return true
    }

    if (nodes.kind[node_id] == node.NodeKind.UnaryExpr &&
        tokens.kind[nodes.data0[node_id]] == token.TokenKind.Minus) {
        val operand_id: i64 = node.node_child_at(ref nodes, node_id, 0)
        if (operand_id >= 0 && nodes.kind[operand_id] == node.NodeKind.NumberLit) {
            val text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[operand_id])
            if (integer_text_is_i64_min_abs(ref text)) {
                return false
            }
        }
    }

    mut child_id: i64 = nodes.first_child[node_id]
    while (child_id >= 0) {
        if (integer_expr_arithmetic_overflows(ref sources, ref text_pool, ref tokens, ref nodes, child_id)) {
            return true
        }
        child_id = nodes.next_sibling[child_id]
    }
    false
}

// Integer literal coercions still need one concrete target-range check for typed bindings.
func integer_value_fits_type(
    ref builtins: types.BuiltinTypes,
    target_type: i64,
    int_value: i64
): bool = {
    if (target_type == builtins.i64_type) {
        return true
    }
    if (target_type == builtins.i32_type) {
        return int_value >= INT_CONST_I32_MIN && int_value <= INT_CONST_I32_MAX
    }
    if (target_type == builtins.u32_type) {
        return int_value >= 0 && int_value <= 4294967295
    }
    if (target_type == builtins.u8_type) {
        return int_value >= 0 && int_value <= 255
    }
    false
}

// Typed and inferred integer bindings share the same constant-range diagnostics.
func check_integer_binding_diagnostics(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    type_id: i64,
    init_node: i64
): void = {
    if (expr_has_overflowing_integer_literal(ref sources, ref text_pool, ref tokens, ref nodes, init_node)) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, init_node, ref "P006", ref "Integer literal out of range")
        return
    }
    if (integer_expr_divides_by_zero(ref sources, ref text_pool, ref tokens, ref nodes, init_node)) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, init_node, ref "S019", ref "Division by zero in constant expression")
        return
    }
    if (integer_expr_arithmetic_overflows(ref sources, ref text_pool, ref tokens, ref nodes, init_node)) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, init_node, ref "S050", ref "Literal out of range for target type / integer overflow in constant expression")
        return
    }
    val literal_eval: IntegerLiteralEval = integer_literal_eval(
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        init_node
    )
    if (literal_eval.known &&
        integer_value_fits_type(ref builtins, type_id, literal_eval.int_value) == false) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, init_node, ref "S050", ref "Literal out of range for target type / integer overflow in constant expression")
    }
}

// Literal coercions and byte-slice compatibility stay in one reusable helper.
func expr_type_compatible(
    ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    expected_type: i64,
    actual_type: i64,
    value_node: i64,
    allow_array_to_slice: bool
): bool = {
    if (expected_type < 0 || actual_type < 0) {
        return false
    }
    if (expected_type == actual_type) {
        return true
    }

    if (node_is_integer_literal(ref tokens, ref nodes, value_node) &&
        type_is_numeric_builtin(ref types_table, expected_type)) {
        return true
    }
    if (node_is_float_literal(ref tokens, ref nodes, value_node) &&
        types_table.kind[expected_type] == types.TypeKind.F64Type) {
        return true
    }

    if (allow_array_to_slice &&
        types_table.kind[expected_type] == types.TypeKind.SliceType &&
        types_table.kind[actual_type] == types.TypeKind.ArrayType &&
        types_table.data0[expected_type] == types_table.data0[actual_type]) {
        return true
    }

    if (types_table.kind[expected_type] == types.TypeKind.StrType &&
        type_is_byte_view(ref types_table, ref builtins, actual_type)) {
        return true
    }
    if (types_table.kind[expected_type] == types.TypeKind.SliceType &&
        types_table.data0[expected_type] == builtins.u8_type &&
        type_is_byte_view(ref types_table, ref builtins, actual_type)) {
        return true
    }

    false
}

// Binary operators need one "expected common type" helper for literal coercions.
func numeric_common_type(
    ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    left_node: i64,
    left_type: i64,
    right_node: i64,
    right_type: i64
): i64 = {
    if (left_type < 0 || right_type < 0) {
        return types.invalid_type_id()
    }
    if (left_type == right_type) {
        return left_type
    }

    val left_is_float: bool = node_is_float_literal(ref tokens, ref nodes, left_node) ||
        types_table.kind[left_type] == types.TypeKind.F64Type
    val right_is_float: bool = node_is_float_literal(ref tokens, ref nodes, right_node) ||
        types_table.kind[right_type] == types.TypeKind.F64Type

    if (left_is_float && node_is_integer_literal(ref tokens, ref nodes, right_node)) {
        return builtins.f64_type
    }
    if (right_is_float && node_is_integer_literal(ref tokens, ref nodes, left_node)) {
        return builtins.f64_type
    }
    if (left_is_float && type_is_numeric_builtin(ref types_table, right_type)) {
        return builtins.f64_type
    }
    if (right_is_float && type_is_numeric_builtin(ref types_table, left_type)) {
        return builtins.f64_type
    }
    if (node_is_integer_literal(ref tokens, ref nodes, left_node) &&
        type_is_numeric_builtin(ref types_table, right_type)) {
        return right_type
    }
    if (node_is_integer_literal(ref tokens, ref nodes, right_node) &&
        type_is_numeric_builtin(ref types_table, left_type)) {
        return left_type
    }

    types.invalid_type_id()
}

// Record-like types all find fields through the original declaration node.
func record_decl_node(ref types_table: types.Types, type_id: i64): i64 = {
    if (type_id < 0) {
        return node.invalid_node_id()
    }

    val kind: types.TypeKind = types_table.kind[type_id]
    if (kind == types.TypeKind.ValueType ||
        kind == types.TypeKind.StructType ||
        kind == types.TypeKind.TableType) {
        return types_table.decl_node[type_id]
    }
    if (kind == types.TypeKind.TableRowType) {
        val base_table_type: i64 = types_table.data0[type_id]
        if (base_table_type >= 0) {
            return types_table.decl_node[base_table_type]
        }
    }
    node.invalid_node_id()
}

// Field lookup stays linear for now because bootstrap compiler types stay small.
func type_find_field(
    ref nodes: node.Nodes,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref types_table: types.Types,
    type_id: i64,
    field_token: i64
): i64 = {
    val decl_id: i64 = record_decl_node(ref types_table, type_id)
    if (decl_id < 0) {
        return node.invalid_node_id()
    }

    mut child_id: i64 = nodes.first_child[decl_id]
    while (child_id >= 0) {
        if (nodes.kind[child_id] == node.NodeKind.FieldDecl &&
            token_name_eq(
                ref sources,
                ref text_pool,
                ref tokens,
                nodes.data0[child_id],
                field_token
            )) {
            return child_id
        }
        child_id = nodes.next_sibling[child_id]
    }
    node.invalid_node_id()
}

// Field rows lazily resolve their type nodes so imported declarations work cross-module.
func ensure_field_decl_type(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    record_type: i64,
    field_decl: i64
): i64 = {
    if (field_decl < 0) {
        return types.invalid_type_id()
    }
    if (nodes.type_id[field_decl] >= 0) {
        return nodes.type_id[field_decl]
    }

    mut owner_type: i64 = record_type
    if (record_type >= 0 && types_table.kind[record_type] == types.TypeKind.TableRowType) {
        owner_type = types_table.data0[record_type]
    }
    val owner_module: i64 = if (owner_type >= 0) {
        types_table.module_id[owner_type]
    } else {
        -1
    }
    val type_node: i64 = node.node_child_at(ref nodes, field_decl, 0)
    val type_id: i64 = resolve_type_node(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref scopes_table,
        ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        owner_module,
        type_node,
        false
    )
    nodes.type_id[field_decl] = type_id
    type_id
}

// Cross-module call checks need parameter types even before the callee body is visited.
func ensure_param_decl_type(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    module_id: i64,
    param_id: i64
): i64 = {
    if (param_id < 0) {
        return types.invalid_type_id()
    }
    if (nodes.type_id[param_id] >= 0) {
        return nodes.type_id[param_id]
    }

    val type_node: i64 = node.node_child_at(ref nodes, param_id, 0)
    val type_id: i64 = resolve_type_node(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref scopes_table,
        ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        module_id,
        type_node,
        false
    )
    nodes.type_id[param_id] = type_id
    type_id
}

// Function return types are also resolved lazily so forward and imported calls can typecheck.
func ensure_function_return_type(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    function_symbol: i64
): i64 = {
    if (function_symbol < 0) {
        return types.invalid_type_id()
    }
    if (symbols_table.type_id[function_symbol] >= 0) {
        return symbols_table.type_id[function_symbol]
    }

    val decl_id: i64 = symbols_table.decl_node[function_symbol]
    val module_id: i64 = symbols_table.module_id[function_symbol]
    val param_count: i64 = nodes.data2[decl_id]
    val return_type_node: i64 = node.node_child_at(ref nodes, decl_id, param_count)
    val return_type: i64 = resolve_type_node(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref scopes_table,
        ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        module_id,
        return_type_node,
        false
    )
    nodes.type_id[decl_id] = return_type
    symbols_table.type_id[function_symbol] = return_type
    return_type
}

// Only function and annotated-global rows can be completed lazily today.
func ensure_symbol_type(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    symbol_id: i64
): i64 = {
    if (symbol_id < 0) {
        return types.invalid_type_id()
    }
    if (symbols_table.type_id[symbol_id] >= 0) {
        return symbols_table.type_id[symbol_id]
    }

    if (symbols_table.kind[symbol_id] == symbols.SymbolKind.FunctionSymbol) {
        return ensure_function_return_type(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            mut ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            symbol_id
        )
    }

    if (symbols_table.kind[symbol_id] == symbols.SymbolKind.GlobalSymbol) {
        val decl_id: i64 = symbols_table.decl_node[symbol_id]
        if (nodes.type_id[decl_id] >= 0) {
            symbols_table.type_id[symbol_id] = nodes.type_id[decl_id]
            return nodes.type_id[decl_id]
        }
        if (decl_has_type(ref nodes, decl_id)) {
            val type_node: i64 = node.node_child_at(ref nodes, decl_id, 0)
            val type_id: i64 = resolve_type_node(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                symbols_table.module_id[symbol_id],
                type_node,
                false
            )
            nodes.type_id[decl_id] = type_id
            symbols_table.type_id[symbol_id] = type_id
            return type_id
        }
    }

    types.invalid_type_id()
}

// Field/index/slice projections stay addressable only when they bottom out at storage.
func expr_has_addressable_root(ref nodes: node.Nodes, node_id: i64): bool = {
    if (node_id < 0) {
        return false
    }
    if (nodes.kind[node_id] == node.NodeKind.Identifier) {
        return true
    }
    if (nodes.kind[node_id] == node.NodeKind.FieldAccess ||
        nodes.kind[node_id] == node.NodeKind.IndexExpr ||
        nodes.kind[node_id] == node.NodeKind.SliceExpr) {
        return expr_has_addressable_root(ref nodes, node.node_child_at(ref nodes, node_id, 0))
    }
    false
}

// Ref expressions and assignments both need the same notion of addressability.
func expr_is_addressable(ref nodes: node.Nodes, node_id: i64): bool = {
    if (node_id < 0) {
        return false
    }
    if (nodes.kind[node_id] == node.NodeKind.Identifier) {
        return true
    }
    if (nodes.kind[node_id] == node.NodeKind.FieldAccess ||
        nodes.kind[node_id] == node.NodeKind.IndexExpr) {
        return expr_has_addressable_root(ref nodes, node_id)
    }
    false
}

// Ref operands allow field and slice views, but never paths that pass through array indexing.
func expr_has_ref_root(ref nodes: node.Nodes, node_id: i64): bool = {
    if (node_id < 0) {
        return false
    }
    if (nodes.kind[node_id] == node.NodeKind.Identifier) {
        return true
    }
    if (nodes.kind[node_id] == node.NodeKind.FieldAccess ||
        nodes.kind[node_id] == node.NodeKind.SliceExpr) {
        return expr_has_ref_root(ref nodes, node.node_child_at(ref nodes, node_id, 0))
    }
    false
}

// Slice and str refs can still alias through indexed storage even though the path is not a plain place root.
func type_is_slice_like_ref_target(ref types_table: types.Types, type_id: i64): bool = {
    if (type_id < 0) {
        return false
    }

    types_table.kind[type_id] == types.TypeKind.SliceType ||
    types_table.kind[type_id] == types.TypeKind.StrType
}

// Ref arguments also allow sub-slices as views over an addressable root object.
func expr_can_take_ref(ref nodes: node.Nodes, ref types_table: types.Types, node_id: i64): bool = {
    if (node_id < 0) {
        return false
    }
    if (nodes.kind[node_id] == node.NodeKind.StringLit) {
        return true
    }
    if (nodes.kind[node_id] == node.NodeKind.Identifier ||
        nodes.kind[node_id] == node.NodeKind.FieldAccess ||
        nodes.kind[node_id] == node.NodeKind.SliceExpr) {
        if (expr_has_ref_root(ref nodes, node_id)) {
            return true
        }
    }
    if ((nodes.kind[node_id] == node.NodeKind.FieldAccess ||
         nodes.kind[node_id] == node.NodeKind.IndexExpr ||
         nodes.kind[node_id] == node.NodeKind.SliceExpr) &&
        type_is_slice_like_ref_target(ref types_table, nodes.type_id[node_id])) {
        return expr_has_addressable_root(ref nodes, node_id)
    }
    false
}

// Mutable places recurse through field and index projections to the root binding.
func expr_is_mutable_place(
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    node_id: i64
): bool = {
    if (node_id < 0) {
        return false
    }

    if (nodes.kind[node_id] == node.NodeKind.Identifier) {
        val symbol_id: i64 = nodes.symbol_id[node_id]
        if (symbol_id < 0) {
            return false
        }
        return symbols.symbol_is_mut(ref symbols_table, symbol_id)
    }

    if (nodes.kind[node_id] == node.NodeKind.FieldAccess ||
        nodes.kind[node_id] == node.NodeKind.IndexExpr ||
        nodes.kind[node_id] == node.NodeKind.SliceExpr) {
        return expr_is_mutable_place(
            ref nodes,
            ref symbols_table,
            node.node_child_at(ref nodes, node_id, 0)
        )
    }

    false
}

// Arena-parameter lookup follows ref wrappers and projections back to one root identifier.
func expr_root_identifier_node(ref nodes: node.Nodes, node_id: i64): i64 = {
    if (node_id < 0) {
        return node.invalid_node_id()
    }
    if (nodes.kind[node_id] == node.NodeKind.Identifier) {
        return node_id
    }
    if (nodes.kind[node_id] == node.NodeKind.RefExpr ||
        nodes.kind[node_id] == node.NodeKind.FieldAccess ||
        nodes.kind[node_id] == node.NodeKind.IndexExpr ||
        nodes.kind[node_id] == node.NodeKind.SliceExpr) {
        return expr_root_identifier_node(ref nodes, node.node_child_at(ref nodes, node_id, 0))
    }
    node.invalid_node_id()
}

// Arena provenance only cares whether the source arena outlives the current function.
func symbol_is_local_arena_owner(ref symbols_table: symbols.Symbols, symbol_id: i64): bool = {
    if (symbol_id < 0) {
        return false
    }
    if (symbols_table.kind[symbol_id] == symbols.SymbolKind.GlobalSymbol) {
        return false
    }
    if (symbols_table.kind[symbol_id] == symbols.SymbolKind.ParamSymbol &&
        symbols.symbol_is_ref(ref symbols_table, symbol_id)) {
        return false
    }
    true
}

// Rebinding a value clears any stale invalidation/provenance before optional propagation.
func symbol_clear_arena_tracking(mut ref symbols_table: symbols.Symbols, symbol_id: i64): void = {
    if (symbol_id < 0) {
        return
    }
    symbols_table.arena_source_symbol[symbol_id] = symbols.invalid_symbol_id()
    symbols_table.flags[symbol_id] &= ~(symbols.SYM_FLAG_ARENA_LOCAL | symbols.SYM_FLAG_INVALIDATED)
}

// Store the arena source once so later resets can invalidate every derived value.
func symbol_set_arena_tracking(
    mut ref symbols_table: symbols.Symbols,
    symbol_id: i64,
    arena_symbol: i64,
    arena_is_local: bool
): void = {
    if (symbol_id < 0 || arena_symbol < 0) {
        return
    }
    symbols_table.arena_source_symbol[symbol_id] = arena_symbol
    symbols_table.flags[symbol_id] &= ~(symbols.SYM_FLAG_ARENA_LOCAL | symbols.SYM_FLAG_INVALIDATED)
    if (arena_is_local) {
        symbols_table.flags[symbol_id] |= symbols.SYM_FLAG_ARENA_LOCAL
    }
}

// Copy provenance through borrows and payload bindings without inventing a new source arena.
func symbol_copy_arena_tracking(
    mut ref symbols_table: symbols.Symbols,
    symbol_id: i64,
    source_symbol: i64
): void = {
    if (symbol_id < 0 || source_symbol < 0) {
        return
    }
    val arena_symbol: i64 = symbols_table.arena_source_symbol[source_symbol]
    if (arena_symbol < 0) {
        symbol_clear_arena_tracking(mut ref symbols_table, symbol_id)
        return
    }
    symbol_set_arena_tracking(
        mut ref symbols_table,
        symbol_id,
        arena_symbol,
        symbols.symbol_arena_is_local(ref symbols_table, source_symbol)
    )
    if (symbols.symbol_is_invalidated(ref symbols_table, source_symbol)) {
        symbols_table.flags[symbol_id] |= symbols.SYM_FLAG_INVALIDATED
    }
}

// Direct string-literal bindings stay immutable because they point at static read-only storage.
func decl_init_is_string_literal(ref nodes: node.Nodes, decl_id: i64): bool = {
    val init_node: i64 = decl_init_node(ref nodes, decl_id)
    init_node >= 0 && nodes.kind[init_node] == node.NodeKind.StringLit
}

// Slice locals only stay valid when they come from a fresh producer or a sub-slice view.
func expr_is_slice_local_initializer(ref nodes: node.Nodes, node_id: i64): bool = {
    if (node_id < 0) {
        return false
    }
    nodes.kind[node_id] == node.NodeKind.CallExpr ||
    nodes.kind[node_id] == node.NodeKind.SliceExpr
}

// Non-copyable locals only reject direct copies; constructors and calls remain allowed.
func expr_is_copy_source(ref nodes: node.Nodes, node_id: i64): bool = {
    if (node_id < 0) {
        return false
    }
    nodes.kind[node_id] == node.NodeKind.Identifier ||
    nodes.kind[node_id] == node.NodeKind.FieldAccess
}

// Table built-ins all materialize the same synthetic `.Row` type for one table decl.
func table_row_type(mut ref types_table: types.Types, table_type: i64): i64 = {
    if (table_type < 0 || types_table.kind[table_type] != types.TypeKind.TableType) {
        return types.invalid_type_id()
    }

    types.type_table_row(
        mut ref types_table,
        types_table.module_id[table_type],
        types_table.decl_node[table_type],
        table_type
    )
}

// Match today only supports the same scalar scrutinees as the stage-0 language rules.
func type_is_match_scalar(ref types_table: types.Types, type_id: i64): bool = {
    type_is_bool_builtin(ref types_table, type_id) ||
    type_is_integer_builtin(ref types_table, type_id)
}

// Slice-bearing enums are the only enum shapes that stop being copyable.
func enum_has_slice_payload(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    enum_type: i64,
    budget: i64
): bool = {
    if (enum_type < 0 ||
        budget <= 0 ||
        types_table.kind[enum_type] != types.TypeKind.EnumType) {
        return false
    }

    val enum_decl: i64 = types_table.decl_node[enum_type]
    mut variant_id: i64 = nodes.first_child[enum_decl]
    while (variant_id >= 0) {
        if (nodes.kind[variant_id] == node.NodeKind.VariantDecl &&
            flag_has(nodes.data1[variant_id], CHECK_NODE_FLAG_HAS_TYPE)) {
            val payload_type: i64 = ensure_variant_decl_type(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                enum_type,
                variant_id
            )
            if (payload_type >= 0) {
                if (types_table.kind[payload_type] == types.TypeKind.SliceType ||
                    types_table.kind[payload_type] == types.TypeKind.StrType) {
                    return true
                }
                if (types_table.kind[payload_type] == types.TypeKind.EnumType &&
                    enum_has_slice_payload(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        ref scopes_table,
                        ref symbols_table,
                        mut ref types_table,
                        ref builtins,
                        mut ref diags,
                        mut ref diag_pool,
                        payload_type,
                        budget - 1
                    )) {
                    return true
                }
            }
        }
        variant_id = nodes.next_sibling[variant_id]
    }
    false
}

// Struct-like arena escape checks only care about fields that can point into arena memory.
func type_decl_has_arena_fields(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    type_id: i64,
    budget: i64
): bool = {
    if (type_id < 0 || budget <= 0) {
        return false
    }

    val kind: types.TypeKind = types_table.kind[type_id]
    if (!(kind == types.TypeKind.ValueType ||
          kind == types.TypeKind.StructType)) {
        return false
    }

    val decl_id: i64 = types_table.decl_node[type_id]
    mut field_decl: i64 = nodes.first_child[decl_id]
    while (field_decl >= 0) {
        if (nodes.kind[field_decl] == node.NodeKind.FieldDecl) {
            val field_type: i64 = ensure_field_decl_type(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                type_id,
                field_decl
            )
            if (field_type >= 0 &&
                (types_table.kind[field_type] == types.TypeKind.SliceType ||
                 types_table.kind[field_type] == types.TypeKind.StrType ||
                 types_table.kind[field_type] == types.TypeKind.TableType ||
                 (types_table.kind[field_type] == types.TypeKind.EnumType &&
                  enum_has_slice_payload(
                      mut ref mem,
                      ref sources,
                      ref text_pool,
                      ref tokens,
                      mut ref nodes,
                      ref scopes_table,
                      ref symbols_table,
                      mut ref types_table,
                      ref builtins,
                      mut ref diags,
                      mut ref diag_pool,
                      field_type,
                      budget - 1
                  )))) {
                return true
            }
        }
        field_decl = nodes.next_sibling[field_decl]
    }
    false
}

// Arena safety only tracks types whose values can contain arena-backed slices/strings.
// Results are cached in types.data2 to avoid redundant recursive walks.
func type_has_arena_data(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    type_id: i64,
    budget: i64
): bool = {
    if (type_id < 0 || budget <= 0) {
        return false
    }

    if (flag_has(types_table.data2[type_id], TYPE_CACHE_HAS_ARENA_COMPUTED)) {
        return flag_has(types_table.data2[type_id], TYPE_CACHE_HAS_ARENA_VALUE)
    }

    val kind: types.TypeKind = types_table.kind[type_id]
    if (kind == types.TypeKind.SliceType ||
        kind == types.TypeKind.StrType ||
        kind == types.TypeKind.TableType) {
        types_table.data2[type_id] = types_table.data2[type_id] | TYPE_CACHE_HAS_ARENA_COMPUTED | TYPE_CACHE_HAS_ARENA_VALUE
        return true
    }
    mut result: bool = false
    if (kind == types.TypeKind.EnumType) {
        result = enum_has_slice_payload(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            type_id,
            budget - 1
        )
    } else {
        result = type_decl_has_arena_fields(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            type_id,
            budget - 1
        )
    }
    types_table.data2[type_id] = types_table.data2[type_id] | TYPE_CACHE_HAS_ARENA_COMPUTED
    if (result) {
        types_table.data2[type_id] = types_table.data2[type_id] | TYPE_CACHE_HAS_ARENA_VALUE
    }
    result
}

// Deferred call-site checks only need one callee edge per function to reach fixpoint.
func arena_dep_add(
    mut ref deps: ArenaDependencies,
    func_symbol: i64,
    callee_symbol: i64
): void = {
    if (func_symbol < 0 || callee_symbol < 0 || func_symbol == callee_symbol) {
        return
    }

    mut dep_id: i64 = 0
    while (dep_id < table_len(ref deps)) {
        if (deps.func_symbol[dep_id] == func_symbol &&
            deps.callee_symbol[dep_id] == callee_symbol) {
            return
        }
        dep_id += 1
    }

    table_insert(mut ref deps, ArenaDependencies.Row {
        func_symbol: func_symbol,
        callee_symbol: callee_symbol
    })
}

// Forward references mean call-site escape diagnostics are emitted after all bodies are checked.
func deferred_arena_check_add(
    mut ref checks: DeferredArenaChecks,
    call_node: i64,
    callee_symbol: i64,
    arena_symbol: i64
): void = {
    if (call_node < 0 || callee_symbol < 0 || arena_symbol < 0) {
        return
    }

    mut check_id: i64 = 0
    while (check_id < table_len(ref checks)) {
        if (checks.call_node[check_id] == call_node &&
            checks.callee_symbol[check_id] == callee_symbol &&
            checks.arena_symbol[check_id] == arena_symbol) {
            return
        }
        check_id += 1
    }

    table_insert(mut ref checks, DeferredArenaChecks.Row {
        call_node: call_node,
        callee_symbol: callee_symbol,
        arena_symbol: arena_symbol
    })
}

// Borrowed slices keep the provenance of their root source expression.
func track_symbol_arena_from_expr(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref builtins: types.BuiltinTypes,
    mut ref symbols_table: symbols.Symbols,
    symbol_id: i64,
    expr_id: i64
): void = {
    symbol_clear_arena_tracking(mut ref symbols_table, symbol_id)
    if (symbol_id < 0 || expr_id < 0) {
        return
    }

    if (nodes.kind[expr_id] == node.NodeKind.Identifier) {
        val source_symbol: i64 = nodes.symbol_id[expr_id]
        if (source_symbol >= 0 &&
            symbols_table.arena_source_symbol[source_symbol] >= 0) {
            symbol_copy_arena_tracking(mut ref symbols_table, symbol_id, source_symbol)
        }
        return
    }

    if (nodes.kind[expr_id] == node.NodeKind.RefExpr ||
        nodes.kind[expr_id] == node.NodeKind.FieldAccess ||
        nodes.kind[expr_id] == node.NodeKind.IndexExpr ||
        nodes.kind[expr_id] == node.NodeKind.SliceExpr) {
        track_symbol_arena_from_expr(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref builtins,
            mut ref symbols_table,
            symbol_id,
            node.node_child_at(ref nodes, expr_id, 0)
        )
        return
    }

    if (nodes.kind[expr_id] != node.NodeKind.CallExpr) {
        return
    }

    val callee_id: i64 = node.node_child_at(ref nodes, expr_id, 0)
    if (callee_id >= 0 && nodes.kind[callee_id] == node.NodeKind.Identifier) {
        val builtin_kind: i64 = builtin_call_kind(ref sources, ref text_pool, ref tokens, nodes.data0[callee_id])
        if (builtin_kind == BUILTIN_CALL_ARENA_ALLOC ||
            builtin_kind == BUILTIN_CALL_TABLE_ALLOC) {
            val arena_root: i64 = expr_root_identifier_node(ref nodes, node.node_child_at(ref nodes, expr_id, 1))
            if (arena_root >= 0 && nodes.symbol_id[arena_root] >= 0) {
                symbol_set_arena_tracking(
                    mut ref symbols_table,
                    symbol_id,
                    nodes.symbol_id[arena_root],
                    symbol_is_local_arena_owner(ref symbols_table, nodes.symbol_id[arena_root])
                )
            }
            return
        }
        if (token_name_is(ref sources, ref text_pool, ref tokens, nodes.data0[callee_id], ref "args")) {
            val arena_root: i64 = expr_root_identifier_node(ref nodes, node.node_child_at(ref nodes, expr_id, 1))
            if (arena_root >= 0 && nodes.symbol_id[arena_root] >= 0) {
                symbol_set_arena_tracking(
                    mut ref symbols_table,
                    symbol_id,
                    nodes.symbol_id[arena_root],
                    symbol_is_local_arena_owner(ref symbols_table, nodes.symbol_id[arena_root])
                )
            }
            return
        }
        if (builtin_kind == BUILTIN_CALL_NONE &&
            nodes.symbol_id[callee_id] >= 0 &&
            symbols.symbol_returns_arena_slices(ref symbols_table, nodes.symbol_id[callee_id])) {
            val callee_decl: i64 = symbols_table.decl_node[nodes.symbol_id[callee_id]]
            mut arg_id: i64 = nodes.next_sibling[callee_id]
            mut arg_index: i64 = 0
            while (arg_id >= 0 && arg_index < nodes.data2[callee_decl]) {
                val param_id: i64 = node.node_child_at(ref nodes, callee_decl, arg_index)
                if (nodes.type_id[param_id] == builtins.arena_type &&
                    decl_is_ref(ref nodes, param_id)) {
                    val arena_root: i64 = expr_root_identifier_node(ref nodes, arg_id)
                    if (arena_root >= 0 && nodes.symbol_id[arena_root] >= 0) {
                        symbol_set_arena_tracking(
                            mut ref symbols_table,
                            symbol_id,
                            nodes.symbol_id[arena_root],
                            symbol_is_local_arena_owner(ref symbols_table, nodes.symbol_id[arena_root])
                        )
                    }
                    return
                }
                arg_id = nodes.next_sibling[arg_id]
                arg_index += 1
            }
        }
        return
    }
}

// Arena reset invalidates every tracked value in the currently reachable lexical scopes.
func invalidate_arena_values(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    scope_id: i64,
    arena_symbol: i64
): void = {
    if (arena_symbol < 0) {
        return
    }

    mut current_scope: i64 = scope_id
    while (current_scope >= 0) {
        mut symbol_id: i64 = scopes_table.first_symbol[current_scope]
        while (symbol_id >= 0) {
            if (symbols_table.arena_source_symbol[symbol_id] == arena_symbol &&
                type_has_arena_data(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    ref scopes_table,
                    ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    symbols_table.type_id[symbol_id],
                    64
                )) {
                symbols_table.flags[symbol_id] |= symbols.SYM_FLAG_INVALIDATED
            }
            symbol_id = symbols_table.next_symbol[symbol_id]
        }
        current_scope = scopes_table.parent[current_scope]
    }
}

// Return-by-call escape checks share the same arena-parameter scan across direct and deferred cases.
func check_return_call_arena_escape(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    scope_id: i64,
    return_type: i64,
    call_id: i64,
    func_symbol: i64
): void = {
    if (call_id < 0 ||
        nodes.kind[call_id] != node.NodeKind.CallExpr ||
        !type_has_arena_data(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            return_type,
            64
        )) {
        return
    }

    val callee_id: i64 = node.node_child_at(ref nodes, call_id, 0)
    val callee_symbol: i64 = if (callee_id >= 0) {
        nodes.symbol_id[callee_id]
    } else {
        symbols.invalid_symbol_id()
    }
    if (callee_symbol < 0 ||
        symbols_table.kind[callee_symbol] != symbols.SymbolKind.FunctionSymbol) {
        return
    }

    val callee_decl: i64 = symbols_table.decl_node[callee_symbol]
    mut arg_id: i64 = nodes.next_sibling[callee_id]
    mut arg_index: i64 = 0
    while (arg_id >= 0 && arg_index < nodes.data2[callee_decl]) {
        val param_id: i64 = node.node_child_at(ref nodes, callee_decl, arg_index)
        val param_type: i64 = ensure_param_decl_type(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            symbols_table.module_id[callee_symbol],
            param_id
        )
        if (param_type == builtins.arena_type &&
            decl_is_ref(ref nodes, param_id)) {
            val arena_root: i64 = expr_root_identifier_node(ref nodes, arg_id)
            if (arena_root >= 0 && nodes.symbol_id[arena_root] >= 0) {
                val arena_symbol: i64 = nodes.symbol_id[arena_root]
                if (symbol_is_local_arena_owner(ref symbols_table, arena_symbol)) {
                    deferred_arena_check_add(mut ref deferred, call_id, callee_symbol, arena_symbol)
                } else {
                    arena_dep_add(mut ref deps, func_symbol, callee_symbol)
                }
            }
            return
        }
        arg_id = nodes.next_sibling[arg_id]
        arg_index += 1
    }
}

// Direct bare returns propagate or reject already-tracked arena provenance.
func check_return_identifier_arena_escape(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    scope_id: i64,
    value_id: i64,
    return_type: i64,
    func_symbol: i64
): void = {
    if (value_id < 0 || nodes.kind[value_id] != node.NodeKind.Identifier) {
        return
    }

    val value_symbol: i64 = nodes.symbol_id[value_id]
    if (value_symbol >= 0 && symbols_table.arena_source_symbol[value_symbol] >= 0) {
        if (symbols.symbol_arena_is_local(ref symbols_table, value_symbol)) {
            val name: [u8] = token_text_or_synthetic(ref sources, ref text_pool, ref tokens, nodes.data0[value_id])
            val message: str = message_named(mut ref mem, ref "Slice '", ref name, ref "' escapes local arena")
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, value_id, ref "S053", ref message)
        } else {
            symbols_table.flags[func_symbol] |= symbols.SYM_FLAG_RETURNS_ARENA_SLICES
        }
        return
    }

    if (value_symbol >= 0 &&
        symbols_table.decl_node[value_symbol] >= 0 &&
        nodes.kind[symbols_table.decl_node[value_symbol]] == node.NodeKind.VarDecl) {
        val init_id: i64 = decl_init_node(ref nodes, symbols_table.decl_node[value_symbol])
        check_return_call_arena_escape(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            mut ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            mut ref deps,
            mut ref deferred,
            scope_id,
            return_type,
            init_id,
            func_symbol
        )
    }
}

// Struct-style constructors only escape when one of their arena-backed fields escapes.
func check_return_constructor_arena_escape(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    scope_id: i64,
    value_id: i64,
    return_type: i64,
    func_symbol: i64
): void = {
    if (value_id < 0 || nodes.kind[value_id] != node.NodeKind.ConstructorExpr) {
        return
    }

    val callee_id: i64 = node.node_child_at(ref nodes, value_id, 0)
    mut init_id: i64 = nodes.next_sibling[callee_id]
    while (init_id >= 0) {
        val field_decl: i64 = type_find_field(
            ref nodes,
            ref sources,
            ref text_pool,
            ref tokens,
            ref types_table,
            return_type,
            nodes.data0[init_id]
        )
        if (field_decl >= 0) {
            val field_type: i64 = ensure_field_decl_type(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                return_type,
                field_decl
            )
            if (type_has_arena_data(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    ref scopes_table,
                    ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    field_type,
                    64
                )) {
                val field_value: i64 = node.node_child_at(ref nodes, init_id, 0)
                if (field_value >= 0 &&
                    nodes.kind[field_value] == node.NodeKind.Identifier &&
                    nodes.symbol_id[field_value] >= 0 &&
                    symbols_table.arena_source_symbol[nodes.symbol_id[field_value]] >= 0) {
                    if (symbols.symbol_arena_is_local(ref symbols_table, nodes.symbol_id[field_value])) {
                        val name: [u8] = token_text_or_synthetic(ref sources, ref text_pool, ref tokens, nodes.data0[field_value])
                        val message: str = message_named(mut ref mem, ref "Slice '", ref name, ref "' in returned struct escapes local arena")
                        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, field_value, ref "S053", ref message)
                    } else {
                        symbols_table.flags[func_symbol] |= symbols.SYM_FLAG_RETURNS_ARENA_SLICES
                    }
                } else {
                    check_return_call_arena_escape(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        ref scopes_table,
                        mut ref symbols_table,
                        mut ref types_table,
                        ref builtins,
                        mut ref diags,
                        mut ref diag_pool,
                        mut ref deps,
                        mut ref deferred,
                        scope_id,
                        field_type,
                        field_value,
                        func_symbol
                    )
                }
            }
        }
        init_id = nodes.next_sibling[init_id]
    }
}

// Tagged-enum payload returns need the same arena escape rules as struct field returns.
func check_return_variant_arena_escape(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    module_id: i64,
    scope_id: i64,
    value_id: i64,
    return_type: i64,
    func_symbol: i64
): void = {
    if (value_id < 0 ||
        nodes.kind[value_id] != node.NodeKind.CallExpr ||
        return_type < 0 ||
        types_table.kind[return_type] != types.TypeKind.EnumType) {
        return
    }

    val callee_id: i64 = node.node_child_at(ref nodes, value_id, 0)
    if (callee_id < 0 ||
        nodes.kind[callee_id] != node.NodeKind.FieldAccess ||
        node.node_child_at(ref nodes, value_id, 1) < 0) {
        return
    }

    val payload_id: i64 = node.node_child_at(ref nodes, value_id, 1)
    val payload_type: i64 = nodes.type_id[payload_id]
    if (!type_has_arena_data(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            payload_type,
            64
        )) {
        return
    }

    if (payload_id >= 0 &&
        nodes.kind[payload_id] == node.NodeKind.Identifier &&
        nodes.symbol_id[payload_id] >= 0 &&
        symbols_table.arena_source_symbol[nodes.symbol_id[payload_id]] >= 0) {
        if (symbols.symbol_arena_is_local(ref symbols_table, nodes.symbol_id[payload_id])) {
            val name: [u8] = token_text_or_synthetic(ref sources, ref text_pool, ref tokens, nodes.data0[payload_id])
            val message: str = message_named(mut ref mem, ref "Slice '", ref name, ref "' escapes local arena")
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, payload_id, ref "S053", ref message)
        } else {
            symbols_table.flags[func_symbol] |= symbols.SYM_FLAG_RETURNS_ARENA_SLICES
        }
    } else {
        check_return_call_arena_escape(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            mut ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            mut ref deps,
            mut ref deferred,
            scope_id,
            payload_type,
            payload_id,
            func_symbol
        )
    }
}

// Return statements are the bootstrap arena-safety boundary for direct and indirect escapes.
func check_return_arena_escape(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    module_id: i64,
    scope_id: i64,
    value_id: i64,
    return_type: i64
): void = {
    if (value_id < 0 ||
        return_type < 0 ||
        !type_has_arena_data(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            return_type,
            64
        )) {
        return
    }

    val func_symbol: i64 = scope_enclosing_function_symbol(ref nodes, ref scopes_table, scope_id)
    if (func_symbol < 0) {
        return
    }

    check_return_identifier_arena_escape(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        mut ref deps,
        mut ref deferred,
        scope_id,
        value_id,
        return_type,
        func_symbol
    )
    check_return_call_arena_escape(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        mut ref deps,
        mut ref deferred,
        scope_id,
        return_type,
        value_id,
        func_symbol
    )
    check_return_constructor_arena_escape(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        mut ref deps,
        mut ref deferred,
        scope_id,
        value_id,
        return_type,
        func_symbol
    )
    check_return_variant_arena_escape(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        mut ref deps,
        mut ref deferred,
        module_id,
        scope_id,
        value_id,
        return_type,
        func_symbol
    )
}

// Stage-0 field and payload validation treats structs, Arena, tables, and slice-bearing enums as non-copyable.
func type_is_non_copyable(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    type_id: i64,
    budget: i64
): bool = {
    if (type_id < 0 || budget <= 0) {
        return false
    }

    if (flag_has(types_table.data2[type_id], TYPE_CACHE_NON_COPYABLE_COMPUTED)) {
        return flag_has(types_table.data2[type_id], TYPE_CACHE_NON_COPYABLE_VALUE)
    }

    val kind: types.TypeKind = types_table.kind[type_id]
    if (kind == types.TypeKind.StructType ||
        kind == types.TypeKind.TableType ||
        kind == types.TypeKind.ArenaType) {
        types_table.data2[type_id] = types_table.data2[type_id] | TYPE_CACHE_NON_COPYABLE_COMPUTED | TYPE_CACHE_NON_COPYABLE_VALUE
        return true
    }
    mut result: bool = false
    if (kind == types.TypeKind.EnumType) {
        result = enum_has_slice_payload(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            type_id,
            budget - 1
        )
    }
    types_table.data2[type_id] = types_table.data2[type_id] | TYPE_CACHE_NON_COPYABLE_COMPUTED
    if (result) {
        types_table.data2[type_id] = types_table.data2[type_id] | TYPE_CACHE_NON_COPYABLE_VALUE
    }
    result
}

// Table fields and tagged-enum payload checks both need the same recursive value-compatibility rule.
func type_is_value_compatible(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    type_id: i64,
    budget: i64
): bool = {
    if (type_id < 0 || budget <= 0) {
        return false
    }

    if (flag_has(types_table.data2[type_id], TYPE_CACHE_VALUE_COMPAT_COMPUTED)) {
        return flag_has(types_table.data2[type_id], TYPE_CACHE_VALUE_COMPAT_VALUE)
    }

    val kind: types.TypeKind = types_table.kind[type_id]
    if (kind == types.TypeKind.I64Type ||
        kind == types.TypeKind.I32Type ||
        kind == types.TypeKind.U8Type ||
        kind == types.TypeKind.U32Type ||
        kind == types.TypeKind.F64Type ||
        kind == types.TypeKind.BoolType) {
        types_table.data2[type_id] = types_table.data2[type_id] | TYPE_CACHE_VALUE_COMPAT_COMPUTED | TYPE_CACHE_VALUE_COMPAT_VALUE
        return true
    }
    if (kind == types.TypeKind.StrType ||
        kind == types.TypeKind.ArenaType ||
        kind == types.TypeKind.SliceType ||
        kind == types.TypeKind.StructType ||
        kind == types.TypeKind.TableType ||
        kind == types.TypeKind.VoidType ||
        kind == types.TypeKind.InvalidType) {
        types_table.data2[type_id] = types_table.data2[type_id] | TYPE_CACHE_VALUE_COMPAT_COMPUTED
        return false
    }
    mut result: bool = true
    if (kind == types.TypeKind.ArrayType) {
        result = type_is_value_compatible(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            types_table.data0[type_id],
            budget - 1
        )
    } else {
        if (kind == types.TypeKind.EnumType) {
            val enum_decl: i64 = types_table.decl_node[type_id]
            mut variant_id: i64 = nodes.first_child[enum_decl]
            while (variant_id >= 0) {
                if (nodes.kind[variant_id] == node.NodeKind.VariantDecl &&
                    flag_has(nodes.data1[variant_id], CHECK_NODE_FLAG_HAS_TYPE)) {
                    val payload_type: i64 = ensure_variant_decl_type(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        ref scopes_table,
                        ref symbols_table,
                        mut ref types_table,
                        ref builtins,
                        mut ref diags,
                        mut ref diag_pool,
                        type_id,
                        variant_id
                    )
                    if (!type_is_value_compatible(
                            mut ref mem,
                            ref sources,
                            ref text_pool,
                            ref tokens,
                            mut ref nodes,
                            ref scopes_table,
                            ref symbols_table,
                            mut ref types_table,
                            ref builtins,
                            mut ref diags,
                            mut ref diag_pool,
                            payload_type,
                            budget - 1
                        )) {
                        result = false
                        variant_id = -1
                    }
                }
                if (variant_id >= 0) {
                    variant_id = nodes.next_sibling[variant_id]
                }
            }
        } else {
            val decl_id: i64 = record_decl_node(ref types_table, type_id)
            if (decl_id < 0) {
                result = false
            } else {
                mut field_id: i64 = nodes.first_child[decl_id]
                while (field_id >= 0) {
                    if (nodes.kind[field_id] == node.NodeKind.FieldDecl) {
                        val field_type: i64 = ensure_field_decl_type(
                            mut ref mem,
                            ref sources,
                            ref text_pool,
                            ref tokens,
                            mut ref nodes,
                            ref scopes_table,
                            ref symbols_table,
                            mut ref types_table,
                            ref builtins,
                            mut ref diags,
                            mut ref diag_pool,
                            type_id,
                            field_id
                        )
                        if (!type_is_value_compatible(
                                mut ref mem,
                                ref sources,
                                ref text_pool,
                                ref tokens,
                                mut ref nodes,
                                ref scopes_table,
                                ref symbols_table,
                                mut ref types_table,
                                ref builtins,
                                mut ref diags,
                                mut ref diag_pool,
                                field_type,
                                budget - 1
                            )) {
                            result = false
                            field_id = -1
                        }
                    }
                    if (field_id >= 0) {
                        field_id = nodes.next_sibling[field_id]
                    }
                }
            }
        }
    }
    types_table.data2[type_id] = types_table.data2[type_id] | TYPE_CACHE_VALUE_COMPAT_COMPUTED
    if (result) {
        types_table.data2[type_id] = types_table.data2[type_id] | TYPE_CACHE_VALUE_COMPAT_VALUE
    }
    result
}

// Enum-pattern helpers only need the unqualified variant token from one identifier/call shape.
func match_pattern_variant_name(ref nodes: node.Nodes, pattern_id: i64): i64 = {
    if (pattern_id < 0) {
        return -1
    }
    if (nodes.kind[pattern_id] == node.NodeKind.Identifier) {
        return nodes.data0[pattern_id]
    }
    if (nodes.kind[pattern_id] == node.NodeKind.CallExpr) {
        val callee_id: i64 = node.node_child_at(ref nodes, pattern_id, 0)
        if (callee_id >= 0 && nodes.kind[callee_id] == node.NodeKind.Identifier) {
            return nodes.data0[callee_id]
        }
    }
    -1
}

// Bootstrap or-patterns reuse the existing binary `|` expression node shape.
func match_pattern_is_or(
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    pattern_id: i64
): bool = {
    pattern_id >= 0 &&
    nodes.kind[pattern_id] == node.NodeKind.BinaryExpr &&
    tokens.kind[nodes.data0[pattern_id]] == token.TokenKind.Pipe
}

// Catch-all match arms reuse the identifier/call pattern shape, but the spelling is reserved.
func match_pattern_is_else(
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    pattern_id: i64
): bool = {
    if (pattern_id < 0) {
        return false
    }
    if (nodes.kind[pattern_id] == node.NodeKind.Identifier) {
        return tokens.kind[nodes.data0[pattern_id]] == token.TokenKind.Else
    }
    if (nodes.kind[pattern_id] == node.NodeKind.CallExpr) {
        val callee_id: i64 = node.node_child_at(ref nodes, pattern_id, 0)
        if (callee_id >= 0 && nodes.kind[callee_id] == node.NodeKind.Identifier) {
            return tokens.kind[nodes.data0[callee_id]] == token.TokenKind.Else
        }
    }
    false
}

// Validate and tag an `else` catch-all leaf; returns true if the pattern was handled.
func check_match_catch_all_pattern(
    mut ref mem: Arena,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    pattern_id: i64,
    scrutinee_type: i64,
    in_or_group: bool
): bool = {
    if (!match_pattern_is_else(ref tokens, ref nodes, pattern_id)) {
        return false
    }
    nodes.type_id[pattern_id] = scrutinee_type
    if (nodes.kind[pattern_id] != node.NodeKind.Identifier) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S078", ref "Catch-all match arm does not bind a payload")
    }
    if (in_or_group) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S006", ref "Type mismatch")
    } else {
        nodes.data2[pattern_id] = MATCH_PATTERN_CATCH_ALL_ID
    }
    true
}

// Scalar wildcard matching is just the special bare `_` identifier spelling.
func match_pattern_is_scalar_wildcard(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    pattern_id: i64
): bool = {
    pattern_id >= 0 &&
    nodes.kind[pattern_id] == node.NodeKind.Identifier &&
    token_name_is(ref sources, ref text_pool, ref tokens, nodes.data0[pattern_id], ref "_")
}

// Duplicate scalar-arm checks need char literals reduced to one canonical integer value.
func char_literal_value(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    token_id: i64
): i64 = {
    val payload: [u8] = token.token_payload_text(ref sources, ref text_pool, ref tokens, token_id)
    if (payload.len <= 0) {
        return 0
    }
    if (payload[0] != '\\') {
        return i64(payload[0])
    }
    if (payload.len < 2) {
        return 0
    }

    match (payload[1]) {
        '0' = { 0 }
        'n' = { i64('\n') }
        'r' = { i64('\r') }
        't' = { i64('\t') }
        '\\' = { i64('\\') }
        '\'' = { i64('\'') }
        '"' = { i64('"') }
        _ = { i64(payload[1]) }
    }
}

// Coverage and duplicate checks compare scalar patterns after one literal normalization step.
func match_scalar_pattern_info(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    pattern_id: i64
): ScalarPatternInfo = {
    if (match_pattern_is_scalar_wildcard(ref sources, ref text_pool, ref tokens, ref nodes, pattern_id)) {
        return ScalarPatternInfo {
            wildcard: true,
            has_value: false,
            literal_value: 0
        }
    }
    if (pattern_id < 0) {
        return ScalarPatternInfo {
            wildcard: false,
            has_value: false,
            literal_value: 0
        }
    }

    val kind: node.NodeKind = nodes.kind[pattern_id]
    if (kind == node.NodeKind.BoolLit) {
        mut bool_value: i64 = 0
        if (token_name_is(ref sources, ref text_pool, ref tokens, nodes.data0[pattern_id], ref "true")) {
            bool_value = 1
        }
        return ScalarPatternInfo {
            wildcard: false,
            has_value: true,
            literal_value: bool_value
        }
    }
    if (kind == node.NodeKind.NumberLit) {
        val text: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, nodes.data0[pattern_id])
        val parsed: string.ParseResult = string.str_to_i64(ref text)
        val info: ScalarPatternInfo = match (parsed) {
            Ok(n) = {
                ScalarPatternInfo {
                    wildcard: false,
                    has_value: true,
                    literal_value: n
                }
            }
            None = {
                ScalarPatternInfo {
                    wildcard: false,
                    has_value: false,
                    literal_value: 0
                }
            }
        }
        return info
    }
    if (kind == node.NodeKind.CharLit) {
        return ScalarPatternInfo {
            wildcard: false,
            has_value: true,
            literal_value: char_literal_value(ref sources, ref text_pool, ref tokens, nodes.data0[pattern_id])
        }
    }
    if (kind == node.NodeKind.UnaryExpr &&
        tokens.kind[nodes.data0[pattern_id]] == token.TokenKind.Minus) {
        val operand_id: i64 = node.node_child_at(ref nodes, pattern_id, 0)
        val operand_info: ScalarPatternInfo = match_scalar_pattern_info(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            operand_id
        )
        mut allow_unary_value: bool = operand_info.has_value
        if (allow_unary_value && operand_info.wildcard) {
            allow_unary_value = false
        }
        if (allow_unary_value &&
            nodes.kind[operand_id] != node.NodeKind.BoolLit) {
            return ScalarPatternInfo {
                wildcard: false,
                has_value: true,
                literal_value: 0 - operand_info.literal_value
            }
        }
    }

    ScalarPatternInfo {
        wildcard: false,
        has_value: false,
        literal_value: 0
    }
}

// Catch-all coverage only counts when sema accepted a real leaf pattern.
func match_pattern_find_catch_all_id(
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    pattern_id: i64
): i64 = {
    if (pattern_id < 0) {
        return node.invalid_node_id()
    }
    if (match_pattern_is_or(ref tokens, ref nodes, pattern_id)) {
        val left_id: i64 = node.node_child_at(ref nodes, pattern_id, 0)
        val left_match: i64 = match_pattern_find_catch_all_id(ref tokens, ref nodes, left_id)
        if (left_match >= 0) {
            return left_match
        }
        val right_id: i64 = node.node_child_at(ref nodes, pattern_id, 1)
        return match_pattern_find_catch_all_id(ref tokens, ref nodes, right_id)
    }
    if (nodes.data2[pattern_id] == MATCH_PATTERN_CATCH_ALL_ID) {
        return pattern_id
    }
    node.invalid_node_id()
}

// Walk each enum-or-pattern leaf in source order so duplicates get flagged at the repeated leaf.
func check_match_enum_variant_duplicates(
    mut ref mem: Arena,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    pattern_id: i64,
    variant_id: i64,
    seen_before: bool
): bool = {
    if (pattern_id < 0) {
        return seen_before
    }
    if (match_pattern_is_or(ref tokens, ref nodes, pattern_id)) {
        val left_id: i64 = node.node_child_at(ref nodes, pattern_id, 0)
        val left_seen: bool = check_match_enum_variant_duplicates(
            mut ref mem,
            ref tokens,
            ref nodes,
            mut ref diags,
            mut ref diag_pool,
            left_id,
            variant_id,
            seen_before
        )
        val right_id: i64 = node.node_child_at(ref nodes, pattern_id, 1)
        return check_match_enum_variant_duplicates(
            mut ref mem,
            ref tokens,
            ref nodes,
            mut ref diags,
            mut ref diag_pool,
            right_id,
            variant_id,
            left_seen
        )
    }
    if (nodes.data2[pattern_id] == variant_id) {
        if (seen_before) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S075", ref "Duplicate match arm")
        }
        return true
    }
    seen_before
}

// Scalar coverage reuses one flat buffer so duplicates span earlier arms and earlier leaves in the same arm.
func check_match_scalar_pattern_coverage(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref literal_values: ibuf.I64Buf,
    scrutinee_type: i64,
    bool_match: bool,
    pattern_id: i64,
    state: ScalarCoverageState
): ScalarCoverageState = {
    if (pattern_id < 0) {
        return state
    }
    if (match_pattern_is_or(ref tokens, ref nodes, pattern_id)) {
        val left_id: i64 = node.node_child_at(ref nodes, pattern_id, 0)
        val left_state: ScalarCoverageState = check_match_scalar_pattern_coverage(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            mut ref literal_values,
            scrutinee_type,
            bool_match,
            left_id,
            state
        )
        val right_id: i64 = node.node_child_at(ref nodes, pattern_id, 1)
        return check_match_scalar_pattern_coverage(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            mut ref literal_values,
            scrutinee_type,
            bool_match,
            right_id,
            left_state
        )
    }

    if (nodes.data2[pattern_id] == MATCH_PATTERN_CATCH_ALL_ID) {
        return state
    }

    val info: ScalarPatternInfo = match_scalar_pattern_info(
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        pattern_id
    )
    mut valid_value: bool = info.has_value
    if (valid_value && bool_match) {
        valid_value = nodes.kind[pattern_id] == node.NodeKind.BoolLit
    } else {
        if (valid_value) {
            valid_value = expr_type_compatible(
                ref types_table,
                ref builtins,
                ref tokens,
                ref nodes,
                scrutinee_type,
                nodes.type_id[pattern_id],
                pattern_id,
                false
            )
        }
    }
    if (!valid_value) {
        return state
    }

    if (bool_match) {
        mut next_state: ScalarCoverageState = state
        if (info.literal_value != 0) {
            if (state.has_true) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S075", ref "Duplicate match arm")
            }
            next_state.has_true = true
        } else {
            if (state.has_false) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S075", ref "Duplicate match arm")
            }
            next_state.has_false = true
        }
        return next_state
    }

    mut literal_id: i64 = 0
    while (literal_id < literal_values.count) {
        if (literal_values.data[literal_id] == info.literal_value) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S075", ref "Duplicate match arm")
            return state
        }
        literal_id += 1
    }
    ibuf.i64_buf_push(mut ref mem, mut ref literal_values, info.literal_value)
    state
}

// Enum matches are exhaustive when every declared variant is covered exactly once.
func check_match_enum_coverage(
    mut ref mem: Arena,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref types_table: types.Types,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    match_id: i64,
    scrutinee_id: i64,
    scrutinee_type: i64
): void = {
    val enum_decl: i64 = types_table.decl_node[scrutinee_type]
    mut has_else: bool = false
    mut arm_id: i64 = nodes.next_sibling[scrutinee_id]
    while (arm_id >= 0) {
        val pattern_id: i64 = node.node_child_at(ref nodes, arm_id, 0)
        if (has_else) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S089", ref "Catch-all match arm must be last")
        }

        val catch_all_id: i64 = match_pattern_find_catch_all_id(ref tokens, ref nodes, pattern_id)
        if (catch_all_id >= 0) {
            if (has_else) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, catch_all_id, ref "S075", ref "Duplicate match arm")
            }
            has_else = true
        }
        arm_id = nodes.next_sibling[arm_id]
    }

    mut missing_variant: bool = false
    mut variant_id: i64 = nodes.first_child[enum_decl]
    while (variant_id >= 0) {
        if (nodes.kind[variant_id] == node.NodeKind.VariantDecl) {
            mut seen_variant: bool = false
            mut arm_id: i64 = nodes.next_sibling[scrutinee_id]
            while (arm_id >= 0) {
                val pattern_id: i64 = node.node_child_at(ref nodes, arm_id, 0)
                seen_variant = check_match_enum_variant_duplicates(
                    mut ref mem,
                    ref tokens,
                    ref nodes,
                    mut ref diags,
                    mut ref diag_pool,
                    pattern_id,
                    variant_id,
                    seen_variant
                )
                arm_id = nodes.next_sibling[arm_id]
            }
            if (!seen_variant) {
                missing_variant = true
            }
        }
        variant_id = nodes.next_sibling[variant_id]
    }

    if (!has_else && missing_variant) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, match_id, ref "S074", ref "Non-exhaustive match")
    }
}

// Scalar matches need duplicate literal detection plus wildcard-based exhaustiveness.
func check_match_scalar_coverage(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    match_id: i64,
    scrutinee_id: i64,
    scrutinee_type: i64
): void = {
    mut has_catch_all: bool = false
    val bool_match: bool = type_is_bool_builtin(ref types_table, scrutinee_type)
    mut state: ScalarCoverageState = ScalarCoverageState {
        has_true: false,
        has_false: false
    }
    mut literal_values: ibuf.I64Buf = ibuf.i64_buf_new(mut ref mem, 8)

    mut arm_id: i64 = nodes.next_sibling[scrutinee_id]
    while (arm_id >= 0) {
        val pattern_id: i64 = node.node_child_at(ref nodes, arm_id, 0)
        if (has_catch_all) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S089", ref "Catch-all match arm must be last")
        }

        val catch_all_id: i64 = match_pattern_find_catch_all_id(ref tokens, ref nodes, pattern_id)
        if (catch_all_id >= 0) {
            if (has_catch_all) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, catch_all_id, ref "S075", ref "Duplicate match arm")
            }
            has_catch_all = true
        } else {
            state = check_match_scalar_pattern_coverage(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref literal_values,
                scrutinee_type,
                bool_match,
                pattern_id,
                state
            )
        }

        arm_id = nodes.next_sibling[arm_id]
    }

    if (bool_match) {
        if (!has_catch_all && (!(state.has_true) || !(state.has_false))) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, match_id, ref "S074", ref "Non-exhaustive match")
        }
    } else {
        if (!has_catch_all) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, match_id, ref "S074", ref "Non-exhaustive match")
        }
    }
}

// Tagged-enum arms recurse through `|` groups, but only single-variant arms may bind payloads.
func check_match_enum_pattern_impl(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    module_id: i64,
    arm_scope: i64,
    scrutinee_type: i64,
    pattern_id: i64,
    in_or_group: bool
): void = {
    if (match_pattern_is_or(ref tokens, ref nodes, pattern_id)) {
        nodes.type_id[pattern_id] = scrutinee_type
        val left_id: i64 = node.node_child_at(ref nodes, pattern_id, 0)
        val right_id: i64 = node.node_child_at(ref nodes, pattern_id, 1)
        check_match_enum_pattern_impl(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            mut ref scopes_table,
            mut ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            module_id,
            arm_scope,
            scrutinee_type,
            left_id,
            true
        )
        check_match_enum_pattern_impl(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            mut ref scopes_table,
            mut ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            module_id,
            arm_scope,
            scrutinee_type,
            right_id,
            true
        )
        return
    }

    if (check_match_catch_all_pattern(mut ref mem, ref tokens, mut ref nodes, mut ref diags, mut ref diag_pool, pattern_id, scrutinee_type, in_or_group)) {
        return
    }

    val variant_token: i64 = match_pattern_variant_name(ref nodes, pattern_id)
    if (variant_token < 0) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S006", ref "Type mismatch")
        return
    }

    val variant_id: i64 = enum_find_variant(
        ref nodes,
        ref sources,
        ref text_pool,
        ref tokens,
        ref types_table,
        scrutinee_type,
        variant_token
    )
    if (variant_id < 0) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S006", ref "Type mismatch")
        return
    }

    nodes.type_id[pattern_id] = scrutinee_type
    nodes.data2[pattern_id] = variant_id
    val has_payload: bool = flag_has(nodes.data1[variant_id], CHECK_NODE_FLAG_HAS_TYPE)
    if (nodes.kind[pattern_id] != node.NodeKind.CallExpr) {
        if (has_payload && !in_or_group) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S079", ref "Missing payload for data variant")
        }
        return
    }

    if (in_or_group) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S078", ref "Or-pattern enum variants do not bind payloads")
        return
    }
    if (!has_payload) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S078", ref "Unexpected payload/binding for non-data variant")
        return
    }
    if (nodes.data0[pattern_id] != 1) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S079", ref "Missing payload for data variant")
        return
    }

    val binding_id: i64 = node.node_child_at(ref nodes, pattern_id, 1)
    if (binding_id < 0 || nodes.kind[binding_id] != node.NodeKind.Identifier) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S006", ref "Type mismatch")
        return
    }
    if (token_name_is(ref sources, ref text_pool, ref tokens, nodes.data0[binding_id], ref "_")) {
        return
    }

    val payload_type: i64 = ensure_variant_decl_type(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref scopes_table,
        ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        scrutinee_type,
        variant_id
    )
    val symbol_id: i64 = symbols.symbols_push(
        mut ref symbols_table,
        symbols.SymbolKind.LocalSymbol,
        module_id,
        arm_scope,
        binding_id,
        nodes.data0[binding_id],
        payload_type,
        -1,
        0
    )
    scope_append_symbol(mut ref scopes_table, mut ref symbols_table, arm_scope, symbol_id)
    nodes.symbol_id[binding_id] = symbol_id
    nodes.type_id[binding_id] = payload_type

    if (type_has_arena_data(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            payload_type,
            64
        )) {
        val arm_id: i64 = nodes.parent[pattern_id]
        val match_id: i64 = if (arm_id >= 0) {
            nodes.parent[arm_id]
        } else {
            node.invalid_node_id()
        }
        val scrutinee_id: i64 = if (match_id >= 0) {
            node.node_child_at(ref nodes, match_id, 0)
        } else {
            node.invalid_node_id()
        }
        if (scrutinee_id >= 0 &&
            nodes.kind[scrutinee_id] == node.NodeKind.Identifier &&
            nodes.symbol_id[scrutinee_id] >= 0 &&
            symbols_table.arena_source_symbol[nodes.symbol_id[scrutinee_id]] >= 0) {
            symbol_copy_arena_tracking(mut ref symbols_table, symbol_id, nodes.symbol_id[scrutinee_id])
        }
    }
}

func check_match_enum_pattern(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    module_id: i64,
    arm_scope: i64,
    scrutinee_type: i64,
    pattern_id: i64
): void = {
    check_match_enum_pattern_impl(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        mut ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        module_id,
        arm_scope,
        scrutinee_type,
        pattern_id,
        false
    )
}

// Scalar-pattern checking keeps `_` special and otherwise reuses normal expression typing.
func check_match_scalar_pattern_impl(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    module_id: i64,
    scope_id: i64,
    func_return_type: i64,
    in_loop: bool,
    scrutinee_type: i64,
    pattern_id: i64,
    in_or_group: bool
): void = {
    if (match_pattern_is_or(ref tokens, ref nodes, pattern_id)) {
        nodes.type_id[pattern_id] = scrutinee_type
        val left_id: i64 = node.node_child_at(ref nodes, pattern_id, 0)
        val right_id: i64 = node.node_child_at(ref nodes, pattern_id, 1)
        check_match_scalar_pattern_impl(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            mut ref scopes_table,
            mut ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            mut ref deps,
            mut ref deferred,
            module_id,
            scope_id,
            func_return_type,
            in_loop,
            scrutinee_type,
            left_id,
            true
        )
        check_match_scalar_pattern_impl(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            mut ref scopes_table,
            mut ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            mut ref deps,
            mut ref deferred,
            module_id,
            scope_id,
            func_return_type,
            in_loop,
            scrutinee_type,
            right_id,
            true
        )
        return
    }

    if (check_match_catch_all_pattern(mut ref mem, ref tokens, mut ref nodes, mut ref diags, mut ref diag_pool, pattern_id, scrutinee_type, in_or_group)) {
        return
    }
    if (nodes.kind[pattern_id] == node.NodeKind.Identifier &&
        token_name_is(ref sources, ref text_pool, ref tokens, nodes.data0[pattern_id], ref "_")) {
        nodes.type_id[pattern_id] = scrutinee_type
        if (in_or_group) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S006", ref "Type mismatch")
            return
        }
        nodes.data2[pattern_id] = MATCH_PATTERN_CATCH_ALL_ID
        return
    }
    if (nodes.kind[pattern_id] == node.NodeKind.Identifier ||
        nodes.kind[pattern_id] == node.NodeKind.CallExpr) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S006", ref "Type mismatch")
        return
    }

    check_expr(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        mut ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        mut ref deps,
        mut ref deferred,
        module_id,
        scope_id,
        func_return_type,
        in_loop,
        pattern_id,
        false
    )
    if (!expr_type_compatible(
            ref types_table,
            ref builtins,
            ref tokens,
            ref nodes,
            scrutinee_type,
            nodes.type_id[pattern_id],
            pattern_id,
            false
        )) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S006", ref "Type mismatch")
    }
}

func check_match_scalar_pattern(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    module_id: i64,
    scope_id: i64,
    func_return_type: i64,
    in_loop: bool,
    scrutinee_type: i64,
    pattern_id: i64
): void = {
    check_match_scalar_pattern_impl(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        mut ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        mut ref deps,
        mut ref deferred,
        module_id,
        scope_id,
        func_return_type,
        in_loop,
        scrutinee_type,
        pattern_id,
        false
    )
}

// Match arms split into enum-pattern and scalar-pattern checking before the body scope runs.
func check_match_pattern(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    module_id: i64,
    arm_scope: i64,
    func_return_type: i64,
    in_loop: bool,
    scrutinee_type: i64,
    pattern_id: i64
): void = {
    if (scrutinee_type < 0) {
        return
    }
    if (types_table.kind[scrutinee_type] == types.TypeKind.EnumType) {
        check_match_enum_pattern(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            mut ref scopes_table,
            mut ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            module_id,
            arm_scope,
            scrutinee_type,
            pattern_id
        )
        return
    }
    if (type_is_match_scalar(ref types_table, scrutinee_type)) {
        check_match_scalar_pattern(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            mut ref scopes_table,
            mut ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            mut ref deps,
            mut ref deferred,
            module_id,
            arm_scope,
            func_return_type,
            in_loop,
            scrutinee_type,
            pattern_id
        )
        return
    }
    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, pattern_id, ref "S073", ref "Match scrutinee is not an enum, bool, or supported integer type")
}

// Enum variant lookups stay linear because bootstrap enums are small.
func enum_find_variant(
    ref nodes: node.Nodes,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref types_table: types.Types,
    enum_type: i64,
    variant_token: i64
): i64 = {
    if (enum_type < 0 || types_table.kind[enum_type] != types.TypeKind.EnumType) {
        return node.invalid_node_id()
    }

    val enum_decl: i64 = types_table.decl_node[enum_type]
    mut variant_id: i64 = nodes.first_child[enum_decl]
    while (variant_id >= 0) {
        if (nodes.kind[variant_id] == node.NodeKind.VariantDecl &&
            token_name_eq(
                ref sources,
                ref text_pool,
                ref tokens,
                nodes.data0[variant_id],
                variant_token
            )) {
            return variant_id
        }
        variant_id = nodes.next_sibling[variant_id]
    }
    node.invalid_node_id()
}

// Plain-vs-tagged checks only need to know whether any variant carries payload data.
func enum_has_payload_variant(
    ref nodes: node.Nodes,
    ref types_table: types.Types,
    enum_type: i64
): bool = {
    if (enum_type < 0 || types_table.kind[enum_type] != types.TypeKind.EnumType) {
        return false
    }

    val enum_decl: i64 = types_table.decl_node[enum_type]
    mut variant_id: i64 = nodes.first_child[enum_decl]
    while (variant_id >= 0) {
        if (nodes.kind[variant_id] == node.NodeKind.VariantDecl &&
            flag_has(nodes.data1[variant_id], CHECK_NODE_FLAG_HAS_TYPE)) {
            return true
        }
        variant_id = nodes.next_sibling[variant_id]
    }
    false
}

// Variant payload types resolve lazily the same way field rows do.
func ensure_variant_decl_type(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    enum_type: i64,
    variant_id: i64
): i64 = {
    if (variant_id < 0 || !flag_has(nodes.data1[variant_id], CHECK_NODE_FLAG_HAS_TYPE)) {
        return types.invalid_type_id()
    }
    if (nodes.type_id[variant_id] >= 0) {
        return nodes.type_id[variant_id]
    }

    val type_node: i64 = node.node_child_at(ref nodes, variant_id, 0)
    val type_id: i64 = resolve_type_node(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref scopes_table,
        ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        types_table.module_id[enum_type],
        type_node,
        false
    )
    nodes.type_id[variant_id] = type_id
    type_id
}

// Local/global decl helpers both need one stable way to recover the initializer child.
func decl_init_node(ref nodes: node.Nodes, decl_id: i64): i64 = {
    if (decl_id < 0) {
        return node.invalid_node_id()
    }
    if (decl_has_type(ref nodes, decl_id)) {
        return node.node_child_at(ref nodes, decl_id, 1)
    }
    node.node_child_at(ref nodes, decl_id, 0)
}

// Value blocks only contribute to constant-expression checks through their trailing expression.
func block_value_expr(ref nodes: node.Nodes, block_id: i64): i64 = {
    if (block_id < 0 ||
        nodes.kind[block_id] != node.NodeKind.Block ||
        !flag_has(nodes.data1[block_id], CHECK_NODE_FLAG_HAS_VALUE) ||
        nodes.last_child[block_id] < 0) {
        return node.invalid_node_id()
    }
    nodes.last_child[block_id]
}

// If nodes only behave like expressions when the parser proved both branches yield values.
func if_stmt_has_value(ref nodes: node.Nodes, node_id: i64): bool = {
    if (node_id < 0 || nodes.kind[node_id] != node.NodeKind.IfStmt) {
        return false
    }

    val then_id: i64 = node.node_child_at(ref nodes, node_id, 1)
    val else_id: i64 = node.node_child_at(ref nodes, node_id, 2)
    if (block_value_expr(ref nodes, then_id) < 0 || else_id < 0) {
        return false
    }
    if (nodes.kind[else_id] == node.NodeKind.Block) {
        return block_value_expr(ref nodes, else_id) >= 0
    }
    if (nodes.kind[else_id] == node.NodeKind.IfStmt) {
        return if_stmt_has_value(ref nodes, else_id)
    }
    false
}

// Untyped immutable locals/globals are the only bindings that can stand in for comptime values.
func symbol_is_untyped_const_binding(
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    symbol_id: i64
): bool = {
    if (symbol_id < 0) {
        return false
    }
    if (symbols_table.kind[symbol_id] != symbols.SymbolKind.GlobalSymbol &&
        symbols_table.kind[symbol_id] != symbols.SymbolKind.LocalSymbol) {
        return false
    }
    val decl_id: i64 = symbols_table.decl_node[symbol_id]
    decl_id >= 0 &&
    !decl_is_mut(ref nodes, decl_id) &&
    !decl_has_type(ref nodes, decl_id)
}

// Untyped local declarations are limited to a small comptime-only subset.
func expr_is_untyped_constant(
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    node_id: i64,
    budget: i64
): bool = {
    if (node_id < 0 || budget <= 0) {
        return false
    }

    val kind: node.NodeKind = nodes.kind[node_id]
    if (kind == node.NodeKind.NumberLit ||
        kind == node.NodeKind.FloatLit ||
        kind == node.NodeKind.BoolLit ||
        kind == node.NodeKind.CharLit) {
        return true
    }

    if (kind == node.NodeKind.Identifier) {
        val symbol_id: i64 = nodes.symbol_id[node_id]
        if (!symbol_is_untyped_const_binding(ref nodes, ref symbols_table, symbol_id)) {
            return false
        }
        return expr_is_untyped_constant(
            ref nodes,
            ref symbols_table,
            decl_init_node(ref nodes, symbols_table.decl_node[symbol_id]),
            budget - 1
        )
    }

    if (kind == node.NodeKind.UnaryExpr) {
        return expr_is_untyped_constant(
            ref nodes,
            ref symbols_table,
            node.node_child_at(ref nodes, node_id, 0),
            budget - 1
        )
    }

    if (kind == node.NodeKind.BinaryExpr) {
        return expr_is_untyped_constant(
                ref nodes,
                ref symbols_table,
                node.node_child_at(ref nodes, node_id, 0),
                budget - 1
            ) &&
            expr_is_untyped_constant(
                ref nodes,
                ref symbols_table,
                node.node_child_at(ref nodes, node_id, 1),
                budget - 1
            )
    }

    if (kind == node.NodeKind.IfStmt) {
        val then_value: i64 = block_value_expr(ref nodes, node.node_child_at(ref nodes, node_id, 1))
        val else_value: i64 = block_value_expr(ref nodes, node.node_child_at(ref nodes, node_id, 2))
        if (then_value < 0 || else_value < 0) {
            return false
        }
        return expr_is_untyped_constant(
                ref nodes,
                ref symbols_table,
                node.node_child_at(ref nodes, node_id, 0),
                budget - 1
            ) &&
            expr_is_untyped_constant(ref nodes, ref symbols_table, then_value, budget - 1) &&
            expr_is_untyped_constant(ref nodes, ref symbols_table, else_value, budget - 1)
    }

    false
}

// Global initializers accept constants; mut Arena globals handle arena() as a declaration exception.
func expr_is_global_initializer(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    module_id: i64,
    node_id: i64,
    budget: i64
): bool = {
    if (node_id < 0 || budget <= 0) {
        return false
    }

    val kind: node.NodeKind = nodes.kind[node_id]
    if (kind == node.NodeKind.NumberLit ||
        kind == node.NodeKind.FloatLit ||
        kind == node.NodeKind.BoolLit ||
        kind == node.NodeKind.StringLit ||
        kind == node.NodeKind.CharLit) {
        return true
    }

    if (kind == node.NodeKind.Identifier) {
        val symbol_id: i64 = nodes.symbol_id[node_id]
        if (symbol_id < 0) {
            return false
        }
        if (symbols_table.kind[symbol_id] == symbols.SymbolKind.GlobalSymbol &&
            symbols_table.decl_node[symbol_id] < 0 &&
            symbols_table.name_token[symbol_id] == SYNTHETIC_TOKEN_TARGET_OS) {
            return true
        }
        if (!symbol_is_untyped_const_binding(ref nodes, ref symbols_table, symbol_id)) {
            return false
        }
        return expr_is_global_initializer(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            module_id,
            decl_init_node(ref nodes, symbols_table.decl_node[symbol_id]),
            budget - 1
        )
    }

    if (kind == node.NodeKind.UnaryExpr) {
        return expr_is_global_initializer(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            module_id,
            node.node_child_at(ref nodes, node_id, 0),
            budget - 1
        )
    }

    if (kind == node.NodeKind.BinaryExpr) {
        return expr_is_global_initializer(
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                module_id,
                node.node_child_at(ref nodes, node_id, 0),
                budget - 1
            ) &&
            expr_is_global_initializer(
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                module_id,
                node.node_child_at(ref nodes, node_id, 1),
                budget - 1
            )
    }

    if (kind == node.NodeKind.FieldAccess) {
        val left_id: i64 = node.node_child_at(ref nodes, node_id, 0)
        val left: TypePathResolution = resolve_expr_type_path(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            module_id,
            left_id
        )
        if (left.type_id < 0 || types_table.kind[left.type_id] != types.TypeKind.EnumType) {
            return false
        }
        val variant_id: i64 = enum_find_variant(
            ref nodes,
            ref sources,
            ref text_pool,
            ref tokens,
            ref types_table,
            left.type_id,
            nodes.data0[node_id]
        )
        return variant_id >= 0 && !flag_has(nodes.data1[variant_id], CHECK_NODE_FLAG_HAS_TYPE)
    }

    if (kind == node.NodeKind.CallExpr) {
        val callee_id: i64 = node.node_child_at(ref nodes, node_id, 0)
        if (callee_id < 0 || nodes.kind[callee_id] != node.NodeKind.FieldAccess) {
            return false
        }

        val left_id: i64 = node.node_child_at(ref nodes, callee_id, 0)
        val left: TypePathResolution = resolve_expr_type_path(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            module_id,
            left_id
        )
        if (left.type_id < 0 || types_table.kind[left.type_id] != types.TypeKind.EnumType) {
            return false
        }
        if (enum_find_variant(
                ref nodes,
                ref sources,
                ref text_pool,
                ref tokens,
                ref types_table,
                left.type_id,
                nodes.data0[callee_id]
            ) < 0) {
            return false
        }

        mut arg_id: i64 = nodes.next_sibling[callee_id]
        while (arg_id >= 0) {
            if (!expr_is_global_initializer(
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    ref nodes,
                    ref scopes_table,
                    ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    module_id,
                    arg_id,
                    budget - 1
                )) {
                return false
            }
            arg_id = nodes.next_sibling[arg_id]
        }
        return true
    }

    if (kind == node.NodeKind.ConstructorExpr) {
        mut init_id: i64 = nodes.next_sibling[node.node_child_at(ref nodes, node_id, 0)]
        while (init_id >= 0) {
            if (!expr_is_global_initializer(
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    ref nodes,
                    ref scopes_table,
                    ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    module_id,
                    node.node_child_at(ref nodes, init_id, 0),
                    budget - 1
                )) {
                return false
            }
            init_id = nodes.next_sibling[init_id]
        }
        return true
    }

    if (kind == node.NodeKind.ArrayLit) {
        mut elem_id: i64 = nodes.first_child[node_id]
        while (elem_id >= 0) {
            if (!expr_is_global_initializer(
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    ref nodes,
                    ref scopes_table,
                    ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    module_id,
                    elem_id,
                    budget - 1
                )) {
                return false
            }
            elem_id = nodes.next_sibling[elem_id]
        }
        return true
    }

    if (kind == node.NodeKind.IfStmt) {
        val then_value: i64 = block_value_expr(ref nodes, node.node_child_at(ref nodes, node_id, 1))
        val else_value: i64 = block_value_expr(ref nodes, node.node_child_at(ref nodes, node_id, 2))
        if (then_value < 0 || else_value < 0) {
            return false
        }
        return expr_is_global_initializer(
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                module_id,
                node.node_child_at(ref nodes, node_id, 0),
                budget - 1
            ) &&
            expr_is_global_initializer(
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                module_id,
                then_value,
                budget - 1
            ) &&
            expr_is_global_initializer(
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                module_id,
                else_value,
                budget - 1
            )
    }

    false
}

// Global arena construction is a mut Arena declaration exception, not a general constant expression.
func expr_is_global_arena_initializer(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    module_id: i64,
    node_id: i64,
    budget: i64
): bool = {
    if (node_id < 0 ||
        budget <= 0 ||
        nodes.kind[node_id] != node.NodeKind.CallExpr ||
        nodes.type_id[node_id] != builtins.arena_type) {
        return false
    }

    val callee_id: i64 = node.node_child_at(ref nodes, node_id, 0)
    if (callee_id < 0 ||
        nodes.kind[callee_id] != node.NodeKind.Identifier ||
        builtin_call_kind(ref sources, ref text_pool, ref tokens, nodes.data0[callee_id]) != BUILTIN_CALL_ARENA) {
        return false
    }

    mut arg_id: i64 = nodes.next_sibling[callee_id]
    while (arg_id >= 0) {
        if (!expr_is_global_initializer(
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                module_id,
                arg_id,
                budget - 1
            )) {
            return false
        }
        arg_id = nodes.next_sibling[arg_id]
    }

    true
}

// Conservative predicate for future assert stripping and effect-aware diagnostics.
func builtin_call_may_have_side_effects(builtin_kind: i64): bool = {
    builtin_kind == BUILTIN_CALL_ARENA ||
    builtin_kind == BUILTIN_CALL_ARENA_ALLOC ||
    builtin_kind == BUILTIN_CALL_ARENA_RESET ||
    builtin_kind == BUILTIN_CALL_TABLE_ALLOC ||
    builtin_kind == BUILTIN_CALL_TABLE_INSERT
}

// Shared child-list walker so expression and statement containers stay consistent.
func expr_sibling_list_may_have_side_effects(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    first_id: i64
): bool = {
    mut child_id: i64 = first_id
    while (child_id >= 0) {
        if (expr_may_have_side_effects(
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref symbols_table,
                child_id
            )) {
            return true
        }
        child_id = nodes.next_sibling[child_id]
    }
    false
}

// Calls are effectful unless sema identifies a read-only builtin or enum constructor.
func call_expr_may_have_side_effects(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    node_id: i64
): bool = {
    val callee_id: i64 = node.node_child_at(ref nodes, node_id, 0)
    if (callee_id < 0) {
        return true
    }

    if (nodes.kind[callee_id] == node.NodeKind.Identifier) {
        val symbol_id: i64 = nodes.symbol_id[callee_id]
        if (symbol_id >= 0 && symbols_table.kind[symbol_id] == symbols.SymbolKind.FunctionSymbol) {
            return true
        }

        val builtin_kind: i64 = builtin_call_kind(
            ref sources,
            ref text_pool,
            ref tokens,
            nodes.data0[callee_id]
        )
        if (builtin_kind != BUILTIN_CALL_NONE) {
            if (builtin_call_may_have_side_effects(builtin_kind)) {
                return true
            }
            return expr_sibling_list_may_have_side_effects(
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref symbols_table,
                nodes.next_sibling[callee_id]
            )
        }

        return true
    }

    if (nodes.kind[callee_id] == node.NodeKind.FieldAccess) {
        val symbol_id: i64 = nodes.symbol_id[callee_id]
        if (symbol_id >= 0 && symbols_table.kind[symbol_id] == symbols.SymbolKind.FunctionSymbol) {
            return true
        }
        return expr_sibling_list_may_have_side_effects(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            nodes.next_sibling[callee_id]
        )
    }

    true
}

// Walk a checked expression subtree and report whether evaluating it can mutate state or do IO.
pub func expr_may_have_side_effects(
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    node_id: i64
): bool = {
    if (node_id < 0) {
        return false
    }

    val kind: node.NodeKind = nodes.kind[node_id]

    if (kind == node.NodeKind.NumberLit ||
        kind == node.NodeKind.FloatLit ||
        kind == node.NodeKind.BoolLit ||
        kind == node.NodeKind.StringLit ||
        kind == node.NodeKind.CharLit ||
        kind == node.NodeKind.Identifier) {
        return false
    }

    if (kind == node.NodeKind.CallExpr) {
        return call_expr_may_have_side_effects(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            node_id
        )
    }

    if (kind == node.NodeKind.AssignStmt ||
        kind == node.NodeKind.CompoundAssignStmt ||
        kind == node.NodeKind.ReturnStmt ||
        kind == node.NodeKind.AssertStmt ||
        kind == node.NodeKind.WhileStmt ||
        kind == node.NodeKind.ForStmt ||
        kind == node.NodeKind.BreakStmt ||
        kind == node.NodeKind.ContinueStmt) {
        return true
    }

    if (kind == node.NodeKind.VarDecl) {
        return expr_may_have_side_effects(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            decl_init_node(ref nodes, node_id)
        )
    }

    if (kind == node.NodeKind.ConstructorExpr) {
        val callee_id: i64 = node.node_child_at(ref nodes, node_id, 0)
        return expr_sibling_list_may_have_side_effects(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            nodes.next_sibling[callee_id]
        )
    }

    if (kind == node.NodeKind.FieldAccess ||
        kind == node.NodeKind.FieldInit ||
        kind == node.NodeKind.UnaryExpr ||
        kind == node.NodeKind.RefExpr ||
        kind == node.NodeKind.CastExpr ||
        kind == node.NodeKind.ExprStmt) {
        return expr_may_have_side_effects(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            node.node_child_at(ref nodes, node_id, 0)
        )
    }

    if (kind == node.NodeKind.BinaryExpr ||
        kind == node.NodeKind.IndexExpr ||
        kind == node.NodeKind.SliceExpr ||
        kind == node.NodeKind.ArrayLit ||
        kind == node.NodeKind.Block ||
        kind == node.NodeKind.IfStmt ||
        kind == node.NodeKind.MatchExpr ||
        kind == node.NodeKind.MatchArm) {
        return expr_sibling_list_may_have_side_effects(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            nodes.first_child[node_id]
        )
    }

    false
}

func validate_assert_stripping_node(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref symbols_table: symbols.Symbols,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    node_id: i64
): void = {
    if (node_id < 0) {
        return
    }

    if (nodes.kind[node_id] == node.NodeKind.AssertStmt) {
        val cond_id: i64 = node.node_child_at(ref nodes, node_id, 0)
        if (expr_may_have_side_effects(
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref symbols_table,
                cond_id
            )) {
            diag_error_node(
                mut ref mem,
                ref nodes,
                mut ref diags,
                mut ref diag_pool,
                node_id,
                ref "S091",
                ref "Cannot strip assert with side effects"
            )
        }
    }

    mut child_id: i64 = nodes.first_child[node_id]
    while (child_id >= 0) {
        validate_assert_stripping_node(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            mut ref diags,
            mut ref diag_pool,
            child_id
        )
        child_id = nodes.next_sibling[child_id]
    }
}

// Assert stripping is only legal when every removed condition is effect-free.
pub func validate_assert_stripping(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    ref nodes: node.Nodes,
    ref modules: loader.Modules,
    ref symbols_table: symbols.Symbols,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    ref module_range: span.Range
): span.Range = {
    val diag_start: i64 = table_len(ref diags)
    mut module_id: i64 = module_range.start
    val end: i64 = span.range_end(ref module_range)
    while (module_id < end && module_id < table_len(ref modules)) {
        validate_assert_stripping_node(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref symbols_table,
            mut ref diags,
            mut ref diag_pool,
            modules.root_node[module_id]
        )
        module_id += 1
    }
    span.range(diag_start, table_len(ref diags) - diag_start)
}

// Expression nodes infer expected type from the same parent contexts as built-ins.
func expr_expected_type(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    module_id: i64,
    func_return_type: i64,
    node_id: i64
): i64 = {
    val parent_id: i64 = nodes.parent[node_id]
    if (parent_id < 0) {
        return types.invalid_type_id()
    }

    if (nodes.kind[parent_id] == node.NodeKind.VarDecl) {
        if (!decl_has_type(ref nodes, parent_id)) {
            return types.invalid_type_id()
        }
        val type_node: i64 = node.node_child_at(ref nodes, parent_id, 0)
        return resolve_type_node(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            module_id,
            type_node,
            false
        )
    }

    if ((nodes.kind[parent_id] == node.NodeKind.AssignStmt ||
         nodes.kind[parent_id] == node.NodeKind.CompoundAssignStmt) &&
        node.node_child_at(ref nodes, parent_id, 1) == node_id) {
        return nodes.type_id[node.node_child_at(ref nodes, parent_id, 0)]
    }

    if (nodes.kind[parent_id] == node.NodeKind.ReturnStmt &&
        node.node_child_at(ref nodes, parent_id, 0) == node_id) {
        return func_return_type
    }

    if (nodes.kind[parent_id] == node.NodeKind.Block &&
        flag_has(nodes.data1[parent_id], CHECK_NODE_FLAG_HAS_VALUE) &&
        nodes.last_child[parent_id] == node_id) {
        return expr_expected_type(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            module_id,
            func_return_type,
            parent_id
        )
    }

    if ((nodes.kind[parent_id] == node.NodeKind.FuncDecl ||
         nodes.kind[parent_id] == node.NodeKind.NativeFuncDecl) &&
        nodes.last_child[parent_id] == node_id) {
        return nodes.type_id[parent_id]
    }

    if (nodes.kind[parent_id] == node.NodeKind.IfStmt &&
        (node.node_child_at(ref nodes, parent_id, 1) == node_id ||
         node.node_child_at(ref nodes, parent_id, 2) == node_id)) {
        return expr_expected_type(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            module_id,
            func_return_type,
            parent_id
        )
    }

    types.invalid_type_id()
}

// Built-in ref parameters still use the same call-site spelling as normal ref params.
func builtin_ref_value_id(
    mut ref mem: Arena,
    ref nodes: node.Nodes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    arg_id: i64,
    expects_mut_ref: bool
): i64 = {
    if (arg_id < 0) {
        return node.invalid_node_id()
    }

    if (nodes.kind[arg_id] != node.NodeKind.RefExpr) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, arg_id, ref "S038", ref "ref/mut ref mismatch between call site and parameter")
        return arg_id
    }

    val is_mut_ref: bool = flag_has(nodes.data0[arg_id], CHECK_NODE_FLAG_MUT)
    if ((expects_mut_ref && !is_mut_ref) || (!expects_mut_ref && is_mut_ref)) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, arg_id, ref "S038", ref "ref/mut ref mismatch between call site and parameter")
    }
    node.node_child_at(ref nodes, arg_id, 0)
}

// Enum-variant values reuse type-path syntax on the left side and stay typed as the enum.
func check_enum_variant_access(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    module_id: i64,
    node_id: i64
): bool = {
    if (nodes.kind[node_id] != node.NodeKind.FieldAccess) {
        return false
    }

    val left_id: i64 = node.node_child_at(ref nodes, node_id, 0)
    val field_token: i64 = nodes.data0[node_id]
    val left: TypePathResolution = resolve_expr_type_path(
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref scopes_table,
        ref symbols_table,
        mut ref types_table,
        module_id,
        left_id
    )
    if (left.type_id < 0 || types_table.kind[left.type_id] != types.TypeKind.EnumType) {
        return false
    }

    if (left.symbol_id >= 0 &&
        symbols_table.module_id[left.symbol_id] != module_id &&
        !symbols.symbol_is_public(ref symbols_table, left.symbol_id)) {
        val type_name: [u8] = name_text(ref sources, ref text_pool, ref tokens, symbols_table.name_token[left.symbol_id])
        val message: str = message_named(
            mut ref mem,
            ref "Type '",
            ref type_name,
            ref "' is not public in the target module"
        )
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, field_token, ref "S084", ref message)
    }

    nodes.symbol_id[left_id] = left.symbol_id
    nodes.type_id[left_id] = left.type_id

    val variant_id: i64 = enum_find_variant(
        ref nodes,
        ref sources,
        ref text_pool,
        ref tokens,
        ref types_table,
        left.type_id,
        field_token
    )
    if (variant_id < 0) {
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, field_token, ref "P045", ref "Unknown enum variant")
        return true
    }
    if (flag_has(nodes.data1[variant_id], CHECK_NODE_FLAG_HAS_TYPE)) {
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, field_token, ref "S079", ref "Missing payload for data variant")
    }

    nodes.type_id[node_id] = left.type_id
    true
}

// Data-variant construction typechecks like a one-argument constructor returning the enum.
func check_enum_variant_call(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    module_id: i64,
    scope_id: i64,
    func_return_type: i64,
    in_loop: bool,
    node_id: i64
): bool = {
    if (nodes.kind[node_id] != node.NodeKind.CallExpr) {
        return false
    }

    val callee_id: i64 = node.node_child_at(ref nodes, node_id, 0)
    if (callee_id < 0 || nodes.kind[callee_id] != node.NodeKind.FieldAccess) {
        return false
    }

    val left_id: i64 = node.node_child_at(ref nodes, callee_id, 0)
    val field_token: i64 = nodes.data0[callee_id]
    val left: TypePathResolution = resolve_expr_type_path(
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref scopes_table,
        ref symbols_table,
        mut ref types_table,
        module_id,
        left_id
    )
    if (left.type_id < 0 || types_table.kind[left.type_id] != types.TypeKind.EnumType) {
        return false
    }

    if (left.symbol_id >= 0 &&
        symbols_table.module_id[left.symbol_id] != module_id &&
        !symbols.symbol_is_public(ref symbols_table, left.symbol_id)) {
        val type_name: [u8] = name_text(ref sources, ref text_pool, ref tokens, symbols_table.name_token[left.symbol_id])
        val message: str = message_named(
            mut ref mem,
            ref "Type '",
            ref type_name,
            ref "' is not public in the target module"
        )
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, field_token, ref "S084", ref message)
    }

    nodes.symbol_id[left_id] = left.symbol_id
    nodes.type_id[left_id] = left.type_id
    nodes.type_id[callee_id] = left.type_id

    val variant_id: i64 = enum_find_variant(
        ref nodes,
        ref sources,
        ref text_pool,
        ref tokens,
        ref types_table,
        left.type_id,
        field_token
    )
    if (variant_id < 0) {
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, field_token, ref "P045", ref "Unknown enum variant")
        return true
    }

    val arg_count: i64 = nodes.data0[node_id]
    mut arg_id: i64 = nodes.next_sibling[callee_id]
    while (arg_id >= 0) {
        check_expr(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            mut ref scopes_table,
            mut ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            mut ref deps,
            mut ref deferred,
            module_id,
            scope_id,
            func_return_type,
            in_loop,
            arg_id,
            false
        )
        arg_id = nodes.next_sibling[arg_id]
    }

    if (!flag_has(nodes.data1[variant_id], CHECK_NODE_FLAG_HAS_TYPE)) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S078", ref "Unexpected payload for non-data variant")
        nodes.type_id[node_id] = left.type_id
        return true
    }

    if (arg_count == 0) {
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, field_token, ref "S079", ref "Missing payload for data variant")
        nodes.type_id[node_id] = left.type_id
        return true
    }
    if (arg_count != 1) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S017", ref "Wrong number of arguments")
        nodes.type_id[node_id] = left.type_id
        return true
    }

    val payload_id: i64 = node.node_child_at(ref nodes, node_id, 1)
    val payload_type: i64 = ensure_variant_decl_type(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref scopes_table,
        ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        left.type_id,
        variant_id
    )
    if (payload_id >= 0 &&
        !expr_type_compatible(
            ref types_table,
            ref builtins,
            ref tokens,
            ref nodes,
            payload_type,
            nodes.type_id[payload_id],
            payload_id,
            false
        )) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, payload_id, ref "S077", ref "Payload type mismatch in tagged union construction")
    }

    nodes.type_id[node_id] = left.type_id
    true
}

// Compiler built-ins are handled directly until sema gets first-class builtin symbols.
func check_builtin_call(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    module_id: i64,
    scope_id: i64,
    func_return_type: i64,
    in_loop: bool,
    node_id: i64
): bool = {
    val callee_id: i64 = node.node_child_at(ref nodes, node_id, 0)
    if (callee_id < 0 || nodes.kind[callee_id] != node.NodeKind.Identifier) {
        return false
    }

    val name_token: i64 = nodes.data0[callee_id]
    val module_scope: i64 = module_scope_id(ref scopes_table, module_id)
    if (module_find_function(
            ref scopes_table,
            ref symbols_table,
            ref sources,
            ref text_pool,
            ref tokens,
            module_scope,
            name_token,
            false
        ) >= 0) {
        return false
    }

    val builtin_kind: i64 = builtin_call_kind(ref sources, ref text_pool, ref tokens, name_token)
    if (builtin_kind == BUILTIN_CALL_NONE) {
        return false
    }

    val arg_count: i64 = nodes.data0[node_id]

    if (builtin_kind == BUILTIN_CALL_ARENA) {
        val capacity_id: i64 = node.node_child_at(ref nodes, node_id, 1)
        if (capacity_id >= 0) {
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                capacity_id,
                false
            )
            if (!type_is_integer_builtin(ref types_table, nodes.type_id[capacity_id]) &&
                !node_is_integer_literal(ref tokens, ref nodes, capacity_id)) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, capacity_id, ref "S006", ref "Type mismatch")
            }
        }
        if (arg_count != 1) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S017", ref "Wrong number of arguments")
        }
        nodes.type_id[node_id] = builtins.arena_type
        return true
    }

    if (builtin_kind == BUILTIN_CALL_ARENA_ALLOC) {
        val arena_id: i64 = node.node_child_at(ref nodes, node_id, 1)
        val count_id: i64 = node.node_child_at(ref nodes, node_id, 2)
        if (arena_id >= 0) {
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                arena_id,
                false
            )
            val arena_value: i64 = builtin_ref_value_id(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, arena_id, true)
            if (arena_value >= 0 && nodes.type_id[arena_value] >= 0 && nodes.type_id[arena_value] != builtins.arena_type) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, arena_id, ref "S051", ref "arena_alloc() requires Arena type")
            } else {
                if (arena_value >= 0 &&
                    !expr_is_mutable_place(ref nodes, ref symbols_table, arena_value)) {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, arena_id, ref "S052", ref "Cannot arena_alloc from immutable Arena (use 'mut')")
                }
            }
        }
        if (count_id >= 0) {
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                count_id,
                false
            )
            if (!type_is_integer_builtin(ref types_table, nodes.type_id[count_id]) &&
                !node_is_integer_literal(ref tokens, ref nodes, count_id)) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, count_id, ref "S006", ref "Type mismatch")
            }
        }
        if (arg_count != 2) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S017", ref "Wrong number of arguments")
        }

        val expected_type: i64 = expr_expected_type(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            module_id,
            func_return_type,
            node_id
        )
        if (expected_type >= 0 &&
            (types_table.kind[expected_type] == types.TypeKind.SliceType ||
             types_table.kind[expected_type] == types.TypeKind.StrType)) {
            nodes.type_id[node_id] = expected_type
        } else {
            if (expected_type >= 0) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S006", ref "Type mismatch")
            }
        }
        return true
    }

    if (builtin_kind == BUILTIN_CALL_ARENA_RESET) {
        val arena_id: i64 = node.node_child_at(ref nodes, node_id, 1)
        if (arena_id >= 0) {
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                arena_id,
                false
            )
            val arena_value: i64 = builtin_ref_value_id(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, arena_id, true)
            if (arena_value >= 0 && nodes.type_id[arena_value] >= 0 && nodes.type_id[arena_value] != builtins.arena_type) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, arena_id, ref "S006", ref "Type mismatch")
            } else {
                val arena_root: i64 = expr_root_identifier_node(ref nodes, arena_value)
                if (arena_root >= 0 && nodes.symbol_id[arena_root] >= 0) {
                    if (!symbols.symbol_is_mut(ref symbols_table, nodes.symbol_id[arena_root])) {
                        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, arena_id, ref "S055", ref "Cannot arena_reset immutable Arena (use 'mut')")
                    }
                    invalidate_arena_values(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        ref scopes_table,
                        mut ref symbols_table,
                        mut ref types_table,
                        ref builtins,
                        mut ref diags,
                        mut ref diag_pool,
                        scope_id,
                        nodes.symbol_id[arena_root]
                    )
                }
            }
        }
        if (arg_count != 1) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S017", ref "Wrong number of arguments")
        }
        nodes.type_id[node_id] = builtins.void_type
        return true
    }

    if (builtin_kind == BUILTIN_CALL_TABLE_ALLOC) {
        val arena_id: i64 = node.node_child_at(ref nodes, node_id, 1)
        val count_id: i64 = node.node_child_at(ref nodes, node_id, 2)
        if (arena_id >= 0) {
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                arena_id,
                false
            )
            val arena_value: i64 = builtin_ref_value_id(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, arena_id, true)
            if (arena_value >= 0 && nodes.type_id[arena_value] >= 0 && nodes.type_id[arena_value] != builtins.arena_type) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, arena_id, ref "S006", ref "Type mismatch")
            }
        }
        if (count_id >= 0) {
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                count_id,
                false
            )
            if (!type_is_integer_builtin(ref types_table, nodes.type_id[count_id]) &&
                !node_is_integer_literal(ref tokens, ref nodes, count_id)) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, count_id, ref "S006", ref "Type mismatch")
            }
        }
        if (arg_count != 2) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S017", ref "Wrong number of arguments")
        }

        val expected_type: i64 = expr_expected_type(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            module_id,
            func_return_type,
            node_id
        )
        if (expected_type >= 0 && types_table.kind[expected_type] == types.TypeKind.TableType) {
            nodes.type_id[node_id] = expected_type
        } else {
            if (expected_type >= 0) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S006", ref "Type mismatch")
            }
        }
        return true
    }

    if (builtin_kind == BUILTIN_CALL_TABLE_LEN) {
        val table_id: i64 = node.node_child_at(ref nodes, node_id, 1)
        if (table_id >= 0) {
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                table_id,
                false
            )
            val table_value: i64 = builtin_ref_value_id(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, table_id, false)
            if (table_value >= 0 &&
                nodes.type_id[table_value] >= 0 &&
                types_table.kind[nodes.type_id[table_value]] != types.TypeKind.TableType) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, table_id, ref "S060", ref "table_len/table_get/table_insert requires a table type")
            }
        }
        if (arg_count != 1) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S017", ref "Wrong number of arguments")
        }
        nodes.type_id[node_id] = builtins.i64_type
        return true
    }

    if (builtin_kind == BUILTIN_CALL_TABLE_GET) {
        val table_id: i64 = node.node_child_at(ref nodes, node_id, 1)
        val index_id: i64 = node.node_child_at(ref nodes, node_id, 2)
        mut table_type: i64 = types.invalid_type_id()
        if (table_id >= 0) {
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                table_id,
                false
            )
            val table_value: i64 = builtin_ref_value_id(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, table_id, false)
            if (table_value >= 0) {
                table_type = nodes.type_id[table_value]
            }
            if (table_type >= 0 && types_table.kind[table_type] != types.TypeKind.TableType) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, table_id, ref "S060", ref "table_len/table_get/table_insert requires a table type")
            }
        }
        if (index_id >= 0) {
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                index_id,
                false
            )
            if (!type_is_integer_builtin(ref types_table, nodes.type_id[index_id]) &&
                !node_is_integer_literal(ref tokens, ref nodes, index_id)) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, index_id, ref "S034", ref "Index must be integer")
            }
        }
        if (arg_count != 2) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S017", ref "Wrong number of arguments")
        }
        if (table_type >= 0 && types_table.kind[table_type] == types.TypeKind.TableType) {
            nodes.type_id[node_id] = table_row_type(mut ref types_table, table_type)
        }
        return true
    }

    val table_id: i64 = node.node_child_at(ref nodes, node_id, 1)
    val row_id: i64 = node.node_child_at(ref nodes, node_id, 2)
    mut table_type: i64 = types.invalid_type_id()
    if (table_id >= 0) {
        check_expr(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            mut ref scopes_table,
            mut ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            mut ref deps,
            mut ref deferred,
            module_id,
            scope_id,
            func_return_type,
            in_loop,
            table_id,
            false
        )
        val table_value: i64 = builtin_ref_value_id(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, table_id, true)
        if (table_value >= 0) {
            table_type = nodes.type_id[table_value]
        }
        if (table_type >= 0 && types_table.kind[table_type] != types.TypeKind.TableType) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, table_id, ref "S060", ref "table_len/table_get/table_insert requires a table type")
        }
    }
    if (row_id >= 0) {
        check_expr(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            mut ref scopes_table,
            mut ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            mut ref deps,
            mut ref deferred,
            module_id,
            scope_id,
            func_return_type,
            in_loop,
            row_id,
            false
        )
    }
    if (arg_count != 2) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S017", ref "Wrong number of arguments")
    }
    if (table_type >= 0 && types_table.kind[table_type] == types.TypeKind.TableType) {
        val expected_row: i64 = table_row_type(mut ref types_table, table_type)
        if (row_id >= 0 &&
            !expr_type_compatible(
                ref types_table,
                ref builtins,
                ref tokens,
                ref nodes,
                expected_row,
                nodes.type_id[row_id],
                row_id,
                false
            )) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, row_id, ref "S006", ref "Type mismatch")
        }
    }
    nodes.type_id[node_id] = builtins.void_type
    true
}

// Expression checking now resolves both names and concrete subset types.
func check_expr(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    module_id: i64,
    scope_id: i64,
    func_return_type: i64,
    in_loop: bool,
    node_id: i64,
    call_target: bool
): void = {
    if (node_id < 0) {
        return
    }

    val kind: node.NodeKind = nodes.kind[node_id]
    match (kind) {
        NumberLit = {
            val expected_type: i64 = expr_expected_type(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                module_id,
                func_return_type,
                node_id
            )
            if (type_is_integer_builtin(ref types_table, expected_type)) {
                nodes.type_id[node_id] = expected_type
            } else {
                nodes.type_id[node_id] = builtins.i64_type
            }
            return
        }
        FloatLit = {
            nodes.type_id[node_id] = builtins.f64_type
            return
        }
        BoolLit = {
            nodes.type_id[node_id] = builtins.bool_type
            return
        }
        StringLit = {
            nodes.type_id[node_id] = builtins.str_type
            return
        }
        CharLit = {
            nodes.type_id[node_id] = builtins.u8_type
            return
        }

        Identifier = {
            if (call_target) {
                resolve_call_identifier(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    ref scopes_table,
                    ref symbols_table,
                    module_id,
                    node_id,
                    mut ref diags,
                    mut ref diag_pool
                )
            } else {
                resolve_value_identifier(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    ref scopes_table,
                    ref symbols_table,
                    mut ref diags,
                    mut ref diag_pool,
                    scope_id,
                    node_id
                )
            }
            if (nodes.symbol_id[node_id] >= 0) {
                nodes.type_id[node_id] = ensure_symbol_type(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    ref scopes_table,
                    mut ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    nodes.symbol_id[node_id]
                )
                if (symbols.symbol_is_invalidated(ref symbols_table, nodes.symbol_id[node_id]) &&
                    type_has_arena_data(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        ref scopes_table,
                        ref symbols_table,
                        mut ref types_table,
                        ref builtins,
                        mut ref diags,
                        mut ref diag_pool,
                        nodes.type_id[node_id],
                        64
                    )) {
                    val name: [u8] = token_text_or_synthetic(ref sources, ref text_pool, ref tokens, nodes.data0[node_id])
                    val message: str = message_named(mut ref mem, ref "Use of slice '", ref name, ref "' after arena reset")
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S056", ref message)
                }
            }
            return
        }

        RefExpr = {
            val value_id: i64 = node.node_child_at(ref nodes, node_id, 0)
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                value_id,
                false
            )
            if (!expr_can_take_ref(ref nodes, ref types_table, value_id)) {
                if (nodes.kind[value_id] == node.NodeKind.IndexExpr) {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S042", ref "Cannot take reference of array element")
                } else {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S039", ref "Cannot take reference of non-addressable expression")
                }
            } else {
                if (nodes.kind[value_id] == node.NodeKind.FieldAccess &&
                    type_is_scalar_builtin(ref types_table, ref builtins, nodes.type_id[value_id])) {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S041", ref "Cannot take reference of scalar field (just copy it)")
                }
                if (flag_has(nodes.data0[node_id], CHECK_NODE_FLAG_MUT) &&
                    !expr_is_mutable_place(ref nodes, ref symbols_table, value_id)) {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S040", ref "Cannot pass mut ref to immutable variable")
                }
            }
            nodes.type_id[node_id] = nodes.type_id[value_id]
            return
        }

        FieldAccess = {
            if (!call_target &&
                check_enum_variant_access(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    ref scopes_table,
                    ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    module_id,
                    node_id
                )) {
                return
            }

            val left_id: i64 = node.node_child_at(ref nodes, node_id, 0)
            val field_token: i64 = nodes.data0[node_id]
            if (left_id >= 0 && nodes.kind[left_id] == node.NodeKind.Identifier) {
                val name_token: i64 = nodes.data0[left_id]
                val value_symbol: i64 = scope_find_value_visible(
                    ref scopes_table,
                    ref symbols_table,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    scope_id,
                    name_token
                )
                if (value_symbol >= 0) {
                    nodes.symbol_id[left_id] = value_symbol
                    nodes.type_id[left_id] = ensure_symbol_type(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        ref scopes_table,
                        mut ref symbols_table,
                        mut ref types_table,
                        ref builtins,
                        mut ref diags,
                        mut ref diag_pool,
                        value_symbol
                    )
                } else {
                    val alias_symbol: i64 = scope_find_module_alias_local(
                        ref scopes_table,
                        ref symbols_table,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        module_scope_id(ref scopes_table, module_id),
                        name_token
                    )
                    if (alias_symbol >= 0) {
                        nodes.symbol_id[left_id] = alias_symbol
                    } else {
                        check_expr(
                            mut ref mem,
                            ref sources,
                            ref text_pool,
                            ref tokens,
                            mut ref nodes,
                            mut ref scopes_table,
                            mut ref symbols_table,
                            mut ref types_table,
                            ref builtins,
                            mut ref diags,
                            mut ref diag_pool,
                            mut ref deps,
                            mut ref deferred,
                            module_id,
                            scope_id,
                            func_return_type,
                            in_loop,
                            left_id,
                            false
                        )
                    }
                }
            } else {
                check_expr(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    mut ref scopes_table,
                    mut ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    mut ref deps,
                    mut ref deferred,
                    module_id,
                    scope_id,
                    func_return_type,
                    in_loop,
                    left_id,
                    false
                )
            }

            val left_symbol: i64 = nodes.symbol_id[left_id]
            if (left_symbol >= 0 && symbols_table.kind[left_symbol] == symbols.SymbolKind.ModuleAliasSymbol) {
                if (call_target) {
                    resolve_qualified_call(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        ref scopes_table,
                        ref symbols_table,
                        node_id,
                        left_symbol,
                        mut ref diags,
                        mut ref diag_pool
                    )
                } else {
                    resolve_qualified_value(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        ref scopes_table,
                        ref symbols_table,
                        node_id,
                        left_symbol,
                        mut ref diags,
                        mut ref diag_pool
                    )
                }
                if (nodes.symbol_id[node_id] >= 0) {
                    nodes.type_id[node_id] = ensure_symbol_type(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        ref scopes_table,
                        mut ref symbols_table,
                        mut ref types_table,
                        ref builtins,
                        mut ref diags,
                        mut ref diag_pool,
                        nodes.symbol_id[node_id]
                    )
                }
                return
            }

            if (call_target) {
                diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, field_token, ref "S016", ref "Undefined function")
                return
            }

            val left_type: i64 = nodes.type_id[left_id]
            if (token_name_is(ref sources, ref text_pool, ref tokens, field_token, ref "len") &&
                array_like_elem_type(ref types_table, ref builtins, left_type) >= 0) {
                nodes.type_id[node_id] = builtins.i64_type
                return
            }

            val field_decl: i64 = type_find_field(
                ref nodes,
                ref sources,
                ref text_pool,
                ref tokens,
                ref types_table,
                left_type,
                field_token
            )
            if (field_decl < 0) {
                if (record_decl_node(ref types_table, left_type) >= 0) {
                    diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, field_token, ref "S029", ref "Unknown field access")
                } else {
                    diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, field_token, ref "S028", ref "Field access on non-value type")
                }
                return
            }

            val field_type: i64 = ensure_field_decl_type(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                left_type,
                field_decl
            )
            if (left_type >= 0 && types_table.kind[left_type] == types.TypeKind.TableType) {
                nodes.type_id[node_id] = types.type_slice(mut ref types_table, field_type)
            } else {
                nodes.type_id[node_id] = field_type
            }
            return
        }

        CallExpr = {
            val callee_id: i64 = node.node_child_at(ref nodes, node_id, 0)
            if (check_enum_variant_call(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    mut ref scopes_table,
                    mut ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    mut ref deps,
                    mut ref deferred,
                    module_id,
                    scope_id,
                    func_return_type,
                    in_loop,
                    node_id
                )) {
                return
            }
            if (check_builtin_call(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    mut ref scopes_table,
                    mut ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    mut ref deps,
                    mut ref deferred,
                    module_id,
                    scope_id,
                    func_return_type,
                    in_loop,
                    node_id
                )) {
                return
            }

            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                callee_id,
                true
            )

            val callee_symbol: i64 = nodes.symbol_id[callee_id]
            if (callee_symbol < 0 || symbols_table.kind[callee_symbol] != symbols.SymbolKind.FunctionSymbol) {
                return
            }

            val callee_decl: i64 = symbols_table.decl_node[callee_symbol]
            val callee_module: i64 = symbols_table.module_id[callee_symbol]
            val callee_name_token: i64 = symbols_table.name_token[callee_symbol]
            val expected_arg_count: i64 = nodes.data2[callee_decl]
            if (nodes.data0[node_id] != expected_arg_count) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S017", ref "Wrong number of arguments")
            }

            mut arg_id: i64 = nodes.next_sibling[callee_id]
            mut arg_index: i64 = 0
            while (arg_id >= 0) {
                check_expr(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    mut ref scopes_table,
                    mut ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    mut ref deps,
                    mut ref deferred,
                    module_id,
                    scope_id,
                    func_return_type,
                    in_loop,
                    arg_id,
                    false
                )

                if (arg_index < expected_arg_count) {
                    val param_id: i64 = node.node_child_at(ref nodes, callee_decl, arg_index)
                    val param_type: i64 = ensure_param_decl_type(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        ref scopes_table,
                        ref symbols_table,
                        mut ref types_table,
                        ref builtins,
                        mut ref diags,
                        mut ref diag_pool,
                        callee_module,
                        param_id
                    )
                    val expects_ref: bool = decl_is_ref(ref nodes, param_id)
                    val expects_mut_ref: bool = expects_ref && decl_is_mut(ref nodes, param_id)
                    val arg_is_ref: bool = nodes.kind[arg_id] == node.NodeKind.RefExpr
                    if ((expects_ref && !arg_is_ref) || (!expects_ref && arg_is_ref)) {
                        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, arg_id, ref "S038", ref "ref/mut ref mismatch between call site and parameter")
                    } else {
                        if (expects_ref &&
                            ((expects_mut_ref &&
                              !flag_has(nodes.data0[arg_id], CHECK_NODE_FLAG_MUT)) ||
                             (!expects_mut_ref &&
                              flag_has(nodes.data0[arg_id], CHECK_NODE_FLAG_MUT)))) {
                            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, arg_id, ref "S038", ref "ref/mut ref mismatch between call site and parameter")
                        } else {
                            val value_id: i64 = if (arg_is_ref) {
                                node.node_child_at(ref nodes, arg_id, 0)
                            } else {
                                arg_id
                            }
                            if (symbols.symbol_is_native(ref symbols_table, callee_symbol) &&
                                expects_mut_ref &&
                                arg_is_ref &&
                                native_builtin_arg_requires_mutable_buffer(
                                    ref sources,
                                    ref text_pool,
                                    ref tokens,
                                    callee_name_token,
                                    arg_index
                                ) &&
                                !expr_is_mutable_place(ref nodes, ref symbols_table, value_id)) {
                                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, arg_id, ref "S066", ref "I/O built-in buffer must be mutable")
                            }
                            if (!expr_type_compatible(
                                ref types_table,
                                ref builtins,
                                ref tokens,
                                ref nodes,
                                param_type,
                                nodes.type_id[value_id],
                                value_id,
                                expects_ref
                            )) {
                                if (symbols.symbol_is_native(ref symbols_table, callee_symbol) &&
                                    native_builtin_arg_is_fd_integer(
                                        ref sources,
                                        ref text_pool,
                                        ref tokens,
                                        callee_name_token,
                                        arg_index
                                    )) {
                                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, arg_id, ref "S064", ref "I/O built-in fd argument must be integer type")
                                } else {
                                    if (symbols.symbol_is_native(ref symbols_table, callee_symbol) &&
                                        native_builtin_arg_is_byte_buffer(
                                            ref sources,
                                            ref text_pool,
                                            ref tokens,
                                            callee_name_token,
                                            arg_index
                                        )) {
                                        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, arg_id, ref "S065", ref "I/O built-in data/buffer/path argument must be []u8 or [u8; N]")
                                    } else {
                                        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, arg_id, ref "S018", ref "Argument type mismatch")
                                    }
                                }
                            }
                        }
                    }
                }

                arg_id = nodes.next_sibling[arg_id]
                arg_index += 1
            }

            nodes.type_id[node_id] = ensure_function_return_type(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                callee_symbol
            )
            return
        }

        ConstructorExpr = {
            val callee_id: i64 = node.node_child_at(ref nodes, node_id, 0)
            val ctor_type: i64 = resolve_type_node(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                module_id,
                callee_id,
                false
            )
            nodes.type_id[node_id] = ctor_type
            if (ctor_type < 0) {
                return
            }
            if (!(types_table.kind[ctor_type] == types.TypeKind.ValueType ||
                  types_table.kind[ctor_type] == types.TypeKind.StructType ||
                  types_table.kind[ctor_type] == types.TypeKind.TableRowType)) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S027", ref "Not a value type")
                return
            }

            mut init_id: i64 = nodes.next_sibling[callee_id]
            while (init_id >= 0) {
                val value_id: i64 = node.node_child_at(ref nodes, init_id, 0)
                check_expr(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    mut ref scopes_table,
                    mut ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    mut ref deps,
                    mut ref deferred,
                    module_id,
                    scope_id,
                    func_return_type,
                    in_loop,
                    value_id,
                    false
                )

                val init_name: i64 = nodes.data0[init_id]
                mut prev_id: i64 = nodes.next_sibling[callee_id]
                while (prev_id >= 0 && prev_id != init_id) {
                    if (token_name_eq(ref sources, ref text_pool, ref tokens, nodes.data0[prev_id], init_name)) {
                        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, init_name, ref "S026", ref "Duplicate field in constructor")
                        prev_id = init_id
                    } else {
                        prev_id = nodes.next_sibling[prev_id]
                    }
                }

                val field_decl: i64 = type_find_field(
                    ref nodes,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    ref types_table,
                    ctor_type,
                    init_name
                )
                if (field_decl < 0) {
                    diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, init_name, ref "S024", ref "Unknown field in constructor")
                } else {
                    val field_type: i64 = ensure_field_decl_type(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        ref scopes_table,
                        ref symbols_table,
                        mut ref types_table,
                        ref builtins,
                        mut ref diags,
                        mut ref diag_pool,
                        ctor_type,
                        field_decl
                    )
                    if (!expr_type_compatible(
                        ref types_table,
                        ref builtins,
                        ref tokens,
                        ref nodes,
                        field_type,
                        nodes.type_id[value_id],
                        value_id,
                        false
                    )) {
                        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, value_id, ref "S006", ref "Type mismatch")
                    }
                }

                init_id = nodes.next_sibling[init_id]
            }

            val decl_id: i64 = record_decl_node(ref types_table, ctor_type)
            mut field_decl: i64 = nodes.first_child[decl_id]
            while (field_decl >= 0) {
                if (nodes.kind[field_decl] == node.NodeKind.FieldDecl) {
                    mut found: bool = false
                    init_id = nodes.next_sibling[callee_id]
                    while (init_id >= 0) {
                        if (token_name_eq(ref sources, ref text_pool, ref tokens, nodes.data0[field_decl], nodes.data0[init_id])) {
                            found = true
                            init_id = -1
                        } else {
                            init_id = nodes.next_sibling[init_id]
                        }
                    }
                    if (!found) {
                        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, nodes.data0[field_decl], ref "S025", ref "Missing field in constructor")
                    }
                }
                field_decl = nodes.next_sibling[field_decl]
            }
            return
        }

        ArrayLit = {
            val first_elem: i64 = nodes.first_child[node_id]
            if (first_elem < 0) {
                return
            }

            val expected_type: i64 = expr_expected_type(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                module_id,
                func_return_type,
                node_id
            )
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                first_elem,
                false
            )
            mut elem_type: i64 = if (expected_type >= 0 && types_table.kind[expected_type] == types.TypeKind.ArrayType) {
                types_table.data0[expected_type]
            } else {
                nodes.type_id[first_elem]
            }
            if (expected_type >= 0 &&
                types_table.kind[expected_type] == types.TypeKind.ArrayType &&
                !expr_type_compatible(
                    ref types_table,
                    ref builtins,
                    ref tokens,
                    ref nodes,
                    elem_type,
                    nodes.type_id[first_elem],
                    first_elem,
                    false
                )) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, first_elem, ref "S033", ref "Array element type mismatch")
            }
            if (expected_type >= 0 &&
                types_table.kind[expected_type] == types.TypeKind.ArrayType &&
                types_table.data1[expected_type] != nodes.data0[node_id]) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S032", ref "Array literal wrong number of elements")
            }

            mut elem_id: i64 = nodes.next_sibling[first_elem]
            while (elem_id >= 0) {
                check_expr(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    mut ref scopes_table,
                    mut ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    mut ref deps,
                    mut ref deferred,
                    module_id,
                    scope_id,
                    func_return_type,
                    in_loop,
                    elem_id,
                    false
                )
                val common_type: i64 = numeric_common_type(
                    ref types_table,
                    ref builtins,
                    ref tokens,
                    ref nodes,
                    first_elem,
                    elem_type,
                    elem_id,
                    nodes.type_id[elem_id]
                )
                if (expr_type_compatible(
                    ref types_table,
                    ref builtins,
                    ref tokens,
                    ref nodes,
                    elem_type,
                    nodes.type_id[elem_id],
                    elem_id,
                    false
                )) {
                } else {
                    if (expected_type < 0 && common_type >= 0) {
                        elem_type = common_type
                    } else {
                        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, elem_id, ref "S033", ref "Array element type mismatch")
                    }
                }
                elem_id = nodes.next_sibling[elem_id]
            }

            nodes.type_id[node_id] = types.type_array(mut ref types_table, elem_type, nodes.data0[node_id])
            return
        }

        IndexExpr = {
            val object_id: i64 = node.node_child_at(ref nodes, node_id, 0)
            val index_id: i64 = node.node_child_at(ref nodes, node_id, 1)
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                object_id,
                false
            )
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                index_id,
                false
            )
            if (!type_is_integer_builtin(ref types_table, nodes.type_id[index_id]) &&
                !node_is_integer_literal(ref tokens, ref nodes, index_id)) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, index_id, ref "S034", ref "Index must be integer")
            }
            val elem_type: i64 = array_like_elem_type(ref types_table, ref builtins, nodes.type_id[object_id])
            if (elem_type < 0) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, object_id, ref "S035", ref "Cannot index non-array type")
            } else {
                nodes.type_id[node_id] = elem_type
            }
            return
        }

        SliceExpr = {
            val object_id: i64 = node.node_child_at(ref nodes, node_id, 0)
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                object_id,
                false
            )

            mut bound_id: i64 = nodes.next_sibling[object_id]
            while (bound_id >= 0) {
                check_expr(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    mut ref scopes_table,
                    mut ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    mut ref deps,
                    mut ref deferred,
                    module_id,
                    scope_id,
                    func_return_type,
                    in_loop,
                    bound_id,
                    false
                )
                if (!type_is_integer_builtin(ref types_table, nodes.type_id[bound_id]) &&
                    !node_is_integer_literal(ref tokens, ref nodes, bound_id)) {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, bound_id, ref "S071", ref "Slice range bound must be integer type")
                }
                bound_id = nodes.next_sibling[bound_id]
            }

            val slice_type: i64 = array_like_slice_type(mut ref types_table, ref builtins, nodes.type_id[object_id])
            if (slice_type < 0) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, object_id, ref "S072", ref "Cannot sub-slice non-array/slice type")
            } else {
                nodes.type_id[node_id] = slice_type
            }
            return
        }

        UnaryExpr = {
            val operand_id: i64 = node.node_child_at(ref nodes, node_id, 0)
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                operand_id,
                false
            )
            val op_kind: token.TokenKind = tokens.kind[nodes.data0[node_id]]
            if (op_kind == token.TokenKind.Minus) {
                if (type_is_numeric_builtin(ref types_table, nodes.type_id[operand_id])) {
                    nodes.type_id[node_id] = nodes.type_id[operand_id]
                } else {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, operand_id, ref "S006", ref "Type mismatch")
                }
            } else {
                if (op_kind == token.TokenKind.Bang) {
                    if (type_is_bool_builtin(ref types_table, nodes.type_id[operand_id])) {
                        nodes.type_id[node_id] = builtins.bool_type
                    } else {
                        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, operand_id, ref "S006", ref "Type mismatch")
                    }
                } else {
                    if (type_is_integer_builtin(ref types_table, nodes.type_id[operand_id])) {
                        nodes.type_id[node_id] = nodes.type_id[operand_id]
                    } else {
                        if (nodes.type_id[operand_id] >= 0 &&
                            types_table.kind[nodes.type_id[operand_id]] == types.TypeKind.F64Type) {
                            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, operand_id, ref "S062", ref "bitwise operators are not supported on floating-point types")
                        } else {
                            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, operand_id, ref "S006", ref "Type mismatch")
                        }
                    }
                }
            }
            return
        }

        BinaryExpr = {
            val left_id: i64 = node.node_child_at(ref nodes, node_id, 0)
            val right_id: i64 = node.node_child_at(ref nodes, node_id, 1)
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                left_id,
                false
            )
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                right_id,
                false
            )

            val op_kind: token.TokenKind = tokens.kind[nodes.data0[node_id]]
            val left_is_enum: bool = nodes.type_id[left_id] >= 0 && types_table.kind[nodes.type_id[left_id]] == types.TypeKind.EnumType
            val right_is_enum: bool = nodes.type_id[right_id] >= 0 && types_table.kind[nodes.type_id[right_id]] == types.TypeKind.EnumType
            if (op_kind == token.TokenKind.AndAnd || op_kind == token.TokenKind.OrOr) {
                if (!type_is_bool_builtin(ref types_table, nodes.type_id[left_id]) ||
                    !type_is_bool_builtin(ref types_table, nodes.type_id[right_id])) {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S006", ref "Type mismatch")
                } else {
                    nodes.type_id[node_id] = builtins.bool_type
                }
                return
            }

            if (op_kind == token.TokenKind.EqualEqual || op_kind == token.TokenKind.BangEqual) {
                if (left_is_enum || right_is_enum) {
                    if (left_is_enum != right_is_enum) {
                        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S006", ref "Type mismatch")
                    } else {
                        if (nodes.type_id[left_id] != nodes.type_id[right_id]) {
                            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S068", ref "Cannot compare different enum types")
                        } else {
                            if (enum_has_payload_variant(ref nodes, ref types_table, nodes.type_id[left_id])) {
                                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S080", ref "Cannot compare tagged enum (use match instead)")
                            } else {
                                nodes.type_id[node_id] = builtins.bool_type
                            }
                        }
                    }
                    return
                }

                // Bool equality follows stage-0 semantics; ordering stays numeric-only.
                if (type_is_bool_builtin(ref types_table, nodes.type_id[left_id]) &&
                    type_is_bool_builtin(ref types_table, nodes.type_id[right_id])) {
                    nodes.type_id[node_id] = builtins.bool_type
                    return
                }

                if (type_is_numeric_builtin(ref types_table, nodes.type_id[left_id]) &&
                    type_is_numeric_builtin(ref types_table, nodes.type_id[right_id]) &&
                    (expr_type_compatible(
                            ref types_table,
                            ref builtins,
                            ref tokens,
                            ref nodes,
                            nodes.type_id[left_id],
                            nodes.type_id[right_id],
                            right_id,
                            false
                        ) ||
                        expr_type_compatible(
                            ref types_table,
                            ref builtins,
                            ref tokens,
                            ref nodes,
                            nodes.type_id[right_id],
                            nodes.type_id[left_id],
                            left_id,
                            false
                        ))) {
                    nodes.type_id[node_id] = builtins.bool_type
                } else {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S006", ref "Type mismatch")
                }
                return
            }

            val common_type: i64 = numeric_common_type(
                ref types_table,
                ref builtins,
                ref tokens,
                ref nodes,
                left_id,
                nodes.type_id[left_id],
                right_id,
                nodes.type_id[right_id]
            )
            if (op_kind == token.TokenKind.Less ||
                op_kind == token.TokenKind.Greater ||
                op_kind == token.TokenKind.LessEqual ||
                op_kind == token.TokenKind.GreaterEqual) {
                if (left_is_enum || right_is_enum) {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S067", ref "Arithmetic or ordering not allowed on enum type")
                    return
                }
                if (common_type >= 0 && type_is_numeric_builtin(ref types_table, common_type)) {
                    nodes.type_id[node_id] = builtins.bool_type
                } else {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S006", ref "Type mismatch")
                }
                return
            }

            if (op_kind == token.TokenKind.Percent ||
                op_kind == token.TokenKind.Ampersand ||
                op_kind == token.TokenKind.Pipe ||
                op_kind == token.TokenKind.Caret ||
                op_kind == token.TokenKind.LessLess ||
                op_kind == token.TokenKind.GreaterGreater) {
                val left_is_float_operand: bool = nodes.type_id[left_id] >= 0 &&
                    types_table.kind[nodes.type_id[left_id]] == types.TypeKind.F64Type
                val right_is_float_operand: bool = nodes.type_id[right_id] >= 0 &&
                    types_table.kind[nodes.type_id[right_id]] == types.TypeKind.F64Type
                if (left_is_enum || right_is_enum) {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S067", ref "Arithmetic or ordering not allowed on enum type")
                    return
                }
                if (left_is_float_operand || right_is_float_operand) {
                    if (op_kind == token.TokenKind.Percent) {
                        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S061", ref "modulo operator '%' is not supported on floating-point types")
                    } else {
                        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S062", ref "bitwise operators are not supported on floating-point types")
                    }
                    return
                }
                if (common_type >= 0 && type_is_integer_builtin(ref types_table, common_type)) {
                    nodes.type_id[node_id] = common_type
                } else {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S006", ref "Type mismatch")
                }
                return
            }

            if (left_is_enum || right_is_enum) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S067", ref "Arithmetic or ordering not allowed on enum type")
                return
            }
            if (common_type >= 0 && type_is_numeric_builtin(ref types_table, common_type)) {
                nodes.type_id[node_id] = common_type
            } else {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S006", ref "Type mismatch")
            }
            return
        }

        CastExpr = {
            val operand_id: i64 = node.node_child_at(ref nodes, node_id, 0)
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                operand_id,
                false
            )
            nodes.type_id[node_id] = types.builtin_type_from_token(ref builtins, tokens.kind[nodes.data0[node_id]])
            if (nodes.type_id[operand_id] >= 0 &&
                types_table.kind[nodes.type_id[operand_id]] == types.TypeKind.EnumType) {
                if (enum_has_payload_variant(ref nodes, ref types_table, nodes.type_id[operand_id])) {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, operand_id, ref "S081", ref "Cannot cast tagged enum to numeric type")
                } else {
                    if (!type_is_integer_builtin(ref types_table, nodes.type_id[node_id])) {
                        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, operand_id, ref "S063", ref "Cannot cast non-numeric type")
                    }
                }
                return
            }
            if (!type_is_numeric_builtin(ref types_table, nodes.type_id[operand_id]) &&
                !node_is_integer_literal(ref tokens, ref nodes, operand_id) &&
                !node_is_float_literal(ref tokens, ref nodes, operand_id)) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, operand_id, ref "S063", ref "Cannot cast non-numeric type")
            }
            return
        }

        Block = {
            check_block(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                node_id,
                true
            )
            return
        }

        IfStmt = {
            val cond_id: i64 = node.node_child_at(ref nodes, node_id, 0)
            val then_id: i64 = node.node_child_at(ref nodes, node_id, 1)
            val else_id: i64 = node.node_child_at(ref nodes, node_id, 2)
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                cond_id,
                false
            )
            if (!type_is_bool_builtin(ref types_table, nodes.type_id[cond_id])) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, cond_id, ref "S007", ref "Condition must be bool")
            }
            if (then_id >= 0) {
                check_block(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    mut ref scopes_table,
                    mut ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    mut ref deps,
                    mut ref deferred,
                    module_id,
                    scope_id,
                    func_return_type,
                    in_loop,
                    then_id,
                    true
                )
            }
            if (else_id >= 0) {
                if (nodes.kind[else_id] == node.NodeKind.Block) {
                    check_block(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        mut ref scopes_table,
                        mut ref symbols_table,
                        mut ref types_table,
                        ref builtins,
                        mut ref diags,
                        mut ref diag_pool,
                        mut ref deps,
                        mut ref deferred,
                        module_id,
                        scope_id,
                        func_return_type,
                        in_loop,
                        else_id,
                        true
                    )
                } else {
                    check_expr(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        mut ref scopes_table,
                        mut ref symbols_table,
                        mut ref types_table,
                        ref builtins,
                        mut ref diags,
                        mut ref diag_pool,
                        mut ref deps,
                        mut ref deferred,
                        module_id,
                        scope_id,
                        func_return_type,
                        in_loop,
                        else_id,
                        false
                    )
                }
            } else {
                nodes.type_id[node_id] = builtins.void_type
                return
            }

            if (!if_stmt_has_value(ref nodes, node_id)) {
                nodes.type_id[node_id] = builtins.void_type
                return
            }

            if (expr_type_compatible(
                    ref types_table,
                    ref builtins,
                    ref tokens,
                    ref nodes,
                    nodes.type_id[then_id],
                    nodes.type_id[else_id],
                    else_id,
                    false
                )) {
                nodes.type_id[node_id] = nodes.type_id[then_id]
            } else {
                if (expr_type_compatible(
                        ref types_table,
                        ref builtins,
                        ref tokens,
                        ref nodes,
                        nodes.type_id[else_id],
                        nodes.type_id[then_id],
                        then_id,
                        false
                    )) {
                    nodes.type_id[node_id] = nodes.type_id[else_id]
                } else {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, node_id, ref "S021", ref "If/else branches have incompatible types")
                }
            }
            return
        }

        MatchExpr = {
            val scrutinee_id: i64 = node.node_child_at(ref nodes, node_id, 0)
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                scrutinee_id,
                false
            )

            mut result_type: i64 = builtins.void_type
            mut result_node: i64 = node.invalid_node_id()
            mut arm_id: i64 = nodes.next_sibling[scrutinee_id]
            mut first_arm: bool = true
            while (arm_id >= 0) {
                val pattern_id: i64 = node.node_child_at(ref nodes, arm_id, 0)
                val body_id: i64 = node.node_child_at(ref nodes, arm_id, 1)
                if (body_id >= 0) {
                    val arm_scope: i64 = scopes.scopes_push(mut ref scopes_table, scope_id, module_id, arm_id)
                    if (pattern_id >= 0) {
                        check_match_pattern(
                            mut ref mem,
                            ref sources,
                            ref text_pool,
                            ref tokens,
                            mut ref nodes,
                            mut ref scopes_table,
                            mut ref symbols_table,
                            mut ref types_table,
                            ref builtins,
                            mut ref diags,
                            mut ref diag_pool,
                            mut ref deps,
                            mut ref deferred,
                            module_id,
                            arm_scope,
                            func_return_type,
                            in_loop,
                            nodes.type_id[scrutinee_id],
                            pattern_id
                        )
                    }
                    check_block(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        mut ref scopes_table,
                        mut ref symbols_table,
                        mut ref types_table,
                        ref builtins,
                        mut ref diags,
                        mut ref diag_pool,
                        mut ref deps,
                        mut ref deferred,
                        module_id,
                        arm_scope,
                        func_return_type,
                        in_loop,
                        body_id,
                        false
                    )
                    val body_value_id: i64 = if (block_value_expr(ref nodes, body_id) >= 0) {
                        block_value_expr(ref nodes, body_id)
                    } else {
                        body_id
                    }
                    if (first_arm) {
                        result_type = nodes.type_id[body_id]
                        result_node = body_value_id
                        first_arm = false
                    } else {
                        val common_type: i64 = numeric_common_type(
                            ref types_table,
                            ref builtins,
                            ref tokens,
                            ref nodes,
                            result_node,
                            result_type,
                            body_value_id,
                            nodes.type_id[body_id]
                        )
                        if (expr_type_compatible(
                                ref types_table,
                                ref builtins,
                                ref tokens,
                                ref nodes,
                                result_type,
                                nodes.type_id[body_id],
                                body_value_id,
                                false
                            )) {
                        } else {
                            if (expr_type_compatible(
                                    ref types_table,
                                    ref builtins,
                                    ref tokens,
                                    ref nodes,
                                    nodes.type_id[body_id],
                                    result_type,
                                    result_node,
                                    false
                                )) {
                                result_type = nodes.type_id[body_id]
                                result_node = body_value_id
                            } else {
                                if (common_type >= 0) {
                                    result_type = common_type
                                    result_node = body_value_id
                                } else {
                                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, body_id, ref "S076", ref "Match arm types incompatible")
                                }
                            }
                        }
                    }
                }
                arm_id = nodes.next_sibling[arm_id]
            }
            if (nodes.type_id[scrutinee_id] >= 0) {
                if (types_table.kind[nodes.type_id[scrutinee_id]] == types.TypeKind.EnumType) {
                    check_match_enum_coverage(
                        mut ref mem,
                        ref tokens,
                        ref nodes,
                        ref types_table,
                        mut ref diags,
                        mut ref diag_pool,
                        node_id,
                        scrutinee_id,
                        nodes.type_id[scrutinee_id]
                    )
                } else {
                    if (type_is_match_scalar(ref types_table, nodes.type_id[scrutinee_id])) {
                        check_match_scalar_coverage(
                            mut ref mem,
                            ref sources,
                            ref text_pool,
                            ref tokens,
                            ref nodes,
                            ref types_table,
                            ref builtins,
                            mut ref diags,
                            mut ref diag_pool,
                            node_id,
                            scrutinee_id,
                            nodes.type_id[scrutinee_id]
                        )
                    }
                }
            }
            nodes.type_id[node_id] = result_type
            return
        }

        else = {
            mut child_id: i64 = nodes.first_child[node_id]
            while (child_id >= 0) {
                check_expr(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    mut ref scopes_table,
                    mut ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    mut ref deps,
                    mut ref deferred,
                    module_id,
                    scope_id,
                    func_return_type,
                    in_loop,
                    child_id,
                    false
                )
                child_id = nodes.next_sibling[child_id]
            }
            return
        }
    }
}

// Assignment checks reuse expression typing, addressability, and mutability helpers.
func check_assignment_target(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    module_id: i64,
    scope_id: i64,
    func_return_type: i64,
    in_loop: bool,
    target_id: i64
): i64 = {
    check_expr(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        mut ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        mut ref deps,
        mut ref deferred,
        module_id,
        scope_id,
        func_return_type,
        in_loop,
        target_id,
        false
    )

    if (nodes.kind[target_id] == node.NodeKind.FieldAccess) {
        val object_id: i64 = node.node_child_at(ref nodes, target_id, 0)
        if (token_name_is(ref sources, ref text_pool, ref tokens, nodes.data0[target_id], ref "len") &&
            array_like_elem_type(ref types_table, ref builtins, nodes.type_id[object_id]) >= 0) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, target_id, ref "S088", ref "Assignment target must be a variable, field, or index expression")
            return nodes.type_id[target_id]
        }
    }

    if (!expr_is_addressable(ref nodes, target_id)) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, target_id, ref "S088", ref "Assignment target must be a variable, field, or index expression")
        return nodes.type_id[target_id]
    }

    if (nodes.kind[target_id] == node.NodeKind.Identifier) {
        if (!expr_is_mutable_place(ref nodes, ref symbols_table, target_id)) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, target_id, ref "S003", ref "Cannot assign to immutable variable")
        }
    } else {
        if (nodes.kind[target_id] == node.NodeKind.FieldAccess) {
            if (!expr_is_mutable_place(ref nodes, ref symbols_table, target_id)) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, target_id, ref "S030", ref "Cannot assign to field of immutable variable")
            }
        } else {
            if (!expr_is_mutable_place(ref nodes, ref symbols_table, target_id)) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, target_id, ref "S036", ref "Cannot assign to element of immutable variable")
            }
        }
    }

    nodes.type_id[target_id]
}

// Shared slice-local and non-copyable-copy checks for local declarations.
func check_decl_copy_safety(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    type_id: i64,
    init_node: i64
): bool = {
    if (type_id >= 0 &&
        types_table.kind[type_id] == types.TypeKind.SliceType &&
        !expr_is_slice_local_initializer(ref nodes, init_node)) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, init_node, ref "S046", ref "Slice type not allowed as local variable (use arena_alloc or function call)")
        return true
    }
    if (type_is_non_copyable(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            type_id,
            64
        ) &&
        expr_is_copy_source(ref nodes, init_node)) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, init_node, ref "S043", ref "Cannot copy non-copyable value")
        return true
    }
    false
}

// Local declarations infer or validate their type before introducing the new binding.
func check_local_decl(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    module_id: i64,
    scope_id: i64,
    func_return_type: i64,
    in_loop: bool,
    decl_id: i64
): void = {
    val name_token: i64 = nodes.data0[decl_id]
    val has_decl_type: bool = decl_has_type(ref nodes, decl_id)
    mut type_id: i64 = types.invalid_type_id()
    val type_child: i64 = if (has_decl_type) {
        node.node_child_at(ref nodes, decl_id, 0)
    } else {
        node.invalid_node_id()
    }
    val init_child: i64 = if (has_decl_type) {
        node.node_child_at(ref nodes, decl_id, 1)
    } else {
        node.node_child_at(ref nodes, decl_id, 0)
    }

    if (type_child >= 0) {
        type_id = resolve_type_node(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            module_id,
            type_child,
            false
        )
    }

    check_expr(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        mut ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        mut ref deps,
        mut ref deferred,
        module_id,
        scope_id,
        func_return_type,
        in_loop,
        init_child,
        false
    )

    if (scope_find_value_local(
        ref scopes_table,
        ref symbols_table,
        ref sources,
        ref text_pool,
        ref tokens,
        scope_id,
        name_token
    ) >= 0) {
        val name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, name_token)
        val message: str = message_named(
            mut ref mem,
            ref "Variable '",
            ref name,
            ref "' already declared in this scope"
        )
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, name_token, ref "S001", ref message)
        return
    }

    if (type_id < 0) {
        if (!decl_is_mut(ref nodes, decl_id) &&
            !expr_is_untyped_constant(ref nodes, ref symbols_table, init_child, 64)) {
            diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, name_token, ref "S020", ref "Type annotation required (expression is not compile-time constant)")
        }
        type_id = nodes.type_id[init_child]
    } else {
        if (!check_decl_copy_safety(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                type_id,
                init_child
            )) {
            if (!expr_type_compatible(
                    ref types_table,
                    ref builtins,
                    ref tokens,
                    ref nodes,
                    type_id,
                    nodes.type_id[init_child],
                    init_child,
                    false
                )) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, init_child, ref "S006", ref "Type mismatch")
            }
        }
    }
    if (!has_decl_type && type_id >= 0) {
        check_decl_copy_safety(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            type_id,
            init_child
        )
    }
    if (type_is_integer_builtin(ref types_table, type_id)) {
        check_integer_binding_diagnostics(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            type_id,
            init_child
        )
    }
    if (decl_is_mut(ref nodes, decl_id) &&
        decl_init_is_string_literal(ref nodes, decl_id)) {
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, name_token, ref "S054", ref "String literals cannot be mutable (use 'val')")
    }
    nodes.type_id[decl_id] = type_id

    mut flags: i64 = 0
    if (decl_is_mut(ref nodes, decl_id)) {
        flags |= 2
    }
    val symbol_id: i64 = symbols.symbols_push(
        mut ref symbols_table,
        symbols.SymbolKind.LocalSymbol,
        module_id,
        scope_id,
        decl_id,
        name_token,
        type_id,
        -1,
        flags
    )
    scope_append_symbol(mut ref scopes_table, mut ref symbols_table, scope_id, symbol_id)
    nodes.symbol_id[decl_id] = symbol_id

    if (type_has_arena_data(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            type_id,
            64
        )) {
        track_symbol_arena_from_expr(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref builtins,
            mut ref symbols_table,
            symbol_id,
            init_child
        )
    }
}

// Assignment statements share target/value validation; compound ops add numeric checks.
func check_assignment_stmt(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    module_id: i64,
    scope_id: i64,
    func_return_type: i64,
    in_loop: bool,
    stmt_id: i64
): void = {
    val target_id: i64 = node.node_child_at(ref nodes, stmt_id, 0)
    val value_id: i64 = node.node_child_at(ref nodes, stmt_id, 1)
    val target_type: i64 = check_assignment_target(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        mut ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        mut ref deps,
        mut ref deferred,
        module_id,
        scope_id,
        func_return_type,
        in_loop,
        target_id
    )
    check_expr(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        mut ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        mut ref deps,
        mut ref deferred,
        module_id,
        scope_id,
        func_return_type,
        in_loop,
        value_id,
        false
    )

    if (!expr_type_compatible(
        ref types_table,
        ref builtins,
        ref tokens,
        ref nodes,
        target_type,
        nodes.type_id[value_id],
        value_id,
        false
    )) {
        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, value_id, ref "S006", ref "Type mismatch")
    } else {
        if (nodes.kind[target_id] == node.NodeKind.Identifier &&
            nodes.symbol_id[target_id] >= 0 &&
            type_has_arena_data(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                target_type,
                64
            )) {
            track_symbol_arena_from_expr(
                ref sources,
                ref text_pool,
                ref tokens,
                ref nodes,
                ref builtins,
                mut ref symbols_table,
                nodes.symbol_id[target_id],
                value_id
            )
        }
        if (nodes.kind[stmt_id] == node.NodeKind.CompoundAssignStmt) {
            val op_kind: token.TokenKind = tokens.kind[nodes.data0[stmt_id]]
            val common_type: i64 = numeric_common_type(
                ref types_table,
                ref builtins,
                ref tokens,
                ref nodes,
                target_id,
                target_type,
                value_id,
                nodes.type_id[value_id]
            )
            if (op_kind == token.TokenKind.PercentEqual ||
                op_kind == token.TokenKind.AmpersandEqual ||
                op_kind == token.TokenKind.PipeEqual ||
                op_kind == token.TokenKind.CaretEqual ||
                op_kind == token.TokenKind.LessLessEqual ||
                op_kind == token.TokenKind.GreaterGreaterEqual) {
                if (common_type < 0 || !type_is_integer_builtin(ref types_table, common_type)) {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, stmt_id, ref "S006", ref "Type mismatch")
                }
            } else {
                if (common_type < 0 || !type_is_numeric_builtin(ref types_table, common_type)) {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, stmt_id, ref "S006", ref "Type mismatch")
                }
            }
        }
    }
}

// Statement checking owns control-flow, return rules, and assignment validation.
func check_statement(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    module_id: i64,
    scope_id: i64,
    func_return_type: i64,
    in_loop: bool,
    stmt_id: i64
): void = {
    val kind: node.NodeKind = nodes.kind[stmt_id]
    match (kind) {
        VarDecl = {
            check_local_decl(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                stmt_id
            )
            return
        }

        Block = {
            check_block(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                stmt_id,
                true
            )
            return
        }

        ReturnStmt = {
            val value_id: i64 = node.node_child_at(ref nodes, stmt_id, 0)
            if (value_id < 0) {
                if (func_return_type != builtins.void_type) {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, stmt_id, ref "S015", ref "Non-void function must return a value")
                }
            } else {
                check_expr(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    mut ref scopes_table,
                    mut ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    mut ref deps,
                    mut ref deferred,
                    module_id,
                    scope_id,
                    func_return_type,
                    in_loop,
                    value_id,
                    false
                )
                if (func_return_type == builtins.void_type) {
                    diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, stmt_id, ref "S014", ref "Void function cannot return a value")
                } else {
                    if (!expr_type_compatible(
                        ref types_table,
                        ref builtins,
                        ref tokens,
                        ref nodes,
                        func_return_type,
                        nodes.type_id[value_id],
                        value_id,
                        false
                    )) {
                        diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, value_id, ref "S013", ref "Return type mismatch")
                    } else {
                        check_return_arena_escape(
                            mut ref mem,
                            ref sources,
                            ref text_pool,
                            ref tokens,
                            mut ref nodes,
                            ref scopes_table,
                            mut ref symbols_table,
                            mut ref types_table,
                            ref builtins,
                            mut ref diags,
                            mut ref diag_pool,
                            mut ref deps,
                            mut ref deferred,
                            module_id,
                            scope_id,
                            value_id,
                            func_return_type
                        )
                    }
                }
            }
            return
        }

        AssertStmt = {
            val cond_id: i64 = node.node_child_at(ref nodes, stmt_id, 0)
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                cond_id,
                false
            )
            if (!type_is_bool_builtin(ref types_table, nodes.type_id[cond_id])) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, cond_id, ref "S007", ref "Condition must be bool")
            }
            return
        }

        WhileStmt = {
            val cond_id: i64 = node.node_child_at(ref nodes, stmt_id, 0)
            val body_id: i64 = node.node_child_at(ref nodes, stmt_id, 1)
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                cond_id,
                false
            )
            if (!type_is_bool_builtin(ref types_table, nodes.type_id[cond_id])) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, cond_id, ref "S007", ref "Condition must be bool")
            }
            if (body_id >= 0) {
                check_block(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    mut ref scopes_table,
                    mut ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    mut ref deps,
                    mut ref deferred,
                    module_id,
                    scope_id,
                    func_return_type,
                    true,
                    body_id,
                    true
                )
            }
            return
        }

        ForStmt = {
            val start_id: i64 = node.node_child_at(ref nodes, stmt_id, 0)
            val end_id: i64 = node.node_child_at(ref nodes, stmt_id, 1)
            val body_id: i64 = node.node_child_at(ref nodes, stmt_id, 2)
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                start_id,
                false
            )
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                end_id,
                false
            )
            if (!type_is_integer_builtin(ref types_table, nodes.type_id[start_id]) &&
                !node_is_integer_literal(ref tokens, ref nodes, start_id)) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, start_id, ref "S058", ref "For-loop range bound must be integer type")
            }
            if (!type_is_integer_builtin(ref types_table, nodes.type_id[end_id]) &&
                !node_is_integer_literal(ref tokens, ref nodes, end_id)) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, end_id, ref "S058", ref "For-loop range bound must be integer type")
            }

            val loop_scope: i64 = scopes.scopes_push(mut ref scopes_table, scope_id, module_id, stmt_id)
            val loop_symbol: i64 = symbols.symbols_push(
                mut ref symbols_table,
                symbols.SymbolKind.LocalSymbol,
                module_id,
                loop_scope,
                stmt_id,
                nodes.data0[stmt_id],
                builtins.i64_type,
                -1,
                0
            )
            scope_append_symbol(mut ref scopes_table, mut ref symbols_table, loop_scope, loop_symbol)
            nodes.symbol_id[stmt_id] = loop_symbol
            if (body_id >= 0) {
                check_block(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    mut ref scopes_table,
                    mut ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    mut ref deps,
                    mut ref deferred,
                    module_id,
                    loop_scope,
                    func_return_type,
                    true,
                    body_id,
                    false
                )
            }
            return
        }

        BreakStmt = {
            if (!in_loop) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, stmt_id, ref "S004", ref "'break' outside of loop")
            }
            return
        }

        ContinueStmt = {
            if (!in_loop) {
                diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, stmt_id, ref "S005", ref "'continue' outside of loop")
            }
            return
        }

        AssignStmt = {
            check_assignment_stmt(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                stmt_id
            )
            return
        }

        CompoundAssignStmt = {
            check_assignment_stmt(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                stmt_id
            )
            return
        }

        ExprStmt = {
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                node.node_child_at(ref nodes, stmt_id, 0),
                false
            )
            return
        }

        else = {
            check_expr(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                mut ref scopes_table,
                mut ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                mut ref deps,
                mut ref deferred,
                module_id,
                scope_id,
                func_return_type,
                in_loop,
                stmt_id,
                false
            )
            return
        }
    }
}

// Blocks own lexical scope creation plus the trailing-value type of block expressions.
func check_block(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    module_id: i64,
    scope_id: i64,
    func_return_type: i64,
    in_loop: bool,
    block_id: i64,
    create_scope: bool
): void = {
    val block_scope: i64 = if (create_scope) {
        scopes.scopes_push(mut ref scopes_table, scope_id, module_id, block_id)
    } else {
        scope_id
    }

    nodes.type_id[block_id] = builtins.void_type
    mut child_id: i64 = nodes.first_child[block_id]
    while (child_id >= 0) {
        check_statement(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            mut ref scopes_table,
            mut ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            mut ref deps,
            mut ref deferred,
            module_id,
            block_scope,
            func_return_type,
            in_loop,
            child_id
        )
        child_id = nodes.next_sibling[child_id]
    }

    if (flag_has(nodes.data1[block_id], CHECK_NODE_FLAG_HAS_VALUE) &&
        nodes.last_child[block_id] >= 0) {
        nodes.type_id[block_id] = nodes.type_id[nodes.last_child[block_id]]
    }
}

// Parameters are bound before the function body so all later statements can see them.
func check_func_decl(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    module_id: i64,
    decl_id: i64
): void = {
    val module_scope: i64 = module_scope_id(ref scopes_table, module_id)
    val func_symbol: i64 = nodes.symbol_id[decl_id]
    val func_scope: i64 = scopes.scopes_push(mut ref scopes_table, module_scope, module_id, decl_id)
    val param_count: i64 = nodes.data2[decl_id]

    if (decl_is_native(ref nodes, decl_id) &&
        !native_builtin_name_known(ref sources, ref text_pool, ref tokens, nodes.data0[decl_id])) {
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, nodes.data0[decl_id], ref "S086", ref "Unknown native function name")
    }

    mut index: i64 = 0
    while (index < param_count) {
        val param_id: i64 = node.node_child_at(ref nodes, decl_id, index)
        val name_token: i64 = nodes.data0[param_id]
        val type_node: i64 = node.node_child_at(ref nodes, param_id, 0)
        val type_id: i64 = resolve_type_node(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            module_id,
            type_node,
            false
        )
        nodes.type_id[param_id] = type_id
        if (type_id == builtins.void_type) {
            diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, name_token, ref "S012", ref "void is not valid as parameter type")
        }
        if (type_id >= 0 &&
            !decl_is_ref(ref nodes, param_id) &&
            (types_table.kind[type_id] == types.TypeKind.SliceType ||
             types_table.kind[type_id] == types.TypeKind.StrType)) {
            diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, name_token, ref "S049", ref "Slice parameter must use 'ref' or 'mut ref'")
        } else {
            if (type_is_non_copyable(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    ref scopes_table,
                    ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    type_id,
                    64
                ) &&
                !decl_is_ref(ref nodes, param_id)) {
                diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, name_token, ref "S044", ref "Non-copyable parameter must use 'ref' or 'mut ref'")
            }
        }

        if (scope_find_value_local(
            ref scopes_table,
            ref symbols_table,
            ref sources,
            ref text_pool,
            ref tokens,
            func_scope,
            name_token
        ) >= 0) {
            val name: [u8] = token.token_text(ref sources, ref text_pool, ref tokens, name_token)
            val message: str = message_named(mut ref mem, ref "Duplicate parameter '", ref name, ref "'")
            diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, name_token, ref "S011", ref message)
        } else {
            mut flags: i64 = 0
            if (decl_is_mut(ref nodes, param_id)) {
                flags |= 2
            }
            if (decl_is_ref(ref nodes, param_id)) {
                flags |= 4
            }
            val symbol_id: i64 = symbols.symbols_push(
                mut ref symbols_table,
                symbols.SymbolKind.ParamSymbol,
                module_id,
                func_scope,
                param_id,
                name_token,
                type_id,
                -1,
                flags
            )
            scope_append_symbol(mut ref scopes_table, mut ref symbols_table, func_scope, symbol_id)
            nodes.symbol_id[param_id] = symbol_id
        }

        index += 1
    }

    val return_type_node: i64 = node.node_child_at(ref nodes, decl_id, param_count)
    val return_type: i64 = resolve_type_node(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        ref scopes_table,
        ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        module_id,
        return_type_node,
        false
    )
    nodes.type_id[decl_id] = return_type
    if (func_symbol >= 0) {
        symbols_table.type_id[func_symbol] = return_type
    }

    val native_signature_valid: bool = if (decl_is_native(ref nodes, decl_id)) {
        check_native_decl_signature(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            decl_id
        )
    } else {
        true
    }

    if (native_signature_valid &&
        decl_is_native(ref nodes, decl_id) &&
        func_symbol >= 0 &&
        token_name_is(ref sources, ref text_pool, ref tokens, nodes.data0[decl_id], ref "args")) {
        symbols_table.flags[func_symbol] |= symbols.SYM_FLAG_RETURNS_ARENA_SLICES
    }

    if (decl_is_native(ref nodes, decl_id)) {
        return
    }

    val body_id: i64 = node.node_child_at(ref nodes, decl_id, param_count + 1)
    if (body_id >= 0) {
        check_block(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            mut ref scopes_table,
            mut ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            mut ref deps,
            mut ref deferred,
            module_id,
            func_scope,
            return_type,
            false,
            body_id,
            false
        )
    }
}

// Global declarations reuse module scope and only bind names in the collection pass.
func check_global_decl(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    mut ref deps: ArenaDependencies,
    mut ref deferred: DeferredArenaChecks,
    module_id: i64,
    decl_id: i64
): void = {
    val module_scope: i64 = module_scope_id(ref scopes_table, module_id)
    val symbol_id: i64 = nodes.symbol_id[decl_id]
    mut type_id: i64 = types.invalid_type_id()
    if (decl_has_type(ref nodes, decl_id)) {
        val type_node: i64 = node.node_child_at(ref nodes, decl_id, 0)
        type_id = resolve_type_node(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            mut ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            module_id,
            type_node,
            false
        )
    }

    val init_node: i64 = decl_init_node(ref nodes, decl_id)
    check_expr(
        mut ref mem,
        ref sources,
        ref text_pool,
        ref tokens,
        mut ref nodes,
        mut ref scopes_table,
        mut ref symbols_table,
        mut ref types_table,
        ref builtins,
        mut ref diags,
        mut ref diag_pool,
        mut ref deps,
        mut ref deferred,
        module_id,
        module_scope,
        builtins.void_type,
        false,
        init_node,
        false
    )

    val is_constant_init: bool = expr_is_global_initializer(
        ref sources,
        ref text_pool,
        ref tokens,
        ref nodes,
        ref scopes_table,
        ref symbols_table,
        mut ref types_table,
        ref builtins,
        module_id,
        init_node,
        64
    ) || (
        decl_is_mut(ref nodes, decl_id) &&
        type_id == builtins.arena_type &&
        expr_is_global_arena_initializer(
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref scopes_table,
            ref symbols_table,
            mut ref types_table,
            ref builtins,
            module_id,
            init_node,
            64
        )
    )
    if (!is_constant_init) {
        if (decl_is_mut(ref nodes, decl_id)) {
            diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, nodes.data0[decl_id], ref "S057", ref "Global variable initializer must be a constant expression (or arena constructor)")
        } else {
            diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, nodes.data0[decl_id], ref "S057", ref "Global variable initializer must be a constant expression")
        }
    }

    if (type_id < 0) {
        if (!expr_is_untyped_constant(ref nodes, ref symbols_table, init_node, 64)) {
            diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, nodes.data0[decl_id], ref "S020", ref "Type annotation required (expression is not compile-time constant)")
        }
        type_id = nodes.type_id[init_node]
    } else {
        if (!expr_type_compatible(
            ref types_table,
            ref builtins,
            ref tokens,
            ref nodes,
            type_id,
            nodes.type_id[init_node],
            init_node,
            false
        )) {
            diag_error_node(mut ref mem, ref nodes, mut ref diags, mut ref diag_pool, init_node, ref "S006", ref "Type mismatch")
        }
    }
    if (decl_is_mut(ref nodes, decl_id) &&
        decl_init_is_string_literal(ref nodes, decl_id)) {
        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, nodes.data0[decl_id], ref "S054", ref "String literals cannot be mutable (use 'val')")
    }
    if (type_is_integer_builtin(ref types_table, type_id)) {
        check_integer_binding_diagnostics(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            ref nodes,
            ref builtins,
            mut ref diags,
            mut ref diag_pool,
            type_id,
            init_node
        )
    }

    nodes.type_id[decl_id] = type_id
    if (symbol_id >= 0) {
        symbols_table.type_id[symbol_id] = type_id
    }
}

// Type declarations only need their child type references resolved in this milestone slice.
func check_type_decl(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref scopes_table: scopes.Scopes,
    ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    ref builtins: types.BuiltinTypes,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf,
    module_id: i64,
    decl_id: i64
): void = {
    mut child_id: i64 = nodes.first_child[decl_id]
    while (child_id >= 0) {
        if (nodes.kind[child_id] == node.NodeKind.FieldDecl) {
            mut prev_id: i64 = nodes.first_child[decl_id]
            while (prev_id >= 0 && prev_id != child_id) {
                if (nodes.kind[prev_id] == node.NodeKind.FieldDecl &&
                    token_name_eq(
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        nodes.data0[prev_id],
                        nodes.data0[child_id]
                    )) {
                    diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, nodes.data0[child_id], ref "S022", ref "Duplicate field in type declaration")
                    prev_id = child_id
                } else {
                    prev_id = nodes.next_sibling[prev_id]
                }
            }

            val type_node: i64 = node.node_child_at(ref nodes, child_id, 0)
            nodes.type_id[child_id] = resolve_type_node(
                mut ref mem,
                ref sources,
                ref text_pool,
                ref tokens,
                mut ref nodes,
                ref scopes_table,
                ref symbols_table,
                mut ref types_table,
                ref builtins,
                mut ref diags,
                mut ref diag_pool,
                module_id,
                type_node,
                false
            )
            if (nodes.kind[decl_id] == node.NodeKind.TableDecl &&
                !type_is_value_compatible(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    ref scopes_table,
                    ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    nodes.type_id[child_id],
                    64
                )) {
                diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, nodes.data0[child_id], ref "S059", ref "Table field must be value-compatible")
            } else {
                if ((nodes.kind[decl_id] == node.NodeKind.ValueDecl ||
                     nodes.kind[decl_id] == node.NodeKind.StructDecl) &&
                    type_is_non_copyable(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        ref scopes_table,
                        ref symbols_table,
                        mut ref types_table,
                        ref builtins,
                        mut ref diags,
                        mut ref diag_pool,
                        nodes.type_id[child_id],
                        64
                    )) {
                    diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, nodes.data0[child_id], ref "S045", ref "Cannot embed non-copyable type as field")
                }
                if (nodes.kind[decl_id] == node.NodeKind.ValueDecl &&
                    nodes.type_id[child_id] >= 0 &&
                    (types_table.kind[nodes.type_id[child_id]] == types.TypeKind.SliceType ||
                     types_table.kind[nodes.type_id[child_id]] == types.TypeKind.StrType)) {
                    diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, nodes.data0[child_id], ref "S047", ref "Slice type not allowed as field in value type")
                }
            }
        } else {
            if (nodes.kind[child_id] == node.NodeKind.VariantDecl) {
                mut prev_id: i64 = nodes.first_child[decl_id]
                while (prev_id >= 0 && prev_id != child_id) {
                    if (nodes.kind[prev_id] == node.NodeKind.VariantDecl &&
                        token_name_eq(
                            ref sources,
                            ref text_pool,
                            ref tokens,
                            nodes.data0[prev_id],
                            nodes.data0[child_id]
                        )) {
                        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, nodes.data0[child_id], ref "S069", ref "Duplicate variant name in enum")
                        prev_id = child_id
                    } else {
                        prev_id = nodes.next_sibling[prev_id]
                    }
                }

                if (flag_has(nodes.data1[child_id], CHECK_NODE_FLAG_HAS_TYPE)) {
                    val type_node: i64 = node.node_child_at(ref nodes, child_id, 0)
                    nodes.type_id[child_id] = resolve_type_node(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        ref scopes_table,
                        ref symbols_table,
                        mut ref types_table,
                        ref builtins,
                        mut ref diags,
                        mut ref diag_pool,
                        module_id,
                        type_node,
                        false
                    )
                    if (type_is_non_copyable(
                            mut ref mem,
                            ref sources,
                            ref text_pool,
                            ref tokens,
                            mut ref nodes,
                            ref scopes_table,
                            ref symbols_table,
                            mut ref types_table,
                            ref builtins,
                            mut ref diags,
                            mut ref diag_pool,
                            nodes.type_id[child_id],
                            64
                        )) {
                        diag_error_token(mut ref mem, ref tokens, mut ref diags, mut ref diag_pool, nodes.data0[child_id], ref "S082", ref "Variant payload type not value-compatible")
                    }
                }
            }
        }
        child_id = nodes.next_sibling[child_id]
    }
}

// The public entry point builds builtin/module scopes, collects declarations, then resolves bodies.
pub func check_modules(
    mut ref mem: Arena,
    ref sources: source.Sources,
    ref text_pool: bbuf.ByteBuf,
    ref tokens: token.Tokens,
    mut ref nodes: node.Nodes,
    ref modules: loader.Modules,
    ref imports: loader.ModuleImports,
    mut ref scopes_table: scopes.Scopes,
    mut ref symbols_table: symbols.Symbols,
    mut ref types_table: types.Types,
    mut ref diags: diag.Diagnostics,
    mut ref diag_pool: bbuf.ByteBuf
): CheckResult = {
    val scope_start: i64 = table_len(ref scopes_table)
    val symbol_start: i64 = table_len(ref symbols_table)
    val type_start: i64 = table_len(ref types_table)
    val diag_start: i64 = table_len(ref diags)

    val builtins: types.BuiltinTypes = types.types_init_builtins(mut ref types_table)
    val os_type: i64 = inject_builtin_os_type(mut ref nodes, mut ref types_table)
    mut deps: ArenaDependencies = table_alloc(mut ref mem, table_len(ref nodes) + 8)
    mut deferred: DeferredArenaChecks = table_alloc(mut ref mem, table_len(ref nodes) + 8)

    mut module_id: i64 = 0
    while (module_id < table_len(ref modules)) {
        scopes.scopes_push(mut ref scopes_table, -1, module_id, modules.root_node[module_id])
        module_id += 1
    }

    module_id = 0
    while (module_id < table_len(ref modules)) {
        inject_module_builtins(mut ref scopes_table, mut ref symbols_table, module_id, os_type)
        collect_module_symbols(
            mut ref mem,
            ref sources,
            ref text_pool,
            ref tokens,
            ref modules,
            ref imports,
            mut ref nodes,
            mut ref scopes_table,
            mut ref symbols_table,
            mut ref types_table,
            mut ref diags,
            mut ref diag_pool,
            module_id
        )
        module_id += 1
    }

    module_id = 0
    while (module_id < table_len(ref modules)) {
        val root_id: i64 = modules.root_node[module_id]
        mut decl_id: i64 = nodes.first_child[root_id]
        while (decl_id >= 0) {
            val kind: node.NodeKind = nodes.kind[decl_id]
            if (kind == node.NodeKind.FuncDecl || kind == node.NodeKind.NativeFuncDecl) {
                check_func_decl(
                    mut ref mem,
                    ref sources,
                    ref text_pool,
                    ref tokens,
                    mut ref nodes,
                    mut ref scopes_table,
                    mut ref symbols_table,
                    mut ref types_table,
                    ref builtins,
                    mut ref diags,
                    mut ref diag_pool,
                    mut ref deps,
                    mut ref deferred,
                    module_id,
                    decl_id
                )
            } else {
                if (kind == node.NodeKind.VarDecl) {
                    check_global_decl(
                        mut ref mem,
                        ref sources,
                        ref text_pool,
                        ref tokens,
                        mut ref nodes,
                        mut ref scopes_table,
                        mut ref symbols_table,
                        mut ref types_table,
                        ref builtins,
                        mut ref diags,
                        mut ref diag_pool,
                        mut ref deps,
                        mut ref deferred,
                        module_id,
                        decl_id
                    )
                } else {
                    if (kind == node.NodeKind.ValueDecl ||
                        kind == node.NodeKind.StructDecl ||
                        kind == node.NodeKind.TableDecl ||
                        kind == node.NodeKind.EnumDecl) {
                        check_type_decl(
                            mut ref mem,
                            ref sources,
                            ref text_pool,
                            ref tokens,
                            mut ref nodes,
                            ref scopes_table,
                            ref symbols_table,
                            mut ref types_table,
                            ref builtins,
                            mut ref diags,
                            mut ref diag_pool,
                            module_id,
                            decl_id
                        )
                    }
                }
            }
            decl_id = nodes.next_sibling[decl_id]
        }
        module_id += 1
    }

    mut changed: bool = true
    while (changed) {
        changed = false
        mut dep_id: i64 = 0
        while (dep_id < table_len(ref deps)) {
            val func_symbol: i64 = deps.func_symbol[dep_id]
            val callee_symbol: i64 = deps.callee_symbol[dep_id]
            if (func_symbol >= 0 &&
                callee_symbol >= 0 &&
                symbols.symbol_returns_arena_slices(ref symbols_table, callee_symbol) &&
                !symbols.symbol_returns_arena_slices(ref symbols_table, func_symbol)) {
                symbols_table.flags[func_symbol] |= symbols.SYM_FLAG_RETURNS_ARENA_SLICES
                changed = true
            }
            dep_id += 1
        }
    }

    mut check_id: i64 = 0
    while (check_id < table_len(ref deferred)) {
        val callee_symbol: i64 = deferred.callee_symbol[check_id]
        if (callee_symbol >= 0 &&
            symbols.symbol_returns_arena_slices(ref symbols_table, callee_symbol)) {
            val callee_name: [u8] = name_text(
                ref sources,
                ref text_pool,
                ref tokens,
                symbols_table.name_token[callee_symbol]
            )
            val arena_name: [u8] = name_text(
                ref sources,
                ref text_pool,
                ref tokens,
                symbols_table.name_token[deferred.arena_symbol[check_id]]
            )
            val prefix: str = message_named(
                mut ref mem,
                ref "Return value of '",
                ref callee_name,
                ref "' contains slices that escape local arena '"
            )
            val message: str = string.str_concat3(mut ref mem, ref prefix, ref arena_name, ref "'")
            diag_error_node(
                mut ref mem,
                ref nodes,
                mut ref diags,
                mut ref diag_pool,
                deferred.call_node[check_id],
                ref "S053",
                ref message
            )
        }
        check_id += 1
    }

    CheckResult {
        scopes: span.range(scope_start, table_len(ref scopes_table) - scope_start),
        symbols: span.range(symbol_start, table_len(ref symbols_table) - symbol_start),
        types: span.range(type_start, table_len(ref types_table) - type_start),
        diags: span.range(diag_start, table_len(ref diags) - diag_start)
    }
}
